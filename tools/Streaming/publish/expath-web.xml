<webapp xmlns="http://expath.org/ns/webapp/descriptor"
  xmlns:app="http://dev.saxonica.com/stream"
  name="http://dev.saxonica.com/stream" abbrev="stream" version="0.1">

  <title>Saxonica analyze-stream application</title>

  <resource pattern="/" rewrite="index.html" media-type="application/xhtml+xml"/>
  <resource pattern="/style/.+\.css" media-type="text/css"/>
  <resource pattern="/images/.+\.png" media-type="image/png"/>
  <resource pattern="/images/.+\.gif" media-type="image/gif"/>
  <resource pattern="/images/.+\.jpg" media-type="image/jpeg"/>
  

  <servlet name="analyze.html">
    <xslt uri="http://dev.saxonica.com/stream/gen-analyze.xsl"/>
    <url pattern="/analyze\.html"/>
  </servlet>
  
  <servlet name="XSLT3.0-Spec">
    <xslt uri="http://dev.saxonica.com/stream/gen-spec.xsl"/>
    <url pattern="/XSLT3\.0-Spec"/>
  </servlet>

  <servlet name="analyzeStream">
    <xslt uri="http://dev.saxonica.com/stream/main.xsl"/>
    <url pattern="/analyzeStream"/>
  </servlet>
  
  <servlet name="analyzeStreamExample">
    <xslt uri="http://dev.saxonica.com/stream/main.xsl"/>
    <url pattern="/analyzeStreamExample"/>
  </servlet>

  <resource pattern="/.+\.html" media-type="text/html"/>
  <resource pattern="/.+\.js" media-type="text/javascript"/>
  <resource pattern="/.+\.xsl" media-type="application/xslt+xml"/>

</webapp>
