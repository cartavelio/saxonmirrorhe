          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] = 72">                                        <!-- 'item' -->
          <xsl:variable name="state" select="p:shift(72, $input, $state)"/>         <!-- 'item' -->
          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] = 78">                                        <!-- 'namespace-node' -->
          <xsl:variable name="state" select="p:shift(78, $input, $state)"/>         <!-- 'namespace-node' -->
          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] = 80">                                        <!-- 'node' -->
          <xsl:variable name="state" select="p:shift(80, $input, $state)"/>         <!-- 'node' -->
