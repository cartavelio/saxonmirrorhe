  <!--~
   ! Parse PITest.
   !
   ! @param $input the input string.
   ! @param $state the parser state.
   ! @return the updated parser state.
  -->
  <xsl:function name="p:parse-PITest" as="item()+">
    <xsl:param name="input" as="xs:string"/>
    <xsl:param name="state" as="item()+"/>

    <xsl:variable name="count" select="count($state)"/>
    <xsl:variable name="begin" select="$state[$p:e0]"/>
    <xsl:variable name="state" select="p:shift(86, $input, $state)"/>               <!-- 'processing-instruction' -->
    <xsl:variable name="state" select="p:lookahead1W(3, $input, $state)"/>          <!-- S^WS | '(' | ('(' ':') -->
    <xsl:variable name="state" select="p:shift(16, $input, $state)"/>               <!-- '(' -->
    <xsl:variable name="state" select="p:lookahead1W(19, $input, $state)"/>         <!-- StringLiteral | NCName | S^WS | ('(' ':') | ')' -->
    <xsl:variable name="state" as="item()+">
      <xsl:choose>
        <xsl:when test="$state[$p:error]">
          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] != 18">                                       <!-- ')' -->
          <xsl:variable name="state" as="item()+">
            <xsl:choose>
