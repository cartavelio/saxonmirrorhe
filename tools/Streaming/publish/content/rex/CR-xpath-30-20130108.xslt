                <xsl:variable name="state" select="p:parse-ValueComp($input, $state)"/>
                <xsl:sequence select="$state"/>
              </xsl:when>
              <xsl:when test="$state[$p:l1] = 31                                      (: '&lt;&lt;' :)
                           or $state[$p:l1] = 36                                      (: '>>' :)
                           or $state[$p:l1] = 71">                                  <!-- 'is' -->
                <xsl:variable name="state" select="p:whitespace($input, $state)"/>
                <xsl:variable name="state" select="p:parse-NodeComp($input, $state)"/>
                <xsl:sequence select="$state"/>
              </xsl:when>
              <xsl:when test="$state[$p:error]">
                <xsl:sequence select="$state"/>
              </xsl:when>
              <xsl:otherwise>
                <xsl:variable name="state" select="p:whitespace($input, $state)"/>
                <xsl:variable name="state" select="p:parse-GeneralComp($input, $state)"/>
                <xsl:sequence select="$state"/>
              </xsl:otherwise>
