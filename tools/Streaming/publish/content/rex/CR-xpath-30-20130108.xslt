        <xsl:when test="$state[$p:l1] = 89">                                        <!-- 'schema-attribute' -->
          <xsl:variable name="state" select="p:shift(89, $input, $state)"/>         <!-- 'schema-attribute' -->
          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] = 90">                                        <!-- 'schema-element' -->
          <xsl:variable name="state" select="p:shift(90, $input, $state)"/>         <!-- 'schema-element' -->
          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] = 93">                                        <!-- 'switch' -->
          <xsl:variable name="state" select="p:shift(93, $input, $state)"/>         <!-- 'switch' -->
          <xsl:sequence select="$state"/>
