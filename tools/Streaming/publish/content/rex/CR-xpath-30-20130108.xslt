        <xsl:when test="$state[$p:l1] = 87">                                        <!-- 'return' -->
          <xsl:variable name="state" select="p:shift(87, $input, $state)"/>         <!-- 'return' -->
          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] = 88">                                        <!-- 'satisfies' -->
          <xsl:variable name="state" select="p:shift(88, $input, $state)"/>         <!-- 'satisfies' -->
