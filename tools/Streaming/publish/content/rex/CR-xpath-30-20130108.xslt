  <!--~
   ! Parse QName.
   !
   ! @param $input the input string.
   ! @param $state the parser state.
   ! @return the updated parser state.
  -->
  <xsl:function name="p:parse-QName" as="item()+">
    <xsl:param name="input" as="xs:string"/>
    <xsl:param name="state" as="item()+"/>

    <xsl:variable name="count" select="count($state)"/>
    <xsl:variable name="begin" select="$state[$p:e0]"/>
    <xsl:variable name="state" as="item()+">
      <xsl:choose>
        <xsl:when test="$state[$p:l1] = 45">                                        <!-- 'attribute' -->
          <xsl:variable name="state" select="p:shift(45, $input, $state)"/>         <!-- 'attribute' -->
          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] = 49">                                        <!-- 'comment' -->
          <xsl:variable name="state" select="p:shift(49, $input, $state)"/>         <!-- 'comment' -->
          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] = 53">                                        <!-- 'document-node' -->
          <xsl:variable name="state" select="p:shift(53, $input, $state)"/>         <!-- 'document-node' -->
          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] = 54">                                        <!-- 'element' -->
          <xsl:variable name="state" select="p:shift(54, $input, $state)"/>         <!-- 'element' -->
          <xsl:sequence select="$state"/>
