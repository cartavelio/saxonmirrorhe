          <xsl:variable name="state" select="p:shift(59, $input, $state)"/>         <!-- 'except' -->
          <xsl:sequence select="$state"/>
        </xsl:when>
        <xsl:when test="$state[$p:l1] = 60">                                        <!-- 'following' -->
          <xsl:variable name="state" select="p:shift(60, $input, $state)"/>         <!-- 'following' -->
