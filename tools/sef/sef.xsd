<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://ns.saxonica.com/xslt/export" xmlns:export="http://ns.saxonica.com/xslt/export"
    xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:minVersion="1.1">
  
  <xs:element name="package">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="export:package"/>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="export:schema"/>
        <xs:element minOccurs="0" maxOccurs="1" ref="export:glob"/>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="export:co"/>
        <xs:element ref="export:overridden"/>
        <xs:element ref="export:key" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="export:accumulator" minOccurs="0" maxOccurs="unbounded"/>       
        <xs:element ref="export:output" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="export:charMap" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element minOccurs="0" ref="export:strip"/>
        <xs:element ref="export:decimalFormat" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="declaredModes" type="xs:integer"/>
      <xs:attribute name="defaultMode" type="export:QName"/>
      <xs:attribute name="dmk" type="xs:string"/>
      <xs:attribute name="expiry" type="xs:date"/>
      <xs:attribute name="name" type="xs:anyURI"/>
      <xs:attribute name="packageVersion" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="relocatable" type="xs:boolean"/>
      <xs:attribute name="saxonVersion" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="schemaAware" type="xs:boolean"/>
      <xs:attribute name="stripType" type="xs:boolean"/>
      <xs:attribute name="timeStamp" type="xs:dateTimeStamp"/>
      <xs:attribute name="version" use="required" type="xs:integer"/>
    </xs:complexType>
    <xs:unique name="unique-component-id">
      <xs:selector xpath="export:co"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>
  
  <xs:element name="schema">
    <xs:complexType>
      <xs:attribute name="ns" use="required" type="xs:anyURI"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="overridden">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="export:co"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="output">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="export:property"/>
      </xs:sequence>
      <xs:attribute name="name" type="export:QName"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="charMap">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="m" maxOccurs="unbounded" >
          <xs:complexType>
            <xs:attribute name="c" type="export:oneChar" use="required"/>
            <xs:attribute name="s" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="name" type="export:QName"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="property">
    <xs:complexType>
      <xs:attribute name="name" use="required" type="export:ClarkName"/>
      <xs:attribute name="value" use="required" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="strip">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="s" type="export:strip-or-preserve-type"/>
        <xs:element name="p" type="export:strip-or-preserve-type"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  
    <xs:complexType name="strip-or-preserve-type">
      <xs:attribute name="prec" use="required" type="xs:integer"/>
      <xs:attribute name="test" use="required"/>
    </xs:complexType>
   
  <xs:element name="decimalFormat">
    <xs:complexType>
      <xs:attribute name="name" type="export:QName"/>
      <xs:attribute name="decimal-separator"/>
      <xs:attribute name="grouping-separator"/>
      <xs:attribute name="infinity"/>
      <xs:attribute name="minus-sign"/>
      <xs:attribute name="exponent-separator"/>
      <xs:attribute name="NaN"/>
      <xs:attribute name="percent"/>
      <xs:attribute name="per-mille"/>
      <xs:attribute name="zero-digit"/>
      <xs:attribute name="digit"/>
      <xs:attribute name="pattern-separator"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="glob">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="use"/>
      <xs:attribute name="type"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="co">
    <xs:complexType>
      <xs:choice minOccurs="0">
        <xs:element ref="export:attributeSet"/>
        <xs:element ref="export:function"/>
        <xs:element ref="export:globalVariable"/>
        <xs:element ref="export:globalParam"/>
        <xs:element ref="export:mode"/>
        <xs:element ref="export:template"/>
      </xs:choice>
      <xs:attribute name="base" type="xs:nonNegativeInteger"/>
      <xs:attribute name="binds" use="required" type="export:intList"/>
      <xs:attribute name="dpack" type="xs:anyURI"/>
      <xs:attribute name="id" use="required" type="xs:nonNegativeInteger"/>
      <xs:attribute name="vis" type="export:visibilityType"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="accumulator">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:instruction"/>
        <xs:element name="pre" type="export:accumulator-rules-type"/>
        <xs:element name="post" type="export:accumulator-rules-type"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="as" type="xs:string"/>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="name" type="export:QName"/>
      <xs:attribute name="streamable" type="xs:boolean"/>
      <xs:attribute name="binds"  type="export:intList"/>
      <xs:attribute name="slots" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>
  
  <xs:complexType name="accumulator-rules-type">
    <xs:sequence>
      <xs:element name="accRule" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element ref="export:pattern"/>
            <xs:element ref="export:instruction"/>
          </xs:sequence>
          <xs:attribute name="rank" type="xs:nonNegativeInteger"/>
          <xs:attribute name="slots" type="xs:nonNegativeInteger"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="slots" type="xs:nonNegativeInteger"/>
  </xs:complexType>
  
  <xs:element name="key">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:pattern"/>
        <xs:element ref="export:instruction"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="collation" type="xs:anyURI"/>
      <xs:attribute name="name" use="required" type="export:QName"/>
      <xs:attribute name="binds"  type="export:intList"/>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="slots"  type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="attributeSet">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attribute name="binds" use="required" type="export:intList"/>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="line" use="required" type="xs:integer"/>
      <xs:attribute name="module" type="xs:anyURI"/>
      <xs:attribute name="name" use="required"/>
      <xs:attribute name="slots" use="required" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="function" substitutionGroup="export:instruction">
    <!-- Used both for global functions and for literal function items -->
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:arg" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="export:instruction"/>
      </xs:sequence>
      <xs:attribute name="as" use="required" type="xs:anyURI"/>
      <xs:attribute name="eval" use="required" type="xs:nonNegativeInteger"/>
      <xs:attribute name="flags" use="required" type="export:flagsType"/>
      <xs:attribute name="line" use="required" type="xs:integer"/>
      <xs:attribute name="module" type="xs:anyURI"/>
      <xs:attribute name="name" use="required"/>
      <xs:attribute name="slots" use="required" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="arg">
    <xs:complexType>
      <xs:attribute name="as" use="required" type="xs:string"/>
      <xs:attribute name="name" use="required" type="export:QName"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="instruction" abstract="true"/>
  
  <xs:group name="unary">
    <xs:sequence>
      <xs:element ref="export:instruction"/>
    </xs:sequence>
  </xs:group>
  
  <xs:group name="optional-unary">
    <xs:sequence>
      <xs:element ref="export:instruction" minOccurs="0"/>
    </xs:sequence>
  </xs:group>
  
  <xs:group name="binary">
    <xs:sequence>
      <xs:element ref="export:instruction"/>
      <xs:element ref="export:instruction"/>
    </xs:sequence>
  </xs:group>
  
  <xs:group name="ternary">
    <xs:sequence>
      <xs:element ref="export:instruction"/>
      <xs:element ref="export:instruction"/>
      <xs:element ref="export:instruction"/>
    </xs:sequence>
  </xs:group>
  
  <xs:group name="N-ary">
    <xs:sequence>
      <xs:element ref="export:instruction" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>
  
  <xs:attributeGroup name="exprMisc">
    <xs:attribute name="baseUri" type="xs:anyURI"/>
    <xs:attribute name="defaultCollation" type="xs:anyURI"/>
    <xs:attribute name="defaultElementNS" type="xs:anyURI"/>
    <xs:attribute name="role" type="xs:string"/>
    <xs:attribute name="line" type="xs:integer"/>
    <xs:attribute name="module" type="xs:anyURI"/>
    <xs:attribute name="ns" type="xs:string"/>
    <xs:attribute name="vn" type="xs:integer"/>
  </xs:attributeGroup>
  
  <xs:element name="globalVariable">
    <xs:complexType>
      <xs:group ref="export:optional-unary"/>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="line" use="required" type="xs:integer"/>
      <xs:attribute name="module" type="xs:anyURI"/>
      <xs:attribute name="name" use="required" type="export:QName"/>
      <xs:attribute name="slots" type="xs:nonNegativeInteger"/>
      <xs:attribute name="type" use="required" type="xs:anyURI"/>
      <xs:attribute name="visibility" use="required" type="export:visibilityType"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="globalParam">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:instruction" minOccurs="0" maxOccurs="1"/>
      </xs:sequence>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="line" use="required" type="xs:integer"/>
      <xs:attribute name="module" type="xs:anyURI"/>
      <xs:attribute name="name" use="required"/>
      <xs:attribute name="slots" type="xs:nonNegativeInteger"/>
      <xs:attribute name="type" use="required" type="xs:anyURI"/>
      <xs:attribute name="visibility" use="required" type="export:visibilityType"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="mode">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" ref="export:templateRule"/>
      </xs:sequence>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="name"/>
      <xs:attribute name="onNo" use="required" type="xs:string"/>
      <xs:attribute name="patternSlots" use="required" type="xs:nonNegativeInteger"/>
      <xs:attribute name="streamable" type="xs:boolean"/>
      <xs:attribute name="useAcc" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="templateRule">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:pattern"/>
        <xs:element ref="export:instruction"/>
      </xs:sequence>
      <xs:attribute name="as" type="xs:string"/>
      <xs:attribute name="cxt" type="xs:string"/>
      <xs:attribute name="flags" use="required" type="export:flagsType"/>
      <xs:attribute name="line" use="required" type="xs:integer"/>
      <xs:attribute name="minImp" use="required" type="xs:nonNegativeInteger"/>
      <xs:attribute name="module" type="xs:anyURI"/>
      <xs:attribute name="prec" use="required" type="xs:nonNegativeInteger"/>
      <xs:attribute name="prio" use="required" type="xs:double"/> <!-- May be NaN: see match-049 -->
      <xs:attribute name="rank" use="required" type="xs:nonNegativeInteger"/>
      <xs:attribute name="seq" use="required" type="xs:nonNegativeInteger"/>
      <xs:attribute name="slots" use="required" type="xs:nonNegativeInteger"/>
      <xs:attribute name="streamable" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>
   
  <xs:element name="template">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:param" minOccurs="0" maxOccurs="unbounded"/>
        <xs:group ref="export:optional-unary"/>
      </xs:sequence>     
      <xs:attribute name="as" type="xs:string"/>
      <xs:attribute name="cxt" type="xs:string"/>
      <xs:attribute name="flags" use="required" type="export:flagsType"/>
      <xs:attribute name="line" use="required" type="xs:integer"/>
      <xs:attribute name="module" use="required" type="xs:anyURI"/>
      <xs:attribute name="name" use="required"/>
      <xs:attribute name="slots" use="required" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="acFnRef" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="name" use="required" type="export:QName"/>
    </xs:complexType>
  </xs:element>
  
  
  <xs:element name="among" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="op" fixed="among"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="analyzeString" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:N-ary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="and" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="op" fixed="and"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="applyImports" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:withParam" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="flags" type="export:flagsType"/>
    </xs:complexType>
  </xs:element>
   
  <xs:element name="applyT" substitutionGroup="export:instruction">
    <xs:complexType>     
      <xs:sequence>
        <xs:group ref="export:unary"/>
        <xs:element ref="export:withParam" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="bSlot" use="required" type="export:slotNumber"/>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="mode" />
    </xs:complexType>
  </xs:element>
  
  <xs:element name="arith" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="op"/>
      <xs:attribute name="calc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="arith10" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="op"/>
      <xs:attribute name="calc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="arrayBlock" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:N-ary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element> 
  
  <xs:element name="assign" substitutionGroup="export:instruction" type="xs:anyType"/>
  <!-- TODO: saxon:assign extension -->
  
  <xs:element name="atomic" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="val" use="required"/>
      <xs:attribute name="type" type="export:QName" use="required"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="atomSing" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="card" type="xs:string"/>
      <xs:attribute name="diag" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="att" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="name" use="required" type="export:QName"/>
      <xs:attribute name="nsuri" type="xs:anyURI"/>
      <xs:attribute name="validation" type="export:validationType"/>
      <xs:attribute name="type" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="attVal" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="chk" type="xs:integer" use="required"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:assert test="@chk = (0 to 3)"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="axis" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="name" use="required" type="xs:NCName"/>
      <xs:attribute name="nodeTest" use="required"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="break" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:optional-unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
    
  <xs:element name="callT" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:withParam" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="bSlot" type="export:slotNumber" use="required"/>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="name" type="export:QName"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="cast" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="as" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="emptiable" use="required" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="castable" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="as" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="emptiable" use="required" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="check" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="card" use="required"/>
      <xs:attribute name="diag" use="required"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="choose" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:N-ary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="coercedFn" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="type" use="required" type="xs:string"/>
    </xs:complexType>
  </xs:element>
 
  <xs:element name="comment" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="flags" type="export:flagsType"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="compareToInt" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="op" use="required" type="xs:NCName"/>
      <xs:attribute name="val" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="compAtt" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:instruction" minOccurs="2" maxOccurs="3"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="validation" type="export:validationType"/>
      <xs:assert test="deep-equal(*/@role/string(), ('name', 'namespace', 'select')) or
        deep-equal(*/@role/string(), ('name', 'select'))"/>
    </xs:complexType>   
  </xs:element>
  
  <xs:element name="compElem" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:instruction" minOccurs="2" maxOccurs="3"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="validation" type="export:validationType"/>     
      <xs:assert test="deep-equal(*/@role/string(), ('name', 'namespace', 'content')) or
        deep-equal(*/@role/string(), ('name', 'content'))"/>
    </xs:complexType>   
  </xs:element>
  
  <xs:element name="condCont" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="conditionalSort" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="op"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="condSeq" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:N-ary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="consume" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="convert" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="from" use="required" type="export:QName"/>
      <xs:attribute name="to" use="required" type="export:QName"/>
      <xs:attribute name="flags" type="export:flagsType"/>
    </xs:complexType>
  </xs:element>
  
