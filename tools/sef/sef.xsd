          </xs:documentation>
        </xs:annotation>
      </xs:attribute>     
      <xs:attribute name="global" type="xs:string">
        <xs:annotation>
          <xs:documentation>
            <p>Serialization properties specified as attributes of the relevant xsl:output declaration(s)</p>
            <p>The format is that of java.util.Properties.store()</p>
          </xs:documentation>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="validation" type="export:validationType"/>
      <xs:attribute name="type" type="xs:string"/>
      <xs:assert test="every $r in */@role satisfies
        ($r = ('href', 'format', 'content')
        or matches($r, 'Q\{[^}]*\}[\i-[:]][\c-[:]]*'))"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="root" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="sequence" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:param" minOccurs="0" maxOccurs="unbounded"/>
        <xs:group ref="export:N-ary"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="slash" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="simple" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="some" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="var" type="export:QName"/>
      <xs:attribute name="slot" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="sort" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:instruction"/>
        <xs:element ref="export:sortKey" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="sortKey">
    <xs:complexType>
      <xs:group ref="export:N-ary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="comp"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="str" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="val" use="required"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="stream" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="accum" type="xs:string"/>
      <xs:attribute name="flags" use="required" type="export:flagsType"/>
      <xs:attribute name="schemaType" type="xs:string"/>
      <xs:attribute name="validation" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="subscript" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="supplied" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="slot" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="switch" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:instruction"/>
        <xs:element name="case" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:group ref="export:binary"/>
            <xs:attributeGroup ref="export:exprMisc"/>
          </xs:complexType>
        </xs:element>
        <xs:element ref="export:instruction"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="coll" type="xs:anyURI"/>
      <xs:assert test="*[last()]/@role = 'default'"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="tail" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="start" type="xs:positiveInteger"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="tailCallLoop" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
   
  <xs:element name="to" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="op" fixed="to"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="treat" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="as" use="required" type="xs:string"/>
      <xs:attribute name="diag" use="required"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="true" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="try" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="export:unary"/>
        <xs:element name="catch" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:group ref="export:unary"/>
            <xs:attributeGroup ref="export:exprMisc"/>
            <xs:attribute name="err" use="required" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="ufCall" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:N-ary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="bSlot" use="required" type="export:slotNumber"/>
      <xs:attribute name="eval" type="export:intList"/>
      <xs:attribute name="name" use="required"/>
      <xs:attribute name="tailCall" use="required" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="ufRef" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="name" use="required" type="export:QName"/>
      <xs:attribute name="arity" use="required" type="xs:nonNegativeInteger"/>
      <xs:attribute name="bSlot"  use="required" type="export:slotNumber"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="union" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="op" fixed="|"/>
    </xs:complexType>
  </xs:element>
   
  <xs:element name="useAS" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="bSlot" use="required" type="export:slotNumber"/>
      <xs:attribute name="name" use="required" type="xs:NMTOKEN"/>
      <xs:attribute name="flags" type="export:flagsType"/>
    </xs:complexType>
  </xs:element>
   
  <xs:element name="valueOf" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="flags" type="export:flagsType"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="varRef" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="name" use="required" type="export:QName"/>
      <xs:attribute name="slot" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="vc" substitutionGroup="export:instruction">
    <xs:complexType>
      <xs:group ref="export:binary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="onEmpty"/>
      <xs:attribute name="op"/>
      <xs:attribute name="comp"/>
      <xs:assert test="@op = ('eq', 'ne', 'le', 'lt', 'ge', 'gt')"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="while" substitutionGroup="export:instruction" type="xs:anyType"/>
  <!-- TODO: saxon:while extension -->
  
  <xs:element name="withParam">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="name" use="required"/>
      <xs:attribute name="as" type="xs:string"/>
      <xs:attribute name="flags" type="export:flagsType"/>
      <xs:attribute name="slot" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
 
 
  <xs:element name="pattern" abstract="true"/>
  
  <xs:element name="p.any" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="p.booleanExp" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:instruction"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="test"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="p.genNode" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:instruction"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="test"/>
      <xs:attribute name="type"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="p.genPos" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="type" use="required"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="p.nodeSet" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:group ref="export:unary"/>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="test"/>
      <xs:attribute name="type"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="p.nodeTest" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="test" use="required"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="p.simPos" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="test" use="required"/>
      <xs:attribute name="pos" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="p.venn" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:pattern"/>
        <xs:element ref="export:pattern"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="op" use="required"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="p.withCurrent" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:pattern"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="p.withPredicate" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:pattern"/>
        <xs:element ref="export:instruction"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="p.withUpper" substitutionGroup="export:pattern">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="export:pattern"/>
        <xs:element ref="export:pattern"/>
      </xs:sequence>
      <xs:attributeGroup ref="export:exprMisc"/>
      <xs:attribute name="axis" use="required"/>
      <xs:attribute name="upFirst" use="required" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>
  
  <xs:simpleType name="flagsType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9]*"/>
    </xs:restriction>   
  </xs:simpleType>
  
  <xs:simpleType name="intList">
    <xs:annotation>
      <xs:documentation>
        <p>A space-separated list of integers.</p>
      </xs:documentation>
    </xs:annotation>
    <xs:list itemType="xs:integer"/>
  </xs:simpleType>
  
  <xs:simpleType name="NCNameList">
    <xs:annotation>
      <xs:documentation>
        <p>A list of space-separated tokens, each of which is either an xs:NCName, or the special value "#".</p>
      </xs:documentation>
    </xs:annotation>
    <xs:list itemType="export:NCNameOrHash"/>
  </xs:simpleType>
  
  <xs:simpleType name="NCNameOrHash">
    <xs:annotation>
      <xs:documentation>
        <p>Allows either an xs:NCName, or the special value "#".</p>
      </xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="xs:NCName">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="#"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>       
  </xs:simpleType>
  
  <xs:simpleType name="NCNameOrNothing">
    <xs:annotation>
      <xs:documentation>
        <p>Allows either an xs:NCName, or a zero-length string.</p>
      </xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="xs:NCName">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value=""/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>       
  </xs:simpleType>
  
  <xs:simpleType name="QName">
    <xs:union memberTypes="xs:NCName xs:QName">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="Q\{[^}]*\}[\i-[:]][\c-[:]]*"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>       
  </xs:simpleType>
  
  <xs:simpleType name="ClarkName">
    <xs:annotation>
      <xs:documentation>
        <p>An expanded name in Clark notation: "{uri}local". A no-namespace name may
        be represented either as "local" or "{}local".</p>
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(\{[^}]*\})?[\i-[:]][\c-[:]]*"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="oneChar">
    <xs:annotation>
      <xs:documentation>
        <p>An integer representing a Unicode codepoint</p>
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="1114111"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="slotNumber">
    <xs:annotation>
      <xs:documentation>
        <p>An integer representing a slot number, or -1 meaning null/absent</p>
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="-1"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="validationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="strict"/>
      <xs:enumeration value="lax"/>
      <xs:enumeration value="preserve"/>
      <xs:enumeration value="strip"/>
      <xs:enumeration value="by type"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="visibilityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PUBLIC"/>
      <xs:enumeration value="PRIVATE"/>
      <xs:enumeration value="FINAL"/>
      <xs:enumeration value="ABSTRACT"/>
      <xs:enumeration value="HIDDEN"/>
    </xs:restriction>
  </xs:simpleType>
  
</xs:schema>
