<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:map="http://www.w3.org/2005/xpath-functions/map"
    xmlns:fc="http://www.saxonica.com/ns/doc/functions"
    xmlns:xd="http://www.oxygenxml.com/ns/doc/xsl" 
    xmlns:config="http://saxon.sf.net/ns/configuration"
    exclude-result-prefixes="xs map xd fc"
    version="3.0">
    <xd:doc scope="stylesheet">
        <xd:desc>
            <xd:p><xd:b>Created on:</xd:b> Nov 15, 2023</xd:p>
            <xd:p><xd:b>Author:</xd:b> Debbie Lockett, Saxonica</xd:p>
            <xd:p>Generates a sample configuration file from a base configuration file. The aim is
                that the generated configuration file should include all possible options as defined
                in FeatureKeys.xml and AdditionalFeatures.xml. For this to work, the base
                configuration file must include all allowed elements. To make the generated
                configuration file valid and usable, sample values for options are required - these
                are taken from the base configuration file.</xd:p>
            <xd:p>The base configuration file config-base.xml should be supplied as the source.</xd:p>
            <xd:p>Stylesheet parameters can be used to configure the generated configuration file:</xd:p>
            <xd:ul>
                <xd:li>edition - EE|PE|HE - include only options relevant for the Saxon edition</xd:li>
                <xd:li>platform - J|CS - include only options relevant for the platform (Java or C#)</xd:li>
                <xd:li>include-obsolete - used to specify whether or not obsolete options should be
                    included (these result in warnings when the configuration file is run)</xd:li>
                <xd:li>license-file-location - can be used to specify the license file location for
                    the configuration/@licenseFileLocation attribute</xd:li>
            </xd:ul>
            <xd:p>A generated configuration file should be validated against the generated schema; and
                tested that it can be read by the ConfigurationReader.</xd:p>
        </xd:desc>
    </xd:doc>
        
    <xsl:param name="edition" as="xs:string" select="'EE'"/><!-- EE|PE|HE -->
    <xsl:param name="platform" as="xs:string" select="'J'"/><!-- J|CS -->
    <xsl:param name="include-obsolete" as="xs:boolean" select="false()"/>
    <xsl:param name="license-file-location" as="xs:string" select="''"/>
    
    <xsl:output method="xml" indent="yes"/>
    
    <xsl:template match="*:configuration">
        <xsl:comment> GENERATED - DO NOT EDIT THIS FILE</xsl:comment>
        <xsl:comment expand-text="yes"> Configuration file for Saxon{$platform}-{$edition}</xsl:comment>
        <xsl:copy>
            <xsl:attribute name="edition" select="$edition"/>
            <xsl:if test="$license-file-location ne ''">
                <xsl:attribute name="licenseFileLocation" select="$license-file-location"></xsl:attribute>
            </xsl:if>
            <xsl:attribute name="label" select="'Some label'"/>
            <xsl:apply-templates mode="process-base"/>
        </xsl:copy>
    </xsl:template>
    
    <xsl:template match="*" mode="process-base">
        <xsl:variable name="this-element-in-config" select="." as="element()"/>
        <xsl:variable name="element-name" select="local-name()" as="xs:string"/>
        <xsl:message expand-text="yes">processing element: {$element-name}</xsl:message>
        <xsl:variable name="additional-doc" select="doc('AdditionalFeatures.xml')"/>
        <xsl:message expand-text="yes">additional-doc: {exists($additional-doc)}</xsl:message>
        <xsl:variable name="reference-doc"
            select="$additional-doc//config-element[@name eq $element-name]/@src-doc"/>
        <xsl:message expand-text="yes">reference-doc: {$reference-doc}</xsl:message>
        
        <xsl:variable name="src-doc" select="doc($reference-doc)" as="document-node()?"/>
        
        <xsl:variable name="separator">
            <xsl:choose>
                <xsl:when test="$element-name eq 'resources'">
                    <xsl:value-of select="'/'"/>
                </xsl:when>
                <xsl:otherwise>
                    <xsl:value-of select="'@'"/>
                </xsl:otherwise>
            </xsl:choose>
        </xsl:variable>
        
        <xsl:variable name="features-of-config-el" as="element(feature)*"
            select="$src-doc//configfile[tokenize(string(.),'/')[1] eq $element-name]/parent::node()"/>
        
        <xsl:copy>
            <xsl:for-each select="fc:sort-by-config-name($features-of-config-el)">
                <xsl:variable name="option-name" select="tokenize(configfile[1], $separator)[2]"/>
                
                <!--
                    Include features labelled "obsolete" if and only if requested with
                    $include-obsolete.
                    
                    Ignore features labelled "additional" - this is just a place holder for
                    allowing other options.
                    
                    Only include options relevant for the specified edition and platform.
                -->
                
                <xsl:if test="not(exists(obsolete) and not($include-obsolete)) and not(additional) and ($edition =
                    tokenize(string(editions))) and (not(platforms) or $platform = tokenize(string(platforms)))">
                    <xsl:message expand-text="yes">processing {$option-name}</xsl:message>
                    <xsl:choose>
                        <xsl:when test="$element-name eq 'resources'">
                            <xsl:element name="{$option-name}" namespace="http://saxon.sf.net/ns/configuration">
                                <xsl:variable name="element-in-base" select="$this-element-in-config/*[local-name() eq $option-name]"/>
                                <xsl:message expand-text="yes">{$element-name}/{$option-name} = '{string($element-in-base)}'</xsl:message>
                                <xsl:choose>
                                    <xsl:when test="exists($element-in-base)">
                                        <xsl:value-of select="$element-in-base"/>
                                    </xsl:when>
                                    <xsl:otherwise></xsl:otherwise>
                                </xsl:choose>
                            </xsl:element>
                        </xsl:when>
                        <xsl:when test="$element-name eq 'package' and $option-name eq
                            'exportLocation' and exists($this-element-in-config/*:withParam)">
                            <!-- Since package/withParam and package/@exportLocation are mutually exclusive -->
                        </xsl:when>
                        <xsl:when test="$element-name eq 'collation' and
                            (exists($this-element-in-config/@class) 
                            and not($option-name = ('uri', 'class'))) or ($option-name eq 'class'
                            and empty($this-element-in-config/@class))">
                            <!-- Only include the @uri and @class collation attributes when @class
                                is supplied; but include all others otherwise.
                                Note that the base configuration file has collation elements which do
                                and do not supply @class.
                            -->
                        </xsl:when>
                        <xsl:otherwise>
                            <xsl:attribute name="{$option-name}">
                                <xsl:variable name="attribute-in-base" select="$this-element-in-config/@*[local-name() eq $option-name]"/>
                                <xsl:message expand-text="yes">{$element-name}/@{$option-name} = '{string($attribute-in-base)}'</xsl:message>
                                <xsl:choose>
                                    <xsl:when test="exists($attribute-in-base)">
                                        <xsl:value-of select="$attribute-in-base"/>
                                    </xsl:when>
                                    <xsl:otherwise></xsl:otherwise>
                                </xsl:choose>
                            </xsl:attribute>
                        </xsl:otherwise>
                    </xsl:choose>
                </xsl:if>
            </xsl:for-each>
            <xsl:apply-templates mode="process-base"/>
        </xsl:copy>
    </xsl:template>
    
    <xsl:template match="*">
        <xsl:copy>
            <xsl:copy-of select="@*"/>
            <xsl:apply-templates/>
        </xsl:copy>
    </xsl:template>
    
    <xsl:function name="fc:sort-by-config-name" as="element(feature)*">
        <xsl:param name="features" as="element(feature)*"/>
        <xsl:perform-sort select="$features">
            <xsl:sort select="additional"/> <!-- additional attributes after others-->
            <xsl:sort select="use" order="descending"/> <!-- 'required' > 'optional' > undefined use -->
            <xsl:sort select="lower-case(tokenize(configfile[1], '/')[2])" lang="en"/>
        </xsl:perform-sort>
    </xsl:function>
    
</xsl:stylesheet>
