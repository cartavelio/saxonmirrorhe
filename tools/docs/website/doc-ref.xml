<documentation-pages>
    <!-- version    @number     = version number
                    @dir        = name of folder containing documentation and contents pages
                    @dynamic    = name of folder containing dynamic documentation
                    @static     = path from @dir to folder containing static documentation
                    
    index-link  @dynamic    = dynamic documentation page name with extension 
                @static     = static documentation page name with extension
                
    dynamic-page    @doc-entry = path from dynamic documentation page to dynamic documentation
        paths from dynamic documentation page to the different types of documentations, dynamic and static 
        
    static-page     @doc-entry  = path from static documentation page to static documentation
        paths from static documentation page to the different types of documentations, static only -->
    <version number="10" dir="documentation" dynamic="documentation" static="../html/documentation">
        <index-link dynamic="documentation.xml" static="documentation.html"/>        
        <dynamic-page doc-entry="index.html#!">
            <documentation type="Saxon" dynamic="index.html" static="../html/documentation/about/index.html"/>
            <documentation type="Javadoc API" dynamic="index.html#!javadoc" static="../html/documentation/javadoc/index.html"/>
            <documentation type=".NET API" dynamic="index.html#!dotnetdoc" static="../html/documentation/dotnetdoc/index.html"/> 
            <saxonc type="Saxon/C 1.2" dynamic="../saxon-c/documentation/index.html"/>
            <browser type="Saxon-JS 2" dynamic="../saxon-js/documentation/index.html"/>
        </dynamic-page>
        <static-page doc-entry="">
            <documentation type="Saxon" static="about/index.html"/>
            <documentation type="Javadoc API" static="javadoc/index.html"/>
            <documentation type=".NET API" static="dotnetdoc/index.html"/> 
            <saxonc type="Saxon/C 1.2" dynamic="http://www.saxonica.com/saxon-c/documentation/index.html"/>
            <browser type="Saxon-JS 2" dynamic="http://www.saxonica.com/saxon-js/documentation/index.html"/>
        </static-page>         
    </version>
