<?xml version="1.0" encoding="UTF-8"?>
<p:declare-step 
	xmlns:c="http://www.w3.org/ns/xproc-step"
	xmlns:m="http://xylarium.org/ns/xml/documentation"
	xmlns:p="http://www.w3.org/ns/xproc"
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	version="3.1">
	
	<p:documentation>
		<m:title>Aggregate Test Results</m:title>
		<m:desc>
			<m:ul>
				<m:ingress>Runs specified gradle test tasks for one or more editions of Saxon and then generates HTML reports that group and sort the results by:</m:ingress>
				<m:items>
					<m:li>test suite (QT3, QT4)</m:li>
					<m:li>result category (pass, fail, wrongError, notRun, etc.)</m:li>
					<m:li>reason</m:li>
					<m:li>total cases</m:li>
					<m:li>test set</m:li>
				</m:items>
			</m:ul>
			<m:p>For each test case itemised within a group, the information includes which languages (XPath, XQuery) and editions (EE, PE, HE) are affected.</m:p>
		</m:desc>
		<m:note>
			<m:p>The grouping and sorting varies per result category.</m:p>
		</m:note>
		<m:note>
			<m:p>Result categories other than <m:code>pass</m:code> and <m:code>fail</m:code> are defined in the exceptions file used by the gradle task.</m:p>
		</m:note>
		<m:contributors>
			<m:original-author>Sheila Thomson</m:original-author>
		</m:contributors>
		<m:history created="2026-05-20" />		
	</p:documentation>
	
	
	<p:documentation>
		<m:desc>
			<m:p>A list of the products to run tests for and for each product: what the command is to run the tests and a path to where the XML result files will be output to.</m:p>			
		</m:desc>
		<m:note todo="true">Explore running *:testSuites instead of *:aggregated-test-results.  Requires some standardardisation of test result XML content model.</m:note>
	</p:documentation>
	<p:input port="source">
		<p:inline>
			<products>
				<product name="SaxonJ-HE" test-command="java:he:aggregated-test-results" results-dir="java/he/build/test-results/" />
			</products>
			<!-- products>
				<product name="SaxonJ-HE" test-command="java:he:testSuites" results-dir="java/he/build/test-results/" />
			</products -->
		</p:inline>
	</p:input>
	
	
	<p:documentation>
		<m:desc>
			<m:p>A directory listing of the output directory.</m:p>			
		</m:desc>
	</p:documentation>
	<p:output port="result"/>
	
	
	<p:documentation m:ref="run-tests">
		<m:p>Whether to run the gradle tests (true) or simply generate reports from existing XML test results (false).</m:p>
		<m:note>Default: <m:code>true</m:code></m:note>
	</p:documentation>
	<p:option name="run-tests" select="true()" as="xs:boolean" static="true" />
	
	<p:documentation m:ref="saxondev-dir">
		<m:p>A path to the root of the saxondev repository.</m:p>
	</p:documentation>
	<p:option name="saxondev-dir" select="resolve-uri('../../../', static-base-uri())" as="xs:anyURI" />
	
	<p:documentation m:ref="date">
		<m:p>The date that the tests were run (YYYYMMDD).</m:p>
		<m:note>Default: today</m:note>
	</p:documentation>
	<p:option name="date" select="format-date(current-date(), '[Y0001][M01][D01]')" as="xs:string" />
	
	<p:documentation m:ref="output-dir">
		<m:p>Where to save the output files generated by this pipeline.</m:p>
		<m:note>Default: <m:code>../out/YYYYMMDD/</m:code></m:note>
	</p:documentation>
	<p:option name="output-dir" select="resolve-uri(concat('../out/', format-dateTime(current-dateTime(), '[Y0001][M01][D01]/[H01][m01]'), '/'), static-base-uri())" as="xs:anyURI" />
	
	
	<p:documentation>
		<m:desc>For each product listed in the source input file, run the gradle test task specified and aggregate the results into a single XML document.</m:desc>
	</p:documentation>
	<p:for-each>
		<p:with-input select="/products/product" />
		
		<p:variable name="results-dir" select="resolve-uri(/product/@results-dir, $saxondev-dir)" as="xs:anyURI" />
		
		<p:if test="$run-tests"  name="run-tests">
			<p:os-exec command="./gradlew" cwd="{$saxondev-dir}" args="{/product/@test-command}" message="Running tests for {/product/@name}...">
				<p:with-input>
					<p:empty/>
				</p:with-input>
			</p:os-exec>
		</p:if>
		
		<p:directory-list path="{$results-dir}" depends="run-tests" max-depth="3" include-filter="/{$date}/" message="Collating results from {$results-dir}" />
		
		<p:xslt>
			<p:with-input port="stylesheet" href="xsl/fix_xml_base.xsl" />
		</p:xslt>
		
		<p:viewport match="/c:directory/c:directory/c:directory[@name = $date]/c:file[ends-with(@name, '.xml')]">
			<p:insert position="first-child">
				<p:with-input port="insertion">
					<p:document href="{/c:file/@xml:base}/{/c:file/@name}" />
				</p:with-input>
			</p:insert>
		</p:viewport>
		
	</p:for-each>	
	
	
	<p:documentation>
		<m:desc>Combine the aggregated results from all the products into a single result document.</m:desc>
	</p:documentation>
	<p:wrap-sequence wrapper="aggregated-test-results" name="aggregated-test-results" />
	
	
	<p:documentation>
		<m:desc>Store the aggregated results.</m:desc>
	</p:documentation>
	<p:store href="{$output-dir}aggregated_test_results.all.xml" />
	
	
	<p:documentation>
		<m:desc>Split the aggregated results by test suite version, eg 3.1, 4.0.</m:desc>
	</p:documentation>
	<p:xslt>
		<p:with-input port="stylesheet" href="xsl/group_by_test_suite_version.xsl" />
	</p:xslt>
	
	
	<p:documentation>
		<m:desc>For each test suite version, store the XML and an HTML report that groups and summarises the results across all in-scope languages and editions.</m:desc>
	</p:documentation>
	<p:for-each name="report">
		<p:with-input select="/aggregated-test-results" />
		
		<p:variable name="test-suite-version" select="distinct-values(/aggregated-test-results/*:test-suite-result/*:submission/*:test-run/@test-suite-version) ! translate(., '.', '')" as="xs:string" />
		
		<p:store href="{$output-dir}aggregated_test_results.{$test-suite-version}.xml" />
		
		<p:xslt message="Generating report for {$test-suite-version}">
			<p:with-input port="stylesheet" href="xsl/aggregated_test_suite_results2html.xsl" />
		</p:xslt>
			
		<p:store href="{$output-dir}aggregated_test_results.{$test-suite-version}.html" name="store-html" />	
		
		<p:sink />	
		
	</p:for-each>
	
	
	<p:documentation>
		<m:desc>List all the files in the output directory.</m:desc>
	</p:documentation>
	<p:directory-list path="{$output-dir}" depends="report" include-filter="aggregated_test_results\." />
	
</p:declare-step>