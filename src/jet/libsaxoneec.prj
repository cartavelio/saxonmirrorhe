%%Excelsior JET v15.3 project file

-compilewithfixedheap+
-genstackalloc+
-genstacktrace+
-global+
-gui-
-ignoreclassduplication+
-ignorememberabsence+
-inline+
-jetcpenablemanualsettings+
-pgo+
-splashgetfrommanifest-


-apptype=InvocationDLL
-classabsence=HANDLE
-compilerheap=1744830464
-inlinelimit=100
-inlinetolimit=500
-jetcplastpage:=PageCompile
-jetrt=Server
-jetvmprop=-Djet.jit.disable.resolution -Djet.gc.heaplimit:0 -Djet.stack.trace
-jprofile=./libsaxoneec.jprof
-outputdir=../c/eec
-outputname=libsaxoneec
-stacklimit=134217728




!classpathentry ../c/jars/eec/saxon9ee.jar
  -pack=noncompiled
  -protect=nomatter
  -optimize=all
!end
!classpathentry ../c/eec/saxon-data
  -pack=none
  -protect=nomatter
  -optimize=autodetect
!end


