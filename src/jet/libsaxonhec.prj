%%Excelsior JET v15.3 project file

-compilewithfixedheap+
-genstackalloc+
-genstacktrace-
-global+
-gui-
-ignoreclassduplication+
-ignorememberabsence+
-inline+
-pgo+
-splashgetfrommanifest-

-apptype=InvocationDLL
-classabsence=HANDLE
-compilerheap=1744830464
-inlinelimit=100
-inlinetolimit=500
-javacommandline:=java -cp ./saxon9he.jar net.sf.saxon.Transform
-jetcplastpage:=PageCompile
-jetrt=Server
-jetvmprop=-Djet.jit.disable.resolution -Djet.gc.heaplimit:0 -Djet.stack.trace
-jprofile=./libsaxonhec.jprof
-outputdir=../c/hec
-outputname=libsaxonhec
-stacklimit=900000

!classpathentry ../c/jars/hec/saxon9he.jar
  -pack=noncompiled
  -protect=all
  -optimize=all
!end


