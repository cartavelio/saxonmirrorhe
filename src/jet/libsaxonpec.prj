%%Excelsior JET v15.3 project file

-compilewithfixedheap+
-genstackalloc+
-genstacktrace-
-global+
-gui-
-ignoreclassduplication+
-ignorememberabsence+
-inline+
-pgo+
-splashgetfrommanifest-

-apptype=InvocationDLL
-classabsence=HANDLE
-compilerheap=1744830464
-inlinelimit=100
-inlinetolimit=500
-javacommandline:=java -cp ./saxon9pe.jar net.sf.saxon.Transform
