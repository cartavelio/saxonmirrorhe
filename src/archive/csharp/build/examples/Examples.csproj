<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <OutputType>Exe</OutputType>
    <NoWarn>2200;0414;0168;0169;0649;1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

    <Authors>Saxonica Ltd.</Authors>
    <Description>SaxonCS examples.</Description>
    <PackageTags>XML,XSLT,Saxonica,SaxonCS</PackageTags>
    <Copyright>Copyright © 2021 Saxonica, Ltd.</Copyright>
    <PackageProjectUrl>https://saxonica.com/</PackageProjectUrl>
    <PackageReleaseNotes>These example demonstrate the SaxonCS APIs.</PackageReleaseNotes>
    <PackageSummary>Examples of the SaxonCS API.</PackageSummary>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Saxon">
      <HintPath>../cs/bin/Release/net6.0/osx-x64/SaxonCS.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/samples/cs/Examples.cs" />
  </ItemGroup>
    
  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.33" />
    <PackageReference Include="ICU4N" Version="60.1.0-alpha.354" />
    <PackageReference Include="ICU4N.Collation" Version="60.1.0-alpha.354" />
    <PackageReference Include="ICU4N.CurrencyData" Version="60.1.0-alpha.354" />
    <PackageReference Include="ICU4N.LanguageData" Version="60.1.0-alpha.354" />
    <PackageReference Include="ICU4N.RegionData" Version="60.1.0-alpha.354" />
    <PackageReference Include="ICU4N.Transliterator" Version="60.1.0-alpha.354" />
    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.2.0" />
    <PackageReference Include="Singulink.Numerics.BigDecimal" Version="2.0.0" />
    <PackageReference Include="Singulink.Numerics.BigIntegerExtensions" Version="2.0.1" />
    <PackageReference Include="System.Collections.Immutable" Version="5.0.0" />
  </ItemGroup>
</Project>
