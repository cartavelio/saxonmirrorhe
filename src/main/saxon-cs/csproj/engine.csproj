<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>disable</Nullable>
        <OutputType>Library</OutputType>
    </PropertyGroup>
    
    <ItemGroup>
        <Compile Include="../../src/main/saxon-cs/**" />
        <Compile Remove="**/*.csproj" />
        <Compile Remove="../../src/main/saxon-cs/not-yet-needed/*.cs" />
        <Compile Remove="../../src/**/*.DS_Store" />
        <Compile Remove="../../src/main/saxon-cs/commands/*.cs" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Singulink.Numerics.BigDecimal" Version="0.9.1" />
      <PackageReference Include="Singulink.Numerics.BigIntegerExtensions" Version="1.0.1" />
      <PackageReference Include="System.Collections.Immutable" Version="5.0.0" />
    </ItemGroup>
    
</Project>