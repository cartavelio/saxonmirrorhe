<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>9.0</LangVersion>
        <TargetFramework>net5.0</TargetFramework>
        <Nullable>disable</Nullable>
        <OutputType>Exe</OutputType>
        <NoWarn>2200;0414;0168;0169;0649;1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>

        <Authors>Saxonica Ltd.</Authors>
        <Description>SaxonCS is a high-performance XSLT 3.0 processor. It conforms with the
latest W3C specifications (notably XSLT 3.0, XQuery 3.1, and XPath 3.1).</Description>
        <PackageTags>XML,XSLT,Saxonica</PackageTags>
        <Copyright>Copyright © 2021 Saxonica, Ltd.</Copyright>
        <PackageProjectUrl>https://saxonica.com/</PackageProjectUrl>
        <PackageReleaseNotes>Our first native C# release.</PackageReleaseNotes>
        <PackageSummary>An XSLT 3.0 processor for .NET 5</PackageSummary>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>    
    
    <ItemGroup>
        <Compile Include="../../src/main/saxon-cs/**" />
        <Compile Remove="**/*.csproj" />
        <Compile Remove="../../src/main/saxon-cs/not-yet-needed/*.cs" />
        <Compile Remove="../../src/**/*.DS_Store" />
        <Compile Remove="../../src/main/saxon-cs/commands/*.cs" />
    </ItemGroup>
    
    <ItemGroup>
        <None Include="../../tools/saxon-cs/LICENSE.txt" Pack="true" PackagePath=""/>
        <None Include="../../tools/saxon-cs/README.md" Pack="true" PackagePath=""/>
    </ItemGroup>    

    <ItemGroup>
      <EmbeddedResource Include="../../src/main/resources/**/*"
                        Exclude="../../src/main/resources/**/.DS_Store">
        <LogicalName>$(AssemblyName).$([System.IO.Path]::GetFullPath('%(Identity)'))</LogicalName>
      </EmbeddedResource>
      <!-- This is a bit of trail-and-error; we need to move the SEF file to
           a location where Version.platform.locateResource() will find it. -->
      <EmbeddedResource Include="resources/sef/function-library.sef.xml">
         <LogicalName>$(AssemblyName).$([System.IO.Path]::GetFullPath('../../src/main/resources/net/sf/saxon/data/sef/function-library.sef.xml'))</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="HtmlAgilityPack" Version="1.11.33" />
      <PackageReference Include="ICU4N" Version="60.1.0-alpha.354" />
      <PackageReference Include="ICU4N.Collation" Version="60.1.0-alpha.354" />
      <PackageReference Include="ICU4N.CurrencyData" Version="60.1.0-alpha.354" />
      <PackageReference Include="ICU4N.LanguageData" Version="60.1.0-alpha.354" />
      <PackageReference Include="ICU4N.RegionData" Version="60.1.0-alpha.354" />
      <PackageReference Include="ICU4N.Transliterator" Version="60.1.0-alpha.354" />
      <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.2.0" />
      <PackageReference Include="XmlResolver" Version="1.2.0" />
      <PackageReference Include="XmlResolverData" Version="1.1.0" />
      <PackageReference Include="Singulink.Numerics.BigDecimal" Version="2.0.0" />
      <PackageReference Include="Singulink.Numerics.BigIntegerExtensions" Version="2.0.1" />
      <PackageReference Include="System.Collections.Immutable" Version="5.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="5.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="5.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Xml" Version="5.0.0" />
    </ItemGroup>

    
</Project>
