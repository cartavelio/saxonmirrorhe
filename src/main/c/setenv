export SAXONC_HOME=`pwd`
if [ -e "$SAXONC_HOME/*saxon.*" ]
then
  export LD_LIBRARY_PATH=$SAXONC_HOME:$PATH
else
  echo "Error: SaxonC installation cannot be found in the current directory"
  echo ""
  echo "HOW TO FIX:"
  echo ""
  echo "To set up your environment for using SaxonC, change current directory"
  echo "to the SaxonC installation directory first and then run 'source setenv'"
fi
