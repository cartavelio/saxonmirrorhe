        <xsl:text>package net.sf.saxon.lib;&#xa;&#xa;</xsl:text>
        <xsl:text>import java.util.HashMap;&#xa;</xsl:text>
        <xsl:text>import java.util.Map;&#xa;&#xa;</xsl:text>
        <xsl:text>// AUTO-GENERATED FROM FeatureKeys.xml - DO NOT EDIT THIS FILE&#xa;&#xa;</xsl:text>
        <xsl:text>
/**
 * FeatureKeys defines a set of constants, representing the names of Saxon configuration
 * options which can be supplied to the Saxon implementations of the JAXP
 * interfaces TransformerFactory, SchemaFactory, Validator, and ValidationHandler,
 * and to other interfaces such as the s9api {@link net.sf.saxon.s9api.Processor}
 *
 * @author Michael H. Kay
 */
 
 public abstract class FeatureKeys {

        </xsl:text>
        <xsl:apply-templates select="//feature"/>
    
    private static Map&lt;String, Integer&gt; propertyMap;    
    static  {
        Map&lt;String, Integer&gt; map = new HashMap&lt;String, Integer&gt;();
        <xsl:apply-templates select="//feature[type='boolean']" mode="mappings"/>
        propertyMap = map;
    }
    
    public static Map&lt;String, Integer&gt; booleanPropertyMap() {
        return propertyMap;
    }
        
     public abstract class Flags {   
        <xsl:apply-templates select="//feature[type='boolean']" mode="booleans"/>
        
     }   
        <xsl:text>
}
        </xsl:text>
    </xsl:template>
    
    <xsl:template match="feature">
        <xsl:message>processing <xsl:value-of select="name"/></xsl:message>
        <xsl:apply-templates select="desc, name, uri"/>
    </xsl:template>
   
    
    <xsl:template match="name">
        <xsl:text>&#xa;&#xa;    public final static String </xsl:text>
        <xsl:value-of select="."/>
        <xsl:text> = </xsl:text>
    </xsl:template>
    
    <xsl:template match="feature/*" priority="-0.1"/>
    
    <xsl:template match="uri">
        <xsl:text>&#xa;        "</xsl:text>
        <xsl:value-of select="."/>
        <xsl:text>";&#xa;</xsl:text>
        <xsl:text>&#xa;// AUTO-GENERATED FROM FeatureKeys.xml - DO NOT EDIT THIS FILE&#xa;&#xa;</xsl:text>
    </xsl:template>
    
    <xsl:template match="desc">
        <xsl:text>&#xa;    /**</xsl:text>
        <xsl:apply-templates/>
        <xsl:text>&#xa;    **/</xsl:text>
    </xsl:template>
    
    <xsl:template match="desc//*">
        <xsl:text>&lt;</xsl:text>
        <xsl:value-of select="name()"/>
        <xsl:text>&gt;</xsl:text>
        <xsl:apply-templates/>
        <xsl:text>&lt;/</xsl:text>
        <xsl:value-of select="name()"/>
        <xsl:text>&gt;</xsl:text>
    </xsl:template>
    
    <xsl:template match="desc//link" priority="2">
        <xsl:text>{@link </xsl:text>
        <xsl:apply-templates/>
        <xsl:text>}</xsl:text>
    </xsl:template>
    
    <xsl:template match="desc//text()">
        <xsl:value-of select="replace(replace(replace(., '&#xa;', '&#xa;    *'), '&gt;', '&amp;gt;'), '&lt;', '&amp;lt;')"/>
    </xsl:template>
    
    <xsl:template match="feature" mode="booleans" expand-text="yes"
 >       public final static int {name} = {position()};
        <xsl:if test="position() = last()">
        public final static int MAX = {position()};    
        </xsl:if>
    </xsl:template>
    
    <xsl:template match="feature" mode="mappings" expand-text="yes">
        map.put({name}, Flags.{name});</xsl:template>

    

    
    
</xsl:stylesheet>
