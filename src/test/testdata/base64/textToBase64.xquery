
<books>{

for $book in /books/book 
let $text := ddtek:serialize($book/title, "method=xml")
let $b64 := ddtek:serialize-to-base64($text,"")
let $node := ddtek:base64-to-string(xs:base64Binary($b64), "utf-8")
return 
	<base64>
		<a>{$b64}</a>
		<b>{$node}</b>	
	</base64>

}
</books>

