   <!--SCHEMATRON PATTERNS-->


   <!--PATTERN Act_intolerance_Adverse_Event_V3-pattern-errors-->


	  <!--RULE Act_intolerance_Adverse_Event_V3-errors-->
   <xsl:template match="cda:observation[cda:templateId[@root='2.16.840.1.113883.10.20.24.3.104'][@extension='2016-02-01']]"
                 priority="105"
                 mode="M7">

		<!--ASSERT -->
      <xsl:choose>
         <xsl:when test="@classCode='OBS'"/>
         <xsl:otherwise>
            <xsl:message xmlns:iso="http://purl.oclc.org/dsdl/schematron"
                         xmlns:xs="http://www.w3.org/2001/XMLSchema"
                         xmlns:osf="http://www.oxygenxml.com/sch/functions">
               <xsl:text>SHALL contain exactly one [1..1] @classCode="OBS" (CodeSystem: HL7ActClass urn:oid:2.16.840.1.113883.5.6) (CONF:2228-16379).</xsl:text>
            </xsl:message>
         </xsl:otherwise>
      </xsl:choose>

		    <!--ASSERT -->
      <xsl:choose>
         <xsl:when test="@moodCode='EVN'"/>
         <xsl:otherwise>
            <xsl:message xmlns:iso="http://purl.oclc.org/dsdl/schematron"
                         xmlns:xs="http://www.w3.org/2001/XMLSchema"
                         xmlns:osf="http://www.oxygenxml.com/sch/functions">
               <xsl:text>SHALL contain exactly one [1..1] @moodCode="EVN" (CodeSystem: ActMood urn:oid:2.16.840.1.113883.5.1001) (CONF:2228-16380).</xsl:text>
            </xsl:message>
         </xsl:otherwise>
      </xsl:choose>

		    <!--ASSERT -->
      <xsl:choose>
         <xsl:when test="not(@negationInd)"/>
         <xsl:otherwise>
            <xsl:message xmlns:iso="http://purl.oclc.org/dsdl/schematron"
                         xmlns:xs="http://www.w3.org/2001/XMLSchema"
                         xmlns:osf="http://www.oxygenxml.com/sch/functions">
               <xsl:text>SHALL NOT contain [0..0] @negationInd (CONF:2228-28039).</xsl:text>
            </xsl:message>
         </xsl:otherwise>
      </xsl:choose>

		    <!--ASSERT -->
      <xsl:choose>
         <xsl:when test="count(cda:templateId[@root='2.16.840.1.113883.10.20.24.3.104'][@extension='2016-02-01'])=1"/>
         <xsl:otherwise>
            <xsl:message xmlns:iso="http://purl.oclc.org/dsdl/schematron"
                         xmlns:xs="http://www.w3.org/2001/XMLSchema"
                         xmlns:osf="http://www.oxygenxml.com/sch/functions">
               <xsl:text>SHALL contain exactly one [1..1] templateId (CONF:2228-16381) such that it SHALL contain exactly one [1..1] @root="2.16.840.1.113883.10.20.24.3.104" (CONF:2228-16382). SHALL contain exactly one [1..1] @extension="2016-02-01" (CONF:2228-27010).</xsl:text>
            </xsl:message>
         </xsl:otherwise>
      </xsl:choose>

		    <!--ASSERT -->
      <xsl:choose>
         <xsl:when test="count(cda:id) &gt; 0"/>
         <xsl:otherwise>
            <xsl:message xmlns:iso="http://purl.oclc.org/dsdl/schematron"
                         xmlns:xs="http://www.w3.org/2001/XMLSchema"
                         xmlns:osf="http://www.oxygenxml.com/sch/functions">
               <xsl:text>SHALL contain at least one [1..*] id (CONF:2228-16384).</xsl:text>
            </xsl:message>
         </xsl:otherwise>
      </xsl:choose>

		    <!--ASSERT -->
      <xsl:choose>
         <xsl:when test="count(cda:code)=1"/>
         <xsl:otherwise>
            <xsl:message xmlns:iso="http://purl.oclc.org/dsdl/schematron"
                         xmlns:xs="http://www.w3.org/2001/XMLSchema"
                         xmlns:osf="http://www.oxygenxml.com/sch/functions">
               <xsl:text>SHALL contain exactly one [1..1] code (CONF:2228-16385).</xsl:text>
            </xsl:message>
         </xsl:otherwise>
      </xsl:choose>

		    <!--ASSERT -->
      <xsl:choose>
         <xsl:when test="count(cda:statusCode)=1"/>
         <xsl:otherwise>
            <xsl:message xmlns:iso="http://purl.oclc.org/dsdl/schematron"
                         xmlns:xs="http://www.w3.org/2001/XMLSchema"
                         xmlns:osf="http://www.oxygenxml.com/sch/functions">
               <xsl:text>SHALL contain exactly one [1..1] statusCode (CONF:2228-16387).</xsl:text>
            </xsl:message>
         </xsl:otherwise>
      </xsl:choose>

		    <!--ASSERT -->
      <xsl:choose>
         <xsl:when test="count(cda:effectiveTime)=1"/>
         <xsl:otherwise>
            <xsl:message xmlns:iso="http://purl.oclc.org/dsdl/schematron"
                         xmlns:xs="http://www.w3.org/2001/XMLSchema"
                         xmlns:osf="http://www.oxygenxml.com/sch/functions">
               <xsl:text>SHALL contain exactly one [1..1] effectiveTime (CONF:2228-16389).</xsl:text>
            </xsl:message>
         </xsl:otherwise>
      </xsl:choose>

		    <!--ASSERT -->
      <xsl:choose>
         <xsl:when test="count(cda:value[@xsi:type='CD'])=1"/>
         <xsl:otherwise>
            <xsl:message xmlns:iso="http://purl.oclc.org/dsdl/schematron"
                         xmlns:xs="http://www.w3.org/2001/XMLSchema"
                         xmlns:osf="http://www.oxygenxml.com/sch/functions">
