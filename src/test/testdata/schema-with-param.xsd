<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">

   <!-- various constructs using saxon:param -->
   
  <xs:annotation>
    <xs:appinfo>
      <saxon:param xmlns:saxon="http://saxon.sf.net/" name="baseLine" as="xs:date" select="current-date()"/>
      <saxon:param xmlns:saxon="http://saxon.sf.net/" name="dayOfWeek" as="xs:string" select="'Monday'"/>    
    </xs:appinfo>
  </xs:annotation>

  <xs:element name="date">
    <xs:simpleType>
       <xs:restriction base="xs:date">
         <xs:assertion test="$value lt $baseLine"/>
       </xs:restriction>   
    </xs:simpleType>
  </xs:element>
  
  <xs:element name="outer">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="date" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>  
  </xs:element>
  
  <xs:element name="message" type="messageType">
    <xs:alternative test="$dayOfWeek = ('Saturday', 'Sunday')">
      <xs:complexType>
        <xs:complexContent>
        <xs:restriction base="messageType">
          <xs:sequence>
            <xs:element name="stayAtHome"/>
          </xs:sequence>
        </xs:restriction>
        </xs:complexContent>
      </xs:complexType>
    </xs:alternative>
    <xs:alternative>
      <xs:complexType>
      <xs:complexContent>
        <xs:restriction base="messageType">
          <xs:sequence>
            <xs:element name="goToWork"/>
          </xs:sequence>
        </xs:restriction>
        </xs:complexContent>
      </xs:complexType>
    </xs:alternative>
  </xs:element>
  
  <xs:complexType name="messageType">
    <xs:sequence>
      <xs:any processContents="skip"/>
    </xs:sequence>
 <!--   <xs:attribute name="dayOfWeek">
      <xs:simpleType>
      <xs:restriction base="xs:NCName">
        <xs:enumeration value="Sunday"/>
        <xs:enumeration value="Monday"/>
        <xs:enumeration value="Tuesday"/>
        <xs:enumeration value="Wednesday"/>
        <xs:enumeration value="Thursday"/>
        <xs:enumeration value="Friday"/>
        <xs:enumeration value="Saturday"/>
      </xs:restriction>
      </xs:simpleType>
    </xs:attribute>-->
  </xs:complexType>
    
  
</xs:schema>
