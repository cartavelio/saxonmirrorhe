<?xml version="1.0" encoding="ISO-8859-1" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.example.org/person"
           xmlns:target="http://www.example.org/person"
           xmlns:simple="http://www.example.org/simple"
>

    <xs:import namespace="http://www.example.org/simple" schemaLocation="simple.xsd"/>

    <xs:complexType name="person_type">
        <xs:sequence>
            <xs:element name="surname" type="xs:string"/>
            <xs:element name="firstname" type="xs:string"/>
            <xs:element name="birthday" type="xs:string"/>
            <xs:element name="phoneNumber" type="simple:PhoneNumber"/>
        </xs:sequence>
    </xs:complexType>


    <xs:element name="person" type="target:person_type"/>

</xs:schema>
