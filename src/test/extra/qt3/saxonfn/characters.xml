<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-characters">
  <description>Tests for the saxon:characters extension function</description>
  <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/" idref="func-items-before"/>

  <dependency type="spec" value="XP31+ XQ31+"/>

  <test-case name="characters-001">
    <description>Basic example</description>
    <created by="Michael Kay" on="2020-02-08"/>
    <test>saxon:characters("hello")</test>
    <result>
      <assert-deep-eq>('h', 'e', 'l', 'l', 'o')</assert-deep-eq>
    </result>
  </test-case>

  <test-case name="characters-002">
    <description>Empty string</description>
    <created by="Michael Kay" on="2020-02-08"/>
    <test>saxon:characters("")</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>

  <test-case name="characters-003">
    <description>Non-BMP characters</description>
    <created by="Michael Kay" on="2020-02-08"/>
    <test>saxon:characters(codepoints-to-string((100000, 100001)))</test>
    <result>
      <all-of>
        <assert-count>2</assert-count>
        <assert>$result[1] = codepoints-to-string(100000)</assert>
        <assert>$result[2] = codepoints-to-string(100001)</assert>
      </all-of>
    </result>
  </test-case>

  <test-case name="characters-004">
    <description>Applied to xs:anyURI</description>
    <created by="Michael Kay" on="2020-02-08"/>
    <test>saxon:characters(xs:anyURI('http://www.w3.org'))</test>
    <result>
      <assert>$result[5] eq ':'</assert>
    </result>
  </test-case>

  <test-case name="characters-901">
    <description>Empty sequence not allowed</description>
    <created by="Michael Kay" on="2020-02-08"/>
    <test>saxon:characters(())</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>

  <test-case name="characters-902">
    <description>Numeric arg not allowed</description>
    <created by="Michael Kay" on="2020-02-08"/>
    <test>saxon:characters(82)</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>





</test-set>
