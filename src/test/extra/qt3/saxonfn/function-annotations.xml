<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-function-annotations">
   <description>Tests for the saxon:function-annotations extension function introduced in Saxon 9.8</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-abs"/>
         
   <dependency type="spec" value="XQ30+"/>
   <dependency type="xsd-version" value="1.1"/>
   


   <test-case name="function-annotations-001">
      <description>Use saxon:function-annotations() </description>
      <created by="Michael Kay" on="2016-10-13"/>
      <test>
          declare namespace a = "http://anno.com/";
          declare namespace saxon = "http://saxon.sf.net/";
          declare %a:colour("blue") %a:shape("circle", 2) %a:two-dimensional function local:f() as xs:integer {3};
          saxon:function-annotations(local:f#0)   
      </test>
      <result>
         <all-of>
             <assert-type>map(*)*</assert-type>
             <assert-count>3</assert-count>
             <assert>$result[1]?name eq QName("http://anno.com/", "colour")</assert>
             <assert>$result[2]?name eq QName("http://anno.com/", "shape")</assert>
             <assert>$result[3]?name eq QName("http://anno.com/", "two-dimensional")</assert>
             <assert>$result[1]?params[1] eq "blue"</assert>
             <assert>$result[2]?params[1] eq "circle"</assert>
             <assert>$result[2]?params[2] eq 2</assert>
             <assert>empty($result[3]?params)</assert>
         </all-of>
      </result>
   </test-case>
   
  
</test-set>