<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-map-search"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" covers="map-search">
   <description>Tests for the saxon:map-search function introduced in Saxon 9.9</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-31/" idref="func-map-search"/>
   <dependency type="spec" value="XP31+ XQ31+ XT30+"/>
   
   <environment name="map">
      <namespace prefix="map" uri="http://www.w3.org/2005/xpath-functions/map"/>
      <namespace prefix="saxon" uri="http://saxon.sf.net/"/>
   </environment>
   
   <environment name="json-files">
      <resource file="docs/data004.json"
         media-type="text/plain"
         encoding="utf-8"
         uri="http://www.w3.org/qt3/json/data004-json">
         <description>UTF-8 encoded plain text.</description>
         <created by="O'Neil Delpratt" on="2015-02-23"/>
      </resource>
      <namespace prefix="map" uri="http://www.w3.org/2005/xpath-functions/map"/>
   </environment>
   
   <test-case name="map-search-001">
      <description>Enpty sequence as first argument</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>saxon:map-search((), 17, function($x){true()})</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>
   
   <test-case name="map-search-002">
      <description>Integer key, data is present</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>saxon:map-search(map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:"Saturday"}, 4, function($x){ends-with($x, 'day')})?value</test>
      <result>
         <assert-eq>"Wednesday"</assert-eq>
      </result>
   </test-case>
   
   <test-case name="map-search-002a">
      <description>Integer key, data is present, value not selected</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>saxon:map-search(map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:"Saturday"}, 4, function($x){not(ends-with($x, 'day'))})?value</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>
   
   <test-case name="map-search-003">
      <description>Integer key, data is absent</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>saxon:map-search(map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:"Saturday"}, 86)?value</test>
      <result>
         <assert-empty/>
      </result>
   </test-case>
   
   <test-case name="map-search-004">
      <description>Search a sequence of maps</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>saxon:map-search((map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:"Saturday"},
         map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:"Samedi",1:"Dimanche"}), 1)?value</test>
      <result>
         <assert-deep-eq>("Sunday", "Dimanche")</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="map-search-005">
      <description>Search an array of maps</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>saxon:map-search([map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:"Saturday"},
         map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:"Samedi",1:"Dimanche"}], 1, function($x){true()})?value</test>
      <result>
         <assert-deep-eq>("Sunday", "Dimanche")</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="map-search-006">
      <description>Non-maps in the input are ignored</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>saxon:map-search([map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:"Saturday"},
         map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:"Samedi",1:"Dimanche"}, 1], 1, function($x){true()})?value</test>
      <result>
         <assert-deep-eq>("Sunday", "Dimanche")</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="map-search-007">
      <description>Maps within maps</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <modified by="Michael Kay, Saxonica" on="2016-11-01" change="bug 29918 allows results in a different order"/>
      <environment ref="map"/>
      <test>saxon:map-search(map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:"Saturday", "fr":
         map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:"Samedi",1:"Dimanche"}}, 1, function($x){true()})?value</test>
      <result>
         <any-of>
            <assert-deep-eq>("Sunday", "Dimanche")</assert-deep-eq>
            <assert-deep-eq>("Dimanche", "Sunday")</assert-deep-eq>
         </any-of>
      </result>
   </test-case>
   
   <test-case name="map-search-008">
      <description>Maps within arrays within arrays</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <modified by="Michael Kay, Saxonica" on="2016-11-01" change="bug 29918 allows results in a different order"/>
      <environment ref="map"/>
      <test>saxon:map-search([map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:"Saturday", "fr":
         [map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:"Samedi",1:"Dimanche"}, 78]}, 82], 7, function($x){true()})?value</test>
      <result>
         <any-of>
            <assert-deep-eq>("Saturday", "Samedi")</assert-deep-eq>
            <assert-deep-eq>("Samedi", "Saturday")</assert-deep-eq>
         </any-of>
      </result>
   </test-case>
   
   <test-case name="map-search-009">
      <description>Arrays in result</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <modified by="Michael Kay, Saxonica" on="2016-11-01" change="bug 29918 allows results in a different order"/>
      <environment ref="map"/>
      <test>saxon:map-search([map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:["Saturday", "Sat"], "fr":
         [map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:["Samedi", "Sa"],1:"Dimanche"}, 78]}, 82], 7, function($x){true()})?value</test>
      <result>
         <any-of>
            <assert-deep-eq>(["Saturday", "Sat"], ["Samedi", "Sa"])</assert-deep-eq>
            <assert-deep-eq>(["Samedi", "Sa"], ["Saturday", "Sat"])</assert-deep-eq>
         </any-of>
      </result>
   </test-case>
   
   <test-case name="map-search-010">
      <description>Sequences in result</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <modified by="Michael Kay, Saxonica" on="2016-11-01" change="bug 29918 allows results in a different order"/>
      <environment ref="map"/>
      <test>saxon:map-search([map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:("Saturday", "Sat"), "fr":
         [map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:("Samedi", "Sa"),1:"Dimanche"}, 78]}, 82], 7, function($x){true()})?value</test>
      <result>
         <any-of>
            <assert-deep-eq>(("Saturday", "Sat"), ("Samedi", "Sa"))</assert-deep-eq>
            <assert-deep-eq>(("Samedi", "Sa"), ("Saturday", "Sat"))</assert-deep-eq>
         </any-of>
      </result>
   </test-case>
   
   <test-case name="map-search-011">
      <description>Search array of maps: show the relevant map is returned</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <modified by="Michael Kay, Saxonica" on="2016-11-01" change="bug 29918 allows results in a different order"/>
      <environment ref="map"/>
      <test>saxon:map-search(
         [map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:("Saturday", "Sat")},
          map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:("Samedi", "Sa"),1:"Dimanche"}
         ], 7, function($x){$x = 'Samedi'})?map?2</test>
      <result>
         <assert-eq>"Lundi"</assert-eq>
      </result>
   </test-case>
   
   <test-case name="map-search-012">
      <description>Search array of maps: show the relevant key is returned</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <modified by="Michael Kay, Saxonica" on="2016-11-01" change="bug 29918 allows results in a different order"/>
      <environment ref="map"/>
      <test>saxon:map-search(
         [map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:("Saturday", "Sat")},
         map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:("Samedi", "Sa"),1:"Dimanche"}
         ], 7, function($x){$x = 'Samedi'})?key</test>
      <result>
         <assert-eq>7</assert-eq>
      </result>
   </test-case>
   
   <test-case name="map-search-013">
      <description>Search array of maps: get the index of the containing array</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <modified by="Michael Kay, Saxonica" on="2016-11-01" change="bug 29918 allows results in a different order"/>
      <environment ref="map"/>
      <test>let $path := (saxon:map-search(
         [map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:("Saturday", "Sat")},
         map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:("Samedi", "Sa"),1:"Dimanche"}
         ], 7, function($x){$x = 'Samedi'})?map => saxon:pedigree())
         return $path?index</test>
      <result>
         <assert-eq>2</assert-eq>
      </result>
   </test-case>
   
   <test-case name="map-search-014">
      <description>Search array of maps: output path keys</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <modified by="Michael Kay, Saxonica" on="2016-11-01" change="bug 29918 allows results in a different order"/>
      <dependency type="spec" value="XQ30+"/>
      <environment ref="map"/>
      <test>
         declare function local:expand-pedigree($p as function(*)) as item()* {
            let $g := saxon:pedigree($p)
            return if (exists($g?container)) then ($g?index, $g?key, local:expand-pedigree($g?container)) else ()
         };   
         let $ped := saxon:map-search(
         [map{1:"Sunday",2:"Monday",3:"Tuesday",4:"Wednesday",5:"Thursday",6:"Friday",7:("Saturday", "Sat")},
         map{2:"Lundi",3:"Mardi",4:"Mercredi",5:"Jeudi",6:"Vendredi",7:("Samedi", "Sa"),1:"Dimanche"}
         ], 7, function($x){$x = 'Samedi'})?map
         return string-join(reverse(local:expand-pedigree($ped)), '/')</test>
      <result>
         <assert-eq>"2"</assert-eq>
      </result>
   </test-case>
   
   <test-case name="map-search-015">
      <description>Search nested maps: output path keys</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <modified by="Michael Kay, Saxonica" on="2016-11-01" change="bug 29918 allows results in a different order"/>
      <dependency type="spec" value="XQ30+"/>
      <environment ref="map"/>
      <test>
         declare function local:expand-pedigree($p as function(*)) as item()* {
            let $g := saxon:pedigree($p)
            return ($g?index, $g?key, if (exists($g?container)) then local:expand-pedigree($g?container) else ())
         }; 
         let $data := map {
            "a": [map { "b": [map { "c": [map { "d": [map { "e": [] }]}]}]}]}, 
             $path := saxon:map-search($data, "e")?map
             return string-join(reverse(local:expand-pedigree($path)), '/')</test>
      <result>
         <assert-eq>"a/1/b/1/c/1/d/1"</assert-eq>
      </result>
   </test-case>
   
   <test-case name="map-search-101">
      <description>Search maps derived from JSON input</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="json-files"/>
      <test>(fn:json-doc("http://www.w3.org/qt3/json/data004-json") => saxon:map-search("servlet-name", function($x){true()}))?value</test>
      <result>
         <assert-deep-eq>("cofaxCDS", "cofaxEmail", "cofaxAdmin", "fileServlet", "cofaxTools")</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="map-search-102">
      <description>Search maps derived from JSON input: values are maps</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="json-files"/>
      <test>
         let $doc := fn:json-doc("http://www.w3.org/qt3/json/data004-json"),
             $ip := saxon:map-search($doc, "init-param") ? value,
             $mh := saxon:map-search($ip, "mailHost")?value
         return $mh
      </test>
      <result>
         <assert-eq>"mail1"</assert-eq>
      </result>
   </test-case>
   
   
</test-set>
