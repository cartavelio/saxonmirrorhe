<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-octets-to-base64Binary">
   <description>Tests for the saxon:octets-to-base64Binary extension function</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-abs"/>
         
    <dependency type="spec" value="XP31+ XQ31+"/>  

   <test-case name="octets-to-base64Binary-001">
       <description>Use octets-to-base64Binary on a short sequence of octets</description>
      <created by="Michael Kay" on="2017-08-17"/>
      <test>string(saxon:octets-to-base64Binary((30,31,32,33,34,35)))</test>
      <result>
          <assert-eq>"Hh8gISIj"</assert-eq>
      </result>
   </test-case>
    
    <test-case name="octets-to-base64Binary-002">
        <description>Use octets-to-base64Binary on an empty sequence</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>string(saxon:octets-to-base64Binary(()))</test>
        <result>
            <assert-eq>""</assert-eq>
        </result>
    </test-case>
    
    <test-case name="octets-to-base64Binary-003">
        <description>Check reversibility</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>saxon:octets-to-base64Binary(0 to 255) => string() => xs:base64Binary() => saxon:base64Binary-to-octets()</test>
        <result>
            <assert-deep-eq>0 to 255</assert-deep-eq>
        </result>
    </test-case>
    
    <test-case name="octets-to-base64Binary-004">
        <description>Error case: octet > 255</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>saxon:octets-to-base64Binary(0 to 256) => string()</test>
        <result>
            <error code="SXJX0001"/>
        </result>
    </test-case>
    
    <test-case name="octets-to-base64Binary-005">
        <description>Error case: octet lt 0</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>saxon:octets-to-base64Binary(reverse(-1 to 100)) => string()</test>
        <result>
            <error code="SXJX0001"/>
        </result>
    </test-case>
    
    <test-case name="octets-to-base64Binary-006">
        <description>xs:long input</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>saxon:octets-to-base64Binary((64 to 80) ! xs:long(.)) => string()</test>
        <result>
            <assert-eq>"QEFCQ0RFRkdISUpLTE1OT1A="</assert-eq>
        </result>
    </test-case>
    
    <test-case name="octets-to-base64Binary-007">
        <description>xs:byte input</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>saxon:octets-to-base64Binary((64 to 80) ! xs:byte(.)) => string()</test>
        <result>
            <assert-eq>"QEFCQ0RFRkdISUpLTE1OT1A="</assert-eq>
        </result>
    </test-case>
    
    <test-case name="octets-to-base64Binary-008">
        <description>Use octets-to-base64Binary on an singleton sequence</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>string(saxon:octets-to-base64Binary(12))</test>
        <result>
            <assert-eq>"DA=="</assert-eq>
        </result>
    </test-case>
    
    <test-case name="octets-to-base64Binary-009">
        <description>Atomization</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <dependency type="spec" value="XQ31+"/>  
        <test><![CDATA[(1 to 10 ! <a>{.}</a>) => saxon:octets-to-base64Binary() => string()]]></test>
        <result>
            <assert-eq>"AQIDBAUGBwgJCg=="</assert-eq>
        </result>
    </test-case>
   
  
</test-set>