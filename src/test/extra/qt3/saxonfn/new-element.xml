<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-new-element">
  <description>Tests for the saxon:new-element() function</description>
  <link type="spec" document="http://www.w3.org/TR/xpath-functions-30/" idref="func-new-element"/>


  <test-case name="new-element-01">
    <description>Empty element</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('', 'a'), ())</test>
    <result>
      <assert-type>element(a)</assert-type>
    </result>
  </test-case>
  
  <test-case name="new-element-02">
    <description>Element with text content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('', 'a'), 'foo')</test>
    <result>
      <all-of>
        <assert-type>element(a)</assert-type>
        <assert-xml><![CDATA[<a>foo</a>]]></assert-xml>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-element-03">
    <description>Element with element content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('', 'a'), saxon:new-element(QName('', 'b'), ()))</test>
    <result>
      <all-of>
        <assert-type>element(a)</assert-type>
        <assert-xml><![CDATA[<a><b/></a>]]></assert-xml>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-element-04">
    <description>Element with attribute content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test><![CDATA[saxon:new-element(QName('', 'a'), parse-xml("<x y='3'/>")//@*)]]></test>
    <result>
      <all-of>
        <assert-type>element(a)</assert-type>
        <assert-xml><![CDATA[<a y="3"/>]]></assert-xml>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-element-05">
    <description>base-uri of result</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>base-uri(saxon:new-element(QName('', 'a'), ())) eq static-base-uri()</test>
    <result>
      <assert-true/>
    </result>
  </test-case>
  
  <test-case name="new-element-06">
    <description>Element with complex content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test><![CDATA[saxon:new-element(QName('', 'a'), 
                        (saxon:new-element(QName('','b'), '12'),
                         saxon:new-element(QName('','c'), '25')))
      ]]></test>
    <result>
      <all-of>
        <assert-type>element(a)</assert-type>
        <assert-xml><![CDATA[<a><b>12</b><c>25</c></a>]]></assert-xml>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-element-07">
    <description>Element in default namespace</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('http://example.com/', 'a'), ())</test>
    <result>
      <assert-xml><![CDATA[<a xmlns='http://example.com/'/>]]></assert-xml>
    </result>
  </test-case>
  
  <test-case name="new-element-08">
    <description>Element in prefixed namespace</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('http://example.com/', 'p:a'), ())</test>
    <result>
      <assert-xml><![CDATA[<p:a xmlns:p='http://example.com/'/>]]></assert-xml>
    </result>
  </test-case>
  
  <test-case name="new-element-09">
    <description>Multiple default namespaces</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('http://example.com/a', 'a'), saxon:new-element(QName('http://example.com/b', 'b'), ()))</test>
    <result>
      <assert-xml><![CDATA[<a xmlns='http://example.com/a'><b xmlns='http://example.com/b'/></a>]]></assert-xml>
    </result>
  </test-case>
  
  <test-case name="new-element-10">
    <description>Multiple non-default namespaces</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('http://example.com/a', 'p:a'), saxon:new-element(QName('http://example.com/b', 'q:b'), ()))</test>
    <result>
      <assert-xml><![CDATA[<p:a xmlns:p='http://example.com/a'><q:b xmlns:q='http://example.com/b'/></p:a>]]></assert-xml>
    </result>
  </test-case>
  
  <test-case name="new-element-11">
    <description>Reuse non-default namespaces</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('http://example.com/a', 'p:a'), saxon:new-element(QName('http://example.com/a', 'p:b'), ()))</test>
    <result>
      <assert-xml><![CDATA[<p:a xmlns:p='http://example.com/a'><p:b/></p:a>]]></assert-xml>
    </result>
  </test-case>
  
  <test-case name="new-element-12">
    <description>Namespaced attribute</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('', 'a'), saxon:new-attribute(QName('http://example.com/a', 'p:b'), "val"))</test>
    <result>
      <assert-xml><![CDATA[<a xmlns:p='http://example.com/a' p:b="val"/>]]></assert-xml>
    </result>
  </test-case>
  
  <test-case name="new-element-13">
    <description>Explicit namespace node</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('', 'a'), saxon:new-namespace('p', 'ftp://example.com/'))</test>
    <result>
      <assert-xml><![CDATA[<a xmlns:p='ftp://example.com/'/>]]></assert-xml>
    </result>
  </test-case>
  
  <test-case name="new-element-14">
    <description>Duplicate attributes: last one wins</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('', 'a'), 
      (saxon:new-attribute(QName('', 'b'), "one"),
       saxon:new-attribute(QName('', 'b'), "two")))</test>
    <result>
      <assert-xml><![CDATA[<a b="two"/>]]></assert-xml>
    </result>
  </test-case>
  
  <test-case name="new-element-15">
    <description>Allow string instead of QName for no-namespace names</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element('a', saxon:new-element('b', ()))</test>
    <result>
      <all-of>
        <assert-type>element(a)</assert-type>
        <assert-xml><![CDATA[<a><b/></a>]]></assert-xml>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-element-16">
    <description>No-namespace element within namespaced element</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element(QName('http://example.com/', 'a'), saxon:new-element('b', ()))</test>
    <result>
      <all-of>
        <assert-type>element(Q{http://example.com/}a)</assert-type>
        <assert-xml><![CDATA[<a xmlns="http://example.com/"><b xmlns=""/></a>]]></assert-xml>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-element-17">
    <description>Element name supplied in Q{uri}local format</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element('Q{http://example.com/}a', saxon:new-element('Q{http://example.com/}b', ()))</test>
    <result>
      <all-of>
        <assert-type>element(Q{http://example.com/}a)</assert-type>
        <assert-xml><![CDATA[<a xmlns="http://example.com/"><b/></a>]]></assert-xml>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-element-18">
    <description>Element name supplied in prefix:local format</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <dependency type="spec" value="XQ31+"/>
    <test><![CDATA[
      declare namespace foo = "http://example.com/";
      saxon:new-element('foo:a', 'bar')
      ]]></test>
    <result>
      <all-of>
        <assert-type>element(Q{http://example.com/}a)</assert-type>
        <assert-xml><![CDATA[<foo:a xmlns:foo="http://example.com/">bar</foo:a>]]></assert-xml>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-element-901">
    <description>Invalid element name</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-element('23X', 'X23')</test>
    <result>
      <error code="XTDE0850"/>
    </result>
  </test-case>
  
  <test-case name="new-element-902">
    <description>Undeclared prefix</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <dependency type="spec" value="XQ31+"/>
    <test><![CDATA[
      declare namespace foo = "http://example.com/";
      saxon:new-element('foops:a', 'bar')
      ]]></test>
    <result>
      <error code="FONS0004"/>
    </result>
  </test-case>

</test-set>
