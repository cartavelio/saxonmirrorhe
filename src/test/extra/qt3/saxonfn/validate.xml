<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-validate">
   <description>Tests for the saxon:validate extension function introduced in Saxon 9.5</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-abs"/>
         
   <dependency type="spec" value="XQ30+"/>
   <dependency type="xsd-version" value="1.1"/>
   
   <environment name="atomic">
        <namespace prefix="atomic" uri="http://www.w3.org/XQueryTest"/> 
        <schema uri="http://www.w3.org/XQueryTest" file="validate/atomic.xsd">
            <description>A Schema for atomic.xml</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </schema>        
        <source role="." file="validate/atomic.xml" validation="strict" uri="http://www.w3.org/fots/docs/atomic.xml">
            <description>A Schema validated xml file, that contains values for data types. Can be used by any test.</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </source>
   </environment>
   
   <environment name="val-param">
      <schema role="." file="validate/schema-with-param.xsd" xsd-version="1.1">
         <description>A parameterized schema</description>
         <created by="Michael Kay" on="2012-02-05"/>
      </schema>
      <source role="$goToWork" file="validate/goToWork.xml">
         <description>A simple instance document</description>
         <created by="Michael Kay" on="2012-02-05"/>
      </source>
      <source role="$stayAtHome" file="validate/stayAtHome.xml">
         <description>A simple instance document</description>
         <created by="Michael Kay" on="2012-02-05"/>
      </source>
   </environment>
   
   <environment name="val-separator">
      <schema role="." file="validate/schema-with-separator.xsd">
         <description>A Schema using the saxon:separator facet for a list type</description>
         <created by="Michael Kay" on="2019-03-26"/>
      </schema>        
      <source role="." file="validate/instance-with-separator.xml" validation="strict" uri="http://www.w3.org/fots/docs/instance-with-separator.xml">
         <description>A Schema validated xml file, that contains values for data types. Can be used by any test.</description>
         <created by="Michael Kay" on="2019-03-26"/>
      </source>
   </environment>

   <test-case name="s-validate-001">
      <description>Use saxon:validate() to validate a document node</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <environment ref="atomic"/>
      <test>saxon:validate(/)("node")/*/*[1]</test>
      <result>
         <all-of>
            <assert>local-name($result) eq 'duration'</assert>
            <assert-type>element(*, xs:duration)</assert-type>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="s-validate-002">
      <description>Use saxon:validate() to validate an element node</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <environment ref="atomic"/>
      <test>saxon:validate(/*)("node")/*[1]</test>
      <result>
         <all-of>
            <assert>local-name($result) eq 'duration'</assert>
            <assert-type>element(*, xs:duration)</assert-type>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="s-validate-003">
      <description>Use saxon:validate() to validate an attribute node</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <environment ref="atomic"/>
      <test>saxon:validate(/*/*:NCName/@*:attr)("node")</test>
      <result>
         <all-of>
            <assert>local-name($result) eq 'attr'</assert>
            <assert>string($result) eq 'aNCname'</assert>
            <assert-type>attribute(*, xs:NCName)</assert-type>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="s-validate-004">
      <description>Use saxon:validate() to validate a document node against a specific type</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="atomic"/>
      <test>saxon:validate(/*/*:duration, map{"type" : xs:QName("xs:duration")})("node")</test>
      <result>
         <all-of>
            <assert>local-name($result) eq 'duration'</assert>
            <assert-type>element(*, xs:duration)</assert-type>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="s-validate-005">
      <description>Use saxon:validate() to validate an element node against a specific type</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="atomic"/>
      <test>import schema namespace atomic = "http://www.w3.org/XQueryTest";
            saxon:validate(/*, map{"type" : xs:QName("atomic:rootType")})("node") 
      			instance of element(atomic:root, atomic:rootType)</test>
      <result>
         <assert-true/>
      </result>
   </test-case>
   
   <test-case name="s-validate-006">
      <description>Use saxon:validate() to validate an element node against a specific type</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="atomic"/>
      <test><![CDATA[
            let $t := <a>nnnn</a> return
            saxon:validate($t, map{"type" : xs:QName("xs:NCName")})("node") 
      			instance of element(a, xs:NCName)
      ]]></test>
      <result>
         <assert-true/>
      </result>
   </test-case>
   
   <test-case name="s-validate-007">
      <description>Use saxon:validate() to validate an element node against a specific type,
      and get a boolean result</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="atomic"/>
      <test><![CDATA[
            let $t := <a>nnnn</a> return
            saxon:validate($t, map{"type" : xs:QName("xs:NCName")})("valid")
      ]]></test>
      <result>
         <assert-true/>
      </result>
   </test-case>
   
   <test-case name="s-validate-008">
      <description>Use saxon:validate() to validate an element node against a specific type,
      and get a boolean result</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="atomic"/>
      <test><![CDATA[
            let $t := <a>01234</a> return
            saxon:validate($t, map{"type" : xs:QName("xs:NCName")})("valid")
      ]]></test>
      <result>
         <assert-false/>
      </result>
   </test-case>
   
   <test-case name="s-validate-009">
      <description>Use saxon:validate() to validate an empty sequence</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="atomic"/>
      <test><![CDATA[
            let $t := //notfound return
            saxon:validate($t, map{"type" : xs:QName("xs:NCName")})
      ]]></test>
      <result>
         <assert-empty/>
      </result>
   </test-case>
   
   <test-case name="s-validate-010">
      <description>Use saxon:validate() to get error information</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="atomic"/>
      <test><![CDATA[
            let $t := <a>01234</a> 
            return saxon:validate($t, map{"type" : xs:QName("xs:NCName")})("errors")
      ]]></test>
      <result>
         <all-of>
           <assert-count>1</assert-count>
           <assert-type>map(xs:string, item()*)</assert-type>
           <assert>contains($result("message"), "does not match")</assert>
           <assert>$result("constraint") eq "cvc-datatype-valid"</assert>
           <assert>$result("code") instance of xs:QName</assert>
           <assert>$result("specPart") eq 2</assert>
           <assert>$result("clause") eq "1"</assert>
           <assert>local-name($result("node")) eq "a"</assert>
         </all-of>  
      </result>
   </test-case>
   
   <!-- test cases using validation parameters -->
   
   <test-case name="s-validate-101">
      <description>Use saxon:validate() to validate simple content; assertion has parameters</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="val-param"/>
      <test><![CDATA[
      	saxon:validate(<date>1999-11-16</date>, map{}, map{xs:QName('baseLine'):xs:date('2010-01-01')})("valid")
      ]]></test>
      <result>
         <assert-true/>
      </result>
   </test-case>
   
   <test-case name="s-validate-102">
      <description>Use saxon:validate() to validate simple content; assertion has parameters</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="val-param"/>
      <test><![CDATA[
      	saxon:validate(<date>1999-11-16</date>, map{}, map{xs:QName('baseLine'):xs:date('1960-01-01')})("valid")
      ]]></test>
      <result>
         <assert-false/>
      </result>
   </test-case>
   
   <test-case name="s-validate-200">
      <description>Typed value of a node with a list type using saxon:separator</description>
      <created by="Michael Kay" on="2019-03-26"/>
      <environment ref="val-separator"/>
      <test>sum(/outer/values[1])</test>
      <result>
         <assert-eq>1</assert-eq>
      </result>
   </test-case>
   
   <test-case name="s-validate-201">
      <description>Typed value of a node with a list type using saxon:separator</description>
      <created by="Michael Kay" on="2019-03-26"/>
      <environment ref="val-separator"/>
      <test>sum(/outer/values[2])</test>
      <result>
         <assert-eq>1</assert-eq>
      </result>
   </test-case>
   
   <test-case name="s-validate-202">
      <description>Typed value of a node with a list type using saxon:separator</description>
      <created by="Michael Kay" on="2019-03-26"/>
      <environment ref="val-separator"/>
      <test>sum(/outer/values[3])</test>
      <result>
         <assert-eq>0</assert-eq>
      </result>
   </test-case>


</test-set>