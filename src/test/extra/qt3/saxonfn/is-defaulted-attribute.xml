<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-is-defaulted-attribute">
   <description>Tests for the saxon:is-defaulted extension function introduced in Saxon 9.7</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-abs"/>
         
   <dependency type="spec" value="XQ30+"/>
   <dependency type="xsd-version" value="1.1"/>
   <dependency type="saxon:config" name="http://saxon.sf.net/feature/markDefaultedAttributes" value="true"/>
   
   <environment name="atomic">
        <namespace prefix="atomic" uri="http://www.w3.org/XQueryTest"/> 
        <schema uri="http://www.w3.org/XQueryTest" file="validate/atomic-with-defaults.xsd">
            <description>A Schema for atomic.xml, with added default values</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </schema>        
        <source role="." file="validate/atomic.xml" validation="strict" uri="http://www.w3.org/fots/docs/atomic.xml">
            <description>A Schema validated xml file, that contains values for data types. Can be used by any test.</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </source>
   </environment>

   <test-case name="s-is-defaulted-001">
      <description>Use saxon:is-defaulted() on a node that was indeed defaulted</description>
      <created by="Michael Kay" on="2015-08-14"/>
      <environment ref="atomic"/>
      <test>saxon:is-defaulted(//*:int/@*:attr)</test>
      <result>
         <assert-true/>
      </result>
   </test-case>
   
  
</test-set>