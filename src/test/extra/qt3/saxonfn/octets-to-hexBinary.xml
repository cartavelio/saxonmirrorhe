<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-octets-to-hexBinary">
   <description>Tests for the saxon:octets-to-hexBinary extension function</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-abs"/>
         
    <dependency type="spec" value="XP31+ XQ31+"/>  

   <test-case name="octets-to-hexBinary-001">
       <description>Use octets-to-hexBinary on a short sequence of octets</description>
      <created by="Michael Kay" on="2017-08-17"/>
      <test>string(saxon:octets-to-hexBinary((30,31,32,33,34,35)))</test>
      <result>
          <assert-eq>"1E1F20212223"</assert-eq>
      </result>
   </test-case>
    
    <test-case name="octets-to-hexBinary-002">
        <description>Use octets-to-hexBinary on an empty sequence</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>string(saxon:octets-to-hexBinary(()))</test>
        <result>
            <assert-eq>""</assert-eq>
        </result>
    </test-case>
    
    <test-case name="octets-to-hexBinary-003">
        <description>Check reversibility</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>saxon:octets-to-hexBinary(0 to 255) => string() => xs:hexBinary() => saxon:hexBinary-to-octets()</test>
        <result>
            <assert-deep-eq>0 to 255</assert-deep-eq>
        </result>
    </test-case>
    
    <test-case name="octets-to-hexBinary-004">
        <description>Error case: octet > 255</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>saxon:octets-to-hexBinary(0 to 256) => string()</test>
        <result>
            <error code="SXJX0001"/>
        </result>
    </test-case>
    
    <test-case name="octets-to-hexBinary-005">
        <description>Error case: octet lt 0</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>saxon:octets-to-hexBinary(reverse(-1 to 100)) => string()</test>
        <result>
            <error code="SXJX0001"/>
        </result>
    </test-case>
    
    <test-case name="octets-to-hexBinary-006">
        <description>xs:long input</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>saxon:octets-to-hexBinary((64 to 80) ! xs:long(.)) => string()</test>
        <result>
            <assert-eq>"404142434445464748494A4B4C4D4E4F50"</assert-eq>
        </result>
    </test-case>
    
    <test-case name="octets-to-hexBinary-007">
        <description>xs:byte input</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>saxon:octets-to-hexBinary((64 to 80) ! xs:byte(.)) => string()</test>
        <result>
            <assert-eq>"404142434445464748494A4B4C4D4E4F50"</assert-eq>
        </result>
    </test-case>
    
    <test-case name="octets-to-hexBinary-008">
        <description>Use octets-to-hexBinary on an singleton sequence</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <test>string(saxon:octets-to-hexBinary(12))</test>
        <result>
            <assert-eq>"0C"</assert-eq>
        </result>
    </test-case>
    
    <test-case name="octets-to-hexBinary-009">
        <description>Atomization</description>
        <created by="Michael Kay" on="2017-08-17"/>
        <dependency type="spec" value="XQ31+"/>  
        <test><![CDATA[(1 to 10 ! <a>{.}</a>) => saxon:octets-to-hexBinary() => string()]]></test>
        <result>
            <assert-eq>"0102030405060708090A"</assert-eq>
        </result>
    </test-case>
   
  
</test-set>