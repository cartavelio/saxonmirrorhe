        </result>
     </test-case>

   <test-case name="send-mail-901err">
      <description>The function saxon:send-mail() without any arguments</description>
      <created by="O'Neil Delpratt" on="2012-06-20"/>
      <test>saxon:send-mail()</test>
      <result>
        <error code="XPST0017"/>
      </result>
   </test-case>

    <test-case name="send-mail-902err">
      <description>The function saxon:send-mail() with subject argument missing</description>
      <created by="O'Neil Delpratt" on="2012-06-20"/>
