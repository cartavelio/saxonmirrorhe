          'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':'false', 'ssl':'true', 'realname':'saxon:Send-mail', 'port':'465'}, "Test send-mail-010", "text content")</test>
    <result>
        <assert-true/>
    </result>
 </test-case>

    <test-case name="send-mail-011">
