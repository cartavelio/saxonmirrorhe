          <created by="O'Neil Delpratt" on="2018-09-04"/>
        <test>saxon:send-mail(map{'to':'70e5321a21-fd3366@inbox.mailtrap.io', 'from':'support@saxonica.com',
              'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':'false', 'ssl':true(), 'realname':'saxon:Send-mail', 'port':'465'}, "Test send-mail-013", "text content")</test>
        <result>
