<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-sendmail">
   <description>Tests for the saxon:send-mail extension function introduced in Saxon 9.5</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-abs"/>

   <dependency type="spec" value="XQ30+ XP31+"/>
   <environment name="contentDoc">
      <source role="." file="sendmail/content.xml">
         <description>The data contains an HTML document</description>
         <created by="O'Neil Delpratt" on="2012-09-20"/>
      </source>
   </environment>


   <test-case name="send-mail-001">
      <description>Use the function saxon:send-mail()</description>
     <created by="O'Neil Delpratt" on="2012-06-20"/>
     <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="contentDoc"/>
      <test>saxon:send-mail(map{'to':'oneil@saxonica.com', 'from':'support@saxonica.com',
            'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':'true', 'realname':'saxon:Send-mail', 'port':'1025'}, "Test send-mail-001", .)</test>
      <result>
        <assert-true/>
      </result>
   </test-case>

   <test-case name="send-mail-002">
      <description>Use the function saxon:send-mail() with empty subject content</description>
     <created by="O'Neil Delpratt" on="2012-06-20"/>
     <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="contentDoc"/>
      <test>saxon:send-mail(map{'to':'oneil@saxonica.com', 'from':'support@saxonica.com',
            'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':'true', 'realname':'saxon:Send-mail', 'port':'1025'}, "", .)</test>
      <result>
        <assert-true/>
      </result>
   </test-case>

   <test-case name="send-mail-003">
      <description>Use the function saxon:send-mail() without port number. Should default to port 25</description>
     <created by="O'Neil Delpratt" on="2012-06-20"/>
     <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <environment ref="contentDoc"/>
      <test>saxon:send-mail(map{'to':'oneil@saxonica.com', 'from':'support@saxonica.com',
            'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':true(), 'realname':'saxon:Send-mail'}, "Test send-mail-003", .)</test>
       <result>
           <assert-true/>
       </result>
   </test-case>

   <test-case name="send-mail-004">
      <description>Use the function saxon:send-mail() without port number. Should default to port 25</description>
     <created by="O'Neil Delpratt" on="2012-06-20"/>
     <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
       <environment ref="contentDoc"/>
      <test>saxon:send-mail(map{'to':'oneil@saxonica.com', 'from':'support@saxonica.com',
            'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':'false', 'realname':'saxon:Send-mail', 'port':'1025'}, "Test send-mail-004", parse-xml(<![CDATA['<doc>text content</doc>']]>))</test>
       <result>
           <assert-true/>
       </result>
   </test-case>



      <test-case name="send-mail-005">
      <description>Use the function saxon:send-mail() with email content  as plain text</description>
        <created by="O'Neil Delpratt" on="2012-06-20"/>
        <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <test>saxon:send-mail(map{'to':'oneil@saxonica.com', 'from':'support@saxonica.com',
            'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':'false', 'realname':'saxon:Send-mail', 'port':'1025'}, "Test send-mail-005", "text content")</test>
          <result>
              <assert-true/>
          </result>
   </test-case>

      <test-case name="send-mail-006">
      <description>Use the function saxon:send-mail() with email content  as plain text and html set to true</description>
        <created by="O'Neil Delpratt" on="2012-06-20"/>
        <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <test>saxon:send-mail(map{'to':'oneil@saxonica.com', 'from':'support@saxonica.com',
            'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':'true', 'realname':'saxon:Send-mail', 'port':'1025'}, "Test send-mail-006", "text content")</test>
      <result>
          <assert-true/>
      </result>
   </test-case>

   <test-case name="send-mail-007">
      <description>Use the function saxon:send-mail() with email content as html, but html = false in config</description>
     <created by="O'Neil Delpratt" on="2012-06-20"/>
     <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
       <environment ref="contentDoc"/>
      <test>saxon:send-mail(map{'to':'oneil@saxonica.com', 'from':'support@saxonica.com',
            'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':'false', 'realname':'saxon:Send-mail', 'port':'1025'}, "Test send-mail-007", .)</test>
       <result>
           <assert-true/>
       </result>
   </test-case>

   <test-case name="send-mail-008">
      <description>Use the function saxon:send-mail() with email content as plain text with html code and html = true in config, which is overridden by plain text setting</description>
     <created by="O'Neil Delpratt" on="2012-06-20"/>
     <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
      <test>saxon:send-mail(map{'to':'oneil@saxonica.com', 'from':'support@saxonica.com',
            'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':'true', 'realname':'saxon:Send-mail', 'port':'1025'}, "Test send-mail-008", "<html><body>email text content body</body></html>")</test>
      <result>
            <assert-true/>
      </result>
   </test-case>

      <test-case name="send-mail-009">
      <description>Use the function saxon:send-mail() with invalid attachment type</description>
        <created by="O'Neil Delpratt" on="2012-06-20"/>
        <modified by="Debbie Lockett" on="2015-11-03" change="update map syntax ':=' -> ':' "/>
       <environment ref="contentDoc"/>
      <test>saxon:send-mail(map{'to':'oneil@saxonica.com', 'from':'support@saxonica.com',
            'smtp-server':'localhost', 'username':'send-mail', 'password':'9091d8ef09ca0cf5', 'html':'true', 'realname':'saxon:Send-mail', 'port':'1025'}, "Test send-mail-009", ., "")</test>
          <result>
            <error code="SXJE0051"/>
          </result>
   </test-case>

    <test-case name="send-mail-010">
    <description>Use the function saxon:send-mail() with SSL option true</description>
      <created by="O'Neil Delpratt" on="2018-09-04"/>
