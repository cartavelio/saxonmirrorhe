<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-parse-dateTime">
   <description>Tests for the saxon:parse-dateTime extension function</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-abs"/>
         
    <dependency type="spec" value="XP31+ XQ31+"/>  

   <test-case name="parse-dateTime-001">
       <description>Basic example</description>
      <created by="Michael Kay" on="2019-06-04"/>
      <test>saxon:parse-dateTime('01/02/2001 11:40AM', 'MM/dd/yyyy hh:mma')</test>
      <result>
          <assert-eq>xs:dateTime('2001-01-02T11:40:00')</assert-eq>
      </result>
   </test-case>
    
    <test-case name="parse-dateTime-002">
        <description>Empty sequence</description>
        <created by="Michael Kay" on="2019-06-04"/>
        <test>saxon:parse-dateTime((), 'MM/dd/yyyy hh:mma')</test>
        <result>
            <assert-empty/>
        </result>
    </test-case>
    
    <test-case name="parse-dateTime-003">
        <description>Date only</description>
        <created by="Michael Kay" on="2019-06-04"/>
        <test>saxon:parse-dateTime('03/05/1999', 'dd/MM/yyyy')</test>
        <result>
            <assert-eq>xs:date('1999-05-03')</assert-eq>
        </result>
    </test-case>
    
    <test-case name="parse-dateTime-004">
        <description>Date only allowing single digit</description>
        <created by="Michael Kay" on="2019-06-04"/>
        <test>saxon:parse-dateTime('3/12/1999', 'd/M/yyyy')</test>
        <result>
            <assert-eq>xs:date('1999-12-03')</assert-eq>
        </result>
    </test-case>
    
    <test-case name="parse-dateTime-005">
        <description>Time only sans seconds</description>
        <created by="Michael Kay" on="2019-06-04"/>
        <test>saxon:parse-dateTime('12:40', 'HH:mm')</test>
        <result>
            <assert-eq>xs:time('12:40:00')</assert-eq>
        </result>
    </test-case>
    
    <test-case name="parse-dateTime-006">
        <description>Time only with seconds</description>
        <created by="Michael Kay" on="2019-06-04"/>
        <test>saxon:parse-dateTime('12.40.21', 'HH.mm.ss')</test>
        <result>
            <assert-eq>xs:time('12:40:21')</assert-eq>
        </result>
    </test-case>
    
    <test-case name="parse-dateTime-007">
        <description>Time only with fractional seconds</description>
        <created by="Michael Kay" on="2019-06-04"/>
        <test>saxon:parse-dateTime("12-40:21.123456", "H-m:ss.SSSSSS")</test>
        <result>
            <assert-eq>xs:time("12:40:21.123456")</assert-eq>
        </result>
    </test-case>
    
    <test-case name="parse-dateTime-008">
        <description>Time only with timezone</description>
        <created by="Michael Kay" on="2019-06-04"/>
        <test>saxon:parse-dateTime("12-40:21.123456+0100", "HH-mm:ss.SSSSSSZ")</test>
        <result>
            <assert-eq>xs:time("12:40:21.123456+01:00")</assert-eq>
        </result>
    </test-case>
    
    <test-case name="parse-dateTime-009">
        <description>gYearMonth</description>
        <created by="Michael Kay" on="2019-06-04"/>
        <test>saxon:parse-dateTime("Jan 1848", "MMM yyyy")</test>
        <result>
            <assert-eq>xs:gYearMonth('1848-01')</assert-eq>
        </result>
    </test-case>
    
    <test-case name="parse-dateTime-010">
        <description>gMonth</description>
        <created by="Michael Kay" on="2019-06-04"/>
        <test>saxon:parse-dateTime("January", "MMMM")</test>
        <result>
            <assert-eq>xs:gMonth('--01')</assert-eq>
        </result>
    </test-case>
    
    <test-case name="parse-dateTime-011">
        <description>dateTime with TZ but no seconds</description>
        <created by="Michael Kay" on="2019-06-04"/>
        <test>saxon:parse-dateTime("2018-03-31T14:20", "yyyy-MM-dd'T'HH:mm")</test>
        <result>
            <assert-eq>xs:dateTime('2018-03-31T14:20:00')</assert-eq>
        </result>
    </test-case>
    

  
</test-set>