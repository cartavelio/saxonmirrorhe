<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-analyze-uri">
  <description>Tests for the saxon:analyze-uri() function</description>
  <link type="spec" document="http://www.w3.org/TR/xpath-functions-30/" idref="func-index-where"/>

  <dependency type="feature" value="higherOrderFunctions"/>
  
  
  <test-case name="analyze-uri-001">
    <description>Invalid URI - isValid=true</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('###')?isValid</test>
    <result>
      <assert-false/>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-002">
    <description>Invalid URI - error exists</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>exists(saxon:analyze-uri('###')?error)</test>
    <result>
      <assert-true/>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-003">
    <description>valid URI - isValid=true</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('http://www.w3.org/')?isValid</test>
    <result>
      <assert-true/>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-004">
    <description>valid URI - no error field</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>exists(saxon:analyze-uri('http://www.w3.org/')?error)</test>
    <result>
      <assert-false/>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-005">
    <description>valid absolute URI - isAbsolute=true</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('http://www.w3.org/')?isAbsolute</test>
    <result>
      <assert-true/>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-006">
    <description>valid relative URI - isAbsolute=false</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('books.xml')?isAbsolute</test>
    <result>
      <assert-false/>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-007">
    <description>valid absolute URI - get scheme</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('https://www.w3.org/')?scheme</test>
    <result>
      <assert-eq>'https'</assert-eq>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-008">
    <description>Percent-encoded URI</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('https://mywebsite/docs%20english/site%2Fmybook.do#%3Frequest_type')</test>
    <result>
      <all-of>
        <assert>$result?isValid</assert>
        <assert>$result?isAbsolute</assert>
        <assert>not($result?isOpaque)</assert>
        <assert>$result?scheme = "https"</assert>
        <assert>$result?authority = "mywebsite"</assert>
        <assert>$result?rawAuthority = "mywebsite"</assert>
        <assert>$result?path = "/docs english/site/mybook.do"</assert>
        <assert>$result?rawPath = "/docs%20english/site%2Fmybook.do"</assert>
        <assert>$result?fragment = "?request_type"</assert>
        <assert>$result?rawFragment = "%3Frequest_type"</assert>
      </all-of>
      <assert-eq>'https'</assert-eq>
    </result>
  </test-case>

  <test-case name="analyze-uri-050">
    <description>query parameters</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('https://www.w3.org/?x=3;y=4')?queryParams?x</test>
    <result>
      <assert-eq>'3'</assert-eq>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-051">
    <description>query parameters</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('https://www.w3.org/?x=3'||codepoints-to-string(38)||'y=4')?queryParams?y</test>
    <result>
      <assert-eq>'4'</assert-eq>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-052">
    <description>query parameters</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('https://www.w3.org/?x=3'||codepoints-to-string(38)||'y=4')?queryParams?z</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-053">
    <description>percent-encoded query parameters</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('https://www.w3.org/?x=3;y=4;dir=My%20Documents')?queryParams?dir</test>
    <result>
      <assert-eq>'My Documents'</assert-eq>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-054">
    <description>query parameter with empty value</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('https://www.w3.org/?x=;y=;dir=My%20Documents')?queryParams?y</test>
    <result>
      <assert-eq>''</assert-eq>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-055">
    <description>query parameter with no value (and no equals sign)</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>map:contains(saxon:analyze-uri('https://www.w3.org/?x;y;dir=My%20Documents')?queryParams, 'y')</test>
    <result>
      <assert-true/>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-056">
    <description>query parameter with no value (and no equals sign)</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>map:get(saxon:analyze-uri('https://www.w3.org/?x;y;dir=My%20Documents')?queryParams, 'y')</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>
  
  <test-case name="analyze-uri-057">
    <description>query parameter with repeated values</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>map:get(saxon:analyze-uri('https://www.w3.org/?x=3;x=4;dir=My%20Documents;x=5')?queryParams, 'x')</test>
    <result>
      <assert-deep-eq>'3', '4', '5'</assert-deep-eq>
    </result>
  </test-case>
  
  
  
  
  <test-case name="analyze-uri-901">
    <description>undefined property</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:analyze-uri('https://www.w3.org/'||current-date())?mutability</test>
    <result>
      <any-of>
        <error code="XPTY0004"/>
        <assert-empty/>
      </any-of>
    </result>
  </test-case>
  

  
 

</test-set>
