<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-type">
   <description>Tests for the saxon:type extension function introduced in Saxon 9.5
    (and also the older saxon:type-annotation)</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-abs"/>
         
   <dependency type="spec" value="XQ30+"/>
   <dependency type="xsd-version" value="1.1"/>
   
   <environment name="atomic">
        <namespace prefix="atomic" uri="http://www.w3.org/XQueryTest"/> 
        <schema uri="http://www.w3.org/XQueryTest" file="validate/atomic.xsd">
            <description>A Schema for atomic.xml</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </schema>        
        <source role="." file="validate/atomic.xml" validation="strict" uri="http://www.w3.org/fots/docs/atomic.xml">
            <description>A Schema validated xml file, that contains values for data types. Can be used by any test.</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </source>
   </environment>
   

   <test-case name="s-type-001">
      <description>Use saxon:type() to get the type annotation of an element node</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <feature value="schema_aware"/>
      <environment ref="atomic"/>
      <test>let $s := saxon:type(/atomic:root/atomic:duration)
            return ($s('name'), $s('target namespace'))
             </test>
      <result>
         <assert-string-value>duration http://www.w3.org/2001/XMLSchema</assert-string-value>
      </result>
   </test-case>
   
   <test-case name="s-type-002">
      <description>Use saxon:type() to get the type annotation of an attribute node</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <feature value="schema_aware"/>
      <environment ref="atomic"/>
      <test>let $s := saxon:type(/atomic:root/atomic:idrefs/@atomic:attr)
            return ($s('name'), $s('target namespace'), $s('variety'))
             </test>
      <result>
         <assert-string-value>IDREFS http://www.w3.org/2001/XMLSchema list</assert-string-value>
      </result>
   </test-case>
   
   <test-case name="s-type-003">
      <description>Use saxon:type() to get the type annotation of an untyped node</description>
      <created by="Michael Kay" on="2012-02-05"/>
      <test><![CDATA[
            let $s := saxon:type(<a/>)
            return ($s('name'), $s('target namespace'), $s('variety'))
      ]]></test>
      <result>
         <assert-string-value>untyped http://www.w3.org/2001/XMLSchema</assert-string-value>
      </result>
   </test-case>
   


</test-set>