<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified"
  targetNamespace="http://saxonica.com/ns/enumerationsTest"
  xmlns:enum="http://saxonica.com/ns/enumerationsTest">
  
  <xs:simpleType name="weekday">
    <xs:restriction  base="xs:string">
      <xs:enumeration value="Monday"/>
      <xs:enumeration value="Tuesday"/>
      <xs:enumeration value="Wednesday"/>
      <xs:enumeration value="Thursday"/>
      <xs:enumeration value="Friday"/>
      <xs:enumeration value="Saturday"/>
      <xs:enumeration value="Sunday"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="weekdayList">
    <xs:list itemType="enum:weekday"/>
  </xs:simpleType>
  
  <xs:simpleType name="dayRange">
    <xs:restriction base="enum:weekdayList">
      <xs:enumeration value="Monday Tuesday Wednesday Thursday Friday"/>
      <xs:enumeration value="Saturday Sunday"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="month">
    <xs:restriction  base="xs:short">
      <xs:enumeration value="1"/>
      <xs:enumeration value="2"/>
      <xs:enumeration value="3"/>
      <xs:enumeration value="4"/>
      <xs:enumeration value="5"/>
      <xs:enumeration value="6"/>
      <xs:enumeration value="7"/>
      <xs:enumeration value="8"/>
      <xs:enumeration value="9"/>
      <xs:enumeration value="10"/>
      <xs:enumeration value="11"/>
      <xs:enumeration value="12"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="monthList">
    <xs:list itemType="enum:month"></xs:list>
  </xs:simpleType>
  
  <xs:simpleType name="quarter">
    <xs:restriction base="enum:monthList">
      <xs:enumeration value="1 2 3"/>
      <xs:enumeration value="4 5 6"/>
      <xs:enumeration value="7 8 9"/>
      <xs:enumeration value="10 11 12"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
