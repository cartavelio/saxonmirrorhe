<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-decimal-divide">
    <description>Tests for the saxon extension functions</description>
    <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
        idref="func-abs"/>
    
    <dependency type="spec" value="XP30+ XQ30+"/>
    
 
    <test-case name="decimal-divide-001">
        <description>Basic test that the function exists and returns the right type</description>
        <created by="Debbie Lockett" on="2015-11-10"/>
        <modified by="Michael Kay" on="2017-05-17" change="correct expected result"/>
        <test>saxon:decimal-divide(100, 30, 2)</test>
        <result>
            <all-of>
                <assert-type>xs:decimal</assert-type>
                <assert-string-value>3.33</assert-string-value>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="decimal-divide-002">
        <description>Value less than 1</description>
        <created by="Michael Kay" on="2021-08-29"/>
        <test>saxon:decimal-divide(100, 300, 2)</test>
        <result>
            <all-of>
                <assert-type>xs:decimal</assert-type>
                <assert-string-value>0.33</assert-string-value>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="decimal-divide-003">
        <description>Value less than 0.1</description>
        <created by="Michael Kay" on="2021-08-29"/>
        <test>saxon:decimal-divide(10, 300, 2)</test>
        <result>
            <all-of>
                <assert-type>xs:decimal</assert-type>
                <assert-string-value>0.03</assert-string-value>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="decimal-divide-004">
        <description>Value less than 0.01</description>
        <created by="Michael Kay" on="2021-08-29"/>
        <test>saxon:decimal-divide(1, 300, 2)</test>
        <result>
            <all-of>
                <assert-type>xs:decimal</assert-type>
                <assert-string-value>0</assert-string-value>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="decimal-divide-005">
        <description>Value is an integer</description>
        <created by="Michael Kay" on="2021-08-29"/>
        <test>saxon:decimal-divide(300, 10, 5)</test>
        <result>
            <all-of>
                <assert-type>xs:decimal</assert-type>
                <assert-string-value>30</assert-string-value>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="decimal-divide-006">
        <description>Zero decimal places</description>
        <created by="Michael Kay" on="2021-08-29"/>
        <test>saxon:decimal-divide(100, 30, 0)</test>
        <result>
            <all-of>
                <assert-type>xs:decimal</assert-type>
                <assert-string-value>3</assert-string-value>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="decimal-divide-007">
        <description>Negative scale</description>
        <created by="Michael Kay" on="2021-08-29"/>
        <test>saxon:decimal-divide(1000, 25, -1)</test>
        <result>
            <all-of>
                <assert-type>xs:decimal</assert-type>
                <assert-string-value>40</assert-string-value>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="decimal-divide-008">
        <description>Negative scale</description>
        <created by="Michael Kay" on="2021-08-29"/>
        <test>saxon:decimal-divide(420, 10, -1)</test>
        <result>
            <all-of>
                <assert-type>xs:decimal</assert-type>
                <assert-string-value>40</assert-string-value>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="decimal-divide-009">
        <description>One seventh</description>
        <created by="Michael Kay" on="2021-08-29"/>
        <test>saxon:decimal-divide(100, 700, 6)</test>
        <result>
            <all-of>
                <assert-type>xs:decimal</assert-type>
                <assert-string-value>0.142857</assert-string-value>
            </all-of>
        </result>
    </test-case>
 
    
</test-set>