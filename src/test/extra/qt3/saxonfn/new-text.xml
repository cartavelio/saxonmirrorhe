<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-new-text">
  <description>Tests for the saxon:new-text() function</description>
  <link type="spec" document="http://www.w3.org/TR/xpath-functions-30/" idref="func-new-text"/>


  <test-case name="new-text-01">
    <description>Empty content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-text(())</test>
    <result>
      <all-of>
        <assert-type>text()</assert-type>
        <assert-string-value></assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-text-02">
    <description>Empty content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-text("")</test>
    <result>
      <all-of>
        <assert-type>text()</assert-type>
        <assert-string-value></assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  
  <test-case name="new-text-03">
    <description>Text content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-text('foo')</test>
    <result>
      <all-of>
        <assert-type>text()</assert-type>
        <assert-string-value>foo</assert-string-value>
        <assert>not($result/..)</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-text-04">
    <description>Can be added to document node</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-document((saxon:new-text('foo'), saxon:new-text('bar')))</test>
    <result>
      <assert-string-value>foobar</assert-string-value>
    </result>
  </test-case>
  
  <test-case name="new-text-05">
    <description>Ampersands are OK (test written to work in both XPath and XQuery)</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <dependency type="spec" value="XP30+ XQ30+"/>
    <test>saxon:new-text('foo'|| codepoints-to-string(38) ||'bar')</test>
    <result>
      <assert-string-value><![CDATA[foo&bar]]></assert-string-value>
    </result>
  </test-case>
  
  <test-case name="new-text-06">
    <description>Curlies are OK</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test><![CDATA[saxon:new-text('foo{and}bar')]]></test>
    <result>
      <assert-string-value><![CDATA[foo{and}bar]]></assert-string-value>
    </result>
  </test-case>
  
  <test-case name="new-text-07">
    <description>Double hyphens are OK</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test><![CDATA[saxon:new-text('foo--bar')]]></test>
    <result>
      <assert-string-value><![CDATA[foo--bar]]></assert-string-value>
    </result>
  </test-case>
  
 

</test-set>
