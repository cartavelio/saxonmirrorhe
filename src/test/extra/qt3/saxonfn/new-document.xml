<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-new-document">
  <description>Tests for the saxon:new-document() function</description>
  <link type="spec" document="http://www.w3.org/TR/xpath-functions-30/" idref="func-new-document"/>


  <test-case name="new-document-01">
    <description>Basic test - empty document</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-document(())</test>
    <result>
      <assert-type>document-node()</assert-type>
    </result>
  </test-case>
  
  <test-case name="new-document-02">
    <description>Basic test - document with element content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <dependency type="spec" value="XP31+ XQ31+"/>
    <test><![CDATA[saxon:new-document(parse-xml("<a/>"))]]></test>
    <result>
      <all-of>
        <assert-type>document-node(element(a))</assert-type>
        <assert-xml><![CDATA[<a/>]]></assert-xml>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-document-03">
    <description>Basic test - document with element content and comments</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <dependency type="spec" value="XP31+ XQ31+"/>
    <test><![CDATA[saxon:new-document(parse-xml("<!--BEFORE--><a/><!--AFTER-->"))]]></test>
    <result>
      <all-of>
        <assert-type>document-node(element(a))</assert-type>
        <assert-xml><![CDATA[<!--BEFORE--><a/><!--AFTER-->]]></assert-xml>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-document-04">
    <description>Basic test - document fragment</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <dependency type="spec" value="XP31+ XQ31+"/>
    <test><![CDATA[saxon:new-document(parse-xml-fragment("<a/><b/>"))]]></test>
    <result>
      <all-of>
        <assert-type>document-node()</assert-type>
        <assert>$result/a</assert>
        <assert>$result/b</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-document-05">
    <description>base-uri of result</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>base-uri(saxon:new-document(())) eq static-base-uri()</test>
    <result>
      <assert-true/>
    </result>
  </test-case>
  
  <test-case name="new-document-06">
    <description>array in content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <dependency type="spec" value="XP31+ XQ31+"/>
    <test>saxon:new-document([1 to 5])</test>
    <result>
      <assert-string-value>1 2 3 4 5</assert-string-value>
    </result>
  </test-case>
  
  <test-case name="new-document-50">
    <description>Worked example</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <dependency type="spec" value="XP31+ XQ31+"/>
    <test><![CDATA[
      let $json := '[ 
                     {"first":"Michael",
                      "last":"Kay"},
                     {"first":"John",
                      "last":"Lumley"}]',
          $parsed-json := parse-json($json)
      return saxon:new-document(
                saxon:new-element('persons',
                     for $person in $parsed-json?*
                     return saxon:new-element('person',
                              (saxon:new-attribute('first', $person?first),
                               saxon:new-attribute('last', $person?last)))
                ))
      ]]></test>
    <result>
      <assert-xml><![CDATA[<persons><person first="Michael" last="Kay"/><person first="John" last="Lumley"/></persons>]]></assert-xml>
    </result>
  </test-case>
  
  <test-case name="new-document-90">
    <description>attributes not allowed in document content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <dependency type="spec" value="XP31+ XQ31+"/>
    <test><![CDATA[saxon:new-document(parse-xml("<a id='3'/>")//@id)]]></test>
    <result>
      <error code="XTDE0420"/>
    </result>
  </test-case>
  
  <test-case name="new-document-91">
    <description>maps not allowed in document content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <dependency type="spec" value="XP31+ XQ31+"/>
    <test><![CDATA[saxon:new-document(map{'a':22})]]></test>
    <result>
      <error code="XTDE0450"/>
    </result>
  </test-case>
  


</test-set>
