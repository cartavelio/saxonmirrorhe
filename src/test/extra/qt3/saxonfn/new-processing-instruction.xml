<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-new-processing-instruction">
  <description>Tests for the saxon:new-processing-instruction() function</description>
  <link type="spec" document="http://www.w3.org/TR/xpath-functions-30/" idref="func-new-processing-instruction"/>


  <test-case name="new-processing-instruction-01">
    <description>Empty content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-processing-instruction('pi', ())</test>
    <result>
      <all-of>
        <assert-type>processing-instruction(pi)</assert-type>
        <assert>name($result) eq 'pi'</assert>
        <assert-string-value></assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-processing-instruction-02">
    <description>Empty content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-processing-instruction('pi', "")</test>
    <result>
      <all-of>
        <assert-type>processing-instruction(pi)</assert-type>
        <assert>name($result) eq 'pi'</assert>
        <assert-string-value></assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  
  <test-case name="new-processing-instruction-03">
    <description>Text content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-processing-instruction('foo', 'bar')</test>
    <result>
      <all-of>
        <assert-type>processing-instruction(foo)</assert-type>
        <assert-string-value>bar</assert-string-value>
        <assert>name($result) eq 'foo'</assert>
        <assert>not($result/..)</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-processing-instruction-04">
    <description>Can be added to document node</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-document((saxon:new-processing-instruction('foo', ''), saxon:new-processing-instruction('bar', '')))</test>
    <result>
      <all-of>
        <assert>$result/processing-instruction()[1]!name() eq 'foo'</assert>
        <assert>$result/processing-instruction()[2]!name() eq 'bar'</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-processing-instruction-05">
    <description>Any "?>" is replaced by "? >"</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-processing-instruction('pi', 'foo?>bar')</test>
    <result>
      <assert-string-value>foo? >bar</assert-string-value>
    </result>
  </test-case>
  
  <test-case name="new-processing-instruction-06">
    <description>Any final "?>" is replaced by "? >"</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-processing-instruction('pi', 'foo-bar?>')</test>
    <result>
      <assert-string-value>foo-bar? ></assert-string-value>
    </result>
  </test-case>
  
  <test-case name="new-processing-instruction-07">
    <description>Multiple replacements of "?>" by "? >"</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-processing-instruction('pi', '?>?>?>?>?')</test>
    <result>
      <assert-string-value>? >? >? >? >?</assert-string-value>
    </result>
  </test-case>
  
  <test-case name="new-processing-instruction-90">
    <description>Name 'xml' not allowed</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-processing-instruction('xml', '')</test>
    <result>
      <error code="XTDE0890"/>
    </result>
  </test-case>
  
  <test-case name="new-processing-instruction-91">
    <description>Name 'XML' not allowed</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-processing-instruction('XML', '')</test>
    <result>
      <error code="XTDE0890"/>
    </result>
  </test-case>
  
  <test-case name="new-processing-instruction-92">
    <description>Name '23X' not allowed</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-processing-instruction('23X', '')</test>
    <result>
      <error code="XTDE0890"/>
    </result>
  </test-case>
  
  
 

</test-set>
