<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-doc">
   <description>Tests for the saxon:doc extension function introduced in Saxon 9.5</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-abs"/>
         
   <dependency type="spec" value="XQ31+"/>
   <dependency type="xsd-version" value="1.1"/>
   
   <environment name="atomic">
        <namespace prefix="atomic" uri="http://www.w3.org/XQueryTest"/> 
        <schema uri="http://www.w3.org/XQueryTest" file="validate/atomic.xsd">
            <description>A Schema for atomic.xml</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </schema>        
        <source role="." file="validate/atomic.xml" validation="strict" uri="http://www.w3.org/fots/docs/atomic.xml">
            <description>A Schema validated xml file, that contains values for data types. Can be used by any test.</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </source>
   </environment>
   
   <environment name="val-param">
      <schema role="." file="validate/schema-with-param.xsd">
         <description>A parameterized schema</description>
         <created by="Michael Kay" on="2012-02-05"/>
      </schema>
      <source role="$goToWork" file="validate/goToWork.xml">
         <description>A simple instance document</description>
         <created by="Michael Kay" on="2012-02-05"/>
      </source>
      <source role="$stayAtHome" file="validate/stayAtHome.xml">
         <description>A simple instance document</description>
         <created by="Michael Kay" on="2012-02-05"/>
      </source>
   </environment>

   <test-case name="s-doc-001">
      <description>Use saxon:doc() to validate a document node</description>
      <created by="Michael Kay" on="2017-03-27"/>
      <environment ref="atomic"/>
      <test>
         import schema "http://www.w3.org/XQueryTest" at "validate/atomic.xsd"; 
         saxon:doc('validate/atomic.xml', map{'validation':'strict'})/*/*[1]</test>
      <result>
         <all-of>
            <assert>local-name($result) eq 'duration'</assert>
            <assert-type>element(*, xs:duration)</assert-type>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="s-doc-002">
      <description>Use saxon:doc() to validate a document node</description>
      <created by="Michael Kay" on="2017-03-27"/>
      <environment ref="atomic"/>
      <test>
         import schema "http://www.w3.org/XQueryTest" at "validate/atomic.xsd"; 
         saxon:doc('validate/atomic.xml', map{'validation':'lax'})/*/*[1]</test>
      <result>
         <all-of>
            <assert>local-name($result) eq 'duration'</assert>
            <assert-type>element(*, xs:duration)</assert-type>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="s-doc-003">
      <description>Use saxon:doc() to validate a document node</description>
      <created by="Michael Kay" on="2017-03-27"/>
      <environment ref="atomic"/>
      <test>
         import schema "http://www.w3.org/XQueryTest" at "validate/atomic.xsd"; 
         saxon:doc('validate/atomic.xml', map{'validation':'preserve'})/*/*[1]</test>
      <result>
         <all-of>
            <assert>local-name($result) eq 'duration'</assert>
            <assert-type>element(*, xs:untyped)</assert-type>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="s-doc-004">
      <description>Use saxon:doc() to validate a document node</description>
      <created by="Michael Kay" on="2017-03-27"/>
      <environment ref="atomic"/>
      <test>
         import schema "http://www.w3.org/XQueryTest" at "validate/atomic.xsd"; 
         saxon:doc('validate/atomic.xml', map{'validation':'skip'})/*/*[1]</test>
      <result>
         <all-of>
            <assert>local-name($result) eq 'duration'</assert>
            <assert-type>element(*, xs:untyped)</assert-type>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="s-doc-005">
      <description>Use saxon:doc() to validate a document node against a specific type</description>
      <created by="Michael Kay" on="2017-03-27"/>
      <environment ref="atomic"/>
      <test>
         import schema namespace xt = "http://www.w3.org/XQueryTest" at "validate/atomic.xsd"; 
         saxon:doc('validate/atomic.xml', map{'type':xs:QName('xt:rootType')})/*/*[1]</test>
      <result>
         <all-of>
            <assert>local-name($result) eq 'duration'</assert>
            <assert-type>element(*, xs:duration)</assert-type>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="s-doc-006">
      <description>Use saxon:doc() to validate a document node against a specific type - validation failure</description>
      <created by="Michael Kay" on="2017-03-27"/>
      <environment ref="atomic"/>
      <test>
         import schema namespace xt = "http://www.w3.org/XQueryTest" at "validate/atomic.xsd"; 
         saxon:doc('validate/stayAtHome.xml', map{'validation':'strict'})/*/*[1]</test>
      <result>
         <error code="XQDY0027"/>
      </result>
   </test-case>
   
   <test-case name="s-doc-007">
      <description>Use saxon:doc() to validate a document node against a specific type - validation failure</description>
      <created by="Michael Kay" on="2017-03-27"/>
      <environment ref="atomic"/>
      <test>
         import schema namespace xt = "http://www.w3.org/XQueryTest" at "validate/atomic.xsd"; 
         saxon:doc('validate/stayAtHome.xml', map{'type':xs:QName('xt:rootType')})/*/*[1]</test>
      <result>
         <error code="XQDY0027"/>
      </result>
   </test-case>
   
   <test-case name="s-doc-008">
      <description>Use saxon:doc() to control white-space stripping</description>
      <created by="Michael Kay" on="2017-03-27"/>
      <environment ref="atomic"/>
      <test>
         import schema namespace xt = "http://www.w3.org/XQueryTest" at "validate/atomic.xsd"; 
         saxon:doc('validate/atomic.xml', map{'strip-space':'all'})</test>
      <result>
         <all-of>
            <assert>count($result/*/text()) = 0</assert>
            <assert>count($result/*/node()) = 37</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="s-doc-009">
      <description>Use saxon:doc() to control white-space stripping</description>
      <created by="Michael Kay" on="2017-03-27"/>
      <environment ref="atomic"/>
      <test>
         import schema namespace xt = "http://www.w3.org/XQueryTest" at "validate/atomic.xsd"; 
         saxon:doc('validate/atomic.xml', map{'strip-space':'none'})</test>
      <result>
         <all-of>
            <assert>count($result/*/text()) = 38</assert>
            <assert>count($result/*/node()) = 75</assert>
         </all-of>
      </result>
   </test-case>

</test-set>