<?xml version="1.0" encoding="utf-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-escape-NCName">
  <description>Tests for the saxon:escape-NCName extension function</description>
  <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/" idref="func-items-before"/>



  <test-case name="escape-ncname-001">
    <description>Empty string</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>_</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-002">
    <description>Single underscore</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("_")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>__</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-003">
    <description>Leading underscore</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("_abc")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>__abc</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-004">
    <description>Middling underscores</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("abc_def_ghi")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>abc__def__ghi</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-005">
    <description>All underscores</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("___")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>______</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-006">
    <description>No escaping needed</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("Foo")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>Foo</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-007">
    <description>Middling colon</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("xsl:text")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>xsl_3a_text</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-008">
    <description>All colons</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName(":::")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>_3a__3a__3a_</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-009">
    <description>Whitespace</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("date of birth")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>date_20_of_20_birth</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-010">
    <description>Accented Latin letters</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("Darré")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>Darré</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-011">
    <description>Disallowed Latin-1 characters</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("£300.00")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>_a3_300.00</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-012">
    <description>Leading digit</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("300.00")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>_33_00.00</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-013">
    <description>Astral characters are permitted</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName(codepoints-to-string(100000 to 100009))</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-eq>codepoints-to-string(100000 to 100009)</assert-eq>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-014">
    <description>Hyphen not allowed at start</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName("---")</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>_2d_--</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="escape-ncname-015">
    <description>Single-character hex escape</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:escape-NCName(codepoints-to-string((10, 13)))</test>
    <result>
      <all-of>
        <assert-type>xs:NCName</assert-type>
        <assert-string-value>_a__d_</assert-string-value>
      </all-of>
    </result>
  </test-case>
  




</test-set>
