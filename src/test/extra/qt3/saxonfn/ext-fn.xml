    <!-- c.f. fn:serialize -->
    <test-case name="serialize-001">
        <description>Example from the documentation</description>
        <created by="Debbie Lockett" on="2016-04-14"/>
        <test><![CDATA[declare namespace saxon="http://saxon.sf.net/"; 
declare namespace xsl="http://www.w3.org/1999/XSL/Transform"; 

<out>{ 
let $x := <a><b/><c>content</c><?pi?><!--comment--></a>
return saxon:serialize($x, <xsl:output method="xml" 
                                 omit-xml-declaration="yes"
                                 indent="yes" 
                                 saxon:indent-spaces="1"/>) 
}</out>]]></test>
        <result>
            <all-of>
                <assert>contains($result,'content')</assert>
            </all-of>
        </result>
    </test-case>
    
