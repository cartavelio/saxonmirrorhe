    <test-case name="evaluate-001">
        <description>Test that saxon:evaluate can call user-defined functions</description>
        <created by="Michael Kay" on="2016-12-22"/>
        <environment ref="atomic"/>
        <test><![CDATA[
            declare function local:add($x as xs:integer, $y as xs:integer) as xs:integer {$x + $y};
            saxon:evaluate("local:add(2, 2)")
            ]]></test>
        <result>
            <assert-eq>4</assert-eq>
        </result>
    </test-case>
    
    <test-case name="evaluate-002">
        <description>Test saxon:evaluate with parameters</description>
        <created by="Michael Kay" on="2016-12-22"/>
        <environment ref="atomic"/>
        <test><![CDATA[
            declare function local:add($x as xs:integer, $y as xs:integer) as xs:integer {$x + $y};
            saxon:evaluate("local:add($p1, $p2)", 3, 4)
            ]]></test>
        <result>
            <assert-eq>7</assert-eq>
        </result>
    </test-case>
    
    <test-case name="evaluate-003">
        <description>Test saxon:evaluate namespace context</description>
        <created by="Michael Kay" on="2016-12-22"/>
        <environment ref="atomic"/>
        <test><![CDATA[
            declare namespace p = "http://p.com/";
            declare function p:add($x as xs:integer, $y as xs:integer) as xs:integer {$x + $y};
            saxon:evaluate("p:add($p1, $p2)", 3, 4)
            ]]></test>
        <result>
            <assert-eq>7</assert-eq>
        </result>
    </test-case>
    
    
    
    <test-case name="expression-001">
        <description>Test saxon:expression and saxon:eval with changing parameters</description>
        <created by="Michael Kay" on="2016-12-22"/>
        <environment ref="atomic"/>
        <test><![CDATA[
            declare namespace p = "http://p.com/";
            declare function p:add($x as xs:integer, $y as xs:integer) as xs:integer {$x + $y};
            let $expr := saxon:expression("p:add($p1, $p2)")
            for $n in 1 to 5
            return saxon:eval($expr, $n, 1)
            ]]></test>
        <result>
            <assert-deep-eq>2, 3, 4, 5, 6</assert-deep-eq>
        </result>
    </test-case>
    
    <test-case name="expression-002">
        <description>Test saxon:expression#2 </description>
        <created by="Michael Kay" on="2016-12-22"/>
        <environment ref="atomic"/>
        <test><![CDATA[
            declare namespace p = "http://p.com/";
            declare function p:add($x as xs:integer, $y as xs:integer) as xs:integer {$x + $y};
            let $e := <e xmlns:q="http://p.com/">q:add($p1, $p2)</e>
            let $exp := saxon:expression(string($e), $e)
            return saxon:eval($exp, 3, 4)
            ]]></test>
        <result>
            <assert-eq>7</assert-eq>
        </result>
    </test-case>
    
