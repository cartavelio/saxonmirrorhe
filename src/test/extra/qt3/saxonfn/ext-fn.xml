        <result>
            <all-of>
                <assert-type>array(*)*</assert-type>
                <assert>empty($result[1]?*)</assert>
                <assert>deep-equal($result[2]?*/@name/string(), ('Amherst', 'Amherst', 'Auburn'))</assert>               
                <assert>deep-equal($result[3]?*/@name/string(), ('Auburn','Auburn', 'Bristol', 'Bristol', 'Bristol'))</assert>
                <assert>deep-equal($result[4]?*/@name/string(), ('Bristol', 'Bristol', 'Cambridge'))</assert>
