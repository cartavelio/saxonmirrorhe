    <test-case name="group-starting-001">
        <description>Basic test that the function exists and returns the right type</description>
        <created by="Michael Kay" on="2017-11-05"/>
        <environment name="towns">
            <source role="." file="docs/towns.xml"/>
        </environment>
        <test>saxon:group-starting(//town, function($t){$t/@state = 'ME'})
        </test>
        <result>
            <all-of>
                <assert-type>array(*)*</assert-type>
                <assert>deep-equal($result[1]?*/@name/string(), ('Amherst', 'Amherst', 'Auburn', 'Auburn'))</assert>
                <assert>deep-equal($result[2]?*/@name/string(), ('Auburn', 'Bristol'))</assert>
                <assert>deep-equal($result[3]?*/@name/string(), ('Bristol', 'Bristol', 'Bristol', 'Bristol'))</assert>
                <assert>deep-equal($result[4]?*/@name/string(), ('Cambridge'))</assert>
            </all-of>
        </result>
    </test-case>
    
