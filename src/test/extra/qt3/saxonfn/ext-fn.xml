<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-ext-fn">
    <description>Tests for the saxon extension functions</description>
    <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
        idref="func-abs"/>
    
    <dependency type="spec" value="XQ30+"/>
    <dependency type="xsd-version" value="1.1"/>
    
    <environment name="atomic">
        <namespace prefix="atomic" uri="http://www.w3.org/XQueryTest"/> 
        <schema uri="http://www.w3.org/XQueryTest" file="validate/atomic.xsd">
            <description>A Schema for atomic.xml</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </schema>        
        <source role="." file="validate/atomic.xml" validation="strict" uri="http://www.w3.org/fots/docs/atomic.xml">
            <description>A Schema validated xml file, that contains values for data types. Can be used by any test.</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </source>
    </environment>
    
    <environment name="pathdata">
        <source role="." file="path/pathdata.xml">
            <description>A file containing data for testing the fn:path() function</description>
            <created by="Michael Kay" on="2010-12-08"/>
        </source>
    </environment>
    
    
    <test-case name="adjust-to-civil-time-001">
        <description>Basic test that the function exists and returns the right type</description>
        <created by="Debbie Lockett" on="2015-11-10"/>
        <test>saxon:adjust-to-civil-time(xs:dateTime('2008-01-10T12:00:00Z'), 'America/New_York')</test>
        <result>
            <all-of>
                <assert-type>xs:dateTime</assert-type>
                <assert-string-value>2008-01-10T07:00:00-05:00</assert-string-value>
            </all-of>
        </result>
    </test-case> 
    
