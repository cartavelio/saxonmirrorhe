<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-new-comment">
  <description>Tests for the saxon:new-comment() function</description>
  <link type="spec" document="http://www.w3.org/TR/xpath-functions-30/" idref="func-new-comment"/>


  <test-case name="new-comment-01">
    <description>Empty content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-comment(())</test>
    <result>
      <all-of>
        <assert-type>comment()</assert-type>
        <assert-string-value></assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-comment-02">
    <description>Empty content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-comment("")</test>
    <result>
      <all-of>
        <assert-type>comment()</assert-type>
        <assert-string-value></assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  
  <test-case name="new-comment-03">
    <description>Text content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-comment('foo')</test>
    <result>
      <all-of>
        <assert-type>comment()</assert-type>
        <assert-string-value>foo</assert-string-value>
        <assert>not($result/..)</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-comment-04">
    <description>Can be added to document node</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-document((saxon:new-comment('foo'), saxon:new-comment('bar')))</test>
    <result>
      <all-of>
        <assert>$result/comment()[1] eq 'foo'</assert>
        <assert>$result/comment()[2] eq 'bar'</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-comment-05">
    <description>Any "--" is replaced by "- -"</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-comment('foo--bar')</test>
    <result>
      <assert-string-value>foo- -bar</assert-string-value>
    </result>
  </test-case>
  
  <test-case name="new-comment-06">
    <description>Any final "-" is replaced by "- "</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-comment('foo-bar-')</test>
    <result>
      <assert-string-value>foo-bar- </assert-string-value>
    </result>
  </test-case>
  
  <test-case name="new-comment-07">
    <description>Any final "--" is replaced by "- - "</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-comment('foo-bar--')</test>
    <result>
      <assert-string-value>foo-bar- - </assert-string-value>
    </result>
  </test-case>
  
  
 

</test-set>
