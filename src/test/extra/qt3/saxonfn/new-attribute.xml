<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-new-attribute">
  <description>Tests for the saxon:new-attribute() function</description>
  <link type="spec" document="http://www.w3.org/TR/xpath-functions-30/" idref="func-new-attribute"/>


  <test-case name="new-attribute-01">
    <description>Empty attribute</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute('a', ())</test>
    <result>
      <assert-type>attribute(a)</assert-type>
      <assert>name($result) = 'a'</assert>
      <assert>string($result) = ''</assert>
    </result>
  </test-case>
  
  <test-case name="new-attribute-02">
    <description>Attribute with text content</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute(QName('', 'a'), 'foo')</test>
    <result>
      <all-of>
        <assert-type>attribute(a)</assert-type>
        <assert>name($result) = 'a'</assert>
        <assert>string($result) = 'foo'</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-attribute-03">
    <description>Attribute in namespace with supplied prefix</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute(QName('http://example.com/', 'p:a'), 'foo')</test>
    <result>
      <all-of>
        <assert-type>attribute(Q{http://example.com/}a)</assert-type>
        <assert>name($result) = 'p:a'</assert>
        <assert>string($result) = 'foo'</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-attribute-04">
    <description>Attribute in namespace with no supplied prefix</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute(QName('http://example.com/', 'a'), 'foo')</test>
    <result>
      <all-of>
        <assert-type>attribute(Q{http://example.com/}a)</assert-type>
        <assert>ends-with(name($result), ':a')</assert>
        <assert>node-name($result) eq QName('http://example.com/', 'a')</assert>
        <assert>string($result) = 'foo'</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-attribute-05">
    <description>Attribute name prefix "xmlns" gets substituted</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute(QName("http://example.com/", "xmlns:a"), "foo")</test>
    <result>
      <all-of>
        <assert-type>attribute(Q{http://example.com/}a)</assert-type>
        <assert>name($result) => ends-with(':a')</assert>
        <assert>node-name($result) eq QName('http://example.com/', 'a')</assert>
        <assert>string($result) = 'foo'</assert>
        <assert>name($result) != 'xmlns:a'</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-attribute-06">
    <description>Attribute name in format prefix:local</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute('xml:lang', "en")</test>
    <result>
      <all-of>
        <assert-type>attribute(Q{http://www.w3.org/XML/1998/namespace}lang)</assert-type>
        <assert>name($result) = 'xml:lang'</assert>
        <assert>node-name($result) eq QName("http://www.w3.org/XML/1998/namespace", 'lang')</assert>
        <assert>string($result) = 'en'</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-attribute-07">
    <description>Attribute name in format Q{uri}local</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute('Q{http://www.w3.org/XML/1998/namespace}lang', "en")</test>
    <result>
      <all-of>
        <assert-type>attribute(Q{http://www.w3.org/XML/1998/namespace}lang)</assert-type>
        <assert>name($result) = 'xml:lang'</assert>
        <assert>node-name($result) eq QName("http://www.w3.org/XML/1998/namespace", 'lang')</assert>
        <assert>string($result) = 'en'</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-attribute-08">
    <description>Attribute name in format Q{uri}local</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute('Q{http://example.com/}lang', "en")</test>
    <result>
      <all-of>
        <assert-type>attribute(Q{http://example.com/}lang)</assert-type>
        <assert>ends-with(name($result), ':lang')</assert>
        <assert>node-name($result) eq QName("http://example.com/", 'lang')</assert>
        <assert>string($result) = 'en'</assert>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="new-attribute-901">
    <description>Attribute name "xmlns" not allowed</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute("xmlns", "http://www.example.com")</test>
    <result>
      <error code="XQDY0044"/>
    </result>
  </test-case>
  
  <test-case name="new-attribute-902">
    <description>Attribute name "23X" not allowed</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute("23X", "foo")</test>
    <result>
      <error code="FOCA0002"/>
    </result>
  </test-case>
  
  <test-case name="new-attribute-903">
    <description>Undeclared prefix</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute("foo:bar", "baz")</test>
    <result>
      <error code="FONS0004"/>
    </result>
  </test-case>
  
  <test-case name="new-attribute-904">
    <description>Prefix "xml" with wrong namespace</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute(QName("http://example.com/", "xml:lang"), "en")</test>
    <result>
      <error code="XTDE0835"/>
    </result>
  </test-case>
  
  <test-case name="new-attribute-905">
    <description>URI "http://www.w3.org/XML/1998/namespace" with wrong prefix</description>
    <created by="Michael Kay" on="2020-02-09"/>
    <test>saxon:new-attribute(QName("http://www.w3.org/XML/1998/namespace", "my:lang"), "en")</test>
    <result>
      <error code="XTDE0835"/>
    </result>
  </test-case>
  
  

</test-set>
