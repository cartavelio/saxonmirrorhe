<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-EQName">
    <description>Tests for the saxon:EQName extension function</description>
    <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/" idref="func-EQName"/>

    <dependency type="spec" value="XP31+ XQ31+"/>

    <test-case name="EQName-001">
        <description>Empty sequence</description>
        <created by="Michael Kay" on="2019-06-19"/>
        <test>saxon:EQName(())</test>
        <result>
            <assert-empty/>
        </result>
    </test-case>

    <test-case name="EQName-002">
        <description>NCName</description>
        <created by="Michael Kay" on="2019-06-19"/>
        <test>saxon:EQName('pineapple')</test>
        <result>
            <all-of>
                <assert>$result instance of xs:QName</assert>
                <assert>namespace-uri-from-QName($result) eq ''</assert>
                <assert>empty(prefix-from-QName($result))</assert>
                <assert>local-name-from-QName($result) eq 'pineapple'</assert>
            </all-of>
        </result>
    </test-case>

    <test-case name="EQName-003">
        <description>Q{uri}local</description>
        <created by="Michael Kay" on="2019-06-19"/>
        <test>saxon:EQName('Q{http://xyz.com/}pineapple')</test>
        <result>
            <all-of>
                <assert>$result instance of xs:QName</assert>
                <assert>namespace-uri-from-QName($result) eq 'http://xyz.com/'</assert>
                <assert>empty(prefix-from-QName($result))</assert>
                <assert>local-name-from-QName($result) eq 'pineapple'</assert>
            </all-of>
        </result>
    </test-case>

    <test-case name="EQName-004">
        <description>Q{}local</description>
        <created by="Michael Kay" on="2019-06-19"/>
        <test>saxon:EQName('Q{}pineapple')</test>
        <result>
            <all-of>
                <assert>$result instance of xs:QName</assert>
                <assert>namespace-uri-from-QName($result) eq ''</assert>
                <assert>empty(prefix-from-QName($result))</assert>
                <assert>local-name-from-QName($result) eq 'pineapple'</assert>
            </all-of>
        </result>
    </test-case>

    <test-case name="EQName-005">
        <description>prefix:local</description>
        <created by="Michael Kay" on="2019-06-19"/>
        <test>saxon:EQName('saxon:pineapple')</test>
        <result>
            <all-of>
                <assert>$result instance of xs:QName</assert>
                <assert>namespace-uri-from-QName($result) eq 'http://saxon.sf.net/'</assert>
                <assert>prefix-from-QName($result) eq 'saxon'</assert>
                <assert>local-name-from-QName($result) eq 'pineapple'</assert>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="EQName-006">
        <description>NCName with whitespace</description>
        <created by="Michael Kay" on="2019-06-19"/>
        <test>saxon:EQName(' pineapple ')</test>
        <result>
            <all-of>
                <assert>$result instance of xs:QName</assert>
                <assert>namespace-uri-from-QName($result) eq ''</assert>
                <assert>empty(prefix-from-QName($result))</assert>
                <assert>local-name-from-QName($result) eq 'pineapple'</assert>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="EQName-007">
        <description>Q{}local with whitespace</description>
        <created by="Michael Kay" on="2019-06-19"/>
        <test>saxon:EQName(' Q{}pineapple ')</test>
        <result>
            <all-of>
                <assert>$result instance of xs:QName</assert>
                <assert>namespace-uri-from-QName($result) eq ''</assert>
                <assert>empty(prefix-from-QName($result))</assert>
                <assert>local-name-from-QName($result) eq 'pineapple'</assert>
            </all-of>
        </result>
    </test-case>
    
    <test-case name="EQName-008">
        <description>prefix:local with whitespace</description>
        <created by="Michael Kay" on="2019-06-19"/>
        <test>saxon:EQName(' saxon:pineapple ')</test>
        <result>
            <all-of>
                <assert>$result instance of xs:QName</assert>
                <assert>namespace-uri-from-QName($result) eq 'http://saxon.sf.net/'</assert>
                <assert>prefix-from-QName($result) eq 'saxon'</assert>
                <assert>local-name-from-QName($result) eq 'pineapple'</assert>
            </all-of>
        </result>
    </test-case>

    <test-case name="EQName-901">
        <description>prefix:local, unbound prefix</description>
        <created by="Michael Kay" on="2019-06-19"/>
        <test>saxon:EQName('bang:pineapple')</test>
        <result>
            <error code="FONS0004"/>
        </result>
    </test-case>

    <test-case name="EQName-902">
        <description>invalid NCName</description>
        <created by="Michael Kay" on="2019-06-19"/>
        <test>saxon:EQName('23banana')</test>
        <result>
