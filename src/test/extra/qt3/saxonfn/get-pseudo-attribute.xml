<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-get-pseudo-attribute">
   <description>Tests for the saxon:get-pseudo-attribute extension function</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-get-pseudo-attribute"/>
         
   <dependency type="spec" value="XQ31+"/>  

   <test-case name="get-pseudo-001">
      <description>Basic example</description>
      <created by="Michael Kay" on="2019-10-02"/>
       <test><![CDATA[<?pi a="3" b="52"?> ! saxon:get-pseudo-attribute("b")]]></test>
      <result>
          <assert-eq>"52"</assert-eq>
      </result>
   </test-case>
    
    <test-case name="get-pseudo-002">
        <description>No match</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA[<?pi a="3" b="52"?> ! saxon:get-pseudo-attribute("c")]]></test>
        <result>
            <assert-empty/>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-003">
        <description>Multiple match</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA[<?pi a="3" b="52" a="18"?> ! saxon:get-pseudo-attribute("a")]]></test>
        <result>
            <error code="SXCH0005"/>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-004">
        <description>Also works on non-PIs</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA[' a="3" b="52"' ! saxon:get-pseudo-attribute("b")]]></test>
        <result>
            <assert-eq>"52"</assert-eq>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-005">
        <description>Whitespace allowed</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA[' a = "3" b = "52"' ! saxon:get-pseudo-attribute("b")]]></test>
        <result>
            <assert-eq>"52"</assert-eq>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-006">
        <description>This shouldn't match</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA[' mensa="3" b = "52"' ! saxon:get-pseudo-attribute("a")]]></test>
        <result>
            <assert-empty/>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-007">
        <description>This one isn't well-defined</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA[' 1a="3" b = "52"' ! saxon:get-pseudo-attribute("a")]]></test>
        <result>
            <error code="SXCH0005"/>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-008">
        <description>This one isn't well-defined either</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA[' a="3"b="52"' ! saxon:get-pseudo-attribute("a")]]></test>
        <result>
            <error code="SXCH0005"/>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-009">
        <description>This one probably ought to work</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA['a="3" b="52"' ! saxon:get-pseudo-attribute("a")]]></test>
        <result>
            <assert-eq>"3"</assert-eq>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-010">
        <description>Empty value, single quotes</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA["a='xxxx yyyy' b=''" ! saxon:get-pseudo-attribute("b")]]></test>
        <result>
            <assert-eq>""</assert-eq>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-011">
        <description>Built-in entity references</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test>"a=' &amp;amp;lt; &amp;amp;gt; ' b=''" ! saxon:get-pseudo-attribute("a")</test>
        <result>
            <assert-eq><![CDATA[" < > "]]></assert-eq>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-012">
        <description>Built-in character references</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA[<?pi a='&#x20;&#9;' b=''?> ! saxon:get-pseudo-attribute("a") => string-to-codepoints()]]></test>
        <result>
            <assert-deep-eq>32, 9</assert-deep-eq>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-013">
        <description>Bad entity reference</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA[<?pi a='Barnes & Noble' b=''?> ! saxon:get-pseudo-attribute("a") ]]></test>
        <result>
            <error code="SXCH0005"/>
        </result>
    </test-case>
    
    <test-case name="get-pseudo-014">
        <description>Colon in names is permitted by the xml-stylesheet spec</description>
        <created by="Michael Kay" on="2019-10-02"/>
        <test><![CDATA[<?xml-stylesheet a="23" b:foo="81" :c="98" ?> ! saxon:get-pseudo-attribute(":c") ]]></test>
        <result>
            <assert-string-value>98</assert-string-value>
        </result>
    </test-case>

    

  
</test-set>