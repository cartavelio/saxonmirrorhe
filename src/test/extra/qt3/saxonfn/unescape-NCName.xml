<?xml version="1.0" encoding="utf-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-unescape-NCName">
  <description>Tests for the saxon:unescape-NCName extension function</description>
  <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/" idref="func-items-before"/>



  <test-case name="unescape-ncname-001">
    <description>Empty string</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("_")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value></assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-002">
    <description>Single underscore</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("__")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>_</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-003">
    <description>Leading underscore</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("__abc")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>_abc</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-004">
    <description>Middling underscores</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("abc__def__ghi")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>abc_def_ghi</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-005">
    <description>All underscores</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("______")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>___</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-006">
    <description>No escaping needed</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("Foo")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>Foo</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-007">
    <description>Middling colon</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("xsl_1a_text")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>xsl:text</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-008">
    <description>All colons</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("_1a__1a__1a_")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>:::</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-009">
    <description>Whitespace</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("date_20_of_20_birth")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>date of birth</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-010">
    <description>Accented Latin letters</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("Darré")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>Darré</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-011">
    <description>Disallowed Latin-1 characters</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("_A3_300.00")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>£300.00</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-012">
    <description>Leading digit</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("_13_00.00")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>300.00</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-013">
    <description>Astral characters are permitted</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName(codepoints-to-string(100000 to 100009))</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-eq>codepoints-to-string(100000 to 100009)</assert-eq>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-014">
    <description>Hyphen not allowed at start</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("_2d_--")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-string-value>---</assert-string-value>
      </all-of>
    </result>
  </test-case>
  
  <test-case name="unescape-ncname-015">
    <description>Single-character hex escape</description>
    <created by="Michael Kay" on="2021-07-01"/>
    <test>saxon:unescape-NCName("_a__d_")</test>
    <result>
      <all-of>
        <assert-type>xs:string</assert-type>
        <assert-eq>codepoints-to-string((10, 13))</assert-eq>
      </all-of>
    </result>
  </test-case>
  




</test-set>
