<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-read-binary-resource">
   <description>Tests for the saxon:read-binary-resource extension function introduced in Saxon 9.7</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/"
         idref="func-abs"/>
 
   

   <test-case name="read-binary-001">
      <description>Basic test that the function exists and returns the right type</description>
      <created by="Michael Kay" on="2015-05-07"/>
      <test>saxon:read-binary-resource("http://www.saxonica.com")</test>
      <result>
         <assert-type>xs:base64Binary</assert-type>
      </result>
   </test-case>
   
   <test-case name="read-binary-002">
      <description>Test the content of an HTTP resource</description>
      <created by="Michael Kay" on="2015-05-07"/>
      <test>saxon:base64Binary-to-string(saxon:read-binary-resource("https://www.saxonica.com"), "utf-8")</test>
      <result>
         <assert><![CDATA[contains($result, "<title>Saxonica: XSLT and XQuery Processing</title>")]]></assert>
      </result>
   </test-case>
   
   <test-case name="read-binary-003">
      <description>Non-existent resource</description>
      <created by="Michael Kay" on="2015-05-07"/>
      <test>saxon:base64Binary-to-string(saxon:read-binary-resource("file:///non-existent.xml"), "utf-8")</test>
      <result>
         <error code="SXJE0053"/>
      </result>
   </test-case>
   
   <test-case name="read-binary-004">
      <description>Bad URI</description>
      <created by="Michael Kay" on="2015-05-07"/>
      <test>saxon:read-binary-resource("http:\\www.saxonica.com\")</test>
      <result>
         <error code="SXJE0053"/>
      </result>
   </test-case>
   
