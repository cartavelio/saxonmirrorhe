<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="saxon-pedigree"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" covers="saxon:with-pedigree saxon:pedigree">
   <description>Tests for the saxon:with-pedigree and saxon:pedigree functions introduced in Saxon 9.9</description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-31/" idref="func-map-search"/>
   <dependency type="spec" value="XP31+ XQ31+ XT30+"/>
   
   <environment name="map">
      <namespace prefix="map" uri="http://www.w3.org/2005/xpath-functions/map"/>
      <namespace prefix="saxon" uri="http://saxon.sf.net/"/>
   </environment>
 
   <test-case name="pedigree-001">
      <description>Pedigree on a map containing arrays</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>(map{"a":[1], "b":[2], "c":[3, 4]} => saxon:with-pedigree() => map:get("a") => saxon:pedigree())?container?c</test>
      <result>
         <assert-deep-eq>[3, 4]</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="pedigree-002">
      <description>Pedigree on a map containing arrays</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>(map{"a":[1], "b":[2], "c":[3]} => saxon:with-pedigree() => map:get("a") => saxon:pedigree())?key</test>
      <result>
         <assert-eq>"a"</assert-eq>
      </result>
   </test-case>
   
   <test-case name="pedigree-003">
      <description>Pedigree on an array containing maps</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>([map{"a":1, "b":2}, map{"a":11, "b":12}] => saxon:with-pedigree() => array:get(2) => saxon:pedigree())?container?1?b</test>
      <result>
         <assert-eq>2</assert-eq>
      </result>
   </test-case>
   
   <test-case name="pedigree-004">
      <description>Pedigree on an array containing maps</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>([map{"a":1, "b":2}, map{"a":11, "b":12}] => saxon:with-pedigree() => array:get(1) => saxon:pedigree())?index</test>
      <result>
         <assert-eq>1</assert-eq>
      </result>
   </test-case>
   
   <test-case name="pedigree-005">
      <description>Pedigree on JSON content</description>
      <created by="Michael Kay, Saxonica" on="2016-09-06"/>
      <environment ref="map"/>
      <test>
         let $ped := (json-doc('docs/glossary.json') => saxon:with-pedigree())?*[?keyword = "XSLT"]?origin?2 => saxon:pedigree()
         return $ped?container?1?version</test>
      <result>
         <assert-eq>1</assert-eq>
      </result>
   </test-case>

 
</test-set>
