<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="arrayFilter">
  <description>Originally tested some saxon extension syntax for filtering arrays; now use standard XPath 3.1 syntax</description>
  <dependency type="spec" value="XP30+ XQ30+"/>

  <environment name="arrayFilter">
    <saxon:property name="http://saxon.sf.net/feature/allowSyntaxExtensions" value="true"
      xmlns:saxon="http://saxon.sf.net/"/>
  </environment>

  <test-case name="arrayFilter-001">
    <description>arrayFilter, simple case</description>
    <created by="Michael Kay" on="2017-11-07"/>
    <environment ref="arrayFilter"/>
    <test>[1 ,2 ,3, 4, 5]?*[. gt 3]</test>
    <result>
      <assert-deep-eq>(4, 5)</assert-deep-eq>
    </result>
  </test-case>
  
  <test-case name="arrayFilter-002">
    <description>arrayFilter, empty case</description>
    <created by="Michael Kay" on="2017-11-07"/>
    <environment ref="arrayFilter"/>
    <test>[]?*[. gt 3]</test>
    <result>
      <assert-deep-eq>()</assert-deep-eq>
    </result>
  </test-case>
  
  <test-case name="arrayFilter-003">
    <description>arrayFilter, contains sequences</description>
    <created by="Michael Kay" on="2017-11-07"/>
    <environment ref="arrayFilter"/>
    <test>[(1,2), (), (2,3), (3,4)]?*[. gt 3]</test>
    <result>
      <assert-eq>4</assert-eq>
    </result>
  </test-case>
  
  <test-case name="arrayFilter-004">
    <description>arrayFilter, contains maps</description>
    <created by="Michael Kay" on="2017-11-07"/>
    <environment ref="arrayFilter"/>
    <test>[map{"a":1, "b":11}, map{"a":2, "b":12}, map{"a":3, "b":13}]?*[?a = 2]?b</test>
    <result>
      <assert-eq>12</assert-eq>
    </result>
  </test-case>
  
  <test-case name="arrayForMember-001">
    <description>for member expression</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>for member $m in [(1,2,3), (4,5,6)] return sum($m)</test>
    <result>
      <assert-deep-eq>6, 15</assert-deep-eq>
    </result>
  </test-case>
  
  <test-case name="arrayForMember-002">
    <description>for member expression - empty</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>for member $m in [] return sum($m)</test>
    <result>
      <assert-empty/>
    </result>
  </test-case>
  
  <test-case name="arrayForMember-003">
    <description>for member expression - multiple clauses</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>for member $m in [1, 2], $n in [3, 4] return $m * $n</test>
    <result>
      <assert-deep-eq>3, 4, 6, 8</assert-deep-eq>
    </result>
  </test-case>
  
  <test-case name="arrayForMember-004">
    <description>for member expression - static type error</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>for member $m in [1, 2], $n in (3, 4) return $m * $n</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>
  
  <test-case name="arrayForMember-005">
    <description>for member expression - dynamic type error</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>let $x := if (current-date() lt xs:date('1900-01-01')) then [1,2,3] else 28
          return for member $m in $x return $m + 1</test>
    <result>
      <error code="XPTY0004"/>
    </result>
  </test-case>
  
  <test-case name="arrayForMember-006">
    <description>for member expression - nested</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>for member $x in [[1,2,3], [4,5,6]], $y in $x return $y + 1</test>
    <result>
      <assert-deep-eq>2,3,4,5,6,7</assert-deep-eq>
    </result>
  </test-case>
  
  <test-case name="arrayForMember-007">
    <description>for member expression - filtered</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>for member $x in array:filter([1, 5, 6, 12], function($n){$n mod 3 = 0}) return $x + 1</test>
    <result>
      <assert-deep-eq>7, 13</assert-deep-eq>
    </result>
  </test-case>
  
  <test-case name="arrayForMember-008">
    <description>for member expression - on result of JSON parsing</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>for member $m in parse-json('[{"x":1,"y":22}, {"x":2,"y":33}]') return $m?y</test>
    <result>
      <assert-deep-eq>22, 33</assert-deep-eq>
    </result>
  </test-case>
  
  <test-case name="lookup-001">
    <description>Saxon extension: string literal after lookup operator</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>map{"the key":5, "the value":33}?"the value"</test>
    <result>
      <assert-eq>33</assert-eq>
    </result>
  </test-case>
  
  <test-case name="lookup-002">
    <description>Saxon extension: variable reference after lookup operator</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>for $i in 1 to 3 return [22, 33, 44]?$i</test>
    <result>
      <assert-deep-eq>22, 33, 44</assert-deep-eq>
    </result>
  </test-case>
  
  <test-case name="lookup-003">
    <description>Saxon extension: variable reference after lookup operator</description>
    <created by="Michael Kay" on="2019-04-03"/>
    <environment ref="arrayFilter"/>
    <test>for member $i in ["the value"], $m in parse-json('[{"the key":1,"the value":22}, {"the key":2,"the value":33}]') return $m?$i</test>
    <result>
      <assert-deep-eq>22, 33</assert-deep-eq>
    </result>
  </test-case>
  

 

</test-set>
