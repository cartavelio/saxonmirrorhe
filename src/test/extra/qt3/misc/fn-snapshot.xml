<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-snapshot" covers="fn-snapshot">
   <description>
      Tests the snapshot() function: this is defined in XSLT 3.0 but Saxon chooses to make it available also in XPath and XQuery.
   </description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/" idref="func-parse-json"/>
   <dependency type="spec" value="XP31+ XQ31+"/>
   
   <test-case name="fn-snapshot-001">
      <description>Check arity=1 function exists</description>
      <created by="Michael Kay, Saxonica" on="2017-07-17"/>
      <test>snapshot(doc('docs/atomic.xml'))</test>
      <result>
         <assert>$result/(/*:root)</assert>
      </result>
   </test-case>
   
   <test-case name="fn-snapshot-002">
      <description>Check arity=0 function exists</description>
      <created by="Michael Kay, Saxonica" on="2017-07-17"/>
      <test>doc('docs/atomic.xml')/snapshot()</test>
      <result>
         <assert>$result/(/*:root)</assert>
      </result>
   </test-case>
   

</test-set>
