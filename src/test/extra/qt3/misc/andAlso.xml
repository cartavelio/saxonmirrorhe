<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="andAlso">
  <description>Testing the saxon extension syntax: andAlso operator</description>
  <dependency type="spec" value="XP30+ XQ30+"/>

  <environment name="andAlso">
    <saxon:property name="http://saxon.sf.net/feature/allowSyntaxExtensions" value="true"
      xmlns:saxon="http://saxon.sf.net/"/>
  </environment>

  <test-case name="andAlso-001">
    <description>andAlso, simple case</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>true() andAlso false()</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="andAlso-002">
    <description>andAlso, simple case</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>false() andAlso true()</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="andAlso-003">
    <description>andAlso, simple case</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>false() andAlso false()</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="andAlso-004">
    <description>andAlso, simple case</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>true() andAlso true()</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="andAlso-005">
    <description>andAlso, simple case with EBV conversion</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>0 andAlso 0</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="andAlso-006">
    <description>andAlso, simple case with EBV conversion</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>0 andAlso 1</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="andAlso-007">
    <description>andAlso, simple case with EBV conversion</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>1 andAlso ""</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="andAlso-008">
    <description>andAlso, simple case with EBV conversion</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>"aaa" andAlso "bbb"</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="andAlso-009">
    <description>Demonstrate short-circuit semantics</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>false() andAlso doc('nonexistent.xml')/a</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="andAlso-010">
    <description>Demonstrate short-circuit semantics</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>true() andAlso doc('nonexistent.xml')/a</test>
    <result>
      <error code="FODC0002"/>
    </result>
  </test-case>
  
  <test-case name="andAlso-011">
    <description>Demonstrate short-circuit semantics</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>current-date() le xs:date('1900-12-01') andAlso doc('nonexistent.xml')/a</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="andAlso-012">
    <description>Demonstrate short-circuit semantics</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>current-date() gt xs:date('1900-12-01') andAlso doc('nonexistent.xml')/a</test>
    <result>
      <error code="FODC0002"/>
    </result>
  </test-case>
  
  <test-case name="andAlso-013">
    <description>Demonstrate short-circuit semantics in a predicate</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="andAlso"/>
    <test>((1 to 10)!(""||. , "a"||.))[. castable as xs:integer andAlso xs:integer(.) gt 9]</test>
    <result>
      <assert-eq>"10"</assert-eq>
    </result>
  </test-case>



</test-set>
