<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-serialize"
    covers="fn-serialize">
    <description>Tests for implementation specific options for the fn:serialize()
        and load-xquery-module() functions</description>
    <link type="spec" document="http://www.w3.org/TR/xpath-functions-31/" idref="func-serialize-xml"/>

    <dependency type="spec" value="XQ31+ XP31+"/>
    
    <environment name="atomic">
        <namespace prefix="atomic" uri="http://www.w3.org/XQueryTest"/> 
        <schema uri="http://www.w3.org/XQueryTest" file="docs/atomic.xsd">
            <description>A Schema for atomic.xml</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </schema>        
        <source role="." file="docs/atomic.xml" validation="strict" uri="http://www.w3.org/fots/docs/atomic.xml">
            <description>A Schema validated xml file, that contains values for data types. Can be used by any test.</description>
            <created by="Carmelo Montanez" on="2005-03-08"/>
        </source>
    </environment>
    
    
    <!-- Saxon attribute tests NOT TO BE ADDED TO QT3 -->
    <!-- The tests generally only check that the serialization parameters are accepted,
        they do not check the effect.  -->
    
    <test-case name="serialize-xml-saxon-001" covers="fn-serialize">
        <description>serialize test - params supplied as map, 
            Saxon attribute-order serialization parameter</description>
        <created by="Debbie Lockett, Saxonica" on="2015-11-10"/>
        <environment>
            <source role="." file="docs/data-001.xml" uri="http://www.w3.org/fots/docs/data-001.xml"/>
        </environment>
        <dependency type="spec" value="XP31+ XQ31+"/>
        <test>let $params := map {
            "indent" : true(),
            QName("http://saxon.sf.net/","attribute-order") : (QName("","c"), QName("","b"), QName("","a"), QName("","x")) 
            }
            return normalize-space(serialize(., $params))
        </test>
        <result>
            <assert-string-value>&lt;data c="c" b="b" a="a" x="x"/&gt;</assert-string-value>
        </result>
    </test-case>
    
    <test-case name="serialize-xml-saxon-002" covers="fn-serialize">
        <description>serialize test - params supplied as map, 
            Saxon character-representation serialization parameter</description>
        <created by="Debbie Lockett, Saxonica" on="2015-11-10"/>
        <environment ref="atomic"/>
        <dependency type="spec" value="XP31+ XQ31+"/>
        <test>let $params := map {
            "indent" : true(),
            QName("http://saxon.sf.net/","character-representation") : "decimal"
            }
            return serialize(., $params)
        </test>
        <result>
            <assert>contains($result,'atomic')</assert>
        </result>
    </test-case>
    
    <test-case name="serialize-xml-saxon-003" covers="fn-serialize">
        <description>serialize test - params supplied as map, 
            Saxon double-space serialization parameter</description>
        <created by="Debbie Lockett, Saxonica" on="2015-11-10"/>
        <environment ref="atomic"/>
        <dependency type="spec" value="XP31+ XQ31+"/>
        <test>let $params := map {
            "indent" : true(),
            QName("http://saxon.sf.net/","double-space") : 
            [QName("http://www.w3.org/XQueryTest","boolean"), 
            QName("http://www.w3.org/XQueryTest","decimal")]
            }
            return serialize(., $params)
