<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-copy-of" covers="fn-copy-of">
   <description>
      Tests Saxon-specific options for the map:merge() function.
   </description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/" idref="func-map-merge"/>
   <dependency type="spec" value="XP31+ XQ31+"/>
   
   <test-case name="fn-map-merge-001">
      <description>Check duplicates-error-code</description>
      <created by="Michael Kay, Saxonica" on="2019-09-23"/>
      <test>map:merge((map{1: "a"}, map{1: "b"}), 
                      map{"duplicates":"reject", QName("http://saxon.sf.net/", "duplicates-error-code"): "FOJS-duplicate"})</test>
      <result>
         <error code="FOJS-duplicate"/>
      </result>
   </test-case>
   
   <test-case name="fn-map-merge-011">
      <description>Custom action on duplicates (arity 2)</description>
      <created by="Michael Kay, Saxonica" on="2019-09-23"/>
      <test>map:merge((map{1: 22}, map{1: 39}), 
         map{QName("http://saxon.sf.net/", "on-duplicates"): function($a, $b){$a + $b}})</test>
      <result>
         <assert>$result?1 eq 61</assert>
      </result>
   </test-case>
   
   <test-case name="fn-map-merge-012">
      <description>Custom action on duplicates (arity 3)</description>
      <created by="Michael Kay, Saxonica" on="2019-09-23"/>
      <test>map:merge((map{1: 22}, map{1: 39}), 
         map{QName("http://saxon.sf.net/", "on-duplicates"): function($a, $b, $k){if ($k mod 2 eq 1) then $a + $b else $a - $b}})</test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>
   
   <test-case name="fn-map-merge-021">
      <description>Specify key-type</description>
      <created by="Michael Kay, Saxonica" on="2019-09-23"/>
      <test>map:merge((map{"a": 22}, map{"b": 39}), 
         map{QName("http://saxon.sf.net/", "key-type"): "string"})</test>
      <result>
         <assert>$result?a eq 22</assert>
      </result>
   </test-case>
   
   <test-case name="fn-map-merge-022">
      <description>Specify key-type (no error because this is only an optemization)</description>
      <created by="Michael Kay, Saxonica" on="2019-09-23"/>
      <test>map:merge((map{"a": 22}, map{12: 39}), 
         map{QName("http://saxon.sf.net/", "key-type"): "string"})</test>
      <result>
         <assert>$result?a eq 22</assert>
      </result>
   </test-case>
   
   <test-case name="fn-map-merge-031">
      <description>Specify final</description>
      <created by="Michael Kay, Saxonica" on="2019-09-23"/>
      <test>map:merge((map{"a": 22}, map{"b": 39}), 
         map{QName("http://saxon.sf.net/", "final"): true()})</test>
      <result>
         <assert>$result?a eq 22</assert>
      </result>
   </test-case>
   
   <test-case name="fn-map-merge-032">
      <description>Specify final (no error because this is only an optemization)</description>
      <created by="Michael Kay, Saxonica" on="2019-09-23"/>
      <test>map:merge((map{"a": 22}, map{12: 39}), 
         map{QName("http://saxon.sf.net/", "final"): true()}) => map:put(16, 18)</test>
      <result>
         <assert>$result?16 eq 18</assert>
      </result>
   </test-case>
   
 

</test-set>
