<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="orElse">
  <description>Testing the saxon extension syntax: orElse operator</description>
  <dependency type="spec" value="XP30+ XQ30+"/>

  <environment name="orElse">
    <saxon:property name="http://saxon.sf.net/feature/allowSyntaxExtensions" value="true"
      xmlns:saxon="http://saxon.sf.net/"/>
  </environment>

  <test-case name="orElse-001">
    <description>OrElse, simple case</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>true() orElse false()</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="orElse-002">
    <description>OrElse, simple case</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>false() orElse true()</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="orElse-003">
    <description>OrElse, simple case</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>false() orElse false()</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="orElse-004">
    <description>OrElse, simple case</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>true() orElse true()</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="orElse-005">
    <description>OrElse, simple case with EBV conversion</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>0 orElse 0</test>
    <result>
      <assert-false/>
    </result>
  </test-case>

  <test-case name="orElse-006">
    <description>OrElse, simple case with EBV conversion</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>0 orElse 1</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="orElse-007">
    <description>OrElse, simple case with EBV conversion</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>1 orElse ""</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="orElse-008">
    <description>OrElse, simple case with EBV conversion</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>"aaa" orElse "bbb"</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="orElse-009">
    <description>Demonstrate short-circuit semantics</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>true() orElse doc('nonexistent.xml')/a</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="orElse-010">
    <description>Demonstrate short-circuit semantics</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>false() orElse doc('nonexistent.xml')/a</test>
    <result>
      <error code="FODC0002"/>
    </result>
  </test-case>
  
  <test-case name="orElse-011">
    <description>Demonstrate short-circuit semantics</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>current-date() gt xs:date('1900-12-01') orElse doc('nonexistent.xml')/a</test>
    <result>
      <assert-true/>
    </result>
  </test-case>

  <test-case name="orElse-012">
    <description>Demonstrate short-circuit semantics</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>current-date() lt xs:date('1900-12-01') orElse doc('nonexistent.xml')/a</test>
    <result>
      <error code="FODC0002"/>
    </result>
  </test-case>
  
  <test-case name="orElse-013">
    <description>Demonstrate short-circuit semantics in a predicate</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="orElse"/>
    <test>((1 to 10)!(""||. , "a"||.))[. castable as xs:integer orElse contains(., "5")]</test>
    <result>
      <assert-count>11</assert-count>
    </result>
  </test-case>



</test-set>
