<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="fn-parse-json" covers="fn-parse-json">
   <description>
      Tests the parse-json function with liberal=true.
   </description>
   <link type="spec" document="http://www.w3.org/TR/xpath-functions-11/" idref="func-parse-json"/>
   <dependency type="spec" value="XP31+ XQ31+"/>
   
   <test-case name="fn-parse-json-liberal-001">
      <description>Surplus trailing comma in array</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('[1,2,3,]', map{"liberal":true()})</test>
      <result>
         <assert-deep-eq>[1,2,3]</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-003">
      <description>Surplus trailing comma in object</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('{"a":2, "b":3, }', map{"liberal":true()})</test>
      <result>
         <assert-deep-eq>map{"a":2, "b":3}</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-011">
      <description>Leading + in number</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('+12', map{"liberal":true()})</test>
      <result>
         <assert-deep-eq>12</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-012">
      <description>Leading + in number</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('+12.0', map{"liberal":true()})</test>
      <result>
         <assert-deep-eq>12.0</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-013">
      <description>Leading . in number</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('.05', map{"liberal":true()})</test>
      <result>
         <assert-deep-eq>0.05</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-014">
      <description>Trailing . in number</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('50.', map{"liberal":true()})</test>
      <result>
         <assert-deep-eq>50</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-015">
      <description>Trailing 0 in number</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('009', map{"liberal":true()})</test>
      <result>
         <assert-deep-eq>9</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-021">
      <description>Invalid escape character</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('"bye-b\ye"', map{"liberal":true()})</test>
      <result>
         <assert-deep-eq>"bye-bye"</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-031">
      <description>No quotes in map keyword</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('{a:2, b:3}', map{"liberal":true()})</test>
      <result>
         <assert-deep-eq>map{"a":2, "b":3}</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-032">
      <description>No quotes in map keyword provided it is an NCName and not true|false|null</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('{a:2, -b:3}', map{"liberal":true()})</test>
      <result>
         <error code="FOJS0001"/>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-033">
      <description>No quotes in map keyword provided it is an NCName and not true|false|null</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('{a:2, true:3}', map{"liberal":true()})</test>
      <result>
         <error code="FOJS0001"/>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-034">
      <description>No quotes in map keyword provided it is an NCName and not true|false|null</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('{a:2, false:3}', map{"liberal":true()})</test>
      <result>
         <error code="FOJS0001"/>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-035">
      <description>No quotes in map keyword provided it is an NCName and not true|false|null</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('{a:2, null:3}', map{"liberal":true()})</test>
      <result>
         <error code="FOJS0001"/>
      </result>
   </test-case>
   
   <test-case name="fn-parse-json-liberal-036">
      <description>No quotes in map keyword provided it is an NCName and not true|false|null</description>
      <created by="Michael Kay, Saxonica" on="2017-07-13"/>
      <test>parse-json('{a:2, b-c-d:3}', map{"liberal":true()})</test>
      <result>
         <assert-deep-eq>map{"a":2, "b-c-d":3}</assert-deep-eq>
      </result>
   </test-case>
 

</test-set>
