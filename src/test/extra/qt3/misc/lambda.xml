<?xml version="1.0" encoding="us-ascii"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="lambda">
  <description>Testing the saxon extension syntax: lambda operator</description>
  <dependency type="spec" value="XP40+ XQ40+"/>
  <dependency type="feature" value="higherOrderFunctions"/>

  <environment name="lambda">
    <saxon:property name="http://saxon.sf.net/feature/allowSyntaxExtensions" value="true"
      xmlns:saxon="http://saxon.sf.net/"/>
  </environment>

  <test-case name="lambda-001">
    <description>Simple function expression, simple case, original syntax</description>
    <created by="Michael Kay" on="2017-11-03"/>
    <environment ref="lambda"/>
    <test>deep-equal(filter(1 to 10, ->{. gt 5}), 6 to 10)</test>
    <result>
      <assert-true/>
    </result>
  </test-case>
  
  <test-case name="lambda-002">
    <description>Dot-function expression, simple case, revised syntax</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>deep-equal(filter(1 to 10, ->{. gt 5}), 6 to 10)</test>
    <result>
      <assert-true/>
    </result>
  </test-case>
  
  <test-case name="lambda-003">
    <description>Dot-function expression, context item as node</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>doc('docs/atomic.xml')/*/* => filter(->{@*:attr = 'id1 id2'}) => tokenize()</test>
    <result>
      <assert-deep-eq>"id1", "id2"</assert-deep-eq>
    </result>
  </test-case>
  
  <test-case name="lambda-004">
    <description>Dot-function expression, use as function item without call</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>->{@x} => function-arity()</test>
    <result>
      <assert-eq>1</assert-eq>
    </result>
  </test-case>
  
  <test-case name="lambda-005">
    <description>Dot-function expression, use as function item without call</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>->{@x} instance of function(item()) as item()*</test>
    <result>
      <assert-true/>
    </result>
  </test-case>
  
  <test-case name="lambda-006">
    <description>Dot-function expression, uses closure</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>let $x := 3, $f := ->{. gt $x} return filter(1 to 10, $f)</test>
    <result>
      <assert-deep-eq>4 to 10</assert-deep-eq>
    </result>
  </test-case>
  
  <test-case name="underscore-function-001">
    <description>Underscore-function, arity one</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>_{$1+1}(3)</test>
    <result>
      <assert-eq>4</assert-eq>
    </result>
  </test-case>
  
  <test-case name="underscore-function-002">
    <description>Underscore-function, arity two</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>_{$1+$2}(3, 5)</test>
    <result>
      <assert-eq>8</assert-eq>
    </result>
  </test-case>
  
  <test-case name="underscore-function-003">
    <description>Underscore-function, arity two, reverse order of params</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>_{$2-$1}(3, 5)</test>
    <result>
      <assert-eq>2</assert-eq>
    </result>
  </test-case>
  
  <test-case name="underscore-function-004">
    <description>Underscore-function, arity two, arguments used repeatedly or not at all</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>_{$2+$2}(3, 5)</test>
    <result>
      <assert-eq>10</assert-eq>
    </result>
  </test-case>
  
  <test-case name="underscore-function-005">
    <description>Zero-arity function</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>sum(_{1 to 5}())</test>
    <result>
      <assert-eq>15</assert-eq>
    </result>
  </test-case>
  
  <test-case name="underscore-function-006">
    <description>Underscore function, uses closure</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>let $n := 5, $f := _{$ 1 to $n} return sum($f(4))</test>
    <result>
      <assert-eq>9</assert-eq>
    </result>
  </test-case>
  
  <test-case name="underscore-function-007">
    <description>Numeric variable reference on rhs of lookup operator</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>let $array := [4,5,6], $f := _{$array?$1} return $f(2)</test>
    <result>
      <assert-eq>5</assert-eq>
    </result>
  </test-case>
  
  <test-case name="underscore-function-008">
    <description>Numeric variable reference on rhs of arrow operator</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>let $f := _{8.2 => $1()} return $f(ceiling#1)</test>
    <result>
      <assert-eq>9</assert-eq>
    </result>
  </test-case>
  
  <test-case name="underscore-function-901">
    <description>Numeric param not in an underscore function</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>function($x){$x + $1}(3)</test>
    <result>
      <error code="XPST0003"/>
    </result>
  </test-case>
  
  <test-case name="underscore-function-902">
    <description>Numeric param not in a function</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>$5</test>
    <result>
      <error code="XPST0003"/>
    </result>
  </test-case>
  
  <test-case name="underscore-function-903">
    <description>Numeric param value zero</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>_{$1+$0}(3, 5)</test>
    <result>
      <error code="XPST0003"/>
    </result>
  </test-case>
  
  <test-case name="underscore-function-904">
    <description>Non-integer numeric param value</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>_{$1+$3.5}(3, 5)</test>
    <result>
      <error code="XPST0003"/>
    </result>
  </test-case>
  
  <test-case name="underscore-function-905">
    <description>Numeric param cannot be declared</description>
    <created by="Michael Kay" on="2020-01-02"/>
    <environment ref="lambda"/>
    <test>let $1 := 187 return $1+2</test>
    <result>
      <error code="XPST0003"/>
    </result>
  </test-case>
 
 

</test-set>
