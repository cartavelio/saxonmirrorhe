<?xml version="1.0" encoding="UTF-8"?>
<catalog xmlns="http://www.w3.org/2010/09/qt-fots-catalog" test-suite="FOTS" version="0.6">
  <environment name="empty">
    <!-- The context item MUST be undefined/absent for queries run in this environment. -->
    <!-- The test query will always be an expression, and if necessary an empty context can be achieved by wrapping
             the expression as the body of a function -->
  </environment>

  <!-- EXPATH EXTENSIONS -->
  <!-- The masters for these are on GitHub - these are merely loosely synchronised local copies -->
  <test-set name="expath-file" file="expath/file/file.xml"/>
  <test-set name="expath-binary" file="expath/binary/binary.xml"/>
  <test-set name="expath-binary2" file="expath/binary/binary2.xml"/>
  <test-set name="expath-archive" file="expath/archive/archive.xml"/>
  
  <!-- SAXON-SPECIFIC FUNCTIONALITY IN EXPATH -->
  
  <test-set name="expath-binary-extra" file="expath/binary/binary-extra.xml"/>

  <!-- UCA Collations -->
  <test-set name="UCA-collation" file="UCA/UCA-collation.xml"/>

  <!-- SAXON EXTENSION FUNCTIONS -->
  
  <test-set name="saxon-characters" file="saxonfn/characters.xml"/>
  <test-set name="saxon-decimal-divide" file="saxonfn/decimal-divide.xml"/>
  <test-set name="saxon-doc" file="saxonfn/doc.xml"/>
  <test-set name="saxon-EQName" file="saxonfn/EQName.xml"/>
  <test-set name="saxon-escape-NCName" file="saxonfn/escape-NCName.xml"/>
  <test-set name="saxon-ext-fn" file="saxonfn/ext-fn.xml"/>
  <test-set name="saxon-function-annotations" file="saxonfn/function-annotations.xml"/>
  <test-set name="saxon-get-pseudo-attribute" file="saxonfn/get-pseudo-attribute.xml"/>
  <test-set name="saxon-in-scope-namespaces" file="saxonfn/in-scope-namespaces.xml"/> 
  <test-set name="saxon-index-where" file="saxonfn/index-where.xml"/>
  <test-set name="saxon-is-defaulted-attribute" file="saxonfn/is-defaulted-attribute.xml"/>
  <test-set name="saxon-is-NaN" file="saxonfn/is-NaN.xml"/> 
  <test-set name="saxon-items-after" file="saxonfn/items-after.xml"/>
  <test-set name="saxon-items-before" file="saxonfn/items-before.xml"/>
  <test-set name="saxon-items-from" file="saxonfn/items-from.xml"/>
  <test-set name="saxon-items-until" file="saxonfn/items-until.xml"/>
  <test-set name="saxon-map-search" file="saxonfn/map-search.xml"/>
  <test-set name="saxon-new-attribute" file="saxonfn/new-attribute.xml"/>
  <test-set name="saxon-new-comment" file="saxonfn/new-comment.xml"/>
  <test-set name="saxon-new-document" file="saxonfn/new-document.xml"/>
  <test-set name="saxon-new-element" file="saxonfn/new-element.xml"/>
  <test-set name="saxon-new-processing-instruction" file="saxonfn/new-processing-instruction.xml"/>
  <test-set name="saxon-new-text" file="saxonfn/new-text.xml"/>
  <test-set name="saxon-octets-to-base64Binary" file="saxonfn/octets-to-base64Binary.xml"/>
  <test-set name="saxon-octets-to-hexBinary" file="saxonfn/octets-to-hexBinary.xml"/>
  <test-set name="saxon-parse-dateTime" file="saxonfn/parse-dateTime.xml"/>
  <test-set name="saxon-pedigree" file="saxonfn/pedigree.xml"/>
  <test-set name="saxon-read-binary-resource" file="saxonfn/read-binary-resource.xml"/>
  <test-set name="saxon-replace-with" file="saxonfn/replace-with.xml"/>
  <test-set name="saxon-schema" file="saxonfn/schema.xml"/>
  <test-set name="saxon-timestamp" file="saxonfn/timestamp.xml"/>
  <test-set name="saxon-type" file="saxonfn/type.xml"/>
