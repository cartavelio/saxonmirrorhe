  <test-set name="type-alias" file="misc/type-alias.xml"/>
  <test-set name="union" file="misc/union.xml"/>
  
  <!-- Saxon-specific features in the implementation of standard functions -->
  <test-set name="fn-doc" file="misc/fn-doc.xml"/>
