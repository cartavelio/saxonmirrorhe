<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns="http://www.w3.org/2010/09/qt-fots-catalog" name="UCA-collation"
  xmlns:j="http://www.w3.org/2013/XSL/json">
  <description>Tests for Unicode Collation Algorithm features. These tests check mainly the
    operation of the parametric controls for the UCA, rather than the UCA details themselves (such
    as the correct ordering of characters within a plethora of different locales) on the assumption
    that an implementation will use an already established and well tested UCA implementation (e.g.
    ICU) to 'do the work'. To test the UCA details themselves, the reader is referred to "UCA
    Conformance Tests" at http://www.unicode.org/Public/UCA/latest/CollationTest.html. Note the
    tests are written on the assumption that the "working directory" for resolving relative
    filenames (if any) is the directory containing this test catalog file. </description>
  
  <link type="spec" document="http://www.w3.org/TR/2013/WD-xslt-30-20131212/#uca-collations"/>
  <dependency type="spec" value="XP30+"/>


  <environment name="UCA-collation">
    <param name="collation" select="'http://www.w3.org/2013/collation/UCA?'"/>
  </environment>
  <environment name="UCA-collation.en">
    <param name="collation" select="'http://www.w3.org/2013/collation/UCA?lang=en;'"/>
  </environment>
  <environment name="UCA-collation.en.primary">
    <param name="collation"
      select="'http://www.w3.org/2013/collation/UCA?lang=en;strength=primary;'"/>
  </environment>


  <expand name="UCA-collation">
    <created by="John Lumley" on="2014-05-02"/>
    <environment ref="UCA-collation"/>

    <test-case UCA="unknown fallback" a="abc" b="aBC" error="FOCH0002" keys="fallback=unknown"/>
    <test-case UCA="unknown keyword" a="abc" b="aBC" error="FOCH0002"
      keys="fallback=no;keyword=unknown"/>
    <test-case UCA="unknown strength" a="abc" b="aBC" error="FOCH0002"
      keys="fallback=no;strength=unknown"/>
    <test-case UCA="unknown alternate" a="abc" b="aBC" error="FOCH0002"
      keys="fallback=no;alternate=unknown"/>
    <test-case UCA="unknown backwards" a="abc" b="aBC" error="FOCH0002"
      keys="fallback=no;backwards=unknown"/>
    <test-case UCA="unknown normalization" a="abc" b="aBC" error="FOCH0002"
      keys="fallback=no;normalization=unknown"/>
    <test-case UCA="unknown caseLevel" a="abc" b="aBC" error="FOCH0002"
      keys="fallback=no;caseLevel=unknown"/>
    <test-case UCA="unknown caseFirst" a="abc" b="aBC" error="FOCH0002"
      keys="fallback=no;caseFirst=unknown"/>
    <test-case UCA="unknown hiraganaQuaternary" a="abc" b="aBC" error="FOCH0002"
      keys="fallback=no;hiraganaQuaternary=unknown"/>
    <test-case UCA="unknown numeric" a="abc" b="aBC" error="FOCH0002"
      keys="fallback=no;numeric=unknown"/>


    <test-case UCA="unknown keyword - lax" a="abc" b="aBC" result="-1" keys="keyword=unknown"/>
    <test-case UCA="unknown strength - lax" a="abc" b="aBC" result="-1" keys="strength=unknown"/>
    <test-case UCA="unknown alternate - lax" a="abc" b="aBC" result="-1" keys="alternate=unknown"/>
    <test-case UCA="unknown backwards - lax" a="abc" b="aBC" result="-1" keys="backwards=unknown"/>
    <test-case UCA="unknown normalization - lax" a="abc" b="aBC" result="-1"
      keys="normalization=unknown"/>
    <test-case UCA="unknown caseLevel - lax" a="abc" b="aBC" result="-1" keys="caseLevel=unknown"/>
    <test-case UCA="unknown caseFirst - lax" a="abc" b="aBC" result="-1" keys="caseFirst=unknown"/>
    <test-case UCA="unknown hiraganaQuaternary - lax" a="abc" b="aBC" result="-1"
      keys="hiraganaQuaternary=unknown"/>
    <test-case UCA="unknown numeric - lax" a="abc" b="aBC" result="-1" keys="numeric=unknown"/>

    <test-case UCA="version" a="abc" b="aBC" result="-1" keys="version=5.0"/>
    <test-case UCA="version" a="abc" b="aBC" result="-1" keys="version=6.0"/>
    <test-case UCA="version" a="abc" b="aBC" error="FOCH0002" keys="version=7.0"/>
    <test-case UCA="version" a="abc" b="aBC" error="FOCH0002" keys="version=unknown"/>
  </expand>

  <expand name="UCA-reorder-codes">
    <created by="John Lumley" on="2014-05-02"/>
    <environment ref="UCA-collation.en.primary"/>

    <test-case UCA="Reorder with unknown code - error" a=".123" b="123" error="FOCH0002"
      keys="fallback=no;reorder=Z,digit"/>
    <test-case UCA="Reorder with unknown code - lax" a=".123" b="123" result="-1" keys="reorder=Z,digit"/>
    <test-case UCA="Reorder with unknown code - fallback" a=".123" b="123" result="-1" keys="fallback=yes;reorder=Z,digit"/>

    <test-case UCA="Reorder reorder=punct,digit" a=".123" b="123" result="-1" keys="reorder=punct,digit"/>
    <test-case UCA="Reorder reorder=digit,punct" a=".123" b="123" result="1" keys="reorder=digit,punct"/>
    <test-case UCA="Reorder reorder=space,digit" a=" 123" b="123" result="-1" keys="reorder=space,digit"/>
    <test-case UCA="Reorder reorder=digit,space" a=" 123" b="123" result="1" keys="reorder=digit,space"/>
    <test-case UCA="Reorder reorder=currency,digit" a="£123" b="123" result="-1"
      keys="reorder=currency,digit"/>
    <test-case UCA="Reorder reorder=digit,currency" a="£123" b="123" result="1"
      keys="reorder=digit,currency"/>

    <test-case UCA="Reorder reorder=Latn,digit" a="a123" b="123" result="-1" keys="reorder=Latn,digit"/>
    <test-case UCA="Reorder reorder=digit,Latn" a="a123" b="123" result="1" keys="reorder=digit,Latn"/>
  </expand>

  <expand name="UCA-params">
    <created by="John Lumley" on="2014-05-02"/>
    <environment ref="UCA-collation.en"/>


    <test-case UCA="strength Primary" a="abc" b="aBC" result="0" keys="strength=primary"/>
    <test-case UCA="strength Secondary" a="abc" b="aBC" result="0" keys="strength=secondary"/>
    <test-case UCA="strength Tertiary" a="abc" b="aBC" result="-1" keys="strength=tertiary"/>
    <test-case UCA="strength Quaternary" a="abc" b="aBC" result="-1" keys="strength=quaternary"/>
    <test-case UCA="strength Identical" a="abc" b="aBC" result="-1" keys="strength=identical"/>

    <test-case UCA="strength 1" a="abc" b="aBC" result="0" keys="strength=1"/>
    <test-case UCA="strength 2" a="abc" b="aBC" result="0" keys="strength=2"/>
    <test-case UCA="strength 3" a="abc" b="aBC" result="-1" keys="strength=3"/>
    <test-case UCA="strength 4" a="abc" b="aBC" result="-1" keys="strength=4"/>
    <test-case UCA="strength 5" a="abc" b="aBC" result="-1" keys="strength=5"/>

    <test-case UCA="Ignore punctuation - primary" a="a-bc" b="abc" result="0"
      keys="strength=1;alternate=shifted"/>
    <test-case UCA="Ignore punctuation - secondary" a="a-bc" b="abc" result="0"
      keys="strength=2;alternate=shifted"/>
    <test-case UCA="Ignore punctuation - tertiary" a="a-bc" b="abc" result="0"
      keys="strength=3;alternate=shifted"/>
    <test-case UCA="Ignore punctuation - quaternary" a="a-bc" b="abc" result="-1"
      keys="strength=4;alternate=shifted"/>
    <test-case UCA="Ignore punctuation - identical" a="a-bc" b="abc" result="-1"
      keys="strength=5;alternate=shifted"/>

    <test-case UCA="Check not backwards - primary" a="pêche" b="péché" result="0" keys="strength=primary"/>
    <test-case UCA="Check not backwards - secondary" a="pêche" b="péché" result="1" keys="strength=secondary"/>
    <test-case UCA="Check backwards - primary" a="pêche" b="péché" result="-1"
      keys="strength=secondary;backwards=yes"/>
    <test-case UCA="Check backwards - secondary" a="pêche" b="péché" result="1"
      keys="strength=secondary;backwards=no"/>

    <test-case UCA="Check normalization - no" a="pêche" b="péché" result="1"
      keys="strength=secondary;normalization=no"/>
    <test-case UCA="Check normalization - yes" a="pêche" b="péché" result="1"
      keys="strength=secondary;normalization=yes"/>

    <test-case UCA="Check caseLevel - primary" a="Epee" b="épee" result="1" keys="strength=primary;caseLevel=yes"/>
    <test-case UCA="Check caseLevel - primary" a="Epee" b="épee" result="0" keys="strength=primary;caseLevel=no"/>
    <test-case UCA="Check caseLevel - primary" a="Epee" b="Épee" result="0" keys="strength=primary;caseLevel=yes"/>
    <test-case UCA="Check caseLevel - primary" a="Epee" b="Épee" result="0" keys="strength=primary;caseLevel=no"/>
    <test-case UCA="Check caseLevel - secondary - no effect" a="Epee" b="épee" result="-1" keys="strength=secondary;caseLevel=yes"/>
    <test-case UCA="Check caseLevel - secondary - no effect" a="Epee" b="épee" result="-1" keys="strength=secondary;caseLevel=no"/>
    <test-case UCA="Check caseLevel - secondary - no effect" a="Epee" b="Épee" result="-1" keys="strength=secondary;caseLevel=yes"/>
    <test-case UCA="Check caseLevel - secondary - no effect" a="Epee" b="Épee" result="-1" keys="strength=secondary;caseLevel=no"/>

    <test-case UCA="Check caseFirst - upper" a="ab" b="Ab" result="1" keys="caseFirst=upper"/>
    <test-case UCA="Check caseFirst - lower" a="ab" b="Ab" result="-1" keys="caseFirst=lower"/>

    <test-case UCA="Check numeric - yes" a="ab1a" b="ab12a" result="-1" keys="numeric=yes"/>
    <test-case UCA="Check numeric - no" a="ab1a" b="ab12a" result="1" keys="numeric=no"/>
  </expand>

  <expand name="UCA-misc-lang">
    <created by="John Lumley" on="2014-05-02"/>
    <environment ref="UCA-collation"/>

    <test-case UCA="Check fr accent - primary" a="pêche" b="péché" result="0" keys="strength=primary;lang=fr"/>
    <test-case UCA="Check fr accent - secondary" a="pêche" b="péché" result="1"
      keys="strength=secondary;lang=fr"/>
    <test-case UCA="Check fr-CA accent - secondary" a="pêche" b="péché" result="-1"
      keys="strength=secondary;lang=fr-CA"/>

    <test-case UCA="Check en-US accent - primary" a="pêche" b="péché" result="0" keys="strength=primary;lang=en-US"/>

  </expand>

 <!-- <?include ../../john/collate/qt3.xml?>-->

</test-set>
