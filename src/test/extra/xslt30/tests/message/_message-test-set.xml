<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
   name="message">
   <description>Tests Saxon extensions on xsl:message</description>
   
   <test-case name="message-001">
      <description>Tests xsl:message with saxon:time="yes</description>
      <created by="Michael Kay" on="2016-09-19"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="message-001.xsl"/>
      </test>
      <result>
         <assert-message>
            <assert>matches(., "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3} - One$")</assert>
         </assert-message>
      </result>
   </test-case>
   
   <test-case name="message-001b">
      <description>Tests xsl:message with saxon:time="yes</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="message-001.xsl"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   
   <test-case name="message-002">
      <description>Tests xsl:message with saxon:message-count()</description>
      <created by="Michael Kay" on="2016-09-19"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="message-002.xsl"/>
      </test>
      <result>
         <all-of>
            <assert>/out/counts/@one = '2'</assert>
            <assert>/out/counts/@two = '1'</assert>
            <assert>/out/counts/@three = '1'</assert>
            <assert>/out/counts/@four = '0'</assert>
            <assert>/out/counts/@all = '4'</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="message-002b">
      <description>Tests xsl:message with saxon:message-count()</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="message-002.xsl"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
 
</test-set>