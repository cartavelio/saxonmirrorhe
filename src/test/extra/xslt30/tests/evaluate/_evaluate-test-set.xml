   <test-case name="evaluate-010">
      <description>test call on format-number() and other functions within saxon:evaluate.</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <modified by="Michael Kay" on="2022-03-22" make the called function have public visibility: see bug 5402"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="evaluate-010.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out xmlns:saxon="http://saxon.sf.net/"><a>true</a><a>ab</a><a>1</a><a>3</a><a>25</a><a>5</a></out>]]></assert-xml>
      </result>
   </test-case>

   <test-case name="evaluate-011">
      <description>saxon:evaluate() doesn't use the default namespace</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <environment>
         <source role="." file="evaluate-011.xml"/>
      </environment>
      <test>
         <stylesheet file="evaluate-011.xsl"/>
      </test>
      <result>
         <assert-xml><![CDATA[<html xmlns="http://www.w3.org/1999/xhtml"><head><meta name="Contributor" content="Fred"/><title>test</title></head
            ><body><p>normal xpath/xslt : Saxon is great</p><p>evaluate : Saxon is great</p><p>evaluate without namespaces : Saxon is great</p></body></html>]]></assert-xml>
      </result>
   </test-case>

