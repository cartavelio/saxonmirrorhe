   <test-case name="evaluate-009">
      <description>test call on polymorphic extension functuion occurring within saxon:evaluate. Bug 2859861</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
