<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="evaluate">
   <description>Tests the saxon:evaluate(), saxon:eval(), and saxon:expression() extension functions</description>

   <test-case name="evaluate-001">
      <description>Test saxon:expression() extension function, with an argument that is a string literal containing a call to a stylesheet function. See bug 1952318</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <modified by="Michael Kay" on="2022-03-22" make the called function have public visibility: see bug 5402"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="evaluate-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out>42</out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="evaluate-001b">
      <description>Test saxon:expression() extension function.</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="evaluate-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>

