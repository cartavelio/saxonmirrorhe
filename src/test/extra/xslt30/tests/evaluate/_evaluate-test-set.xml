   <test-case name="evaluate-004">
      <description>A more complex test of saxon:evaluate() with multiple variables. Test was formerly saxon076</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <environment>
         <source role="." file="evaluate-004.xml"/>
      </environment>
      <test>
