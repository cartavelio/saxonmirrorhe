      </result>
   </test-case>

   <test-case name="evaluate-006">
      <description>Test availability of functions within saxon:evaluate(). Test was formerly saxon083.</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
