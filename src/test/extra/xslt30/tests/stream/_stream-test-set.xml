<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="stream">
   <description>Tests saxon:stream() extension function (originally xsl:copy-of saxon:read-once="yes")</description>
   
   <environment name="overlapping">
      <source uri="overlapping.xml" file="overlapping.xml" streaming="true"/>
   </environment>
   
   <environment name="sections">
      <source file="sections.xml" uri="sections.xml" streaming="true">
         <description>Hierarchically nested content (sections within sections)</description>
      </source>
   </environment>
   
   <test-case name="stream-001">
      <description>Very basic Test of xsl:copy-of read-once="yes".</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <feature value="Saxon-EE"/>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="serial-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out>8</out>]]></assert-xml>
      </result>
   </test-case>
   
