<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="optimizer">
   <description>Tests optimization. Depends on optimization assertions in the exceptions.xml file</description>
   <environment name="opt001">
      <source role="." file="opt001.xml"/>
   </environment>
   <dependencies>
      <feature value="schema_aware"/>
   </dependencies>

   <test-case name="opt-001">
      <description>test promotion of independent subexpressions within a filter expression</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment ref="opt001"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="opt-001.xsl"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><section nr="2"/></out>]]></assert-xml>
      </result>
   </test-case>

