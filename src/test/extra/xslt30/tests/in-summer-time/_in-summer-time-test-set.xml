<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="in-summer-time">
   <description>Tests saxon-in-summer-time()</description>

   <test-case name="in-summer-time-001">
      <description>Test saxon:in-summer-time() extension function</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="in-summer-time-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out>
   <a>false</a>
   <b>true</b>
   <c>false</c>
   <d>true</d>
   <e>false</e>
   <f>true</f>
   <g>false</g>
   <h>false</h>
</out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="in-summer-time-001b">
      <description>Test saxon:in-summer-time() extension function</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="in-summer-time-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>

   <test-case name="in-summer-time-002">
      <description>Test saxon:adjust-to-civil-time() extension function</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="in-summer-time-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <all-of>
            <assert>/out/a = "2008-01-14T00:00:00Z"</assert>
            <assert>/out/b = "2008-01-13T21:00:00-08:00"</assert>
            <assert>/out/c = "2008-01-14T01:00:00+01:00"</assert>
            <assert>/out/d = "2008-01-13T19:00:00-05:00"</assert>
            <assert>/out/e = "2008-07-14T02:00:00+02:00"</assert>
            <assert>/out/f = "2008-07-13T20:00:00-04:00"</assert>
            <assert>starts-with(/out/g, "1066-07-13T19:")</assert>
            <!-- (g) is hilarious, but Java gives 1066-07-13T19:04:00-04:56. 
                     Presumably its the difference between solar time in NY and clock time in Greenwich. -->
            <assert>/out/h = "2008-07-14T00:00:00Z"</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="in-summer-time-002b">
      <description>Test saxon:adjust-to-civil-time() extension function</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="in-summer-time-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
</test-set>
