          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="ExsltDate">
   <description>Tests ExsltDate</description>
   <environment name="ExsltDate001">
      <source role=".">
         <content><![CDATA[<doc/>]]></content>
      </source>
   </environment>
   
   <dependencies>
      <saxon:platform value="J" xmlns:saxon="http://saxon.sf.net/"/>
   </dependencies>

   <test-case name="ExsltDate-001">
      <description>Exslt date/time extensions</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment ref="ExsltDate001"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="ExsltDate-001.xsl"/>
      </test>
      <result>
         <assert-xml file="ExsltDate-001.out"/>
      </result>
   </test-case>
   
   <test-case name="ExsltDate-001b">
      <description>Exslt date/time extensions</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <environment ref="ExsltDate001"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="ExsltDate-001.xsl"/>
      </test>
      <result>
         <error code="XTDE1425"/>
      </result>
   </test-case>

