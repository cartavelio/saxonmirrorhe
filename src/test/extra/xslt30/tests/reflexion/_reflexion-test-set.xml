<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          xmlns:saxon="http://saxon.sf.net/"
          name="reflexion">
   <description>Tests reflexive calls to Java extension functions</description>
   
   <dependencies>
      <spec value="XSLT20+"/>
      <saxon:edition value="PE EE"/>
      <saxon:platform value="J"/>
   </dependencies>

   <test-case name="reflexion-001">
      <description>test adjustment of required type: bug 3800</description>
      <created by="Michael Kay" on="2018-05-30"/>
      <test>
         <stylesheet file="reflexion-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<test>jar</test>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="reflexion-001b">
      <description>test adjustment of required type: bug 3800</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <saxon:edition value="HE"/>
      </dependencies>
      <test>
         <stylesheet file="reflexion-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   
   <test-case name="reflexion-002">
      <description>test adjustment of required type: bug 3800</description>
      <created by="Michael Kay" on="2018-05-30"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="reflexion-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<test>1</test>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="reflexion-002b">
      <description>test adjustment of required type: bug 3800</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <saxon:edition value="HE"/>
      </dependencies>
      <test>
         <stylesheet file="reflexion-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>


</test-set>
