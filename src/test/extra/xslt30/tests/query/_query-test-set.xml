<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="query">
   <description>Tests the saxon:compile-query() and saxon:query() extension functions</description>

   <test-case name="query-001">
      <description>test saxon:compile-query() and saxon:query()</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="query-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<result><z>38</z></result>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="query-001b">
      <description>test saxon:compile-query() and saxon:query(), when not available</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="query-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>

   <test-case name="query-002">
      <description>test saxon:compile-query() and saxon:query() inheriting the context item implicitly</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="query-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<result><a><z>2</z></a><a><z>3</z></a><a><z>4</z></a><a><z>5</z></a><a><z>6</z></a></result>]]></assert-xml>
      </result>
   </test-case>
   
