   <test-case name="type-alias-050">
      <description>JSON inversion use case</description>
      <created by="Michael Kay" on="2020-01-28"/>
      <environment>
         <saxon:property name="http://saxon.sf.net/feature/allowSyntaxExtensions" value="true" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="type-alias-050.xsl"/>
         <output tree="no"/>
      </test>
      <result>
         <all-of>
            <assert-type>array(map(*))</assert-type>
            <assert>?1?email = "ann_jones@gmail.com"</assert>
            <assert>deep-equal(?1?courses, ["English", "History"])</assert>
            <assert>?2?email = "amisha_patel@gmail.com"</assert>
            <assert>?3?email = "anil_singh@gmail.com"</assert>
            <assert>?4?email = "mary_smith@gmail.com"</assert>
            <assert>?5?email = "john_taylor@gmail.com"</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="tuple-type-100">
      <description>Tuple type as subtype of map type</description>
      <created by="Michael Kay" on="2020-01-25"/>
      <environment>
         <saxon:property name="http://saxon.sf.net/feature/allowSyntaxExtensions" value="true" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="tuple-type-100.xsl"/>
         <param name="M" static="true" select="'map(xs:string, xs:integer)'"/>
         <param name="T" static="true" select="'tuple(n as xs:integer)'"/>
         <param name="V" select="map{'n': 1}"/>
      </test>
      <result>
         <assert>/out</assert>
      </result>
   </test-case>
   
