<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="transform">
   <description>Tests the saxon:compile-stylesheet() and saxon:transform() extension functions,
   and Saxon extensions to fn:transform()</description>

   <test-case name="transform-001">
      <description>Test saxon:compile-stylesheet() and saxon:transform() supplying a parameter.</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="transform-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<result><out>61</out></result>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="transform-001b">
      <description>Test saxon:compile-stylesheet() and saxon:transform() supplying a parameter.</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="transform-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   
   <test-case name="transform-002">
      <description>Test saxon:compile-stylesheet() and saxon:transform() not supplying a parameter.</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="transform-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<result><out>42</out></result>]]></assert-xml>
      </result>
   </test-case>

   <test-case name="transform-002b">
      <description>Test saxon:compile-stylesheet() and saxon:transform() not supplying a parameter.</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="transform-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>

   <test-case name="transform-003">
      <description>Test saxon:transform() supplying parameters as a map.</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="transform-003.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<result><out>122</out></result>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="transform-003b">
      <description>Test saxon:transform() supplying parameters as a map.</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="transform-003.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   
   <test-case name="transform-100">
      <description>Test fn:transform() with a configuration file dependent on base URI.</description>
      <created by="Michael Kay" on="2020-03-02"/>
      <dependencies>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="transform-100.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<baa/>]]></assert-xml>
      </result>
   </test-case>
</test-set>
