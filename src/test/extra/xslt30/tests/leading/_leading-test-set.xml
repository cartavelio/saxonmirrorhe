<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="leading">
   <description>Tests saxon:leading() extension function</description>

   <test-case name="leading-001">
      <description>Test saxon:leading() extension function</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment>
         <source role="." file="leading-001.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="leading-001.xsl"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out xmlns:saxon="http://saxon.sf.net/">
   <chapter title="chapter 1">
      <p>some text</p>
      <p>some more text</p>
      <p>and yet more</p>
   </chapter>
   <chapter title="chapter 2">
      <p>rhubarb</p>
      <p>custard</p>
      <p>whipped cream</p>
   </chapter>
</out>
]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="leading-001b">
      <description>Test saxon:leading() extension function</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <environment>
         <source role="." file="leading-001.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="leading-001.xsl"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>


</test-set>
