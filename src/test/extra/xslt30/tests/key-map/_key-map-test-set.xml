<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="key-map">
   <description>Tests key-map</description>

   <test-case name="key-map-001">
      <description>Test saxon:key-map() extension function</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <modified by="Debbie Lockett" on="2015-11-06" change="Update map syntax in stylesheet"/>
      <dependencies>
         <feature value="Saxon-EE"/>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="key-map-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <all-of>
            <assert>/out/a = "4"</assert>
            <assert>/out/b = "2006-02-13,2006-02-15,2006-02-16,2006-02-17,2006-02-20,2006-02-21,2006-02-22,2006-02-23"</assert>
            <assert>/out/c = "2006-02-20,2006-02-21,2006-02-22,2006-02-23,2006-02-24,2006-02-25,2006-02-26"</assert>
            <assert>deep-equal(/out/d/transaction/@value/xs:decimal(.), (-5.00, 8.99, 16.00, -2.33, 5.60, 4.32))</assert>
            <assert>/out/e = "happy new century"</assert>
            <assert>deep-equal(/out/f/group/count(*), (1, 1, 1, 3))</assert>
            <assert>deep-equal(/out/g/transaction/@value/xs:decimal(.), (-5.00, 8.99, -2.33, 5.60, 4.32))</assert>           
            <assert>/out/h = "2006-02-20=(-5.00) 2006-02-21=(8.99) 2006-02-22=(16.00) 2006-02-23=(-2.33+5.60+4.32)"</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="key-map-001b">
      <description>Test saxon:key-map() extension function</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <feature value="Saxon-EE" satisfied="false"/>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="key-map-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
</test-set>
