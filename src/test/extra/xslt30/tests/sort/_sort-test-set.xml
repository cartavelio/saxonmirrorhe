<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="sort">
   <description>Tests sort. Tests rewritten May 2017 to use fn:sort rather than fn:sort</description>

   <test-case name="sort-001">
      <description>test fn:sort() on atomic values</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="sort-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<z xmlns="http://www.w3.org/1999/xhtml"
            ><out>0 2 4 5 8 9</out><out>0.1 2.2 4.5 5.6 8.1 9.7</out><out>ert wgh x yh</out></z>]]></assert-xml>
      </result>
   </test-case>

   <test-case name="sort-002">
      <description>test fn:sort() on nodes</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="sort-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<z xmlns="http://www.w3.org/1999/xhtml"
            ><out><b>103</b><a>92</a><c>africa</c><d>europe</d></out></z>]]></assert-xml>
      </result>
   </test-case>

   <test-case name="sort-003">
      <description>test fn:sort() on nodes using a system function to compute sort key</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="sort-003.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<z xmlns="http://www.w3.org/1999/xhtml"
            ><out><a>92</a><b>103</b><d>asia</d><c>africa</c><d>europe</d></out></z>]]></assert-xml>
      </result>
   </test-case>

   <test-case name="sort-004">
      <description>test fn:sort() on nodes using a user-defined function to compute sort key</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="sort-004.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<z><out><a>92</a><b>103</b><c>africa</c><d>asia</d><d>europe</d></out></z>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="sort-005">
      <description>test fn:sort() on nodes using a user-defined function to compute sort key</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment>
         <source role="." file="sort-005.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="sort-005.xsl"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><item price="1.10">
oranges
</item><item price="1.50">
lemons
</item></out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="sort-006">
      <description>test fn:sort() on nodes using a user-defined function to compute sort key</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="sort-006.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<z xmlns="http://www.w3.org/1999/xhtml"
            ><out><d>$34.00</d><a>$92.00</a><b>$103.22</b><c>$127.35 </c></out></z>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="sort-010">
      <description>
         Test xsl:sort-key with different languages. Sorting differences in Swedish.
      </description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <environment>
         <source role="." file="sort010.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="sort-010.xsl"/>
      </test>
      <result>
         <assert-xml><![CDATA[<result><out lang="en">Ö,Z</out><out lang="de">Ö,Z</out><out lang="sv">Z,Ö</out></result>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="sort-011">
      <description>
         Test xsl:sort-key with different languages. Sorting differences in Swedish.
      </description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <environment>
         <source role="." file="sort011.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="sort-010.xsl"/>
      </test>
      <result>
         <assert-xml><![CDATA[<result><out lang="en">a,ä,b,B,c,C,K,ö,r,t,u,U,V,V,x,X,z</out><out lang="de">a,ä,b,B,c,C,K,ö,r,t,u,U,V,V,x,X,z</out><out lang="sv">a,b,B,c,C,K,r,t,u,U,V,V,x,X,z,ä,ö</out></result>]]></assert-xml>
      </result>
   </test-case>
</test-set>
