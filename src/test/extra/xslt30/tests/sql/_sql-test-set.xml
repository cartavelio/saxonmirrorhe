   <test-case name="sql-fn-004">
      <description>SQL query results as JSON</description>
      <created by="Michael Kay" on="2017-11-22"/>
      <environment ref="sqlf-001"/>
      <dependencies>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <initial-template name="test-004"/>
      </test>
      <result>
         <all-of>
            <assert>/out/@rows = '2'</assert>
            <assert>contains(/out,  '"AUTHOR":"Danzig"')
            or contains(/out,  '"author":"Danzig"')</assert>
