<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog" name="sql">
  <description>Tests sql</description>

  <!-- You can configure different driver/database combinations. At the
       time of this writing, the build scripts can stand up either
       a PostgreSQL database:

         <param name="driver" select="'org.postgresql.Driver'"/>
         <param name="database" select="'jdbc:postgresql://localhost/sample'"/>

       or a MySQL database:

          <param name="driver" select="'com.mysql.cj.jdbc.Driver'"/>
          <param name="database"  select="'jdbc:mysql://localhost/sample?generateSimpleParameterMetadata=true'"/>

       Neither driver passes test sql-005 because of namespace differences
       in the output.
  -->

  <environment name="sql001">
    <source role="." file="sql-001.xml"/>
    <stylesheet file="Jsql-001.xsl"/>
    <param name="driver" select="'org.postgresql.Driver'"/>
    <param name="database" select="'jdbc:postgresql://localhost/sample'"/>
<!--
    <param name="driver" select="'com.mysql.cj.jdbc.Driver'"/>
    <param name="database"  select="'jdbc:mysql://localhost/sample?generateSimpleParameterMetadata=true'"/>
-->
    <saxon:property name="http://saxon.sf.net/feature/allow-multithreading"
                    value="false" xmlns:saxon="http://saxon.sf.net/"/>
  </environment>

   <!--
     MHK 2020-03-10
     To investigate the database interactively from the terminal:

     >cd to the xslt30extra/10.0 directory
     >~/repo/lib/db-derby-10.14.2.0-bin/bin/ij
     (responds: ij version 10.14)
     ij> connect 'jdbc:derby:test-db-001';
     ij> select * from JWL.book;

   -->

   <environment name="osql001">
     <source role="." file="sql-001.xml"/>
    <param name="driver" select="'org.postgresql.Driver'"/>
    <param name="database" select="'jdbc:postgresql://localhost/sample'"/>
<!--
    <param name="driver" select="'com.mysql.cj.jdbc.Driver'"/>
    <param name="database"  select="'jdbc:mysql://localhost/sample?generateSimpleParameterMetadata=true'"/>
-->
     <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
   </environment>

   <environment name="sqlf-001">
     <source role="." file="sql-001.xml"/>
     <stylesheet file="sql-fn-001.xsl"/>
    <param name="driver" select="'org.postgresql.Driver'"/>
    <param name="database" select="'jdbc:postgresql://localhost/sample'"/>
<!--
    <param name="driver" select="'com.mysql.cj.jdbc.Driver'"/>
    <param name="database"  select="'jdbc:mysql://localhost/sample?generateSimpleParameterMetadata=true'"/>
-->
     <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
   </environment>

   <dependencies>
     <feature value="Saxon-PE"/>
   </dependencies>

   <test-case name="Jsql-001">
      <description>Test SQL extension elements - building a database and simple
         insertion</description>
      <created by="John Lumley" on="2014-08-15"/>
      <environment ref="sql001"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <initial-template name="test-001"/>
         <output form="raw"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out>Inserted 8 records.</out>]]></assert-xml>
      </result>
   </test-case>

