<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
   name="path">
   <description>Tests saxon:path</description>
   
   <test-case name="path-026">
      <description>Tests saxon:path (was saxon-026 in "original" test suite)</description>
      <created by="Michael Kay" on="2018-11-16"/>
      <environment>
         <source role="." file="path026.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="path026.xsl"/>
      </test>
      <result>
         <assert-xml file="path026.out"/>
      </result>
   </test-case>
   
   <test-case name="path-026b">
      <description>Tests saxon:path; when not available</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <environment>
         <source role="." file="path026.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="path026.xsl"/>
      </test>
      <result>
         <error code="XTDE1425"/>
      </result>
   </test-case>
 
</test-set>