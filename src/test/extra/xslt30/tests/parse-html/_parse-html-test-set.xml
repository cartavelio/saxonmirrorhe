<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="parse-html">
   <description>Tests saxon:parse-html() extension function</description>

   <test-case name="parse-html-001">
      <description>Test saxon:parse-html()</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="parse-html-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <all-of>
            <assert>namespace-uri(/out/*:html) = "http://www.w3.org/1999/xhtml"</assert>
            <assert>exists(/out/Q{http://www.w3.org/1999/xhtml}html/Q{http://www.w3.org/1999/xhtml}body/Q{http://www.w3.org/1999/xhtml}p)</assert>
            <assert>string(//*:p) eq "Some text second line"</assert>
            <assert>//*:p/node()[2][self::Q{http://www.w3.org/1999/xhtml}br]</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="parse-html-001b">
      <description>Test saxon:parse-html()</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="parse-html-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
</test-set>
