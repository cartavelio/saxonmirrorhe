<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
   name="assign">
   <description>Tests assign</description>
   
   <test-case name="assign-001">
      <description>Combines saxon:assign with recursion</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment>
         <source role="." file="assign-001.xml"/>
         <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="assign-001.xsl"/>
      </test>
      <result>
         <assert>normalize-space(/out) = "Extensibility and Reuse de"</assert>
      </result>
   </test-case>
   
   <test-case name="assign-001b">
      <description>Combines saxon:assign with recursion</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <environment>
         <source role="." file="assign-001.xml"/>
         <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="assign-001.xsl"/>
      </test>
      <result>
         <error code="XTDE1450"/>
      </result>
   </test-case>
   
   <test-case name="assign-002">
      <description>Combines saxon:assign with xsl:iterate</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment>
         <source role="." file="assign-002.xml"/>
         <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="assign-002.xsl"/>
      </test>
      <result>
         <assert>/doc = "これは番号なしリストです．"</assert>
      </result>
   </test-case>
   
   <test-case name="assign-002b">
      <description>Combines saxon:assign with xsl:iterate</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <environment>
         <source role="." file="assign-002.xml"/>
         <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="assign-002.xsl"/>
      </test>
      <result>
         <error code="XTDE1450"/>
      </result>
   </test-case>
   
   <test-case name="assign-003">
      <description>Combines saxon:assign with saxon:while</description>
      <created by="Michael Kay" on="2016-06-15"/>
      <environment>
         <source role="." file="assign-001.xml"/>
         <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="assign-003.xsl"/>
      </test>
      <result>
         <assert>/out = "|2|4|8|16|32|64|128|256|512|1024|2048|4096|8192|16384|32768|65536|131072|262144|524288|1048576|2097152"</assert>
      </result>
   </test-case>
   
   <test-case name="assign-003b">
      <description>Combines saxon:assign with saxon:while</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <environment>
         <source role="." file="assign-001.xml"/>
         <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="assign-003.xsl"/>
      </test>
      <result>
         <error code="XTDE1450"/>
      </result>
   </test-case>
   
   <test-case name="assign-004">
      <description>Variant of assign-003 with forwards references to the variable declaration</description>
      <created by="Michael Kay" on="2018-08-17"/>
      <environment>
         <source role="." file="assign-001.xml"/>
         <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="assign-003.xsl"/>
      </test>
      <result>
         <assert>/out = "|2|4|8|16|32|64|128|256|512|1024|2048|4096|8192|16384|32768|65536|131072|262144|524288|1048576|2097152"</assert>
      </result>
   </test-case>
   
   <test-case name="assign-005">
      <description>Assigned value is atomized based on declared type</description>
      <created by="Michael Kay" on="2021-08-27"/>
      <environment>
         <source role="." file="assign-001.xml"/>
         <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="assign-005.xsl"/>
      </test>
      <result>
         <assert>/out = "true"</assert>
      </result>
   </test-case>
   
   <test-case name="assign-006">
      <description>Assigned value is incompatible with declared type</description>
      <created by="Michael Kay" on="2021-08-27"/>
      <environment>
         <source role="." file="assign-001.xml"/>
         <saxon:property name="http://saxon.sf.net/feature/allow-multithreading" value="false" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="assign-006.xsl"/>
      </test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>
</test-set>