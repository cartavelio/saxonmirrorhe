<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="current-mode-name">
   <description>Tests current-mode-name</description>

   <test-case name="current-mode-name-001">
      <description>Test saxon:current-mode-name() extension function</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment>
         <source role="." file="current-mode-name-001.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="current-mode-name-001.xsl"/>
      </test>
      <result>
         <assert-xml file="current-mode-name-001.out"/>
      </result>
   </test-case>
   
   <test-case name="current-mode-name-001b">
      <description>Test saxon:current-mode-name() extension function</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <environment>
         <source role="." file="current-mode-name-001.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="current-mode-name-001.xsl"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   
   <test-case name="current-mode-name-002">
      <description>Test saxon:current-mode-name() extension function</description>
      <created by="Michael Kay" on="2016-11-29"/>
      <environment>
         <source role="." file="current-mode-name-001.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="current-mode-name-002.xsl"/>
      </test>
      <result>
         <assert>count(/out/chap/ok) = 18</assert>
      </result>
   </test-case>
</test-set>
