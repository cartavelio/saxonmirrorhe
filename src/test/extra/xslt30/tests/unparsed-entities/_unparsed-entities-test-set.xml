<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="unparsed-entities">
   <description>Tests saxon:unparsed-entities() extension function</description>
   <environment name="unparsed-entities-001">
      <source role="." file="unparsed-entities-001.xml"/>
   </environment>

   <test-case name="unparsed-entities-001">
      <description>Test saxon:unparsed-entities() extension function</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment ref="unparsed-entities-001"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="unparsed-entities-001.xsl"/>
      </test>
      <result>
         <all-of>
            <assert>/out/ent[@name="hatch-pic"][ends-with(@sys,"tests/grafix/OpenHatch.gif")][@pub=""]</assert>
            <assert>/out/ent[@name="patch-pic"][ends-with(@sys,"tests/grafix/OpenPatch.gif")][@pub="//PUBLIC//ID//"]</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="unparsed-entities-001b">
      <description>Test saxon:unparsed-entities() extension function</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <environment ref="unparsed-entities-001"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="unparsed-entities-001.xsl"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
</test-set>
