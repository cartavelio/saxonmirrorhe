<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
   name="tabulate-maps">
   <description>Tests saxon:tabulate-maps</description>
   
   <test-case name="tabulate-maps-001">
      <description>Basic test</description>
      <created by="Michael Kay" on="2017-11-11"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="tabulate-maps-001.xsl"/>
         <output tree="no" result-var="result"/>
      </test>
      <result>
         <all-of>
            <!--
               map{"order-no":1.23e2,"quantity":1.0e0,"date":"2017-02-03","product":"flour, 25Kg","_keys":[1,"orders",1,"order-lines",1],"customer":"Jones the Baker"}
map{"order-no":1.23e2,"quantity":3.0e0,"date":"2017-02-03","product":"salt, 1Kg","_keys":[1,"orders",1,"order-lines",2],"customer":"Jones the Baker"}
map{"order-no":1.24e2,"quantity":1.0e0,"date":"2017-02-04","product":"butter, 5Kg","_keys":[1,"orders",2,"order-lines",1],"customer":"Jones the Baker"}
map{"order-no":1.24e2,"quantity":3.0e0,"date":"2017-02-04","product":"sugar, 5Kg","_keys":[1,"orders",2,"order-lines",2],"customer":"Jones the Baker"}
map{"order-no":1.201e3,"quantity":1.0e0,"date":"2017-02-05","product":"butter, 5Kg","_keys":[2,"orders",1,"order-lines",1],"customer":"Evans the Butcher"}
map{"order-no":1.201e3,"quantity":3.0e0,"date":"2017-02-05","product":"cleaver","_keys":[2,"orders",1,"order-lines",2],"customer":"Evans the Butcher"}
-->
            <assert>some $r in $result satisfies deep-equal($r, map{"order-no":1.23e2,"quantity":1.0e0,"date":"2017-02-03","product":"flour, 25Kg","_keys":[1,"orders",1,"order-lines",1],"customer":"Jones the Baker"})</assert>
            <assert>some $r in $result satisfies deep-equal($r, map{"order-no":1.23e2,"quantity":3.0e0,"date":"2017-02-03","product":"salt, 1Kg","_keys":[1,"orders",1,"order-lines",2],"customer":"Jones the Baker"})</assert>
            <assert>some $r in $result satisfies deep-equal($r, map{"order-no":1.24e2,"quantity":1.0e0,"date":"2017-02-04","product":"butter, 5Kg","_keys":[1,"orders",2,"order-lines",1],"customer":"Jones the Baker"})</assert>
            <assert>count($result) = 6</assert>
         </all-of>
         
      </result>
   </test-case>
   
   <test-case name="tabulate-maps-001b">
      <description>Basic test when not available</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="tabulate-maps-001.xsl"/>
         <output tree="no" result-var="result"/>
      </test>
      <result>
         <error code="XTDE1450"/>
      </result>
   </test-case>
 
   <test-case name="tabulate-maps-002">
      <description>Tabulate followed by grouping to achieve hierarchic inversion</description>
      <created by="Michael Kay" on="2017-11-11"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="tabulate-maps-002.xsl"/>
         <output tree="no"/>
      </test>
      <result>
          <assert-deep-eq>parse-json('
             [ {"product":"flour, 25Kg",
                "customers":[
                   {"quantity":1.0e0,
                    "name":"Jones the Baker",
                    "date":"2017-02-03"}]},
                {"product":"salt, 1Kg",
                 "customers":[
                    {"quantity":3.0e0,
                     "name":"Jones the Baker",
                     "date":"2017-02-03"}]},
                {"product":"butter, 5Kg",
                 "customers":[
                     {"quantity":1.0e0,
                      "name":"Jones the Baker",
                      "date":"2017-02-04"},
                     {"quantity":1.0e0,
                      "name":"Evans the Butcher",
                      "date":"2017-02-05"}]},
                 {"product":"sugar, 5Kg",
                  "customers":[
                      {"quantity":3.0e0,
                       "name":"Jones the Baker",
                       "date":"2017-02-04"}]},
                 {"product":"cleaver",
                  "customers":[
                     {"quantity":3.0e0,
                      "name":"Evans the Butcher",
                      "date":"2017-02-05"}]}]            
          ')</assert-deep-eq>
      </result>
   </test-case>
   
   <test-case name="tabulate-maps-003">
