      <result>
         <assert>/out = '[{"name":"London","population":7200000,"_keys":[1,"cities",1],"country":"UK"},{"name":"Birmingham","population":992000,"_keys":[1,"cities",2],"country":"UK"},{"name":"Leeds","population":720000,"_keys":[1,"cities",3],"country":"UK"},{"name":"Paris","population":12341418,"_keys":[2,"cities",1],"country":"France"},{"name":"Lyon","population":2214068,"_keys":[2,"cities",2],"country":"France"},{"name":"Marseille","population":1727070,"_keys":[2,"cities",3],"country":"France"}]'</assert>
      </result>
   </test-case>
   
