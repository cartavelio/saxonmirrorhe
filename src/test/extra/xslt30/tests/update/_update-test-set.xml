<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
   name="update">
   <description>Tests saxon:update (new Saxon 9.9 extension)</description>
   
   <test-case name="update-change-001">
      <description>Change value of attribute</description>
      <created by="Michael Kay" on="2018-03-21"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-EE"/>
      </dependencies>
      <test>
         <stylesheet file="update-change-001.xsl"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><doc><a id="1"/><b id="7"/><c id="3"/></doc></out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="update-change-001b">
      <description>Test saxon:update when not available</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-EE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="update-change-001.xsl"/>
      </test>
      <result>
         <error code="XTDE1450"/>
      </result>
   </test-case>
   
