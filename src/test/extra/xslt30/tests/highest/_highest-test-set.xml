<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="highest">
   <description>Tests highest</description>

   <test-case name="highest-001">
      <description>test saxon:highest() - Saxon 9.2 version using higher-order functions</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="highest-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><a id="5">123.60</a><a id="8">123.6</a></out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="highest-001b">
      <description>test saxon:highest() - Saxon 9.2 version using higher-order functions</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="highest-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>

   <test-case name="highest-002">
      <description>test saxon:highest() on an empty sequence - Saxon 9.2 version using higher-order functions</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="highest-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out></out>]]></assert-xml>
      </result>
   </test-case>

   <test-case name="highest-003">
      <description>test saxon:highest() using collations - Saxon 9.2 version using higher-order functions</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="highest-003.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><a id="5">katy</a><a id="7">Katy</a><a id="8">KATY</a></out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="highest-004">
      <description>test saxon:highest() single argument version with a default collation</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="highest-004.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><a id="5">katy</a><a id="7">Katy</a><a id="8">KATY</a></out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="highest-005">
      <description>test saxon:highest() : second argument is a system function</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="highest-005.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><a id="1">123.5</a><a id="5">123.60</a><a id="7">123.5</a><a id="8">123.6</a></out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="highest-006">
      <description>test saxon:highest() second argument is a call on a stylesheet function</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="highest-006.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><a id="5">123.60</a><a id="8">123.6</a></out>]]></assert-xml>
      </result>
   </test-case>   
   
   <test-case name="highest-901">
      <description>test saxon:highest() second argument is a call on a function with the wrong signature</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="highest-901.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPTY0004"/>
      </result>
   </test-case>   
</test-set>
