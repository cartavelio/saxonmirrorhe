   <test-case name="zip-005">
      <description>Test of the function arch:extract-text from the expath zip module</description>
      <created by="O'Neil Delpratt" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="zip-005.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<arch:entries xmlns:arch="http://expath.org/ns/archive">
   <arch:text>Hello.

This is a text file, within a ZIP file.  Its name is file.txt and it
is at the root of the archive.
</arch:text>
</arch:entries>]]></assert-xml>
      </result>
   </test-case>

