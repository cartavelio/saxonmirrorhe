<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog" name="zip">
   <description>Tests zip</description>

   <test-case name="zip-001">
      <description>Test of arch:entries</description>
      <created by="O'Neil Delpratt" on="2014-04-13"/>
      <modified by="Debbie Lockett" on="2015-11-06" change="edit arch:entry[1]/@last-modified in zip-001.out"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="zip-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml file="zip-001.out"/>
      </result>
   </test-case>
   
   <test-case name="zip-001b">
      <description>Test of arch:entries, when extensions not available</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="zip-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>

