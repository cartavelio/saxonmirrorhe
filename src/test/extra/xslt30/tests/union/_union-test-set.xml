<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
   name="union">
   <description>Tests union() item type (Saxon extension)</description>
   
   <test-case name="union-001">
      <description>Basic use case for union()</description>
      <created by="Michael Kay" on="2020-01-28"/>
      <environment>
         <saxon:property name="http://saxon.sf.net/feature/allowSyntaxExtensions" value="true" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="union-001.xsl"/>
      </test>
      <result>
         <assert>/out/a = 'true'</assert>
      </result>
   </test-case>
   
   <test-case name="union-001b">
      <description>Basic use case for union(), when not available</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
