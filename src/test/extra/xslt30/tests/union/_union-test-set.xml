   <test-case name="union-100">
      <description>Union type - subtype relationships</description>
      <created by="Michael Kay" on="2020-01-28"/>
      <environment>
         <saxon:property name="http://saxon.sf.net/feature/allowSyntaxExtensions" value="true" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="union-100.xsl"/>
         <!-- return true if T is a subtype of S -->
         <param name="T" static="true" select="'xs:integer'"/>
         <param name="S" static="true" select="'union(xs:integer, xs:double)'"/>
      </test>
      <result>
         <assert>/out='true'</assert>
      </result>
   </test-case>
   
