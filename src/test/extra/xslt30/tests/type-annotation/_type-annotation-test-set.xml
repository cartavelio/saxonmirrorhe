<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="type-annotation">
   <description>Tests type-annotation</description>

   <test-case name="type-annotation-001">
      <description>Test saxon:type-annotation on atomic values.</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="schema_aware"/>
      </dependencies>
      <test>
         <stylesheet file="type-annotation-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><int v="xs:integer"/><bool v="xs:boolean"/><string v="xs:string"/><qname v="xs:QName"/><id v="xs:ID"/></out>]]></assert-xml>
      </result>
   </test-case>

   <test-case name="type-annotation-002">
      <description>Test saxon:type-annotation on untyped nodes and their atomizations.</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="type-annotation-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml file="type-annotation-002.out"/>
      </result>
   </test-case>
   
   <test-case name="type-annotation-002b">
      <description>Test saxon:type-annotation on untyped nodes, when not available.</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="type-annotation-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   

   <test-case name="type-annotation-003">
      <description>Test saxon:type-annotation on schema-validated nodes and their atomizations.</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <modified by="Michael Kay" on="2017-05-19" change="remove dependency on prefixes of type names"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="schema_aware"/>
      </dependencies>
      <test>
         <stylesheet file="type-annotation-003.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml file="type-annotation-003.out"/>
      </result>
   </test-case>
</test-set>
