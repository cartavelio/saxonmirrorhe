<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="last-modified">
   <description>Tests the saxon:last-modified() extension function</description>

   <test-case name="last-modified-001">
      <description>test last-modified() on a relative file URI</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <modified by="Debbie Lockett" on="2016-04-14" change="add alternative result that works for me"/>
      <modified by="Michael Kay" on="2021-07-27" change="file was touched during repository move"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="last-modified-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out>2021-03-31T18:28:07.555Z</out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="last-modified-001b">
      <description>test last-modified() on a relative file URI</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="last-modified-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>

   <test-case name="last-modified-002">
      <description>test last-modified() on an HTTP URI</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <modified by="Michael Kay" on="2018-07-20" change="file was modified when moved to new server"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="last-modified-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
        <assert-xml><![CDATA[<out>2019-03-18T11:48:04Z</out>]]></assert-xml>
      </result>
   </test-case>

   <test-case name="last-modified-003">
      <description>test last-modified () on an empty sequence</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="last-modified-003.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out/>]]></assert-xml>
      </result>
   </test-case>
</test-set>
