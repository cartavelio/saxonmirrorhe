   <test-case name="tuple-100">
      <description>Tuple type - subtype relationships</description>
      <created by="Michael Kay" on="2020-01-25"/>
      <environment>
         <saxon:property name="http://saxon.sf.net/feature/allowSyntaxExtensions" value="true" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>
      <dependencies>
         <spec value="XSLT40+"/>
      </dependencies>
      <test>
         <stylesheet file="tuple-100.xsl"/>
         <!-- return true if T is a subtype of S -->
         <param name="T" static="true" select="'record(i as xs:integer, j as xs:integer)'"/>
         <param name="S" static="true" select="'record(i as xs:integer, *)'"/>
      </test>
      <result>
         <assert>/out='true'</assert>
      </result>
   </test-case>
   
