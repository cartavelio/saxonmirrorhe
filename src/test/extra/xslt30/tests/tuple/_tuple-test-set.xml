   <test-case name="tuple-001">
      <description>Basic use case for tuple types; use in "as" attributes</description>
      <created by="Michael Kay" on="2020-01-27"/>
      <!--<environment>
         <saxon:property name="http://saxon.sf.net/feature/allowSyntaxExtensions" value="true" xmlns:saxon="http://saxon.sf.net/"/>
      </environment>-->
      <dependencies>
         <spec value="XSLT40+"/>
      </dependencies>
      <test>
         <stylesheet file="tuple-001.xsl"/>
      </test>
      <result>
         <assert>/result = "-1+-1i"</assert>
      </result>
   </test-case>
  
   
