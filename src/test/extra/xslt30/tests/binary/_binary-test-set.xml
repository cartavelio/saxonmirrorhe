   <test-case name="binary-001">
      <description>Test saxon:recognize-binary="yes" with text output method</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="binary-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><a>ðñòóôõö÷øùúûüýþÿ</a><a>0123456789</a><a>banana custard</a></out>]]></assert-xml>
      </result>
   </test-case>
   
