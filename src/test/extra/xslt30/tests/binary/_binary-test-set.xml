   <test-case name="hexBinaryToOctets-001">
      <description>Test saxon:hexBinaryToOctets extension function</description>
      <created by="Michael Kay" on="2017-11-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="hexBinaryToOctets-001.xsl"/>
         <initial-template name="main"/>
         <param name="hexBin" select="'00'"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out><o value="0" instance="true" castable="true" cast="0"/></out>]]></assert-xml>
      </result>
   </test-case>
   
