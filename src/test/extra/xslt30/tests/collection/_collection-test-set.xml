<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="collection">
   <description>Tests collection</description>
   <dependencies>
      <feature value="Saxon-PE"/>
   </dependencies>

   <test-case name="collection-001">
      <description>Test collection catalog</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <modified by="Michael Kay" on="2016-06-12" change="add whitespace stripping"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="collection-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <all-of>
            <assert>tokenize(/out/named, ' ') = "red"</assert>
            <assert>tokenize(/out/named, ' ') = "blue"</assert>
            <assert>tokenize(/out/named, ' ') = "green"</assert>
            <assert>tokenize(/out/named, ' ') = "white"</assert>
            <assert>/out/@white = ""</assert>
            <assert>/out/local/b/@id = 'b1'</assert>
            <assert>/out/local/q/@id = 'q1'</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="collection-002">
      <description>Test directory-based collection with whitespace stripping</description>
      <created by="Michael Kay" on="2016-06-12"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="collection-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert>/out/white = ""</assert>
      </result>
   </test-case>
  
