<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="local">
   <description>Tests local</description>

   <test-case name="local-001">
      <description>Test xsl:number lang="nl"</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <modified by="Debbie Lockett" on="2016-04-14" change="add alternative result"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="local-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <any-of>
            <assert-xml file="local-001.out"/>
            <assert-xml file="local-001b.out"/>
         </any-of>
         <!-- No longer matching original in Saxon 9.6 because ICU outputs the numbers with a soft hyphen at possible breaks -->
      </result>
   </test-case>
   
   <test-case name="local-002">
      <description>Test xsl:number lang="nl" when language unsupported</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="local-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml file="local-002.out"/>
      </result>
   </test-case>
</test-set>
