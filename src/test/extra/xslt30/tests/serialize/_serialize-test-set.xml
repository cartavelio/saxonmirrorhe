<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="serialize">
   <description>Tests saxon:serialize extension function</description>

   <test-case name="serialize-001">
      <description>Test saxon:serialize() with output format name as second arg</description>
      <created by="Michael Kay" on="2016-08-24"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="serialize-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <all-of>
            <assert>/out/one = "SpaghettiSpaghetti Westernwith Parmesan Cheese"</assert>
            <assert>/out/two[contains(., '&lt;meta http-equiv="Content-Type" content="text/html; charset=UTF-8"&gt;')]</assert>
            <assert>/out/three[starts-with(., '&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;html&gt;&lt;head&gt;&lt;title&gt;Spaghetti&lt;/title&gt;')]</assert>
            <assert>/out/four[starts-with(., '&lt;html&gt;&lt;head&gt;&lt;title&gt;Spaghetti&lt;/title&gt;')]</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="serialize-001b">
      <description>Test saxon:serialize() with output format name as second arg</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="serialize-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   
   <test-case name="serialize-002">
      <description>Test saxon:serialize() with xsl:output element as second arg</description>
      <created by="Michael Kay" on="2016-08-24"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="serialize-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <all-of>
            <assert>/out/one = "SpaghettiSpaghetti Westernwith Parmesan Cheese"</assert>
            <assert>/out/two[contains(., '&lt;meta http-equiv="Content-Type" content="text/html; charset=UTF-8"&gt;')]</assert>
            <assert>/out/three[starts-with(., '&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;html xmlns:xsl="http://www.w3.org/1999/XSL/Transform"&gt;&lt;head&gt;&lt;title&gt;Spaghetti&lt;/title&gt;')]</assert>
            <assert>/out/four[starts-with(., '&lt;html xmlns:xsl="http://www.w3.org/1999/XSL/Transform"&gt;&lt;head&gt;&lt;title&gt;Spaghetti&lt;/title&gt;')]</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="serialize-002b">
      <description>Test saxon:serialize() with xsl:output element as second arg</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="serialize-002.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   
 
</test-set>
