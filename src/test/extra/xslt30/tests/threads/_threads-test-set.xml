   <test-case name="threads-004">
      <description>Basic test of saxon:threads on xsl:for-each with use of last().</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment ref="threads001"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="threads-004.xsl"/>
      </test>
      <result>
         <all-of>
            <assert>/out/book[1][@price="4.95"][@position="1"][@of="14"]</assert>
            <assert>/out/book[2][@price="6.58"][@position="2"][@of="14"]</assert>
            <assert>/out/book[3][@price="3.95"][@position="3"][@of="14"]</assert>
            <assert>/out/book[4][@price="14.95"][@position="4"][@of="14"]</assert>
            <assert>/out/book[5][@price="8.88"][@position="5"][@of="14"]</assert>
            <assert>/out/book[6][@price="9.99"][@position="6"][@of="14"]</assert>
            <assert>/out/book[7][@price="12.00"][@position="7"][@of="14"]</assert>
            <assert>/out/book[8][@price="3.60"][@position="8"][@of="14"]</assert>
            <assert>/out/book[9][@price="35.50"][@position="9"][@of="14"]</assert>
            <assert>/out/book[10][@price="28.95"][@position="10"][@of="14"]</assert>
            <assert>/out/book[11][@price="0.00"][@position="11"][@of="14"]</assert>
            <assert>/out/book[12][@price="4.90"][@position="12"][@of="14"]</assert>
            <assert>/out/book[13][@price="17.30"][@position="13"][@of="14"]</assert>
            <assert>/out/book[14][@price="86.00"][@position="14"][@of="14"]</assert>
         </all-of>
      </result>
   </test-case>

