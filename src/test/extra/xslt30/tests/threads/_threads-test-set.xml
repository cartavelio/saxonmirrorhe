   <test-case name="threads-026">
      <description>
         Test of xsl:result-document operating asynchronously producing a large number of output files, while calling last(). Bug 3927.
         Also tests use of saxon:asynchronous extension attribute (though we can't test its actual effect).
      </description>
      <created by="Michael Kay" on="2018-10-02"/>
      <environment>
         <source file="threads026.xml" role="."/>
      </environment>
      <dependencies>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="threads-026.xsl"/>
      </test>
      <result>
         <all-of>
            <assert-result-document uri="en/item_1.html">
               <assert>//li[.='next'] and not(//li[.='prev'])</assert>
            </assert-result-document>
            <assert-result-document uri="en/item_200.html">
               <assert>//li[.='next'] and //li[.='prev']</assert>
            </assert-result-document>
            <assert-result-document uri="en/item_399.html">
               <assert>not(//li[.='next']) and //li[.='prev']</assert>
            </assert-result-document>
            <assert-result-document uri="fr/item_1.html">
               <assert>//li[.='next'] and not(//li[.='prev'])</assert>
            </assert-result-document>
            <assert-result-document uri="fr/item_200.html">
               <assert>//li[.='next'] and //li[.='prev']</assert>
            </assert-result-document>
            <assert-result-document uri="fr/item_399.html">
               <assert>not(//li[.='next']) and //li[.='prev']</assert>
            </assert-result-document>
         </all-of>
      </result>
   </test-case>
   
