<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="collation">
   <description>Tests collation</description>
   <!-- For backwards compatibility reasons the standard collation resolver in Saxon also accepts
      URIs in the form http://saxon.sf.net/collation followed by query parameters; the query
      parameters that are recognized are the same as those defined by W3C UCA collation URIs. -->
   
   <environment name="collation-003">
      <source role="." file="collation-003.xml"/>
   </environment>

   <test-case name="collation-001">
      <description>Use a rule-based collation URI (saxon URI)</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="collation-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out>
   <a>Annie</a>
   <a>annie</a>
   <a>amy</a>
   <a>charles</a>
   <a>nathan</a>
   <a>Mary</a>
   <a>mary</a>
   <a>stephen</a>
</out>]]></assert-xml>
      </result>
   </test-case>

   <test-case name="collation-002">
      <description>Test xsl:key with saxon URI collation</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment>
         <source role="." file="collation-002.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="collation-002.xsl"/>
      </test>
      <result>
         <all-of> 
            <assert>/out/c1="Jaeger,JAEGER,Jæger,JÆGER"</assert>
            <assert>/out/c2="Jaeger,JAEGER,Jæger,JÆGER"</assert>
            <assert>/out/c3="Jaeger,JAEGER,Jæger,JÆGER"</assert>
            <assert>/out/c4="Jaeger,JAEGER"</assert>
         </all-of>
      </result>
   </test-case>

   <test-case name="collation-003">
      <description>Test xsl:key with saxon URI collation</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment ref="collation-003"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="collation-003.xsl"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out>;
     <c3>Jaeger,JAEGER</c3>;
     <c4>Jaeger,JAEGER</c4>;          
   </out>]]></assert-xml>
      </result>
   </test-case>

   <test-case name="collation-004">
      <description>Test xsl:key with saxon URI collation (relative collation URI)</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <environment ref="collation-003"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="collation-004.xsl"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out>;
     <c3>Jaeger,JAEGER</c3>;
     <c4>Jaeger,JAEGER</c4>;          
   </out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="collation-005">
      <description>Test that unknown collations are ignored in default-collation attribute</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <environment ref="collation-003"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="collation-005.xsl"/>
      </test>
      <result>
         <assert-xml><![CDATA[<out>;
     <c3>Jaeger,JAEGER</c3>;
     <c4>Jaeger,JAEGER</c4>;          
   </out>]]></assert-xml>
      </result>
   </test-case>
   
   <test-case name="collation-006">
      <description>Test error when all URIs in default-collation are unrecognized</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <environment ref="collation-003"/>
      <dependencies>
         <spec value="XSLT20+"/>
      </dependencies>
      <test>
         <stylesheet file="collation-006.xsl"/>
      </test>
      <result>
         <error code="XTSE0125"/>
      </result>
   </test-case>
   
   <test-case name="collation-007">
      <description>Collation key on alphanumeric collation</description>
      <created by="Michael Kay" on="2019-04-09"/>
      <dependencies>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="collation-007.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <assert>/out = 'true'</assert>
      </result>
   </test-case>
   
   <test-case name="collation-008">
      <description>Ordering of collation key on alphanumeric collation - bug 5049</description>
      <created by="Michael Kay" on="2019-04-09"/>
      <dependencies>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="collation-008.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <all-of>
            <assert>/out/a = 'true'</assert>
            <assert>/out/b = 'true'</assert>
            <assert>/out/c = 'true'</assert>
            <assert>/out/d = 'true'</assert>
            <assert>/out/e = 'true'</assert>
         </all-of>
      </result>
   </test-case>
</test-set>
