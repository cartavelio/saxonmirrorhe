<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="parent-pointers">
   <description>Tests saxon:parent-pointers extension option in fn:parse-json</description>
   <dependencies>
      <feature value="Saxon-PE"/>
   </dependencies>

   <test-case name="parent-pointers-001">
      <description>Test saxon:parent-pointers() extension function</description>
      <created by="Michael Kay" on="2017-10-10"/>
      <dependencies>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="parent-pointers-001.xsl"/>
      </test>
      <result>
         <all-of>
            <assert>/out/keys/one = 'one'</assert>
            <assert>/out/keys/three = 'three three'</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="parent-pointers-002">
      <description>Test saxon:parent-pointers() extension function</description>
      <created by="Michael Kay" on="2017-10-10"/>
      <dependencies>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="parent-pointers-002.xsl"/>
      </test>
      <result>
         <all-of>
            <assert>/out/x = 33</assert>
            <assert>/out/z = 11</assert>
         </all-of>
      </result>
   </test-case>


</test-set>
