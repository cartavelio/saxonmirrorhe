      </result>
   </test-case>
   
   <test-case name="source-document-strip-space-005">
      <description>xsl:source-document with saxon:strip-space="#all" (validated doc)</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="schema_aware"/>
      </dependencies>
      <test>
         <stylesheet file="source-document-strip-space-005.xsl"/>
         <param name="strip" static="true" select="'#all'"/>
      </test>
      <result>
         <assert>count(//text()[not(normalize-space())]) = 0</assert>
      </result>
   </test-case>
   
   <test-case name="source-document-strip-space-006">
      <description>xsl:source-document with saxon:strip-space="#none" (validated doc)</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="schema_aware"/>
      </dependencies>
      <test>
         <stylesheet file="source-document-strip-space-005.xsl"/>
         <param name="strip" static="true" select="'#none'"/>
      </test>
      <result>
         <assert>count(//text()[not(normalize-space())]) = 0</assert>
         <!-- element-content whitespace is stripped during validation, strip-space has no effect -->
      </result>
   </test-case>
   
