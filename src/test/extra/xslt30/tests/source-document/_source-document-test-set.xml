   <test-case name="source-document-strip-space-011">
      <description>xsl:source-document with saxon:strip-space invalid</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <dependencies>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="source-document-strip-space-008.xsl"/>
         <param name="strip" static="true" select="'#invalid-value'"/>
      </test>
      <result>
         <error code="XTSE0020"/>
      </result>
   </test-case>
   
   <test-case name="source-document-expand-defaults-001">
      <description>xsl:source-document with expand-attribute-defaults="yes" (using schema validation)</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="schema_aware"/>
      </dependencies>
      <!--<environment ref="loans-with-defaults"/>-->
      <test>
         <stylesheet file="source-document-expand-defaults-001.xsl"/>
         <param name="expand" static="true" select="true()"/>
      </test>
      <result>
         <assert>exists(//@virtual-version[. = 93.7])</assert>
      </result>
   </test-case>
   
   <test-case name="source-document-expand-defaults-002">
      <description>xsl:source-document with expand-attribute-defaults="no" (using schema validation)</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="schema_aware"/>
      </dependencies>
     <!--<environment ref="loans-with-defaults"/>-->
      <test>
         <stylesheet file="source-document-expand-defaults-001.xsl"/>
         <param name="expand" static="true" select="false()"/>
      </test>
      <result>
         <assert>empty(//@virtual-version)</assert>
      </result>
   </test-case>
   
 
</test-set>