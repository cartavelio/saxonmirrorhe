<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
   name="source-document">
   <description>Tests Saxon extension attributes for xsl:source-document instruction</description>
  
   <environment name="loans-with-defaults">
     <source role="." file="../../docs/loans-ns.xml"/>
     <schema file="../../docs/loans-with-defaults.xsd"/>
   </environment>
   
   <test-case name="source-document-line-numbering-001">
      <description>xsl:source-document with saxon:line-numbering="yes"</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="source-document-line-numbering-001.xsl"/>
         <param name="line-numbering" static="true" select="true()"/>
      </test>
      <result>
         <assert>exists(/out/price/@line-number[number() gt 0])</assert>
      </result>
   </test-case>
   
   <test-case name="source-document-line-numbering-001b">
      <description>xsl:source-document with saxon:line-numbering="yes"</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="source-document-line-numbering-001.xsl"/>
         <param name="line-numbering" static="true" select="true()"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   
   <test-case name="source-document-line-numbering-002">
      <description>xsl:source-document with saxon:line-numbering="no"</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="source-document-line-numbering-001.xsl"/>
         <param name="line-numbering" static="true" select="false()"/>
      </test>
      <result>
         <assert>empty(/out/price/@line-number[number() gt 0])</assert>
      </result>
   </test-case>
   
   <test-case name="source-document-line-numbering-002b">
      <description>xsl:source-document with saxon:line-numbering="no"</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT30+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="source-document-line-numbering-001.xsl"/>
         <param name="line-numbering" static="true" select="false()"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   
   <test-case name="source-document-strip-space-001">
      <description>xsl:source-document with saxon:strip-space="#all"</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <dependencies>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="source-document-strip-space-001.xsl"/>
         <param name="strip" static="true" select="'#all'"/>
      </test>
      <result>
         <assert>empty(//text()[not(normalize-space())])</assert>
      </result>
   </test-case>
   
   <test-case name="source-document-strip-space-002">
      <description>xsl:source-document with saxon:strip-space="#none"</description>
      <created by="Michael Kay" on="2018-11-23"/>
      <dependencies>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="source-document-strip-space-001.xsl"/>
         <param name="strip" static="true" select="'#none'"/>
      </test>
      <result>
         <assert>count(//text()[not(normalize-space())]) = 86</assert>
      </result>
   </test-case>
   
   <test-case name="source-document-strip-space-003">
      <description>xsl:source-document with saxon:strip-space="#ignorable" (unvalidated doc)</description>
      <created by="Michael Kay" on="2018-11-23"/>
