<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
   name="import-query">
   <description>Tests the saxon:import-query declaration</description>
   
   <test-case name="import-query-001">
      <description>Simple test of saxon:import-query</description>
      <created by="Michael Kay" on="2017-08-25"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="import-query-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <any-of>
            <all-of>
               <assert>/out/var/element/a = "23"</assert>
               <assert>/out/fun/xxx/a = "23"</assert>
            </all-of>
            <error code="SXST0069"/> <!-- export not allowed -->
         </any-of>
      </result>
   </test-case>
   
   <test-case name="import-query-001b">
