<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
   name="send-mail">
   <description>Tests saxon:send-mail extension</description>
   
   <test-case name="send-mail-001">
      <description>Test case from StackOverflow</description>
      <created by="Michael Kay" on="2017-08-17"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="send-mail-001.xsl"/>
      </test>
      <result>
         <assert>normalize-space(/out) = "Extensibility and Reuse de"</assert>
      </result>
   </test-case>
   
   <test-case name="send-mail-001b">
      <description>Test send-mail when not available</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="send-mail-001.xsl"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
   
  
</test-set>