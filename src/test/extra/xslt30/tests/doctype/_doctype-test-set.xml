<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
   name="doctype">
   <description>Tests saxon:doctype</description>
   
   <test-case name="doctype-001">
      <description>Example of saxon:doctype from the documentation</description>
      <created by="Michael Kay" on="2017-11-21"/>
      <environment>
         <source role="." file="../../docs/books.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="doctype-001.xsl"/>
      </test>
      <result>
         <all-of>
            <serialization-matches><![CDATA[<!DOCTYPE\s+booklist\s+\[]]></serialization-matches>
            <serialization-matches><![CDATA[<!ELEMENT\s+booklist\s+\(book\)\*>]]></serialization-matches>
            <serialization-matches><![CDATA[<!ATTLIST\s+book\s+isbn\s+ID\s+#REQUIRED\s+title\s+CDATA\s+#IMPLIED>]]></serialization-matches>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="doctype-001b">
      <description>Example of saxon:doctype from the documentation</description>
      <created by="Michael Kay" on="2017-11-21"/>
      <environment>
         <source role="." file="../../docs/books.xml"/>
      </environment>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE" satisfied="false"/>
      </dependencies>
      <test>
         <stylesheet file="doctype-001.xsl"/>
      </test>
      <result>
         <error code="XTDE1450"/>
      </result>
   </test-case>
   
 
</test-set>