<?xml version="1.0" encoding="UTF-8"?>
<test-set xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.w3.org/2012/10/xslt-test-catalog"
          name="tunnel-params">
   <description>Tests saxon:tunnel-params</description>

   <test-case name="tunnel-params-001">
      <description>Test saxon:tunnel-params extension function</description>
      <created by="Michael Kay" on="2019-12-19"/>
      <dependencies>
         <feature value="Saxon-EE"/>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="tunnel-params-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <all-of>
            <assert>/out/count/@c='4'</assert>
            <assert>/out/p1/@value='5'</assert>
            <assert>/out/p7/@value='7'</assert>
            <assert>/out/par1/@value='2'</assert>
            <assert>/out/par2/@value='2'</assert>
         </all-of>
      </result>
   </test-case>
   
   <test-case name="tunnel-params-001b">
      <description>Test saxon:tunnel-params extension function, when not available</description>
      <created by="Debbie Lockett" on="2020-03-10"/>
      <dependencies>
         <feature value="Saxon-EE" satisfied="false"/>
         <spec value="XSLT30+"/>
      </dependencies>
      <test>
         <stylesheet file="tunnel-params-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
         <error code="XPST0017"/>
      </result>
   </test-case>
</test-set>
