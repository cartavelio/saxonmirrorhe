   <description>Tests output properties in the Saxon namespace</description>

   <test-case name="attribute-order-001">
      <description>Test saxon:attribute-order with XML output method</description>
      <created by="Michael Kay" on="2014-04-13"/>
      <modified by="Michael Kay" on="2020-02-25" change="use serialization-matches to avoid indentation problems"/>
      <dependencies>
         <spec value="XSLT20+"/>
         <feature value="Saxon-PE"/>
      </dependencies>
      <test>
         <stylesheet file="attribute-order-001.xsl"/>
         <initial-template name="main"/>
      </test>
      <result>
        <all-of>
          <serialization-matches>id="x" name="y" alpha="z" beta="w" gamma="g" xml:space="preserve"</serialization-matches>
          <serialization-matches>id="x" name="y" alpha="z" beta="w" gamma="g" java:jam="j" xs:extra="4" xml:space="preserve"</serialization-matches>
          <serialization-matches>id="x" name="y" alpha="z" beta="w" gamma="g" xs:extra="4" xml:space="preserve"</serialization-matches>
          <serialization-matches>b="3" c="4"</serialization-matches>
        </all-of>
      </result>
   </test-case>
   
