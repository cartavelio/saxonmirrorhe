  <test-case name="double-space-001">
    <description>Test saxon:double-space with XML output method</description>
    <created by="Michael Kay" on="2020-03-11"/>
    <dependencies>
      <spec value="XSLT20+"/>
      <feature value="Saxon-PE"/>
    </dependencies>
    <test>
      <stylesheet file="double-space-001.xsl"/>
      <initial-template name="main"/>
    </test>
    <result>
      <all-of>
        <serialization-matches><![CDATA[</test-case>\n\n\s+<test-case]]></serialization-matches>
        <serialization-matches><![CDATA[</test-case>\n\n\s+<java:comment]]></serialization-matches>
        <serialization-matches><![CDATA[<java:comment/>\n\n\s+<test-case]]></serialization-matches>
      </all-of>
    </result>
  </test-case>
  
