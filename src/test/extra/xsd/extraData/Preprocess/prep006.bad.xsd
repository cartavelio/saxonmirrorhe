<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:saxon="http://saxon.sf.net/">

  <xs:element name="publication" type="xslt-draft-date"/>
  
  <xs:simpleType name="us-date-type">
    <!-- accept date in format MM-DD-YYYY -->
    <xs:restriction base="xs:date">
      <saxon:preprocess action="concat(substring($value, 7, 4), '-', substring($value, 1, 2), '-', substring($value, 4, 2))"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="xslt-draft-date">
    <xs:restriction base="us-date-type">
      <!-- WRONG, values must be in the format defined by the base type -->
      <xs:enumeration value="2007-01-23"/>
      <xs:enumeration value="2006-11-21"/>
      <xs:enumeration value="2006-08-06"/>
      <xs:enumeration value="2005-11-03"/>
      <xs:enumeration value="2005-09-15"/>
      <xs:enumeration value="2005-04-04"/>
    </xs:restriction>
  </xs:simpleType>
  
</xs:schema>