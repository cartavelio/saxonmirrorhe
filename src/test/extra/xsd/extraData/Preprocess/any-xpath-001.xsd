<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:saxon="http://saxon.sf.net/"
           xmlns:map="http://www.w3.org/2005/xpath-functions/map"
           saxon:extensions="any-xpath-version">

  <xs:element name="newSize" type="SMLXSizeType"/>
  
  <xs:simpleType name="SMLXSizeType">
    <xs:restriction base="xs:token">
      <xs:assertion test="map{'SMALL':1, 'MEDIUM':2, 'LARGE':3, 'EXTRA LARGE':4, 'tiny':0} =&gt; map:contains(upper-case($value))"/>
    </xs:restriction>
  </xs:simpleType>
  
</xs:schema>