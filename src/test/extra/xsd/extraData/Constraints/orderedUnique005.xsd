<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:saxon="http://saxon.sf.net/"
           saxon:extensions="id-xpath-syntax">
  
  <!-- Use saxon:order on xs:selector, not allowed -->

  <xs:element name="data">
    <xs:complexType>
      <xs:sequence minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="emp"/>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="ordered-names">
      <xs:selector xpath="emp"/>
      <xs:field xpath="last" saxon:order="ascending"/>
      <xs:field xpath="first" saxon:order="descending"/>
    </xs:unique>
    <xs:unique name="ordered-ssn">
      <xs:selector xpath="emp" saxon:order="ascending"/>
      <xs:field xpath="@ssn"/>
    </xs:unique>
  </xs:element>
  
  <xs:element name="emp">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="first" type="xs:string"/>
        <xs:element name="last" type="xs:string"/>
      </xs:sequence>
      <xs:attribute name="ssn" type="xs:string"/>
    </xs:complexType>
  </xs:element>
 
  
</xs:schema>