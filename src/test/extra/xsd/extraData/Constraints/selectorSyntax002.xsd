<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:saxon="http://saxon.sf.net/">
  
  <!-- Use extended syntax for selector attribute, but without enabling the extension -->

  <xs:element name="data">
    <xs:complexType>
      <xs:sequence minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="emp"/>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="unique-ssn">
      <xs:selector xpath="emp[not(@temporary)]"/>
      <xs:field xpath="@ssn"></xs:field>
    </xs:unique>
  </xs:element>
  
  <xs:element name="emp">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="first"/>
        <xs:element name="last"/>
      </xs:sequence>
      <xs:attribute name="temporary" type="xs:boolean" use="optional"/>
      <xs:attribute name="ssn" type="xs:string"/>
    </xs:complexType>
  </xs:element>
 
  
</xs:schema>