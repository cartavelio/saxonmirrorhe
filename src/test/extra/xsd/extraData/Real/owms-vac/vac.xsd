<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:overheid="http://standaarden.overheid.nl/owms/terms/" xmlns:overheidvac="http://standaarden.overheid.nl/vac/terms/"
           xmlns:vac="http://standaarden.overheid.nl/vac/" targetNamespace="http://standaarden.overheid.nl/vac/" xmlns="http://standaarden.overheid.nl/vac/" elementFormDefault="qualified" version="1.0">

	<xs:include schemaLocation="http://standaarden.overheid.nl/owms/3.5/xsd/overheid-schemes.xsd"/>
	<xs:include schemaLocation="http://standaarden.overheid.nl/owms/3.5/xsd/owms-types.xsd"/>
	<xs:include schemaLocation="http://standaarden.overheid.nl/owms/3.5/xsd/owms-classes.xsd"/>

    <xs:import namespace="http://standaarden.overheid.nl/owms/terms/" schemaLocation="http://standaarden.overheid.nl/owms/3.5/xsd/overheid-classes-redef.xsd"/>
	<xs:import namespace="http://purl.org/dc/terms/" schemaLocation="http://standaarden.overheid.nl/vac/1.1/xsd/vac-owms-classes-redef.xsd"/>
    

	

	<xs:element name="vacs">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="vac" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="vac">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="meta"/>
				<xs:element ref="body"/>
			</xs:sequence>
			<xs:attribute name="owms-version" type="xs:token" fixed="3.5" use="required"/>
		</xs:complexType>
	</xs:element>

	<xs:element name="meta">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="owmskern">
					<xs:complexType>
						<xs:group ref="overheid:owmskern"/>
						<!-- Zie http://standaarden.overheid.nl/owms/3.5/xsd/owms.xsd voor elementen owmskern -->
					</xs:complexType>
				</xs:element>

				<xs:element name="owmsmantel">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="overheid:authority"/>
							<xs:element ref="dcterms:contributor" minOccurs="0" maxOccurs="unbounded"/>
							<xs:element ref="dcterms:available" minOccurs="0" maxOccurs="1"/>
							<xs:element ref="dcterms:audience" minOccurs="1" maxOccurs="unbounded"/>
							<xs:element ref="dcterms:subject" minOccurs="1" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>

				<xs:element name="vacmeta">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="bestemming">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="Antwoord"/>
										<xs:enumeration value="Werkplein"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="prioriteit">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="laag"/>
										<xs:enumeration value="medium"/>
										<xs:enumeration value="hoog"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="leverancierSysteem" type="AgentLeverancierSysteem">
								<xs:annotation>
									<xs:documentation>Organisatie die de content-feed
                                    aanbiedt</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="statusRedactie">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="actief"/>
										<xs:enumeration value="non-actief"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="datumControle" type="DateTimeFormat"/>
							<xs:element name="revisionHistory">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="revision" minOccurs="1" maxOccurs="unbounded">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="revisionType">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:enumeration value="tekst"/>
																<xs:enumeration value="inhoud"/>
																<xs:enumeration value="opmaak"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="version" type="xs:string"/>
													<xs:element name="dateTime" type="DateTimeFormat"/>
													<xs:element name="author" type="xs:string"/>
													<xs:element name="comment" type="xs:string"/>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="body">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="kanaal" minOccurs="1" maxOccurs="unbounded">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="vraag" type="xs:string"/>
							<xs:element name="kortAntwoord">
								<xs:complexType mixed="true">
									<xs:sequence>
										<xs:any namespace="http://www.w3.org/1999/xhtml" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="antwoord" minOccurs="0" maxOccurs="1">
								<xs:complexType mixed="true">
									<xs:sequence>
										<xs:any namespace="http://www.w3.org/1999/xhtml" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="onderwaterantwoord" minOccurs="0" maxOccurs="1">
								<xs:complexType mixed="true">
									<xs:sequence>
										<xs:any namespace="http://www.w3.org/1999/xhtml" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="verwijzingOverigeInfo" type="InformationObject" minOccurs="0" maxOccurs="unbounded"/>
							<xs:element name="verwijzingContact" type="InformationObject" minOccurs="0" maxOccurs="unbounded"/>
						</xs:sequence>
						<xs:attribute name="type">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="generiek"/>
									<xs:enumeration value="balie"/>
									<xs:enumeration value="chat"/>
									<xs:enumeration value="e-mail"/>
									<xs:enumeration value="sms"/>
									<xs:enumeration value="telefoon"/>
									<xs:enumeration value="post"/>
									<xs:enumeration value="website"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
				<xs:element name="verwijzingProduct" type="InformationObject" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element name="verwijzingVac" type="InformationObject" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<!-- ====================================== -->
	<!-- VAC eigen datatypes -->

	<xs:complexType name="AgentLeverancierSysteem">
		<xs:annotation>
			<xs:documentation>
			</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="NonEmptyString">
				<xs:attribute name="scheme" type="xs:QName" fixed="overheidvac:LeverancierSysteem"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
</xs:schema>