<?xml version="1.0" encoding="UTF-8"?>
<!-- Ancitel S.p.A. La rete dei Comuni Italiani -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ap5="http://saia.ancitel.it/xmlmanager/ap5" targetNamespace="http://saia.ancitel.it/xmlmanager/ap5" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="BaseTypes.xsd"/>
	<!-- 
	 	tipoGeneralita
	 		Contiene le Generalità 
	 		del soggetto della comunicazione
	-->
	<xs:complexType name="tipoGeneralita">
		<xs:sequence>
			<xs:element name="codiceFiscale" type="ap5:tipoCodiceFiscale" minOccurs="0"/>
			<xs:element name="cognome" type="ap5:charMax80"/>
			<xs:element name="nome" type="ap5:charMax80"/>
			<xs:element name="paternita" type="ap5:tipoPaternita" minOccurs="0"/>
			<xs:element name="maternita" type="ap5:tipoMaternita" minOccurs="0"/>
			<xs:element name="luogoNascita" type="ap5:tipoLuogo"/>
			<xs:element name="attoNascita" type="ap5:tipoAtto" minOccurs="0"/>
			<xs:element name="dataNascita" type="xs:date"/>
			<xs:element name="sesso" type="ap5:tipoSesso"/>
			<xs:element name="cittadinanza" type="ap5:tipoCittadinanza"/>
			<xs:element name="statoCivile" type="ap5:tipoStatoCivile"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
	  	tipoConiuge
	  		Contiene le generalità del Coniuge 
	  		del soggetto della comunicazione 
	-->
	<xs:complexType name="tipoConiuge">
		<xs:sequence>
			<xs:element name="cognomeConiuge" type="ap5:charMax80"/>
			<xs:element name="nomeConiuge" type="ap5:charMax80"/>
			<!-- 
				Il campo seguente è stato aggiunto,
				perché quelli previsti non sono sufficienti ad 
				identificare univocamente il cittadino
			 -->
			<xs:element name="codiceFiscaleConiuge" type="ap5:tipoCodiceFiscale" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		tipoMatrimonio
			Contiene i dati relativi al Matrimonio 
			del soggetto della comunicazione 
	 -->
	<xs:complexType name="tipoMatrimonio">
		<xs:sequence>
			<xs:element name="dataMatrimonio" type="xs:date"/>
			<xs:element name="luogoMatrimonio" type="ap5:tipoLuogo" minOccurs="0"/>
			<xs:element name="attoMatrimonio" type="ap5:tipoAtto" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		tipoVedovanza
			Contiene i dati relativi alla morte del coniuge 
			del soggetto della comunicazione
	 -->
	<xs:complexType name="tipoVedovanza">
		<xs:sequence>
			<xs:element name="dataMorteConiuge" type="xs:date"/>
			<xs:element name="luogoMorteConiuge" type="ap5:tipoLuogo" minOccurs="0"/>
			<xs:element name="attoMorteConiuge" type="ap5:tipoAtto" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		tipoCessazioneAnnullamentoMatrimonio
			Contiene i dati relativi alla Cessazione/Annullamento del matrimonio 
			del soggetto della comunicazione
	-->
	<xs:complexType name="tipoCessazioneAnnullamentoMatrimonio">
		<xs:sequence>
			<xs:element name="sentenza" type="ap5:tipoSentenza"/>
			<xs:element name="dataValidita" type="xs:date"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoIscrizioneAPR
			Contiene i dati relativi all'iscrizione all'Anagrafe della Popolazione Residente 
			del soggetto della comunicazione
	-->
	<xs:complexType name="tipoIscrizioneAPR">
		<xs:sequence>
			<xs:element name="motivoIscrizione">
				<xs:simpleType>
					<xs:restriction base="ap5:numerico1">
						<xs:pattern value="1|2|3|4|5|6|7"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="descrizioneMotivoIscrizione" type="ap5:charMax30" minOccurs="0"/>
			<xs:element name="dataIscrizioneAPR" type="xs:date"/>
			<xs:element name="numeroPraticaIscrizione" type="ap5:charMax30" minOccurs="0"/>
			<xs:element name="dataDefinizionePraticaIscrizione" type="xs:date" minOccurs="0"/>
			<xs:element name="luogoImmigrazione" type="ap5:tipoLuogo" minOccurs="0"/>
			<xs:element name="flagResidenteDallaNascita" type="ap5:char1"/>
			<xs:element name="numeroFamiglia" type="ap5:charMax14" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoIndirizzo
			Contiene i dati relativi all'Indirizzo 
			del soggetto della comunicazione
	-->
	<xs:complexType name="tipoIndirizzo">
		<xs:sequence>
			<xs:element name="cap" type="ap5:numerico5"/>
			<xs:element name="comune" type="ap5:tipoComune"/>
			<xs:element name="frazione" type="ap5:charMax80" minOccurs="0"/>
			<xs:element name="toponimo" type="ap5:tipoToponimo"/>
			<xs:element name="numeroCivico" type="ap5:tipoNumeroCivico" minOccurs="0"/>
			<xs:element name="dataDecorrenzaIndirizzo" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoCartaIdentita
			Contiene i dati relativi alla Carta di Identità 
			del soggetto della comunicazione
	-->
	<xs:complexType name="tipoCartaIdentita">
		<xs:sequence>
			<xs:element name="numeroCI" type="ap5:charMax20"/>
			<xs:element name="dataRilascioCI" type="xs:date"/>
			<xs:element name="cartaceaElettronica" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="ap5:numerico1">
						<xs:pattern value="0|1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="comuneRilascio" type="ap5:tipoComune"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoPermessoSoggiorno
			Contiene i dati relativi al Permesso di Soggiorno 
			del soggetto della comunicazione
	-->
	<xs:complexType name="tipoPermessoSoggiorno">
		<xs:sequence>
			<xs:element name="numeroSoggiorno" type="ap5:charMax20"/>
			<xs:element name="tipoSoggiorno" >
				<xs:simpleType>
					<xs:restriction base="ap5:charMax10">
						<xs:pattern value="PERMESSO|CARTA"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="dataRilascio" type="xs:date" />
			<xs:element name="dataScadenza" type="xs:date" minOccurs="0" />
			<xs:element name="questuraRilascioSoggiorno" type="ap5:tipoComune" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoCancellazioneAPR
			Contiene i dati relativi alla cancellazione dall'APR 
			del soggetto della comunicazione
	-->
	<xs:complexType name="tipoCancellazioneAPR">
		<xs:sequence>
			<xs:element name="motivoCancellazione">
				<xs:simpleType>
					<xs:restriction base="ap5:numerico1">
						<xs:pattern value="1|2|3|4|5|6|7|8"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="descrizioneMotivoCancellazione" type="ap5:charMax30" minOccurs="0"/>
			<xs:element name="dataCancellazioneAPR" type="xs:date" minOccurs="0"/>
			<xs:element name="numeroPraticaCancellazione" type="ap5:charMax30" minOccurs="0"/>
			<xs:element name="dataDefinizionePraticaCancellazione" type="xs:date" minOccurs="0"/>
			<xs:element name="luogoEmigrazione" type="ap5:tipoLuogo" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoMorte
			Contiene i dati relativi alla Morte
			del soggetto della comunicazione
	-->
	<xs:complexType name="tipoMorte">
		<xs:sequence>
			<xs:element name="dataMorte" type="xs:date"/>
			<xs:element name="luogoMorte" type="ap5:tipoLuogo" minOccurs="0"/>
			<xs:element name="attoMorte" type="ap5:tipoAtto" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoPatenti
			Contiene i dati relativi alle Patenti
			del soggetto della comunicazione
	-->
	<xs:complexType name="tipoPatenti">
		<xs:sequence>
			<xs:element name="patente" type="ap5:tipoPatente" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoPatente
			Contiene i dati relativi alla Patente 
			del soggetto della comunicazione
	-->
	<xs:complexType name="tipoPatente">
		<xs:sequence>
			<xs:element name="numeroPatente" type="ap5:charMax20"/>
			<xs:element name="carattereDiControllo" type="ap5:char1" minOccurs="0"/>
			<xs:element name="tipoPatente">
				<xs:simpleType>
					<xs:restriction base="ap5:charMax2">
						<xs:pattern value="A|B|C|D|AS|BS|CS|DS|BE|CE|DE"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="dataRilascioPatente" type="xs:date"/>
			<xs:element name="enteRilascioPatente" type="ap5:charMax80" minOccurs="0"/>
			<xs:element name="provinciaRilascioPatente" type="ap5:char2"/>
		</xs:sequence>
	</xs:complexType>
	<!--
		tipoVeicoli
	-->
	<xs:complexType name="tipoVeicoli">
		<xs:sequence>
			<xs:element name="veicolo" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="tipo">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:pattern value="A|C|M|R"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="targa" type="ap5:charMax8"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoVariazioneNomeCognome
			Contiene i nuovi dati da inserire in caso
			di variazione di cognome/nome
	-->
	<xs:complexType name="tipoVariazioneNomeCognome">
		<xs:sequence>
			<xs:element name="nuovoCognome" type="ap5:charMax80" minOccurs="0"/>
			<xs:element name="nuovoNome" type="ap5:charMax80" minOccurs="0"/>
			<xs:element name="dataVariazione" type="xs:date"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoVariazioneSesso
			Contiene i nuovi dati da inserire in caso
			di variazione di sesso
	-->
	<xs:complexType name="tipoVariazioneSesso">
		<xs:sequence>
			<xs:element name="nuovoSesso" type="ap5:tipoSesso"/>
			<xs:element name="nuovoNome" type="ap5:charMax80"/>
			<xs:element name="dataVariazione" type="xs:date"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoVariazioneCittadinanza
			Contiene i nuovi dati da inserire in caso
			di variazione di cittadinanza
	-->
	<xs:complexType name="tipoVariazioneCittadinanza">
		<xs:sequence>
			<xs:element name="nuovaCittadinanza" type="ap5:tipoCittadinanza"/>
			<xs:element name="dataVariazione" type="xs:date"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoVariazionePaternitaMaternita
			Contiene i nuovi dati da inserire in caso
			di variazione di cittadinanza
	-->
	<xs:complexType name="tipoVariazionePaternitaMaternita">
		<xs:sequence>
			<xs:element name="nuovaPaternita" type="ap5:tipoPaternita" minOccurs="0"/>
			<xs:element name="nuovaMaternita" type="ap5:tipoMaternita" minOccurs="0"/>
			<xs:element name="dataVariazione" type="xs:date"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoVariazionePermessoSoggiorno
			Contiene i dati relativi alla Variazione del Permesso di Soggiorno 
			del soggetto della comunicazione
	-->
	<xs:complexType name="tipoVariazionePermessoSoggiorno">
		<xs:sequence>
			<xs:element name="nuovoPermessoSoggiorno" type="ap5:tipoPermessoSoggiorno"/>
		</xs:sequence>
	</xs:complexType>
	<!--
		tipoDatiRettificati
	-->
	<xs:complexType name="tipoDatiRettificati">
		<xs:sequence>
			<xs:element name="rettifica" type="ap5:tipoRettifica" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<!--
		tipoConsultazionePerCodiceFiscale
	-->
	<xs:complexType name="tipoConsultazionePerCodiceFiscale">
		<xs:sequence>
			<xs:element name="codiceFiscale" type="ap5:tipoCodiceFiscale"/>
		</xs:sequence>
	</xs:complexType>
	<!--
		tipoConsultazionePerNomeCognome
	-->
	<xs:complexType name="tipoConsultazionePerNomeCognome">
		<xs:sequence>
			<xs:element name="nome" type="ap5:charMax80"/>
			<xs:element name="cognome" type="ap5:charMax80"/>
			<xs:element name="sesso" type="ap5:tipoSesso" minOccurs="0"/>
			<xs:element name="datiNascita" type="ap5:tipoDatiNascita" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
