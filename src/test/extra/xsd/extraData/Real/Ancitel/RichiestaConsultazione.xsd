<xsd:schema 
	xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
	xmlns:ap5="http://saia.ancitel.it/xmlmanager/ap5" 
	xmlns:anag="http://saia.ancitel.it/xmlmanager/anagrafico" 
	xmlns:ca="http://saia.ancitel.it/xmlmanager/consultazione" 	
	targetNamespace="http://saia.ancitel.it/xmlmanager/consultazione" 
	elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xsd:annotation>
		<xsd:documentation>Schema per la richiesta di consultazione anagrafica da comune a comune</xsd:documentation>
	</xsd:annotation>
	<xsd:import namespace="http://saia.ancitel.it/xmlmanager/anagrafico" schemaLocation="Vocabulary.xsd"  />
	<xsd:import namespace="http://saia.ancitel.it/xmlmanager/ap5" schemaLocation="BaseTypes.xsd"/>
	<xsd:complexType name="CausaleConsultazione">
		<xsd:sequence>
			<xsd:element name="motivoConsultazione" type="ap5:enumMotivoConsultazioneAnagrafica">
				<xsd:annotation>
					<xsd:documentation>Il campo tipoConsultazione può contenere i seguenti valori: 
1) Dati anagrafici
2) Dati anagrafici + Stato Civile
3) Dati anagrafici + Stato Civile + Familiari
</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="protocolloSAIA" type="ap5:tipoProtocollo" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation/>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="comuneDestinazione" type="anag:Comune"/>
			<xsd:element name="comuneOrigine" type="anag:Comune"/>
			<xsd:element name="tipoConsultazione" type="ca:enumTipoConsultazione">
				<xsd:annotation>
					<xsd:documentation>Specifica se richiesta o risposta</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="Richiesta">
		<xsd:choice>
			<xsd:element name="statoCode" type="anag:StatoCode"/>
			<xsd:element name="presaInCarico" type="anag:PresaInCarico"/>
			<xsd:element name="comunicazione" type="ca:Comunicazione" maxOccurs="unbounded"/>
		</xsd:choice>
		<xsd:attribute name="versione" type="ap5:tipoVersione">
			<xsd:annotation>
				<xsd:documentation>Versione della busta del messaggio </xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="Comunicazione">
		<xsd:sequence>
			<xsd:element name="causale" type="ca:CausaleConsultazione"/>
			<xsd:element name="messaggio" type="ca:Messaggio"/>
		</xsd:sequence>
		<xsd:attribute name="dataOraRichiesta" type="xsd:dateTime">
			<xsd:annotation>
				<xsd:documentation>Data e ora in cui è stata ricevuta la richiesta di consultazione anagrafica</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="Messaggio">
		<xsd:choice>
			<xsd:element name="interrogazioneAnagrafe" type="ca:InterrogazioneAnagrafe"/>
			<xsd:element name="rispostaAnagrafe" type="ca:RispostaAnagrafe"/>
		</xsd:choice>
		<xsd:attribute name="protocolloAnagrafe" type="ap5:tipoProtocolloAnagrafe">
			<xsd:annotation>
				<xsd:documentation>Numero di protocollo assegnato dal comune</xsd:documentation>
			</xsd:annotation>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="InterrogazioneAnagrafe">
		<xsd:sequence>
			<xsd:element name="testata" type="ca:TestataInterrogazione"/>
			<xsd:element name="corpo" type="ca:CorpoInterrogazione"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="CorpoRisposta">
		<xsd:sequence>
			<xsd:element name="cittadino" type="anag:Cittadino" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="CorpoInterrogazione">
		<xsd:sequence>
			<xsd:element name="oggettoConsultazione" type="anag:IdentificativoPersona"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="PiedeInterrogazione"/>
	<xsd:complexType name="PiedeRisposta">
		<xsd:sequence>
			<xsd:element name="tipoRelazioneFamiliare" type="ap5:enumTipoRelazioneFamiliare">
				<xsd:annotation>
					<xsd:documentation>Definisce il tipo di relazione familiare tra famiglia anagrafica o convivenza</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="descrizioneConvivenza" type="ap5:charMax100" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Descrizione del tipo di convivenza</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="numeroFamiglia" type="ap5:numericoMax12" minOccurs="0"/>
			<xsd:element name="numeroConvivenza" type="ap5:numericoMax12" minOccurs="0"/>
			<xsd:element name="residenzaNelComune" type="anag:Residenza">
				<xsd:annotation>
					<xsd:documentation>Residenza nel comune del soggetto della richiesta di consultazione anagrafica</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="RispostaAnagrafe">
		<xsd:sequence>
			<xsd:element name="testata" type="ca:TestataRisposta"/>
			<xsd:element name="corpo" type="ca:CorpoRisposta" minOccurs="0"/>
			<xsd:element name="piede" type="ca:PiedeRisposta"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TestataInterrogazione">
		<xsd:sequence>
			<xsd:element name="comuneRichiedente" type="anag:Comune"/>
			<xsd:element name="comuneDestinatario" type="anag:Comune"/>
			<xsd:element name="responsabileAnagrafe" type="anag:ResponsabileAnagrafe" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TestataRisposta">
		<xsd:sequence>
			<xsd:element name="comuneRichiedente" type="anag:Comune"/>
			<xsd:element name="rispostaDisponibile" type="ap5:tipoSN">
				<xsd:annotation>
					<xsd:documentation>Se la risposta è disponibile il corpo del messaggio contiene i dati richiesti</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="numeroPersone">
				<xsd:annotation>
					<xsd:documentation>Numero di persone coinvolte nella richiesta di consultazione</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="enumTipoConsultazione">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="richiesta da comune"/>
			<xsd:enumeration value="risposta da comune"/>
		</xsd:restriction>
	</xsd:simpleType>
</xsd:schema>
