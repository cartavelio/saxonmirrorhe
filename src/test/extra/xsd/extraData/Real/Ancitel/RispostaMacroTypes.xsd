<?xml version="1.0" encoding="UTF-8"?>
<!-- Ancitel S.p.A. La rete dei Comuni Italiani -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
           xmlns:ap5="http://saia.ancitel.it/xmlmanager/ap5" 
           targetNamespace="http://saia.ancitel.it/xmlmanager/ap5" 
           elementFormDefault="qualified" 
           attributeFormDefault="unqualified">
	<xs:include schemaLocation="BaseTypes.xsd"/>
	<!-- 
		Definizione dei tipi ad uso esclusivo delle 
		risposte da inviare ai comuni
	-->
	<!--  
		tipoRispostaGeneralita
			Contiene i dati generici di interesse relativi 
			al soggetto della comunicazione 
	-->
	<xs:complexType name="tipoRispostaGeneralita">
		<xs:sequence>
			<xs:element name="codiceFiscale" type="ap5:tipoCodiceFiscale" minOccurs="0"/>
			<xs:element name="cognome" type="ap5:charMax80"/>
			<xs:element name="nome" type="ap5:charMax80"/>
			<xs:element name="luogoNascita" type="ap5:tipoLuogo"/>
			<xs:element name="dataNascita" type="xs:date"/>
			<xs:element name="sesso" type="ap5:tipoSesso"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoRispostaDocumentoAccettato
			Contiene i dati da inviare a un comune 
			quando una comunicazione anagrafica 
			viene accettata da SAIA
	-->
	<xs:complexType name="tipoRispostaDocumentoAccettato">
		<xs:sequence>
			<xs:element name="dataOraAccettazione" type="xs:dateTime"/>
			<xs:element name="causale" type="ap5:tipoCausale"/>
			<xs:element name="protocolloAnagrafe" type="ap5:tipoProtocolloAnagrafe" minOccurs="0"/>
			<xs:element name="protocolloComunicazioneAnagrafica" type="ap5:tipoProtocollo"/>
			<xs:element name="generalitaCittadino" type="ap5:tipoRispostaGeneralita"/>
			<xs:element name="destinatario" type="ap5:charMax4" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoRispostaDocumentoNonAccettato
			Contiene i dati da inviare a un comune 
			quando una comunicazione anagrafica 
			viene accettata da SAIA
	-->
	<xs:complexType name="tipoRispostaDocumentoNonAccettato">
		<xs:sequence>
			<xs:element name="dataOraAccettazione" type="xs:dateTime"/>
			<xs:element name="causale" type="ap5:tipoCausale"/>
			<xs:element name="protocolloAnagrafe" type="ap5:tipoProtocolloAnagrafe" minOccurs="0"/>
			<xs:element name="protocolloComunicazioneAnagrafica" type="ap5:tipoProtocollo" minOccurs="0"/>
			<xs:element name="generalitaCittadino" type="ap5:tipoRispostaGeneralita"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio"/>
		</xs:sequence>
	</xs:complexType>
	
	<!--  
		tipoRispostaComuncazioneAnagrafica
			Contiene i dati da inviare a un comune 
			in risposta alle comunicazioni anagrafiche
	-->
	<xs:complexType name="tipoRispostaComunicazioneAnagrafica">
		<xs:sequence>
			<xs:element name="comunicazioneAnagrafica"  minOccurs="0" maxOccurs="unbounded">
			<xs:complexType>
				<xs:choice>
					<xs:element name="documentoAccettato" type="ap5:tipoRispostaDocumentoAccettato"/>
					<xs:element name="documentoNonAccettato" type="ap5:tipoRispostaDocumentoNonAccettato"/>
				</xs:choice>
			</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!--  
		tipoRispostaStatoDocumento
			contiene i dati da inviare a un comune 
			in risposta a una richiesta di 
			osservare lo stato della coda, relativi
			a un singolo documento
	-->
	<xs:complexType name="tipoRispostaStatoDocumento">
		<xs:sequence>
			<xs:element name="riferimenti" type="ap5:tipoDatiRisposta" minOccurs="0"/>
			<xs:element name="statoDocumento" type="ap5:tipoStatoDocumento" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoRispostaStatoDocumento
			contiene i dati relativi allo stato 
			di un singolo documento
	-->
	<xs:complexType name="tipoStatoDocumento">
		<xs:sequence>
			<xs:choice>
				<xs:element name="codiceEnteDestinatario" type="ap5:charMax4" minOccurs="0"/>
				<xs:element name="codiceISTATComuneDestinatario" type="ap5:numerico6" minOccurs="0"/>
			</xs:choice>
			<xs:element name="tipoDocumento" type="ap5:char4" minOccurs="0"/>
			<xs:element name="stato" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="A|I|C|R"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="dataInoltro" type="xs:date" minOccurs="0"/>
			<xs:element name="protocolloInoltro" type="ap5:tipoProtocollo" minOccurs="0"/>
			<xs:element name="dataAccettazioneRisposta" type="xs:date" minOccurs="0"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		tipoDatiRisposta
			contiene i dati comuni 
			a tutte le risposte da inviare ai comuni
	-->
	<xs:complexType name="tipoDatiRisposta">
		<xs:sequence>
			<xs:element name="protocolloAnagrafe" type="ap5:tipoProtocolloAnagrafe" minOccurs="0"/>
			<xs:element name="protocolloComunicazioneAnagrafica" type="ap5:tipoProtocollo"/>
			<xs:element name="dataAccettazione" type="xs:date"/>
			<xs:element name="dataDecorrenzaComunicazione" type="xs:date" minOccurs="0"/>
			<xs:element name="causale" type="ap5:tipoCausale" minOccurs="0"/>
			<xs:element name="generalitaCittadino" type="ap5:tipoRispostaGeneralita" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoEsito
	-->
	<xs:complexType name="tipoEsito">
		<xs:sequence>
			<xs:choice>
				<xs:element name="codiceIstatComuneDestinatario" type="ap5:numerico6"/>
				<xs:element name="codiceEnteDestinatario" type="ap5:charMax4"/>
			</xs:choice>
			<xs:element name="dataInoltro" type="xs:date"/>
			<xs:element name="dataOraPresaVisioneEsito" type="xs:dateTime"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio"/>
			<xs:element name="note" type="ap5:charMax1024" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="protocolloRisposta" type="ap5:tipoProtocollo"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		tipoEsitoAE
	-->
	<xs:complexType name="tipoEsitoAE">
		<xs:sequence>
			<xs:choice>
				<xs:element name="codiceIstatComuneDestinatario" type="ap5:numerico6"/>
				<xs:element name="codiceEnteDestinatario" type="ap5:charMax4"/>
			</xs:choice>
			<xs:element name="dataInoltro" type="xs:date"/>
			<xs:element name="dataOraPresaVisioneEsito" type="xs:dateTime"/>
			<xs:element name="codiceFiscaleAttribuito" type="ap5:tipoCodiceFiscale" minOccurs="0"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio"/>
			<xs:element name="note" type="ap5:charMax1024" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="protocolloRisposta" type="ap5:tipoProtocollo"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoRispostaDaEnte
	-->
	<xs:complexType name="tipoRispostaPresaInCarico">
		<xs:sequence>
			<xs:element name="riferimenti" type="ap5:tipoDatiRisposta" minOccurs="0"/>
			<xs:element name="esito" type="ap5:tipoEsito" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="esitoAE" type="ap5:tipoEsitoAE" minOccurs="0"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		tipoErrore
	-->
	<xs:complexType name="tipoErrore">
		<xs:sequence>
			<xs:element name="tipo" type="ap5:charMax20"/>
			<xs:element name="codice" type="ap5:charMax10" minOccurs="0"/>
			<xs:element name="messaggio">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
						<xs:maxLength value="1024"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="dataOra" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:dateTime">
						<xs:whiteSpace value="collapse"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		tipoRispostaConsultazioni
	-->
	<xs:complexType name="tipoRispostaConsultazioni">
		<xs:sequence>
			<xs:element name="consultazione" type="ap5:tipoRispostaConsultazione" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<!--
		tipoRispostaConsultazione
	-->
	<xs:complexType name="tipoRispostaConsultazione">
    <xs:choice>
			<xs:element name="errore" type="ap5:tipoErrore"></xs:element>

			<xs:element name="messaggio" type="ap5:tipoMessaggio"></xs:element>
			<xs:element name="risultati" maxOccurs="unbounded" type="ap5:tipoRisultatoConsultazione">
			</xs:element>
    </xs:choice>
    <xs:attribute name="protocolloConsultazione" type="ap5:tipoProtocollo" use="required"/>
		<xs:attribute name="idConsultazione" type="xs:long" use="required" />
	</xs:complexType>
	<!--
		tipoRispostaConsultazioneINA
	-->
	<xs:complexType name="tipoRispostaConsultazioneINA">
		<xs:sequence>
			<xs:element name="dataCaricamento" type="xs:date"/>
			<xs:element name="dataUltimoAggiornamento" type="xs:date"/>
			<xs:element name="comuneResidenza" type="ap5:tipoComune"/>
			<xs:element name="dataDecesso" type="xs:date" minOccurs="0"/>
			<xs:element name="inEsame" type="ap5:tipoSN"/>
			<xs:element name="validatiDatiAnagrafici" type="ap5:tipoSN"/>
			<xs:element name="validatoCF" type="ap5:tipoSN"/>
		</xs:sequence>
	</xs:complexType>
	<!--
		tipoRispostaConsultazioneAE
	-->
	<xs:complexType name="tipoRispostaConsultazioneAE">
		<xs:sequence>
			<xs:element name="decesso" type="ap5:tipoRispostaDecessoConsultazioneAE" minOccurs="0"/>
			<xs:element name="ufficioCompetente" type="ap5:tipoUfficioConsultazioneAE" minOccurs="0"/>
			<xs:element name="assegnazioneCodiceFiscale" type="ap5:tipoAssegnazioneCodiceFiscaleConsultazioneAE" minOccurs="0"/>
			<xs:element name="confermaDatiAnagrafici" type="ap5:tipoConfermaDatiAnagraficiConsultazioneAE" minOccurs="0"/>
			<xs:element name="tesseraSanitaria" type="ap5:tipoTesseraSanitariaConsultazioneAE" minOccurs="0"/>
			<xs:element name="storicoResidenze" type="ap5:tipoStoricoResidenzeConsultazioneAE" minOccurs="0"/>
			<xs:element name="storicoResidenzeEstere" type="ap5:tipoStoricoResidenzeEstereConsultazioneAE" minOccurs="0"/>
			<xs:element name="elencoCodiciFiscali" type="ap5:tipoElencoCodiciFiscaliConsultazioneAE" minOccurs="0"/>
			<xs:element name="elencoSinonimiPersoneFisiche" type="ap5:tipoElencoSinonimiPersoneFisicheConsultazioneAE" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="tipoRisultatoConsultazione">
		<xs:sequence>
			<xs:element name="generalita" type="ap5:tipoRispostaGeneralita" />
			<xs:choice>
				<xs:element name="consultazioneINA" type="ap5:tipoRispostaConsultazioneINA" />
				<xs:element name="consultazioneAE" type="ap5:tipoRispostaConsultazioneAE" />
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
