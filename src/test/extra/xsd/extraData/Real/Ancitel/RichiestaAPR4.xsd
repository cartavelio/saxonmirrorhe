<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2006 rel. 3 sp2 (http://www.altova.com) by Luigi Selmi (sharesemantics) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns:anag="http://saia.ancitel.it/xmlmanager/anagrafico" 
xmlns:apr4="http://saia.ancitel.it/xmlmanager/apr4" 
xmlns:ap5="http://saia.ancitel.it/xmlmanager/ap5" 
targetNamespace="http://saia.ancitel.it/xmlmanager/apr4" 
elementFormDefault="qualified" attributeFormDefault="unqualified">

	<xs:import namespace="http://saia.ancitel.it/xmlmanager/anagrafico" schemaLocation="Vocabulary.xsd"/>
	<xs:import namespace="http://saia.ancitel.it/xmlmanager/ap5" schemaLocation="BaseTypes.xsd"/>
	<!-- 
		Richiesta SAIA
	 -->
	<xs:complexType name="TestataInvioAPR4">
		<xs:sequence>
			<xs:element name="tipoRichiestaCancellazione" type="ap5:enumTipoRichiestaCancellazione">
				<xs:annotation>
					<xs:documentation>Descrive il tipo di richiesta di cancellazione nell’ambito di un insieme definito da un tipo enumerato</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="motivoSpedizionePratica" type="ap5:enumMotivoSpedizionePratica" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Motivazione per la spedizione della pratica da parte del responsabile dell’anagrafe del comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="codiceStatoEsteroCancellazione" type="ap5:numerico3" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Codice stato estero ISO 3166</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="comuneCancellazione" type="anag:Comune">
				<xs:annotation>
					<xs:documentation>Comune di emigrazione che deve effettuare la cancellazione del cittadino emigrato dalla propria anagrafe</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="numeroPersone" type="ap5:numericoMax2">
				<xs:annotation>
					<xs:documentation>Numero di persone da cancellare dall'anagrafe del comune di emigrazione contenute nel modello APR4. Deve essere pari al numero di persone coinvolte nel modello APR4 </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="responsabilePraticaIscrizione" type="anag:ResponsabileAnagrafe" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Responsabile dei servizi anagrafici del comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="praticaIscrizione" type="anag:PraticaIscrizioneAnagrafe">
				<xs:annotation>
					<xs:documentation>Dati della pratica di iscrizione all’anagrafe del comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Causale:
			contiene i dati relativi alla Causale 
			della comuinicazione
	-->
	<xs:complexType name="Causale">
		<xs:sequence>
			<xs:element name="tipoComunicazione">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="15"/>
						<xs:pattern value="apr4"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="motivoComunicazione">
				<xs:simpleType>
					<xs:restriction base="ap5:numericoMax2">
						<xs:pattern value="1|2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="protocolloSAIA" type="ap5:tipoProtocollo" minOccurs="0">
				<xs:annotation>
					<xs:documentation/>
				</xs:annotation>
			</xs:element>
			<xs:element name="comuneImmigrazione" type="anag:Comune"/>
			<xs:element name="comuneEmigrazione" type="anag:Comune"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Comunicazione APR4
	 -->
	<xs:complexType name="ComunicazioneAPR4">
		<xs:annotation>
			<xs:documentation>Dati di invio o completamento di un modello APR4</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="causale" type="apr4:Causale">
				<xs:annotation>
					<xs:documentation>Contiene il campo per il numero di protocollo SAIA, il comune di immigrazione e quello di emigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="modello" type="apr4:ModelloAPR4">
				<xs:annotation>
					<xs:documentation>Contiene un modello APR4 inviato da un comune di immigrazione o completato da un comune di emigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="dataOraRichiesta" type="xs:dateTime">
			<xs:annotation>
				<xs:documentation>Data e ora in cui è stata inviata la comunicazione contenente il modelllo APR4 </xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<!-- 
		Modello APR4
	 -->
	<xs:complexType name="ModelloAPR4">
		<xs:choice>
			<xs:element name="invioAPR4" type="apr4:InvioAPR4"/>
			<xs:element name="completamentoAPR4" type="apr4:CompletamentoAPR4"/>
		</xs:choice>
		<xs:attribute name="protocolloAnagrafe" type="ap5:tipoProtocolloAnagrafe">
			<xs:annotation>
				<xs:documentation>Numero di protocollo assegnato dal comune</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<!-- 
		Richiesta
	 -->
	<xs:complexType name="Richiesta">
		<xs:choice>
			<xs:element name="statoCode" type="anag:StatoCode"/>
			<xs:element name="presaInCarico" type="anag:PresaInCarico"/>
			<!-- consultazione -->
			<xs:element name="comunicazione" type="apr4:ComunicazioneAPR4" maxOccurs="unbounded"/>
		</xs:choice>
		<xs:attribute name="versione" type="ap5:tipoVersione">
			<xs:annotation>
				<xs:documentation>Versione della busta del messaggio</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="CompletamentoAPR4">
		<xs:annotation>
			<xs:documentation>Contiene i dati del modello APR4 comletato dal comune di emigrazione</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="testata" type="apr4:TestataCompletamentoAPR4"/>
			<xs:element name="dettaglio" type="apr4:DettaglioAPR4" maxOccurs="unbounded"/>
			<xs:element name="piede" type="apr4:PiedeCompletamentoAPR4"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InvioAPR4">
		<xs:sequence>
			<xs:element name="testata" type="apr4:TestataInvioAPR4"/>
			<xs:element name="dettaglio" type="apr4:DettaglioAPR4" maxOccurs="unbounded"/>
			<xs:element name="piede" type="apr4:PiedeInvioAPR4"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PiedeInvioAPR4">
		<xs:sequence>
			<xs:element name="dichiarante" type="anag:PersonaAnagrafica" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Dati anagrafici del dichiarante</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="intestatarioScheda" type="anag:PersonaAnagrafica" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Dati anagrafici del capo famiglia intestatario della scheda</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="tipoRelazioneFamiliare" type="ap5:enumTipoRelazioneFamiliare">
				<xs:annotation>
					<xs:documentation>Dichiara il tipo di relazione familiare tra famiglia anagrafica o convivenza</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="descrizioneConvivenza" type="ap5:charMax100" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Descrizione del tipo di convivenza</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="residenzaNelComune" type="anag:Residenza" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Residenza nel comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="residenzaEstero" type="anag:ResidenzaEstera" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Residenza all’estero indicante il codice ISO 3166 dello stato</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TestataCompletamentoAPR4">
		<xs:sequence>
			<xs:element name="tipoRichiestaCancellazione" type="ap5:numerico1">
				<xs:annotation>
					<xs:documentation>Descrive il tipo di richiesta di cancellazione nell’ambito di un insieme definito da un tipo enumerato</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="motivoSpedizionePratica" type="ap5:numerico1" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Motivazione per la spedizione della pratica da parte del responsabile dell’anagrafe del comune di emigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="codiceStatoEsteroCancellazione" type="ap5:numerico3" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Codice stato estero ISO 3166</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="comuneCancellazione" type="anag:Comune">
				<xs:annotation>
					<xs:documentation>Comune di emigrazione che deve effettuare la cancellazione del cittadino emigrato dalla propria anagrafe</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="numeroPersone" type="ap5:numericoMax2">
				<xs:annotation>
					<xs:documentation>Numero di persone da cancellare dall'anagrafe del comune di emigrazione contenute nel modello APR4. Deve essere pari al numero delle persone coinvolte nel modello APR4 riportate nel dettaglio</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="responsabilePraticaIscrizione" type="anag:ResponsabileAnagrafe" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Responsabile dei servizi anagrafici del comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="praticaIscrizione" type="anag:Pratica">
				<xs:annotation>
					<xs:documentation>Dati della pratica di iscrizione all’anagrafe del comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="praticaCancellazione" type="anag:PraticaCancellazioneAnagrafe">
				<xs:annotation>
					<xs:documentation>Dati della pratica di cancellazione dall’anagrafe del comune di emigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="responsabilePraticaCancellazione" type="anag:ResponsabileAnagrafe" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Dati del responsabile dei servizi anagrafici del comune di emigrazione che ha lavorato la pratica di cancellazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="provvedimentoCancellazione" type="apr4:ProvvedimentoCancellazione" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tipo di cancellazione dall’anagrafe effettuata in seguito a  provvedimento</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="provvedimentoIscrizione" type="apr4:ProvvedimentoIscrizione" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Tipo di iscrizione all’anagrafe effettuata in seguito a  provvedimento</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="confermaCancellazioneDaAnagrafe">
				<xs:complexType>
					<xs:choice>
						<xs:element name="confermaCancellazione" type="apr4:ConfermaCancellazione">
							<xs:annotation>
								<xs:documentation>Tipo di conferma di cancellazione</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="confermaCancellazioneSenzaProvvedimento" type="apr4:ConfermaCancellazioneSenzaProvvedimento">
							<xs:annotation>
								<xs:documentation>Contiene il tipo di motivo di restituzione senza provvedimento di cancellazione</xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DettaglioAPR4">
		<xs:sequence>
			<xs:element name="cittadino">
				<xs:annotation>
					<xs:documentation>Contiene i dati di un cittadino utilizzati dai servizi anagrafici comunali. </xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="anag:Cittadino">
							<xs:attribute name="progressivo">
								<xs:annotation>
									<xs:documentation>Indice del cittadino coinvolto nella comunicazione</xs:documentation>
								</xs:annotation>
							</xs:attribute>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element name="allegatoAnomalia" type="apr4:AllegatoAnomalia" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Contiene informazioni aggiuntive sul cittadino fornite dal comune di emigrazione riguardanti la residenza in uno stato estero e informazioni sulla cancellazione del cittadino dall'anagrafe </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PiedeCompletamentoAPR4">
		<xs:sequence>
			<xs:element name="dichiarante" type="anag:PersonaAnagrafica" minOccurs="0"/>
			<xs:element name="intestatarioScheda" type="anag:PersonaAnagrafica" minOccurs="0"/>
			<xs:element name="tipoRelazioneFamiliare" type="ap5:numerico1">
				<xs:annotation>
					<xs:documentation>Dichiara il tipo di relazione familiare tra famiglia anagrafica o convivenza</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="descrizioneConvivenza" type="ap5:charMax100" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Descrizione del tipo di convivenza</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="residenzaNelComune" type="anag:Residenza" minOccurs="0"/>
			<xs:element name="residenzaEstero" type="anag:ResidenzaEstera" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ConfermaCancellazione">
		<xs:sequence>
			<xs:element name="tipo" type="ap5:enumTipoConfermaCancellazione"/>
			<xs:element name="codiceStatoEstero" type="ap5:numerico3" minOccurs="0"/>
			<xs:element name="data" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ConfermaCancellazioneSenzaProvvedimento">
		<xs:complexContent>
			<xs:extension base="apr4:ConfermaCancellazione">
				<xs:sequence>
					<xs:element name="motivoRestituzioneSenzaProvvedimento" type="ap5:enumMotivoRestituzioneSenzaProvvedimento"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="ProvvedimentoCancellazione">
		<xs:sequence>
			<xs:element name="provvedimentoCancellazione" type="ap5:enumProvvedimentoCancellazione"/>
			<xs:element name="codiceStatoEsteroDestinazione" type="ap5:numerico3"/>
			<xs:element name="altroMotivoCancellazione" type="ap5:charMax40" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProvvedimentoIscrizione">
		<xs:sequence>
			<xs:element name="provvedimentoIscrizione">
				<xs:simpleType>
					<xs:restriction base="ap5:enumProvvedimentoIscrizione"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="codiceStatoEsteroProvenienza" type="ap5:numerico3"/>
			<xs:element name="altroMotivoIscrizione" type="ap5:charMax40" minOccurs="0"/>
			<xs:element name="dataPrecedenteCancellazione" type="xs:date">
				<xs:annotation>
					<xs:documentation>Data precedente cancellazione per irreperibilita'</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AllegatoAnomalia">
		<xs:sequence>
			<xs:element name="provvedimentoCancellazione" type="apr4:ProvvedimentoCancellazione" minOccurs="0"/>
			<xs:element name="provvedimentoIscrizione" type="apr4:ProvvedimentoIscrizione" minOccurs="0"/>
			<xs:element name="confermaCancellazione" minOccurs="0">
				<xs:complexType>
					<xs:choice>
						<xs:element name="cancellazioneConProvvedimento" type="apr4:ConfermaCancellazione"/>
						<xs:element name="cancellazioneSenzaProvvedimento" type="apr4:ConfermaCancellazioneSenzaProvvedimento"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
