<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2006 rel. 3 sp2 (http://www.altova.com) by Luigi Selmi (sharesemantics) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
xmlns:apr4="http://saia.ancitel.it/xmlmanager/apr4" 
xmlns:anag="http://saia.ancitel.it/xmlmanager/anagrafico" 
xmlns:ap5="http://saia.ancitel.it/xmlmanager/ap5" 
targetNamespace="http://saia.ancitel.it/xmlmanager/apr4" 
elementFormDefault="qualified" attributeFormDefault="unqualified">

	<xs:include schemaLocation="RichiestaAPR4.xsd"/>
	<xs:import namespace="http://saia.ancitel.it/xmlmanager/anagrafico" schemaLocation="Vocabulary.xsd"/>	
	<xs:import namespace="http://saia.ancitel.it/xmlmanager/ap5" schemaLocation="BaseTypes.xsd"/>
	<!--  
		Risposta:
			definisce la struttura della singola risposta
	-->
	<xs:complexType name="Risposta">
		<xs:choice>
			<!-- 
				Risposta Comunicazione Anagrafica Accettata/Non Accettata
			-->
			<xs:element name="comunicazioniAPR4" type="apr4:RispostaComunicazioneAPR4">
				<xs:annotation>
					<xs:documentation>Informazioni di riepilogo e di validità dei modelli ricevuti dal server</xs:documentation>
				</xs:annotation>
			</xs:element>
			<!-- 
				Risposta a Stato Coda 
			-->
			<xs:element name="statoCode">
				<xs:annotation>
					<xs:documentation>Stato dei modelli inviati, e delle richieste provenienti da altri comuni in attesa di essere prese in carico</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="statoModello" type="apr4:StatoModelloAPR4" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="presaInCarico">
				<xs:annotation>
					<xs:documentation>Dati del modelli inviati o completati da altro comune</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="risposta" type="apr4:RispostaPresaInCarico" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
					<xs:attribute name="ultimoId" type="xs:string">
						<xs:annotation>
							<xs:documentation>Chiave identificativa dell’ultimo lotto di modelli presi in carico</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="versione" type="ap5:tipoVersione">
			<xs:annotation>
				<xs:documentation>Versione della busta del messaggio </xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="RispostaPresaInCarico">
		<xs:choice>
			<xs:element name="comunicazioneAPR4" type="apr4:ComunicazioneAPR4"/>
			<xs:element name="rispostaAPR4" type="apr4:RispostaModello"/>
		</xs:choice>
	</xs:complexType>
	<!--  
		RispostaDocumentoAccettato:
			contiene i dati da inviare a un comune 
			quando una comunicazione anagrafica 
			viene accettata da SAIA
	-->
	<xs:complexType name="RispostaModelloAccettato">
		<xs:sequence>
			<xs:element name="dataOraAccettazione" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Data e ora in cui il modello è stato ricevuto e sottoposto a validazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="causale" type="apr4:Causale"/>
			<xs:element name="protocolloAnagrafe" type="ap5:tipoProtocolloAnagrafe" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato al modello dal comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="protocolloSAIA" type="ap5:tipoProtocollo">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato dal SAIA</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dichiarante" type="anag:PersonaAnagrafica"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Contiene un messaggio del SAIA</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--  
		RispostaDocumentoNonAccettato:
			contiene i dati da inviare a un comune 
			quando una comunicazione anagrafica 
			NON viene accettata da SAIA
	-->
	<xs:complexType name="RispostaModelloNonAccettato">
		<xs:sequence>
			<xs:element name="dataOraAccettazione" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Data e ora in cui il modello è stato ricevuto e sottoposto a validazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="causale" type="apr4:Causale"/>
			<xs:element name="protocolloAnagrafe" type="ap5:tipoProtocolloAnagrafe" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato al modello dal comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dichiarante" type="anag:PersonaAnagrafica"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio">
				<xs:annotation>
					<xs:documentation>Contiene un messaggio del SAIA</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--  
		RispostaDocumentoNonAccettato:
			contiene i dati da inviare a un comune 
			quando una comunicazione anagrafica 
			NON viene accettata da SAIA
	-->
	<xs:complexType name="RispostaModello">
		<xs:sequence>
			<xs:element name="dataOraRisposta" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Data e ora in cui il SAIA invia la risposta della presa in carico</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="causale" type="apr4:Causale">
				<xs:annotation>
					<xs:documentation>Contiene il numero di protocollo SAIA, il codice ISTAT del comune di immigrazione e quello del comune di emigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="protocolloAnagrafe" type="ap5:tipoProtocolloAnagrafe" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo del comune </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dichiarante" type="anag:PersonaAnagrafica" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Dati anagrafici del dichiarante</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="esito" type="ap5:tipoMessaggio">
				<xs:annotation>
					<xs:documentation>Esito dell’invio del modello</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="esitoVerificaPersona" type="apr4:EsitoVerificaPersona" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Esito della verifica INA dei cittadini coinvolti nella pratica</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--  
		RispostaGeneralita:
			contiene i dati generici di interesse relativi 
			al soggetto della comunicazione 
	-->
	<xs:complexType name="RispostaGeneralita">
		<xs:sequence/>
	</xs:complexType>
	<!--  
		RispostaComunicazioneAPR4:
			contiene i dati da inviare a un comune 
			in risposta alle comunicazioni anagrafiche
	-->
	<xs:complexType name="RispostaComunicazioneAPR4">
		<xs:sequence>
			<xs:element name="rispostaComunicazioneAPR4" maxOccurs="unbounded">
				<xs:complexType>
					<xs:choice>
						<xs:element name="modelloAccettato" type="apr4:RispostaModelloAccettato"/>
						<xs:element name="modelloNonAccettato" type="apr4:RispostaModelloNonAccettato"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--  
		Esito
	-->
	<xs:complexType name="Esito">
		<xs:sequence>
			<xs:element name="dataInoltro" type="xs:date"/>
			<xs:element name="dataOraPresaVisioneEsito" type="xs:dateTime"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio"/>
			<xs:element name="note" type="ap5:charMax1024" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="protocolloRisposta" type="ap5:tipoProtocollo"/>
			<xs:element name="comuneDestinatario" type="anag:Comune" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		StatoModello APR4:
			contiene i dati relativi allo stato 
			di un singolo modello APR4
	-->
	<xs:complexType name="StatoModelloAPR4">
		<xs:sequence>
			<xs:element name="protocolloSAIA" type="ap5:tipoProtocollo">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato dal SAIA al modello APR4 inviato dal comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="protocolloCompletamentoSAIA" type="ap5:tipoProtocollo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato dal SAIA al modello APR4 completato ricevuto dal comune di emigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="tipoDocumento" type="ap5:charMax20" minOccurs="0"/>
			<xs:element name="comuneIscrizione" type="anag:Comune">
				<xs:annotation>
					<xs:documentation>Contiene il codice ISTAT del comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="comuneCancellazione" type="anag:Comune">
				<xs:annotation>
					<xs:documentation>Contiene il codice ISTA del comune di emigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="stato" type="ap5:enumStatoDocumento">
				<xs:annotation>
					<xs:documentation>Contiene lo stato del documento ricevuto dal SAIA: accettato, completato, preso in carico.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="descrizioneStatoDocumento" type="ap5:charMax120">
				<xs:annotation>
					<xs:documentation>Contiene la descrizione dello stato del documento APR4</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dataInoltro" type="xs:date" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Data inoltro agli enti</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dataRichiestaCancellazione" type="xs:date">
				<xs:annotation>
					<xs:documentation>Data in cui è stata inviata la richiesta di cancellazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dataAccettazioneRisposta" type="xs:date" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Data in cui il SAIA ha accettato il modello completato dal comune di emigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="messaggio" type="ap5:tipoMessaggio" minOccurs="0"/>
			<xs:element name="protocolloComuneIscrizione" type="ap5:tipoProtocollo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato dal comune di immigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="protocolloComuneCancellazione" type="ap5:tipoProtocollo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato dal comune di emigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Dati presa in carico:
			contiene i dati comuni 
			a tutte le risposte da inviare ai comuni
	-->
	<xs:complexType name="DatiPresaInCarico">
		<xs:sequence>
			<xs:element name="datiInvioAPR4"/>
			<xs:element name="datiCompletamentoAPR4"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="EsitoVerificaPersona">
		<xs:sequence>
			<xs:element name="persona" type="anag:PersonaAnagrafica"/>
			<xs:element name="esito" type="ap5:tipoMessaggio"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
