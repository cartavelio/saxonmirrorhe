<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ap5="http://saia.ancitel.it/xmlmanager/ap5" 
xmlns:apr4="http://saia.ancitel.it/xmlmanager/apr4" 
xmlns:ca="http://saia.ancitel.it/xmlmanager/consultazione" 
targetNamespace="http://saia.ancitel.it/xmlmanager/ap5" 
elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="RispostaMacroTypes.xsd"/>
	<xs:import namespace="http://saia.ancitel.it/xmlmanager/apr4" schemaLocation="RispostaAPR4.xsd"/>
	<xs:import namespace="http://saia.ancitel.it/xmlmanager/consultazione" schemaLocation="RispostaConsultazione.xsd"/>	
	<!--  
		tipoRisposta
			definisce la struttura della singola risposta
	-->
	<xs:complexType name="tipoRisposta">
		<xs:choice>
			<!-- 
				Risposta Comunicazione Anagrafica Accettata/Non Accettata
			-->
			<xs:element name="comunicazioniAnagrafiche" type="ap5:tipoRispostaComunicazioneAnagrafica"/>
			<!-- 
				Risposta a Stato Coda 
			-->
			<xs:element name="statoCode">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="documento" type="ap5:tipoRispostaStatoDocumento" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<!-- 
				Risposta a Presa in Carico 
			-->
			<xs:element name="presaInCarico">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="documento" type="ap5:tipoRispostaPresaInCarico" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
					<xs:attribute name="ultimoId" type="xs:string" use="required"/>
				</xs:complexType>
			</xs:element>
			<!-- 
				Risposta a Consultazioni
			-->
			<xs:element name="consultazioni" type="ap5:tipoRispostaConsultazioni"/>
		</xs:choice>
		<xs:attribute name="versione" type="ap5:tipoVersione" use="required"/>
	</xs:complexType>
	<!--  
		tipoRispostaSAIA
			struttura della risposta SAIA:
				i dati del comune mittente della comunicazione
				un eventuale contenitore per le risposte
				un eventuale errore fatale
	-->
	<xs:complexType name="tipoRispostaSAIA">
		<xs:sequence>
			<xs:choice>
				<xs:element name="risposta" type="ap5:tipoRisposta" minOccurs="0"/>
				<xs:element name="rispostaApr4" type="apr4:Risposta" minOccurs="0"/>
				<xs:element name="rispostaConsultazioneAnagrafica" type="ca:Risposta"/>
			</xs:choice>
			<xs:element name="errore" type="ap5:tipoErrore" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="versione" type="ap5:tipoVersione" use="required"/>
		<xs:attribute name="dataOraRisposta" type="xs:dateTime"/>
	</xs:complexType>
	<!--  
		root element
		
		rispostaSAIA
			contiene le risposte da inviare al comune
			e/o l'errore fatale che si è verificato durante l'elaborazione delle richieste
	-->
	<xs:element name="rispostaSAIA" type="ap5:tipoRispostaSAIA"/>
</xs:schema>
