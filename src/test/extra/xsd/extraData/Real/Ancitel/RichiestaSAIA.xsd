<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	xmlns:ap5="http://saia.ancitel.it/xmlmanager/ap5" 
	xmlns:apr4="http://saia.ancitel.it/xmlmanager/apr4" 
	xmlns:ca="http://saia.ancitel.it/xmlmanager/consultazione" 	
	targetNamespace="http://saia.ancitel.it/xmlmanager/ap5" 
	elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="ComAnagTypes.xsd"/>
	<xs:import namespace="http://saia.ancitel.it/xmlmanager/consultazione" schemaLocation="RichiestaConsultazione.xsd"/>	
	<!--xs:import namespace="http://saia.ancitel.it/xmlmanager/apr4" schemaLocation="RichiestaAPR4.xsd"/-->
	
	<xs:complexType name="tipoRichiesta">
		<xs:choice>
			<xs:element name="comunicazione" type="ap5:tipoComGenerica" maxOccurs="unbounded"/>
			<xs:element name="statoCode" type="ap5:tipoStatoCode"/>
			<xs:element name="presaInCarico" type="ap5:tipoPresaInCarico"/>
			<xs:element name="consultazione" type="ap5:tipoConsultazione" maxOccurs="unbounded"/>
		</xs:choice>
		<xs:attribute name="versione" type="ap5:tipoVersione"/>
	</xs:complexType>
	<xs:complexType name="tipoRichiestaSAIA">
		<xs:sequence>
			<xs:element name="mittente" type="ap5:tipoMittente"/>
			<xs:element name="utente" type="ap5:tipoUtente"/>
			<xs:element name="applicazioneAnagrafe" type="ap5:tipoApplicazioneAnagrafe"/>
			<xs:choice>
				<xs:element name="richiesta" type="ap5:tipoRichiesta"/>
				<!--xs:element name="richiestaApr4" type="apr4:Richiesta"/-->
				<xs:element name="richiestaConsultazioneAnagrafica" type="ca:Richiesta"/>
			</xs:choice>
		</xs:sequence>
		<xs:attribute name="versione" type="ap5:tipoVersione" use="required"/>
		<xs:attribute name="versioneXMLSAIA" type="ap5:tipoVersione" use="required"/>
	</xs:complexType>
	<xs:element name="richiestaSAIA" type="ap5:tipoRichiestaSAIA"/>
</xs:schema>
