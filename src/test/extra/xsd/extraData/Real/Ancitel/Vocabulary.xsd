<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2006 rel. 3 sp2 (http://www.altova.com) by Luigi Selmi (sharesemantics) -->
<!-- Ancitel S.p.A. La rete dei Comuni Italiani -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	xmlns:anag="http://saia.ancitel.it/xmlmanager/anagrafico" 
	xmlns:ap5="http://saia.ancitel.it/xmlmanager/ap5" 
	targetNamespace="http://saia.ancitel.it/xmlmanager/anagrafico" 
	elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:import namespace="http://saia.ancitel.it/xmlmanager/ap5" schemaLocation="BaseTypes.xsd"/>
	<xs:complexType name="PresaInCarico">
		<xs:annotation>
			<xs:documentation>Presa in carico delle richieste e delle risposte inviate dai comuni attraverso il SAIA</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="protocolloSAIA" type="ap5:tipoProtocollo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato dal SAIA in seguito all’accettazione di un messaggio.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="dataOraRichiesta" type="xs:dateTime">
			<xs:annotation>
				<xs:documentation>Data e ora in cui è stata ricevuta la richiesta di presa in carico dal SAIA</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="ultimoId" type="xs:string" default="0">
			<xs:annotation>
				<xs:documentation>Chiave identificativa dell’ultimo lotto di comunicazionii prese in carico</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="StatoCode">
		<xs:annotation>
			<xs:documentation>Stato delle richieste inviate precedentemente e delle risposte o richieste provenienti da altri comuni, in attesa di essere presi in carico</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="protocolloSAIA" type="ap5:tipoProtocollo" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="dataOraRichiesta" type="xs:dateTime">
			<xs:annotation>
				<xs:documentation>Data e ora in cui è stata ricevuta la richiesta di stato code dal SAIA</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="ultimoId" type="xs:string" default="0">
			<xs:annotation>
				<xs:documentation>Chiave identificativa dell’ultimo lotto di richieste stato code</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="StoricoResidenza">
		<xs:sequence>
			<xs:element name="residenza" maxOccurs="unbounded">
				<xs:complexType>
					<xs:choice>
						<xs:element name="residenzaItalia" type="anag:Residenza"/>
						<xs:element name="residenzaEstero" type="anag:ResidenzaEstera"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Cittadino
	 -->
	<xs:complexType name="Cittadino">
		<xs:sequence>
			<xs:element name="generalita" type="anag:Generalita">
				<xs:annotation>
					<xs:documentation>Contiene i dati anagrafici del cittadino, utili alla sua identificazione, lo stato civile e la cittadinanza</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="nascita" type="anag:Nascita" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Contiene i dati della nascita di un cittadino</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="matrimonio" type="anag:Matrimonio" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Contiene la data del matrimonio, nome e cognome del coniuge, il regime patrimoniale ed eventualmente informazioni sulla cessazione dello stesso per divorzio o morte del coniuge</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="famigliaAnagrafica" type="anag:FamigliaAnagrafica">
				<xs:annotation>
					<xs:documentation>Dati riguardanti la famiglia del cittadino e la relazione di parentela</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="residenza" type="anag:Residenza" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Residenza del cittadino</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="gruppoLinguistico" type="ap5:enumGruppoLinguistico" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Gruppo linguistico di appartenenza del cittadino</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="professione" type="anag:Professione" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Contiene informazioni riguardanti il titolo di studio e la professione di un cittadino</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="pensioni" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Elenco delle pensioni godute dal cittadino</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="pensione" type="anag:Pensione"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="documenti" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Elenco dei documenti rilasciati al cittadino: carta d’identità, libretto di lavoro, libretto sanitario</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="librettoSanitario" type="anag:DocumentoIndividuale" minOccurs="0"/>
						<xs:element name="cartaIdentita" type="anag:CartaIdentita" minOccurs="0"/>
						<xs:element name="librettoDiLavoro" type="anag:DocumentoIndividuale" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="emigrazione" type="anag:Emigrazione" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Informazioni sulla residenza all'estero e sull'iscrizione all'AIRE
</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="datiAnagrafe" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Informazioni riguardanti le pratiche di iscrizione e cancellazione dall'anagrafe</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="iscrizioneAnagrafe" type="anag:PraticaIscrizioneAnagrafe" minOccurs="0"/>
						<xs:element name="cancellazioneAnagrafe" type="anag:PraticaCancellazioneAnagrafe" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="statistiche" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Informazioni riguardanti l'iscrizione alle liste elettorali e ai registri del censimento</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="iscrittoListeElettorali" type="ap5:tipoSN" minOccurs="0"/>
						<xs:element name="censito" type="ap5:tipoSN" minOccurs="0"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Cittadinanza">
		<xs:sequence>
			<xs:element name="descrizioneStato" type="ap5:charMax80" minOccurs="0"/>
			<xs:element name="codiceStato" type="ap5:char3"/>
			<xs:element name="dataValidita" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		Comune:
			contiene i dati relativi a un comune
	-->
	<xs:complexType name="Comune">
		<xs:sequence>
			<xs:element name="nomeComune" type="ap5:charMax80"/>
			<xs:element name="codiceComuneIstat" type="ap5:numerico6">
				<xs:annotation>
					<xs:appinfo>ValidazioneCodIstat</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="siglaProvinciaIstat" type="ap5:char2"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		Localita:
			contiene i dati relativi a una localita
	-->
	<xs:complexType name="Localita">
		<xs:sequence>
			<xs:element name="descrizioneLocalita" type="ap5:charMax80"/>
			<xs:element name="descrizioneStato" type="ap5:charMax80"/>
			<xs:element name="codiceStato" type="ap5:char3"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Paternita:
			contiene i dati relativi al padre
			del soggetto della comunicazione
	 -->
	<xs:complexType name="Paternita">
		<xs:sequence>
			<xs:element name="cognomePadre" type="ap5:charMax80"/>
			<xs:element name="nomePadre" type="ap5:charMax80"/>
			<!-- 
				Il campo seguente è stato aggiunto,
				perché quelli previsti non sono sufficienti ad 
				identificare univocamente il cittadino
			 -->
			<xs:element name="codiceFiscalePadre" type="ap5:tipoCodiceFiscale" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Maternita:
			contiene i dati relativi alla madre
			del soggetto della comunicazione
	 -->
	<xs:complexType name="Maternita">
		<xs:sequence>
			<xs:element name="cognomeMadre" type="ap5:charMax80"/>
			<xs:element name="nomeMadre" type="ap5:charMax80"/>
			<!-- 
				Il campo seguente è stato aggiunto,
				perché quelli previsti non sono sufficienti ad 
				identificare univocamente il cittadino
			-->
			<xs:element name="codiceFiscaleMadre" type="ap5:tipoCodiceFiscale" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		Luogo:
			contiene i dati relativi a un luogo
	-->
	<xs:complexType name="Luogo">
		<xs:sequence>
			<xs:element name="luogoEccezionale" type="ap5:charMax120" minOccurs="0"/>
			<xs:choice>
				<xs:element name="comune" type="anag:Comune"/>
				<xs:element name="localita" type="anag:Localita"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		AttoNascita:
			contiene i dati relativi all'Atto di Nascita
			del soggetto della comunicazione
	-->
	<xs:complexType name="Atto">
		<xs:sequence>
			<xs:element name="comuneRegistrazione" type="anag:Comune"/>
			<xs:element name="anno" type="ap5:numerico4"/>
			<xs:element name="ufficio" type="ap5:charMax4" minOccurs="0"/>
			<xs:element name="parte" type="ap5:numerico1"/>
			<xs:element name="serie" type="ap5:charMaxNumerico"/>
			<xs:element name="numeroAtto" type="ap5:charMaxNumerico"/>
			<xs:element name="frazione" type="ap5:charMax10" minOccurs="0"/>
			<xs:element name="tipoRegistro" type="ap5:char1" minOccurs="0"/>
			<xs:element name="numeroRegistro" type="ap5:charMax5" minOccurs="0"/>
			<xs:element name="data" type="xs:date"/>
			<xs:element name="note" type="ap5:charMax80" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Sentenza
	-->
	<xs:complexType name="Sentenza">
		<xs:sequence>
			<xs:element name="data" type="xs:date"/>
			<xs:element name="numero" type="ap5:numericoMax20"/>
			<xs:element name="tribunale" type="ap5:charMax80"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		Toponimo
	-->
	<xs:complexType name="Toponimo">
		<xs:sequence>
			<xs:element name="specie" type="ap5:charMax30" minOccurs="0"/>
			<xs:element name="denominazione" type="ap5:charMax100"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		CivicoInterno
	-->
	<xs:complexType name="CivicoInterno">
		<xs:sequence>
			<xs:element name="corte" type="ap5:charMax4" minOccurs="0"/>
			<xs:element name="scala" type="ap5:charMax4" minOccurs="0"/>
			<xs:element name="interno" type="ap5:charMax4"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		NumeroCivico
	-->
	<xs:simpleType name="Colore">
		<xs:restriction base="ap5:numerico1">
			<xs:pattern value="1|2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="NumeroCivico">
		<xs:sequence>
			<xs:element name="numero">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="([0-9])*|s.n.c."/>
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="lettera" type="ap5:charMax4" minOccurs="0"/>
			<xs:element name="colore" minOccurs="0"/>
			<xs:element name="civicoInterno" type="anag:CivicoInterno" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--Divorzio-->
	<xs:complexType name="Divorzio">
		<xs:sequence>
			<xs:element name="sentenza" type="anag:Sentenza"/>
			<xs:element name="dataValidita" type="xs:date"/>
			<xs:element name="attoDivorzio" type="anag:Atto" minOccurs="0"/>
			<xs:element name="trascrizioneAttoDivorzio" type="anag:Atto" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Vedovanza:
			contiene i dati relativi alla morte del coniuge 
			del soggetto della comunicazione
	 -->
	<xs:complexType name="Vedovanza">
		<xs:sequence>
			<xs:element name="dataMorteConiuge" type="xs:date"/>
			<xs:element name="luogoMorteConiuge" type="anag:Luogo" minOccurs="0"/>
			<xs:element name="attoMorteConiuge" type="anag:Atto" minOccurs="0"/>
			<xs:element name="trascrizioneAttoMorteConiuge" type="anag:Atto" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--
		FamigliaAnagrafica:
			contiene i dati relativi ad una famiglia anagrafica
	-->
	<xs:complexType name="FamigliaAnagrafica">
		<xs:sequence>
			<xs:element name="codiceFamiglia" type="ap5:numerico11" minOccurs="0"/>
			<xs:element name="dataOrigineFamiglia" type="xs:date" minOccurs="0"/>
			<xs:element name="dataDecorrenzaAppartenenzaFamiglia" type="xs:date" minOccurs="0"/>
			<xs:element name="codiceRelazioneParentela" type="ap5:enumCodiceParentela"/>
			<!-- xs:element name="codiceIndividuale" type="ap5:numericoMax2"/-->
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Rettifica
	-->
	<xs:complexType name="Rettifica">
		<xs:sequence>
			<xs:element name="nomeCampo" type="xs:string"/>
			<xs:element name="vecchioValore" type="xs:string"/>
			<xs:element name="dataRettifica" type="xs:date"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		DatiNascita
	-->
	<xs:complexType name="DatiNascita">
		<xs:sequence>
			<xs:element name="luogoNascita" type="anag:Luogo"/>
			<xs:element name="dataNascita" type="xs:date"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Ufficio">
		<xs:sequence>
			<xs:element name="codice" type="ap5:charMax20"/>
			<xs:element name="descrizione" type="ap5:charMax1024"/>
		</xs:sequence>
	</xs:complexType>
	<!--
		ConfermaDatiAnagrafici
	-->
	<xs:complexType name="ConfermaDatiAnagrafici">
		<xs:sequence>
			<xs:element name="ufficio" type="anag:Ufficio"/>
			<xs:element name="comune" type="anag:Comune"/>
			<xs:element name="data" type="xs:date"/>
		</xs:sequence>
	</xs:complexType>
	<!--
		TesseraSanitaria
	-->
	<xs:complexType name="TesseraSanitaria">
		<xs:sequence>
			<xs:element name="identificativo" type="ap5:charMax30"/>
			<xs:element name="dataScadenza" type="xs:date" minOccurs="0"/>
			<xs:element name="dataRevoca" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Residenza
	-->
	<xs:complexType name="Residenza">
		<xs:sequence>
			<xs:element name="ubicazione" type="anag:Ubicazione"/>
			<xs:element name="dataInizio" type="xs:date" minOccurs="0"/>
			<xs:element name="dataFine" type="xs:date" minOccurs="0"/>
			<xs:element name="fonteDato" type="ap5:charMax1024" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Ubicazione
	-->
	<xs:complexType name="Ubicazione">
		<xs:sequence>
			<xs:element name="toponimo" type="anag:Toponimo"/>
			<xs:element name="numeroCivico" type="anag:NumeroCivico"/>
			<xs:element name="cap" type="ap5:numerico5"/>
			<xs:element name="comune" type="anag:Comune"/>
			<xs:element name="distretto" type="ap5:char4" minOccurs="0"/>
			<xs:element name="altro" type="ap5:charMax1024" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		ResidenzaEstera
	-->
	<xs:complexType name="ResidenzaEstera">
		<xs:sequence>
			<xs:element name="ubicazione" type="anag:UbicazioneEstera"/>
			<xs:element name="dataInizio" type="xs:date" minOccurs="0"/>
			<xs:element name="dataFine" type="xs:date" minOccurs="0"/>
			<xs:element name="fonteDato" type="ap5:charMax1024" minOccurs="0"/>
			<xs:element name="codiceStatoEstero" type="ap5:char3"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		UbicazioneEstera
	-->
	<xs:complexType name="UbicazioneEstera">
		<xs:sequence>
			<xs:element name="toponimo" type="anag:Toponimo"/>
			<xs:element name="numeroCivico" type="anag:NumeroCivico"/>
			<xs:element name="localita" type="anag:Localita"/>
			<xs:element name="altro" type="ap5:charMax1024" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--
		PersonaAnagrafica
	-->
	<xs:complexType name="PersonaAnagrafica">
		<xs:complexContent>
			<xs:extension base="anag:Persona">
				<xs:sequence>
					<xs:element name="codiceFiscale" type="ap5:tipoCodiceFiscale"/>
					<xs:element name="datiNascita" type="anag:DatiNascita"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<!--Persona-->
	<xs:complexType name="Persona">
		<xs:sequence>
			<xs:element name="cognome" type="ap5:charMax80"/>
			<xs:element name="nome" type="ap5:charMax80"/>
			<xs:element name="sesso" type="ap5:enumSesso" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
	 	Generalita:
	 		contiene le Generalità 
	 		del soggetto della comunicazione
	-->
	<xs:complexType name="Generalita">
		<xs:sequence>
			<xs:element name="cittadinanza" type="anag:Cittadinanza"/>
			<xs:element name="statoCivile" type="ap5:enumStatoCivile"/>
			<xs:element name="datiAnagrafici" type="anag:PersonaAnagrafica"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
	  	Coniuge
	  		Contiene le generalità del Coniuge 
	  		del soggetto della comunicazione 
	-->
	<xs:complexType name="Coniuge">
		<xs:sequence>
			<xs:element name="cognomeConiuge" type="ap5:charMax80"/>
			<xs:element name="nomeConiuge" type="ap5:charMax80"/>
			<!-- 
				Il campo seguente è stato aggiunto,
				perché quelli previsti non sono sufficienti ad 
				identificare univocamente il cittadino
			 -->
			<xs:element name="codiceFiscaleConiuge" type="ap5:tipoCodiceFiscale" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!-- 
		Matrimonio
			Contiene i dati relativi al Matrimonio 
			del soggetto della comunicazione 
	 -->
	<xs:complexType name="Matrimonio">
		<xs:sequence>
			<xs:element name="data" type="xs:date" minOccurs="0"/>
			<xs:element name="luogo" type="anag:Luogo" minOccurs="0"/>
			<xs:element name="coniuge" type="anag:Persona"/>
			<xs:element name="regimePatrimoniale" type="ap5:enumRegimePatrimoniale" minOccurs="0"/>
			<xs:element name="cessazione" minOccurs="0">
				<xs:complexType>
					<xs:choice>
						<xs:element name="vedovanza" type="anag:Vedovanza"/>
						<xs:element name="divorzio" type="anag:Divorzio"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
			<xs:element name="attoMatrimonio" type="anag:Atto" minOccurs="0"/>
			<xs:element name="trascrizioneAttoMatrimonio" type="anag:Atto" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		Indirizzo:
			contiene i dati relativi all'Indirizzo 
			del soggetto della comunicazione
	-->
	<xs:complexType name="Indirizzo">
		<xs:sequence>
			<xs:element name="cap" type="ap5:numerico5"/>
			<xs:element name="comune" type="anag:Comune"/>
			<xs:element name="frazione" type="ap5:charMax80" minOccurs="0"/>
			<xs:element name="toponimo" type="anag:Toponimo"/>
			<xs:element name="numeroCivico" type="anag:NumeroCivico"/>
			<xs:element name="dataDecorrenzaIndirizzo" type="xs:date" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		CartaIdentita:
			contiene i dati relativi alla Carta di Identità 
			del soggetto della comunicazione
	-->
	<xs:complexType name="CartaIdentita">
		<xs:complexContent>
			<xs:extension base="anag:DocumentoIndividuale">
				<xs:sequence>
					<xs:element name="espatrio" type="ap5:tipoSN"/>
					<xs:element name="interdizioneEspatrio" type="ap5:tipoSN" minOccurs="0"/>
					<xs:element name="dataScadenzaInterdizioneEspatrio" type="xs:date" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<!--  
		PermessoSoggiorno:
			contiene i dati relativi al Permesso di Soggiorno 
			del soggetto della comunicazione
	-->
	<xs:complexType name="PermessoSoggiorno">
		<xs:sequence>
			<xs:element name="numeroSoggiorno" type="ap5:charMax20"/>
			<xs:element name="Soggiorno" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="ap5:charMax10">
						<xs:pattern value="PERMESSO|CARTA"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="dataRilascio" type="xs:date"/>
			<xs:element name="dataScadenza" type="xs:date"/>
			<xs:element name="questuraRilascioSoggiorno" type="anag:Comune" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--Libretto sanitario-->
	<xs:complexType name="LibrettoSanitario">
		<xs:sequence>
			<xs:element name="numero" type="ap5:charMax20"/>
			<xs:element name="dataRilascio" type="xs:date"/>
			<xs:element name="comuneRilascio" type="anag:Comune"/>
		</xs:sequence>
	</xs:complexType>
	<!--  
		Morte:
			contiene i dati relativi alla Morte
			del soggetto della comunicazione
	-->
	<xs:complexType name="Morte">
		<xs:sequence>
			<xs:element name="attoMorte" type="anag:Atto" minOccurs="0"/>
			<xs:element name="datiMorte" type="anag:DatiMorte"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LibrettoDiLavoro">
		<xs:sequence>
			<xs:element name="numero" type="ap5:charMax20"/>
			<xs:element name="dataRilascio" type="xs:date"/>
			<xs:element name="comuneRilascio" type="anag:Comune"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Pratica">
		<xs:sequence>
			<xs:element name="numeroPratica" type="ap5:numericoMax6">
				<xs:annotation>
					<xs:appinfo>ValidazioneObbligatorieta</xs:appinfo>
				</xs:annotation>
			</xs:element>
			<xs:element name="dataPratica" type="xs:date">
				<xs:annotation>
					<xs:appinfo>ValidazioneData</xs:appinfo>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ResponsabileAnagrafe">
		<xs:complexContent>
			<xs:extension base="anag:Persona">
				<xs:sequence>
					<xs:element name="telefono" type="xs:string" minOccurs="0"/>
					<xs:element name="fax" type="xs:string" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="StatoCivile">
		<xs:sequence>
			<xs:element name="codiceStatoCivile" type="ap5:numerico1"/>
			<xs:element name="regimePatrimoniale" type="ap5:char1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Professione">
		<xs:sequence>
			<xs:element name="descrizioneProfessione" type="ap5:charMax40" minOccurs="0"/>
			<xs:element name="posizioneNellaProfessione" type="ap5:numerico1"/>
			<xs:element name="settoreAttivitaEconomica" type="ap5:numerico1" minOccurs="0"/>
			<xs:element name="condizioneNonProfessionale" type="ap5:numericoMax2" minOccurs="0"/>
			<xs:element name="titoloDiStudio" type="ap5:enumTitoloDiStudio" minOccurs="0"/>
			<xs:element name="descrizioneDiplomaLaurea" type="ap5:charMax40" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<!--Pensione-->
	<xs:complexType name="Pensione">
		<xs:sequence>
			<xs:element name="enteErogatore" type="ap5:charMax16"/>
			<xs:element name="categoriaPensione" type="ap5:charMax3"/>
			<xs:element name="numeroLibrettoPensione" type="ap5:charMax12"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DatiMorte">
		<xs:sequence>
			<xs:element name="dataMorte" type="xs:date"/>
			<xs:element name="luogoMorte" type="anag:Luogo" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Nascita">
		<xs:annotation>
			<xs:documentation>contiene i dati della nascita di un cittadino</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="maternita" type="anag:PersonaAnagrafica" minOccurs="0"/>
			<xs:element name="attoNascita" type="anag:Atto" minOccurs="0"/>
			<xs:element name="trascrizioneAttoNascita" type="anag:Atto" minOccurs="0"/>
			<xs:element name="paternita" type="anag:PersonaAnagrafica" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DocumentoIndividuale">
		<xs:annotation>
			<xs:documentation>documento personale del cittadino</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="numero" type="ap5:charMax20"/>
			<xs:element name="dataRilascio" type="xs:date"/>
			<xs:element name="dataScadenza" type="xs:date" minOccurs="0"/>
			<xs:element name="comuneRilascio" type="anag:Comune"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PersonaAnagraficaDN">
		<xs:annotation>
			<xs:documentation>Individua un cittadino con nome, cognome e dati nascita</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="anag:Persona">
				<xs:sequence>
					<xs:element name="datiNascita" type="anag:DatiNascita"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PraticaIscrizioneCancellazioneAnagrafe">
		<xs:annotation>
			<xs:documentation>Dati della pratica di iscrizione o cancellazione da anagrafe e motivazione</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="anag:Pratica">
				<xs:sequence>
					<xs:element name="tipoPratica" type="ap5:enumTipoPratica"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PraticaIscrizioneAnagrafe">
		<xs:annotation>
			<xs:documentation>Dati della pratica di iscrizione nell'anagrafe e motivazione</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="anag:Pratica">
				<xs:sequence>
					<xs:element name="tipoIscrizione" type="ap5:enumTipoIscrizioneAnagrafe"/>
					<xs:element name="comportaConteggio" type="ap5:enumComportaConteggio" minOccurs="0"/>
					<xs:element name="dataDecorrenza" type="xs:date" minOccurs="0"/>
					<xs:element name="tipoIstanza" type="ap5:enumTipoIstanza" minOccurs="0"/>
					<xs:element name="motivoIscrizione " type="ap5:charMax40" minOccurs="0"/>
					<xs:element name="provenienza" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="codiceISTATStatoEsteroProvenienza" type="ap5:numerico6"/>
								<xs:element name="codiceISTATComuneProvenienza" type="ap5:numerico6"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PraticaCancellazioneAnagrafe">
		<xs:annotation>
			<xs:documentation>Dati della pratica di cancellazione dall'anagrafe e motivazione</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="anag:Pratica">
				<xs:sequence>
					<xs:element name="tipoCancellazione" type="ap5:enumTipoCancellazioneAnagrafe"/>
					<xs:element name="motivoCancellazione" type="ap5:charMax40" minOccurs="0"/>
					<xs:element name="comportaConteggio" type="ap5:enumComportaConteggio" minOccurs="0"/>
					<xs:element name="dataDecorrenza" type="xs:date" minOccurs="0"/>
					<xs:element name="tipoIstanza" type="ap5:enumTipoIstanza" minOccurs="0"/>
					<xs:element name="provenienza" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="codiceISTATStatoEsteroEmigrazione" type="ap5:numerico6"/>
								<xs:element name="codiceISTATComuneEmigrazione" type="ap5:numerico6"/>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DatiEmigrazione">
		<xs:sequence>
			<xs:element name="praticaEmigrazione" type="anag:PraticaEmigrazione"/>
			<xs:element name="dataEmigrazione" type="xs:date"/>
			<xs:element name="codiceStatoEstero" type="ap5:char3"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IscrizioneAIRE">
		<xs:sequence>
			<xs:element name="comunePrecedenteIscrizioneAIRE" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Comune presso la cui anagrafe si e' iscritti prima dell'iscrizione all'AIRE, cioe' prima del trasferimento all'estero</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="codiceStatoEsteroEmigrazione" type="ap5:char3" minOccurs="0"/>
			<xs:element name="pratica" type="anag:PraticaIscrizioneAIRE" minOccurs="0"/>
			<xs:element name="numeroDistintivoAIRE" minOccurs="0"/>
			<xs:element name="data"/>
			<xs:element name="motivo" type="ap5:enumMotivoIscrizioneAIRE"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PraticaIscrizioneAIRE">
		<xs:complexContent>
			<xs:extension base="anag:Pratica"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="CancellazioneAIRE">
		<xs:sequence>
			<xs:element name="pratica" type="anag:PraticaCancellazioneAIRE" minOccurs="0"/>
			<xs:element name="data" type="xs:date"/>
			<xs:element name="motivo" type="ap5:enumMotivoCancellazioneAIRE"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PraticaEmigrazione">
		<xs:complexContent>
			<xs:extension base="anag:Pratica"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PraticaCancellazioneAIRE">
		<xs:complexContent>
			<xs:extension base="anag:Pratica"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DatiAIRE">
		<xs:annotation>
			<xs:documentation>Iscrizione e cancellazione AIRE</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="iscrizione" type="anag:IscrizioneAIRE" minOccurs="0"/>
			<xs:element name="cancellazione" type="anag:CancellazioneAIRE" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Emigrazione">
		<xs:sequence>
			<xs:element name="datiEmigrazione" type="anag:DatiEmigrazione" minOccurs="0"/>
			<xs:element name="iscrizioneAIRE" type="anag:IscrizioneAIRE" minOccurs="0"/>
			<xs:element name="cancellazioneAIRE" type="anag:CancellazioneAIRE" minOccurs="0"/>
			<xs:element name="residenzaEstero" type="anag:ResidenzaEstera" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PersonaDatiNascita">
		<xs:annotation>
			<xs:documentation>Persona con nome cognome e luogo e data di nascita</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="anag:Persona">
				<xs:sequence>
					<xs:element name="datiNascita" type="anag:DatiNascita"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="IdentificativoPersona">
		<xs:annotation>
			<xs:documentation>Dati sufficienti per l'identificazione di una persona: codice fiscale o nome, cognome e  dati di nascita</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="codiceFiscale" type="ap5:tipoCodiceFiscale"/>
			<xs:element name="datiNascita" type="anag:PersonaDatiNascita"/>
		</xs:choice>
	</xs:complexType>
</xs:schema>
