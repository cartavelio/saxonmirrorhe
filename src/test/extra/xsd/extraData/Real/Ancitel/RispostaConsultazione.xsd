<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2006 rel. 3 sp2 (http://www.altova.com) by Luigi Selmi (sharesemantics) -->
<xs:schema xmlns:apr4="http://saia.ancitel.it/xmlmanager/apr4" 
	xmlns:xs="http://www.w3.org/2001/XMLSchema" 
	xmlns:ap5="http://saia.ancitel.it/xmlmanager/ap5" 
	xmlns:anag="http://saia.ancitel.it/xmlmanager/anagrafico" 
	xmlns:ca="http://saia.ancitel.it/xmlmanager/consultazione" 
	targetNamespace="http://saia.ancitel.it/xmlmanager/consultazione" 
	elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:import namespace="http://saia.ancitel.it/xmlmanager/ap5" schemaLocation="BaseTypes.xsd"/>
	<xs:import namespace="http://saia.ancitel.it/xmlmanager/anagrafico" schemaLocation="Vocabulary.xsd"/>
	<xs:include schemaLocation="RichiestaConsultazione.xsd"/>
	<xs:complexType name="StatoComunicazione">
		<xs:sequence>
			<xs:element name="protocolloSAIA" type="ap5:tipoProtocollo">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato dal SAIA alla richiesta di consultazione inviata dal comune di origine</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="protocolloRispostaSAIA" type="ap5:tipoProtocollo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato dal SAIA alla risposta ricevuta dal comune di destinazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="comuneOrigine" type="anag:Comune">
				<xs:annotation>
					<xs:documentation>Contiene il codice ISTAT del comune che ha richiesto la consultazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="comuneDestinazione" type="anag:Comune">
				<xs:annotation>
					<xs:documentation>Contiene il codice ISTAT del comune destinatario della richiesta di consultazione </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="stato" type="ap5:enumStatoDocumento">
				<xs:annotation>
					<xs:documentation>Contiene lo stato della richiesta ricevuta dal SAIA: accettata, completata, presa in carico.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dataAccettazioneRisposta" type="xs:date" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Data in cui il SAIA ha accettato la risposta dal comune destinatario della richiesta di consultazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="messaggio" type="ap5:tipoMessaggio" minOccurs="0"/>
			<xs:element name="protocolloComuneOrigine" type="ap5:tipoProtocollo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato dal comune di origine della richiesta di consultazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="protocolloComuneDestinazione" type="ap5:tipoProtocollo" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo assegnato dal comune destinatario della richiesta di consultazione</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Risposta">
		<xs:choice>
			<xs:element name="comunicazioni" type="ca:RispostaComunicazioni" >
				<xs:annotation>
					<xs:documentation>Informazioni di riepilogo e di validità delle richieste ricevute dal server</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="statoCode">
				<xs:annotation>
					<xs:documentation>Stato delle richieste inviate e delle richieste provenienti da altri comuni in attesa di essere prese in carico</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="statoComunicazione" type="ca:StatoComunicazione" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="presaInCarico">
				<xs:annotation>
					<xs:documentation>Risposte delle consultazioni </xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="risposta" type="ca:RispostaPresaInCarico" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
				
					<xs:attribute name="ultimoId" type="xs:string">
						<xs:annotation>
							<xs:documentation>Chiave identificativa dell’ultimo lotto di consultazioni anagrafiche prese in carico</xs:documentation>
						</xs:annotation>
					</xs:attribute>
				</xs:complexType>
			</xs:element>
		</xs:choice>
		<xs:attribute name="versione" type="ap5:tipoVersione">
			<xs:annotation>
				<xs:documentation>Versione della busta del messaggio </xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	
	<xs:complexType name="RispostaPresaInCarico">
		<xs:choice>
			<xs:element name="comunicazione" type="ca:Comunicazione" />
			<xs:element name="risposta" type="ca:RispostaConsultazione"/>
		</xs:choice>
	</xs:complexType>
	
	
		<!--  
		RispostaDocumentoNonAccettato:
			contiene i dati da inviare a un comune 
			quando una comunicazione anagrafica 
			NON viene accettata da SAIA
	-->
	<xs:complexType name="RispostaConsultazione">
		<xs:sequence>
			<xs:element name="dataOraRisposta" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>Data e ora in cui il SAIA invia la risposta della presa in carico</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="causale" type="ca:CausaleConsultazione">
				<xs:annotation>
					<xs:documentation>Contiene il numero di protocollo SAIA, il codice ISTAT del comune di immigrazione e quello del comune di emigrazione</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="protocolloAnagrafe" type="ap5:tipoProtocolloAnagrafe" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Numero di protocollo del comune </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dichiarante" type="anag:PersonaAnagrafica" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Dati anagrafici del dichiarante</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="esito" type="ap5:tipoMessaggio">
				<xs:annotation>
					<xs:documentation>Esito dell’invio del modello</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="esitoVerificaPersona" type="ca:EsitoVerificaPersona" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Esito della verifica INA dei cittadini coinvolti nella pratica</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="EsitoVerificaPersona">
		<xs:sequence>
			<xs:element name="persona" type="anag:PersonaAnagrafica"/>
			<xs:element name="esito" type="ap5:tipoMessaggio"/>
		</xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="RispostaComunicazioni">
		<xs:sequence>
			<xs:element name="risposta" maxOccurs="unbounded">
				<xs:complexType>
					<xs:choice>
						<xs:element name="richiestaAccettata" type="ca:RichiestaAccettata"/>
						<xs:element name="richiestaNonAccettata" type="ca:RichiestaNonAccettata"/>
					</xs:choice>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RichiestaAccettata">
		<xs:sequence>
			<xs:element name="dataOraAccettazione" type="xs:dateTime"/>
			<xs:element name="protocolloSAIA" type="ap5:tipoProtocollo"/>
			<xs:element name="protocolloAnagrafe" minOccurs="0"/>
			<xs:element name="causale" type="ca:CausaleConsultazione"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RichiestaNonAccettata">
		<xs:sequence>
			<xs:element name="dataOraAccettazione" type="xs:dateTime"/>
			<xs:element name="messaggio" type="ap5:tipoMessaggio"/>
			<xs:element name="causale" type="ca:CausaleConsultazione"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PresaInCaricoRispostaConsultazione">
		<xs:annotation>
			<xs:documentation>Risposte dei comuni destinatari delle richieste di consultazione anagrafica </xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="rispostaNonDisponibile" type="ca:RispostaNonDisponibile">
				<xs:annotation>
					<xs:documentation>Contiene la motivazione della indisponibilita' delle informazioni richieste</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="rispostaDisponibile" type="ca:RispostaDisponibile">
				<xs:annotation>
					<xs:documentation>Risposta disponibile per la richiesta di consultazione anagrafica</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PresaInCaricoRichiestaConsultazione">
		<xs:annotation>
			<xs:documentation>Richiesta di consultazione presa in carico dal comune destinatario</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="protocolloAnagrafe" minOccurs="0"/>
			<xs:element name="causale" type="ca:CausaleConsultazione"/>
			<xs:element name="corpo" type="ca:CorpoInterrogazione"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RispostaNonDisponibile">
		<xs:sequence>
			<xs:element name="protocolloSAIARisposta" type="ap5:tipoProtocollo"/>
			<xs:element name="motivoDatiIndisponibili" type="ca:enumMotivoDatiIndisponibili"/>
			<xs:element name="richiesta" type="ca:PresaInCaricoRichiestaConsultazione"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RispostaDisponibile">
		<xs:sequence>
			<xs:element name="causaleConsultazione" type="ca:CausaleConsultazione"/>
			<xs:element name="protocolloSAIARisposta" type="ap5:tipoProtocollo"/>
			<xs:element name="rispostaAnagrafica" type="ca:Risposta"/>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="enumMotivoDatiIndisponibili">
		<xs:annotation>
			<xs:documentation>valori ammessi per la motivazione di dati indisponibili per la richiesta di consultazione anagrafica</xs:documentation>
		</xs:annotation>
		<xs:restriction base="ap5:numericoMax2">
			<xs:enumeration value="1">
				<xs:annotation>
					<xs:documentation>Soggetto NON in archivio</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
