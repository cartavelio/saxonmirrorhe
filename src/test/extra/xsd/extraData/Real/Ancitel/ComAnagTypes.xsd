<?xml version="1.0" encoding="UTF-8"?>
<!-- Ancitel S.p.A. La rete dei Comuni Italiani -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ap5="http://saia.ancitel.it/xmlmanager/ap5" targetNamespace="http://saia.ancitel.it/xmlmanager/ap5" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="RichiestaMacroTypes.xsd"/>
	<!-- 
		tipoComGenerica:
			contiene i dati relativi a una 
			comunicazione anagrafica generica
	-->
	<xs:complexType name="tipoComGenerica">
		<xs:sequence>
			<xs:element name="causale" type="ap5:tipoCausale"/>
			<xs:element name="generalita" type="ap5:tipoGeneralita"/>
			<xs:element name="coniuge" type="ap5:tipoConiuge" minOccurs="0"/>
			<xs:element name="matrimonio" type="ap5:tipoMatrimonio" minOccurs="0"/>
			<xs:element name="vedovanza" type="ap5:tipoVedovanza" minOccurs="0"/>
			<xs:element name="cessazioneAnnullamentoMatrimonio" type="ap5:tipoCessazioneAnnullamentoMatrimonio" minOccurs="0"/>
			<xs:element name="iscrizioneAPR" type="ap5:tipoIscrizioneAPR" minOccurs="0"/>
			<xs:element name="indirizzo" type="ap5:tipoIndirizzo" minOccurs="0"/>
			<xs:element name="cartaIdentita" type="ap5:tipoCartaIdentita" minOccurs="0"/>
			<xs:element name="permessoSoggiorno" type="ap5:tipoPermessoSoggiorno" minOccurs="0"/>
			<xs:element name="cancellazioneAPR" type="ap5:tipoCancellazioneAPR" minOccurs="0"/>
			<xs:element name="morte" type="ap5:tipoMorte" minOccurs="0"/>
			<xs:element name="patenti" type="ap5:tipoPatenti" minOccurs="0"/>
			<xs:element name="veicoli" type="ap5:tipoVeicoli" minOccurs="0"/>
			<xs:element name="famigliaAnagrafica" type="ap5:tipoFamigliaAnagrafica" minOccurs="0"/>
			<xs:element name="variazioneNomeCognome" type="ap5:tipoVariazioneNomeCognome" minOccurs="0"/>
			<xs:element name="variazioneSesso" type="ap5:tipoVariazioneSesso" minOccurs="0"/>
			<xs:element name="variazioneCittadinanza" type="ap5:tipoVariazioneCittadinanza" minOccurs="0"/>
			<xs:element name="variazionePermessoSoggiorno" type="ap5:tipoVariazionePermessoSoggiorno" minOccurs="0"/>
			<xs:element name="variazionePaternitaMaternita" type="ap5:tipoVariazionePaternitaMaternita" minOccurs="0"/>
			<xs:element name="datiRettificati" type="ap5:tipoDatiRettificati" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="protocolloAnagrafe" type="ap5:tipoProtocolloAnagrafe"/>
		<xs:attribute name="dataOraRichiesta" type="xs:dateTime" use="required"/>
	</xs:complexType>
	<!--  
		tipoStatoCode
			contiene i dati relativi a una 
			richiesta di stato code		
	-->
	<xs:complexType name="tipoStatoCode">
		<xs:sequence>
			<xs:element name="protocolloComunicazione" type="ap5:tipoProtocollo" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="dataOraRichiesta" type="xs:dateTime"/>
		<xs:attribute name="ultimoId" type="xs:string" default="0"/>
	</xs:complexType>
	<!--  
		tipoPresaInCarico
			contiene i dati relativi a una 
			richiesta di presa in carico
	-->
	<xs:complexType name="tipoPresaInCarico">
		<xs:sequence>
			<xs:element name="protocolloComunicazione" type="ap5:tipoProtocollo" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="dataOraRichiesta" type="xs:dateTime"/>
		<xs:attribute name="ultimoId" type="xs:string" default="0"/>
	</xs:complexType>
	<!-- tipoConsultazione
			contiene i dati relativi a una 
			richiesta di consultazione
	-->
	<xs:complexType name="tipoConsultazione">
		<xs:choice>
			<xs:element name="consultazionePerCodiceFiscale" type="ap5:tipoConsultazionePerCodiceFiscale"/>
			<xs:element name="consultazionePerNomeCognome" type="ap5:tipoConsultazionePerNomeCognome"/>
		</xs:choice>
		<xs:attribute name="tipo" type="ap5:tipoEnteConsultabile"/>
		<xs:attribute name="idConsultazione" type="xs:long" use="required" />
	</xs:complexType>
</xs:schema>
