<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:saxon="http://saxon.sf.net/">

  <xs:element name="foo" type="fooType"/>
  
  <xs:simpleType name="fooType">
    <xs:restriction base="xs:token">
      <xs:pattern value="[a-z]+" saxon:flags="i"/>
    </xs:restriction>
  </xs:simpleType>
  
</xs:schema>