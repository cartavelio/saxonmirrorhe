<testSet name="Flags"
      xmlns="http://www.w3.org/XML/2004/xml-schema-test-suite/"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/XML/2004/xml-schema-test-suite/ AnnotatedTSSchema.xsd"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      contributor="Saxonica"
      version="1.1"
      xmlns:saxon="http://saxon.sf.net/">

    <testGroup name="flags001" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:flags</Title>
                <Description>base type is a built-in type derived from xs:string</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-SchemaComposition-Override"/>
        <schemaTest name="flags001.xsd">
            <schemaDocument xlink:href="../extraData/Flags/flags001.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="flags001.v01.xml">
		        <annotation>
		            <documentation>
		                Valid against the patter.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Flags/flags001.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>     
        <instanceTest name="flags001.v02.xml">
            <annotation>
                <documentation>
                    Valid against the pattern, taking flags into account.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Flags/flags001.v02.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>     
        <instanceTest name="flags001.n01.xml">
		        <annotation>
		            <documentation>
		                Invalid against the pattern.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Flags/flags001.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>                           
    </testGroup>
    
    <testGroup name="flags002" version="1.1">
        <annotation>
            <documentation>
                <Title>Empty saxon:flags</Title>
                <Description>saxon:flags attribute can be a zero-length string</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-SchemaComposition-Override"/>
        <schemaTest name="flags002.xsd">
            <schemaDocument xlink:href="../extraData/Flags/flags002.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="flags002.n01.xml">
            <annotation>
                <documentation>
                    Valid against the pattern.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Flags/flags001.v01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>     
        <instanceTest name="flags002.n02.xml">
            <annotation>
                <documentation>
                    Valid against the pattern, taking flags into account.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Flags/flags001.v02.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>     
        <instanceTest name="flags002.n03.xml">
            <annotation>
                <documentation>
                    Invalid against the pattern.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Flags/flags001.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>                           
    </testGroup>
    
    <testGroup name="flags003" version="1.1">
        <annotation>
            <documentation>
                <Title>Invalid saxon:flags</Title>
                <Description>saxon:flags attribute can be a zero-length string</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-SchemaComposition-Override"/>
        <schemaTest name="flags003.xsd">
            <schemaDocument xlink:href="../extraData/Flags/flags003.xsd"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>                         
    </testGroup>
    
 
    
</testSet>    