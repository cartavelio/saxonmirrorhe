<testSet name="Constraints"
      xmlns="http://www.w3.org/XML/2004/xml-schema-test-suite/"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/XML/2004/xml-schema-test-suite/ AnnotatedTSSchema.xsd"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      contributor="Saxonica"
      version="1.1"
      xmlns:saxon="http://saxon.sf.net/">
    
    <!-- Tests Saxon extensions related to unique / key / keyref constraints -->

    <testGroup name="selectorSyntax001" version="1.1">
        <annotation>
            <documentation>
                <Title>XPath selector syntax extensions</Title>
                <Description>Use Saxon syntax extensions for selectors</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="selectorSyntax001.xsd">
            <schemaDocument xlink:href="../extraData/Constraints/selectorSyntax001.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="selectorSyntax001.v01.xml">
		        <annotation>
		            <documentation>
		                Valid list.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/selectorSyntax001.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="selectorSyntax001.v02.xml">
            <annotation>
                <documentation>
                    Valid list including whitespace.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/selectorSyntax001.v02.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="selectorSyntax001.n01.xml">
		        <annotation>
		            <documentation>
		                Invalid against the pattern.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/selectorSyntax001.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
    </testGroup>
    
    <testGroup name="selectorSyntax002" version="1.1">
        <annotation>
            <documentation>
                <Title>XPath selector syntax extensions</Title>
                <Description>Use Saxon syntax extensions for selectors, without enabling the extension</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="selectorSyntax002.xsd">
            <schemaDocument xlink:href="../extraData/Constraints/selectorSyntax002.xsd"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
    </testGroup>
    
    <testGroup name="selectorSyntax003" version="1.1">
        <annotation>
            <documentation>
                <Title>XPath selector syntax extensions</Title>
                <Description>Use Saxon syntax extensions for fields</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="selectorSyntax003.xsd">
            <schemaDocument xlink:href="../extraData/Constraints/selectorSyntax003.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="selectorSyntax001.v01.xml">
            <annotation>
                <documentation>
                    Valid list.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/selectorSyntax001.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="selectorSyntax001.v02.xml">
            <annotation>
                <documentation>
                    Valid list including whitespace.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/selectorSyntax001.v02.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="selectorSyntax001.n01.xml">
            <annotation>
                <documentation>
                    Invalid against the pattern.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/selectorSyntax001.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
    </testGroup>
    
    <testGroup name="selectorSyntax004" version="1.1">
        <annotation>
            <documentation>
                <Title>XPath selector syntax extensions</Title>
                <Description>Use Saxon syntax extensions for fields without enabling extensions</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="selectorSyntax004.xsd">
            <schemaDocument xlink:href="../extraData/Constraints/selectorSyntax004.xsd"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
    </testGroup>
    
    
    <testGroup name="orderedUnique001" version="1.1">
        <annotation>
            <documentation>
                <Title>xs:unique with saxon:ordered='true'</Title>
                <Description>Use Saxon extensions for ordered uniqueness</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="orderedUnique001.xsd">
            <schemaDocument xlink:href="../extraData/Constraints/orderedUnique001.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="orderedUnique001.v01.xml">
            <annotation>
                <documentation>
                    Valid list.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/orderedUnique001.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="orderedUnique001.v02.xml">
            <annotation>
                <documentation>
                    Valid list including whitespace.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/orderedUnique001.v02.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="orderedUnique001.v03.xml">
            <annotation>
                <documentation>
                    Valid list including whitespace.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/orderedUnique001.v03.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="orderedUnique001.n01.xml">
            <annotation>
                <documentation>
                    Invalid against the pattern.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/orderedUnique001.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="orderedUnique001.n02.xml">
            <annotation>
                <documentation>
                    Invalid against the pattern.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/orderedUnique001.n02.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
    </testGroup>
    
    <testGroup name="orderedUnique002" version="1.1">
        <annotation>
            <documentation>
                <Title>xs:unique with saxon:ordered='true'</Title>
                <Description>Use Saxon extensions for ordered uniqueness</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="orderedUnique002.xsd">
            <schemaDocument xlink:href="../extraData/Constraints/orderedUnique002.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="orderedUnique002.v01.xml">
            <annotation>
                <documentation>
                    Valid list.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/orderedUnique002.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="orderedUnique002.n01.xml">
            <annotation>
                <documentation>
                    Invalid against the ordering constraint.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Constraints/orderedUnique002.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
    </testGroup>
    
