    <testGroup name="orderedUnique004" version="1.1">
        <annotation>
            <documentation>
                <Title>xs:unique with saxon:order - invalid value</Title>
                <Description>Use Saxon extensions for ordered uniqueness</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="orderedUnique004.xsd">
            <schemaDocument xlink:href="../extraData/Constraints/orderedUnique004.xsd"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-06-03"/>
        </schemaTest>
    </testGroup>
    
