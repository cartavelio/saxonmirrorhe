<testSet name="Lists"
      xmlns="http://www.w3.org/XML/2004/xml-schema-test-suite/"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/XML/2004/xml-schema-test-suite/ AnnotatedTSSchema.xsd"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      contributor="Saxonica"
      version="1.1"
      xmlns:saxon="http://saxon.sf.net/">
    
    <!-- Tests Saxon extensions related to validation of list types: saxon:separator, saxon:distinct, saxon:order -->

    <testGroup name="separator001" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:separator</Title>
                <Description>Use comma as separator in list type</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="separator001.xsd">
            <schemaDocument xlink:href="../extraData/Lists/separator001.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="separator001.v01.xml">
		        <annotation>
		            <documentation>
		                Valid list.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator001.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="separator001.v02.xml">
            <annotation>
                <documentation>
                    Valid list including whitespace.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator001.v02.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="separator001.v03.xml">
            <annotation>
                <documentation>
                    Valid singleton list including whitespace.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator001.v03.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="separator001.v04.xml">
            <annotation>
                <documentation>
                    Valid empty list.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator001.v04.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="separator001.n01.xml">
		        <annotation>
		            <documentation>
		                Invalid against the pattern.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator001.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="separator001.n02.xml">
            <annotation>
                <documentation>
                    Invalid empty list (the only token is not a valid integer).
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator001.n02.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
    </testGroup>
    
    <testGroup name="separator002" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:separator combined with xs:length facet</Title>
                <Description>Use comma as separator in list type</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="separator002.xsd">
            <schemaDocument xlink:href="../extraData/Lists/separator002.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="separator002.v01.xml">
            <annotation>
                <documentation>
                    Valid against the pattern.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator001.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="separator002.v02.xml">
            <annotation>
                <documentation>
                    Valid against the pattern.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator001.v02.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="separator002.n01.xml">
            <annotation>
                <documentation>
                    Invalid against the list length.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator002.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>                           
    </testGroup>
    
    <testGroup name="separator003" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:separator combined with saxon:distinct facet</Title>
                <Description>Use comma as separator in list type</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="separator003.xsd">
            <schemaDocument xlink:href="../extraData/Lists/separator003.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="separator001.v01.xml">
            <annotation>
                <documentation>
                    Valid against the pattern.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator001.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="separator003.v02.xml">
            <annotation>
                <documentation>
                    Valid against the pattern.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator001.v02.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="separator003.n01.xml">
            <annotation>
                <documentation>
                    Invalid, contains duplicates.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/separator003.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>                           
    </testGroup>
    
    <testGroup name="distinct004" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:distinct facet with dates</Title>
                <Description>List of dates constrained to be distinct</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="distinct004.xsd">
            <schemaDocument xlink:href="../extraData/Lists/distinct004.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="distinct004.v01.xml">
            <annotation>
                <documentation>
                    All three values distinct.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct004.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="distinct004.v02.xml">
            <annotation>
                <documentation>
                   Only one value, therefore no duplicates.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct004.v02.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>  
        <instanceTest name="distinct004.v03.xml">
            <annotation>
                <documentation>
                    No values, therefore no duplicates.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct004.v03.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>  
        <instanceTest name="distinct004.n01.xml">
            <annotation>
                <documentation>
                    Invalid, contains duplicates.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct004.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>                           
    </testGroup>
    
    <testGroup name="distinct005" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:distinct facet with dateTimes, effect of timezones</Title>
                <Description>List of dateTimes constrained to be distinct</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="distinct005.xsd">
            <schemaDocument xlink:href="../extraData/Lists/distinct005.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="distinct005.v01.xml">
            <annotation>
                <documentation>
                    All three values distinct.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct005.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="distinct005.n01.xml">
            <annotation>
                <documentation>
                    Invalid, contains duplicates.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct005.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="distinct005.n02.xml">
            <annotation>
                <documentation>
                    Timezone adjusted before comparison
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct005.n02.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>  
        <instanceTest name="distinct005.n03.xml">
            <annotation>
                <documentation>
                    Timezone adjusted before comparison
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct005.n03.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>  
    </testGroup>
    
    <testGroup name="distinct006" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:distinct facet with a union type containing integers and doubles; integers and doubles are distinct</Title>
                <Description>List of numbers constrained to be distinct</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="distinct006.xsd">
            <schemaDocument xlink:href="../extraData/Lists/distinct006.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="distinct006.v01.xml">
            <annotation>
                <documentation>
                    All values distinct.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct006.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="distinct006.v01.xml">
            <annotation>
                <documentation>
                    All values distinct; doubles are distinct from integers
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct006.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        
        <instanceTest name="distinct006.n01.xml">
            <annotation>
                <documentation>
                    Invalid, contains duplicates.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct006.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="distinct006.n02.xml">
            <annotation>
                <documentation>
                    Contains duplicates
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/distinct006.n02.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>  
    </testGroup>
    
    <testGroup name="distinct007" version="1.1">
        <annotation>
            <documentation>
                <Title>Invalid saxon:distinct facet</Title>
                <Description>value="false" not allowed</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="distinct007.xsd">
            <schemaDocument xlink:href="../extraData/Lists/distinct007.xsd"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
    </testGroup>
    
    <testGroup name="distinct008" version="1.1">
        <annotation>
            <documentation>
                <Title>Invalid saxon:distinct facet</Title>
                <Description>Not allowed on atomic type</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="distinct008.xsd">
            <schemaDocument xlink:href="../extraData/Lists/distinct008.xsd"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
    </testGroup>
    
    <testGroup name="order101" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:order facet with a sequence of integers</Title>
                <Description>List of numbers constrained to be ordered</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="order101.xsd">
            <schemaDocument xlink:href="../extraData/Lists/order101.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="order101.v01.xml">
            <annotation>
                <documentation>
                    All values properly ordered
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order101.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="order101.v02.xml">
            <annotation>
                <documentation>
                    All values properly ordered, includes duplicates.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order101.v02.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest> 
        <instanceTest name="order101.v03.xml">
            <annotation>
                <documentation>
                    All values properly ordered, there is only one.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order101.v03.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest> 
        <instanceTest name="order101.v04.xml">
            <annotation>
                <documentation>
                    Empty list is properly ordered.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order101.v04.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest> 
        
        <instanceTest name="order101.n01.xml">
            <annotation>
                <documentation>
                    Invalid, contains out of order values.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order101.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="order101.n02.xml">
            <annotation>
                <documentation>
                    Contains out of order values.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order101.n02.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>  
    </testGroup>
    
    <testGroup name="order102" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:order facet with a sequence of integers</Title>
                <Description>List of numbers constrained to be ordered descending</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <schemaTest name="order102.xsd">
            <schemaDocument xlink:href="../extraData/Lists/order102.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </schemaTest>
        <instanceTest name="order102.v01.xml">
            <annotation>
                <documentation>
                    All values properly ordered
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order102.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>    
        <instanceTest name="order102.v02.xml">
            <annotation>
                <documentation>
                    All values properly ordered, includes duplicates.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order102.v02.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest> 
        <instanceTest name="order102.v03.xml">
            <annotation>
                <documentation>
                    All values properly ordered, there is only one.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order101.v03.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest> 
        <instanceTest name="order102.v04.xml">
            <annotation>
                <documentation>
                    Empty list is properly ordered.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order101.v04.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest> 
        
        <instanceTest name="order102.n01.xml">
            <annotation>
                <documentation>
                    Invalid, contains out of order values.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order101.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>
        <instanceTest name="order102.n02.xml">
            <annotation>
                <documentation>
                    Contains out of order values.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Lists/order101.n02.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2019-03-25"/>
        </instanceTest>  
    </testGroup>
    

 
    
</testSet>    