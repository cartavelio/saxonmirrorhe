    <testGroup name="real004">
        <annotation>
            <documentation>
                Schema for ISO19139 ANZLIC supplied by email from Andrew Walsh (awalsh@metoc.gov.au)
                to MHK on 15 Aug 2008. Complains that it is rejected by Saxon but accepted by other processors.
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/2001/REC-xmlschema-1-20010502"/>
        <schemaTest name="real004.xsd">
		        <annotation>
		            <documentation>
		                Valid schema. Rejected by Saxon 9.1 as issued because of a bug testing for
		                reintroduction of particles in types derived by extension and restriction. 
		            </documentation>
		        </annotation>
            <schemaDocument xlink:href="../extraData/Real/iso19139.ANZLIC/schema.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2008-08-25"/>
        </schemaTest>
    </testGroup>        
    
    <testGroup name="real005">
        <annotation>
            <documentation>
                Variant of real004, this time using xs:redefine to create a local variant of the standard schema.
                Schema for ISO19139 ANZLIC supplied by email from Andrew Walsh (awalsh@metoc.gov.au)
                to MHK on 2 Sept 2008. Complains that it is rejected by Saxon but accepted by other processors.
            </documentation>
        </annotation>
        <!--<saxon:Configuration xmlns:saxon="http://saxon.sf.net/">
          <feature name="http://saxon.sf.net/feature/multipleSchemaImports" value="true"/>
          <!-\-<feature name="http://saxon.sf.net/feature/schemaURIResolverClass" value="com.saxonica.testdriver.SchemaTestSuiteDriver$NonStandardXLinkResolver"/>-\->
        </saxon:Configuration>  -->
        <documentationReference xlink:href="http://www.w3.org/TR/2001/REC-xmlschema-1-20010502"/>
        <schemaTest name="real005.xsd">
		        <annotation>
		            <documentation>
		                Valid schema. Rejected by Saxon 9.1 because redefined.xsd in its first xs:redefine
		                brings in some types which are then redefined by the second redefine. The spec isn't
		                very clear on this, but the principle of "pervasivess" suggests it should probably be 
		                allowed.
		                
		                The schema is rejected by Saxon 9.5 because of the relative URI ..\gco\gco.xsd
		                on line 5 of ADO_referenceSystem.xsd, which has been corrected to use forwards slashes.
		                
		                Another problem is that the schema uses (and relies on) a non-standard schema document
		                for the XLink namespace, which Saxon doesn't ordinarily read, because it has its own
		                local copy. To get around this, a custom SchemaURIResolver is needed.
		            </documentation>
		        </annotation>
            <schemaDocument xlink:href="../extraData/Real/ADO_19139_XSDs/gmd_ADO/ADO_gmd.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2008-09-02"/>
        </schemaTest>
        <instanceTest name="real005.v1.xml">
            <instanceDocument xlink:href="../extraData/Real/ADO_19139_XSDs/gmd_ADO/michael.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2008-09-02"/>
        </instanceTest>            
    </testGroup>   
    
    <testGroup name="real006">
        <annotation>
            <documentation>
                The MusicXML 2.0 Schema.
            </documentation>
