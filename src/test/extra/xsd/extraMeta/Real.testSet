		        <annotation>
		            <documentation>
		                Valid schema.
		            </documentation>
		        </annotation>
            <schemaDocument xlink:href="../extraData/Real/MusicXML2.0/musicxml.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2008-09-15"/>
        </schemaTest>
        <instanceTest name="real006.v1.xml">
		        <annotation>
		            <documentation>
		                Valid instance document (a Scott Joplin piano score)
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Real/MusicXML2.0/elite.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2008-09-15"/>
        </instanceTest>                    
    </testGroup>
    
