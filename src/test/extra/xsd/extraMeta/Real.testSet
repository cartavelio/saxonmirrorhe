    <testGroup name="real007">
        <annotation>
            <documentation>
                A schema based on Step-XML. 
                Caused Saxon bug relating to use of QName as a fixed attribute value.
                Bug report from NIST: permission to use requested.
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/2001/REC-xmlschema-1-20010502"/>
        <schemaTest name="real007.v1.xsd">
		        <annotation>
		            <documentation>
		                Valid schema.
		            </documentation>
		        </annotation>
            <schemaDocument xlink:href="../extraData/Real/StepXML/IFC2X3FromRick.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2009-04-16"/>
        </schemaTest>
        <instanceTest name="real007.v1.xml">
		        <annotation>
		            <documentation>
		                Valid instance document.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Real/StepXML/IFCBeam-032409.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2009-04-16"/>
        </instanceTest>                    
    </testGroup>                 
    
    <testGroup name="real008">
        <annotation>
            <documentation>
                Dutch standard documentation schemas from http://standaarden.overheid.nl/vac/.
                Makes heavy use of redefines and chameleon include.
                Failed in Saxon 9.2 - schema compilation and instance validation OK, but fails in SCM generation and XSLT runtime.
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/2001/REC-xmlschema-1-20010502"/>
        <schemaTest name="real008.v1.xsd">
		        <annotation>
		            <documentation>
		                Valid schema.
		            </documentation>
		        </annotation>
            <schemaDocument xlink:href="../extraData/Real/owms-vac/vac.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2009-10-16"/>
        </schemaTest>
        <!--<instanceTest name="real008.v1.xml">
		        <annotation>
		            <documentation>
		                Valid instance document.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Real/StepXML/IFCBeam-032409.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2009-10-16"/>
        </instanceTest>-->                    
    </testGroup>                          
        
    
</testSet>    