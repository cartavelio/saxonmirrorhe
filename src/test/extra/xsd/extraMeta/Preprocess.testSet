<testSet name="Preprocess"
      xmlns="http://www.w3.org/XML/2004/xml-schema-test-suite/"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/XML/2004/xml-schema-test-suite/ AnnotatedTSSchema.xsd"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      contributor="Saxonica"
      version="1.1"
      xmlns:saxon="http://saxon.sf.net/">

    <testGroup name="prep001" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:preprocess</Title>
                <Description>base type is a built-in type derived from xs:string</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-SchemaComposition-Override"/>
        <schemaTest name="prep001.xsd">
            <schemaDocument xlink:href="../extraData/Preprocess/prep001.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2012-04-19"/>
        </schemaTest>
        <instanceTest name="prep001.v01.xml">
		        <annotation>
		            <documentation>
		                Valid against the enumeration, after preprocessing.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep001.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>        
        <instanceTest name="prep001.n01.xml">
		        <annotation>
		            <documentation>
		                Invalid against the enumeration, after preprocessing.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep001.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>                           
    </testGroup>
    
    <testGroup name="prep002" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:preprocess</Title>
                <Description>base type is xs:string</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-SchemaComposition-Override"/>
        <schemaTest name="prep002.xsd">
            <schemaDocument xlink:href="../extraData/Preprocess/prep002.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2012-04-19"/>
        </schemaTest>
        <instanceTest name="prep002.v01.xml">
		        <annotation>
		            <documentation>
		                Valid against the enumeration, after preprocessing.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep001.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>        
        <instanceTest name="prep002.n01.xml">
		        <annotation>
		            <documentation>
		                Invalid against the enumeration, after preprocessing.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep001.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>                           
    </testGroup>
    
    <testGroup name="prep003" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:preprocess</Title>
                <Description>base type is xs:date</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-SchemaComposition-Override"/>
        <schemaTest name="prep003.xsd">
            <schemaDocument xlink:href="../extraData/Preprocess/prep003.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2012-04-19"/>
        </schemaTest>
        <instanceTest name="prep003.v01.xml">
		        <annotation>
		            <documentation>
		                Valid after preprocessing.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep003.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>        
        <instanceTest name="prep003.n01.xml">
		        <annotation>
		            <documentation>
		                Invalid against the base type, after preprocessing.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep003.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>
        <instanceTest name="prep003.n02.xml">
		        <annotation>
		            <documentation>
		                Invalid against other facets of the derived type.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep003.n02.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>                           
    </testGroup>
    
    <testGroup name="prep004" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:preprocess</Title>
                <Description>Type derived from a type with a preprocess facet</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-SchemaComposition-Override"/>
        <schemaTest name="prep004.xsd">
            <schemaDocument xlink:href="../extraData/Preprocess/prep004.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2012-04-19"/>
        </schemaTest>
        <instanceTest name="prep004.v01.xml">
		        <annotation>
		            <documentation>
		                Valid after preprocessing.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep003.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>        
        <instanceTest name="prep004.n01.xml">
		        <annotation>
		            <documentation>
		                Invalid against the base type, after preprocessing.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep003.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>
        <instanceTest name="prep004.n02.xml">
		        <annotation>
		            <documentation>
		                Invalid against other facets of the derived type.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep003.n02.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>                           
    </testGroup>
    
    <testGroup name="prep005" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:preprocess</Title>
                <Description>Type derived from a type with a preprocess facet.
                Also tests facet-available</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-SchemaComposition-Override"/>
        <schemaTest name="prep005.xsd">
            <schemaDocument xlink:href="../extraData/Preprocess/prep005.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2012-04-19"/>
        </schemaTest>
        <instanceTest name="prep005.v01.xml">
		        <annotation>
		            <documentation>
		                Valid after preprocessing.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep005.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>        
        <instanceTest name="prep005.n01.xml">
		        <annotation>
		            <documentation>
		                Invalid against the base type, after preprocessing.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep005.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>
        <instanceTest name="prep005.n02.xml">
		        <annotation>
		            <documentation>
		                Invalid against other facets of the derived type.
		            </documentation>
		        </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep005.n02.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2012-04-19"/>
        </instanceTest>                           
    </testGroup>
    
    <testGroup name="prep006" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:preprocess</Title>
                <Description>Invalid schema; enumeration facet must be in the correct format for the base type</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-SchemaComposition-Override"/>
        <schemaTest name="prep006.xsd">
            <schemaDocument xlink:href="../extraData/Preprocess/prep006.bad.xsd"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2012-04-19"/>
        </schemaTest>
    </testGroup>

    <testGroup name="any-xpath-001" version="1.1">
        <annotation>
            <documentation>
                <Title>saxon:extension="any-xpath-version"</Title>
                <Description>Allow use of XPath 3.1 in assertions</Description>
            </documentation>
        </annotation>
        <documentationReference xlink:href="http://www.w3.org/TR/xmlschema11-1/#override-schema"/>
        <documentationReference xlink:href="../common/XSD1_1TestCategories.xml#xsd1_1-SchemaComposition-Override"/>
        <schemaTest name="any-xpath-001.xsd">
            <schemaDocument xlink:href="../extraData/Preprocess/any-xpath-001.xsd"/>
            <expected validity="valid"/>
            <current status="accepted" date="2017-08-30"/>
        </schemaTest>
        <instanceTest name="any-xpath-001.v01.xml">
            <annotation>
                <documentation>
                    Valid against the enumeration, after preprocessing.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep001.v01.xml"/>
            <expected validity="valid"/>
            <current status="accepted" date="2017-08-30"/>
        </instanceTest>        
        <instanceTest name="any-xpath-001.n01.xml">
            <annotation>
                <documentation>
                    Invalid against the enumeration, after preprocessing.
                </documentation>
            </annotation>
            <instanceDocument xlink:href="../extraData/Preprocess/prep001.n01.xml"/>
            <expected validity="invalid"/>
            <current status="accepted" date="2017-08-30"/>
        </instanceTest>                           
    </testGroup>
    
</testSet>    