<configuration edition="EE" xmlns="http://saxon.sf.net/ns/configuration"> 
    <xsltPackages>
        <package name='http://package-add/' base="http://example.org/pack-120.xsl" version='1.0' sourceLocation='pack-120.xsl'>
            <withParam name="operator" select="'+'"/>
            <withParam name="opname" select="'add'"/>
        </package>
        <package name='http://package-subtract/' base="http://example.org/pack-120.xsl" version='1.0' sourceLocation='pack-120.xsl'>
            <withParam name="operator" select="'-'"/>
            <withParam name="opname" select="'subtract'"/>
        </package>
        <package name='http://package-multiply/' base="http://example.org/pack-120.xsl" version='1.0' sourceLocation='pack-120.xsl'>
            <withParam name="operator" select="'*'"/>
            <withParam name="opname" select="'multiply'"/>
        </package>
    </xsltPackages>
</configuration>