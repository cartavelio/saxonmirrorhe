<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://myns2" xmlns:myns="http://myns2"
attributeFormDefault="unqualified"
elementFormDefault="qualified">

  <xsd:element type="myns:docType" name="doc"/>

  <xsd:complexType name="docType">
      <xsd:sequence maxOccurs="1" minOccurs="0">
          <xsd:element type="myns:abstractType" name="object" />
      </xsd:sequence>
  </xsd:complexType>
  
  <xsd:complexType name="abstractType" abstract="true"/>
  <xsd:complexType name="concreteType">
      <xsd:complexContent>
          <xsd:extension base="myns:abstractType">
              <xsd:sequence maxOccurs="1" minOccurs="0">
                  <xsd:element type="xsd:string" name="field" />
              </xsd:sequence>
          </xsd:extension>
      </xsd:complexContent>
  </xsd:complexType>
 
</xsd:schema>