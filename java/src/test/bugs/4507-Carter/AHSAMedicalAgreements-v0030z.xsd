<?xml version="1.0" encoding="UTF-8"?>
<!-- AHSA Medical Agreements XML Schema -->
<!-- Schema Version: 3.0 (Revision 0030e) -->
<!-- XML Schema Version 1.1 -->
<!-- Created on 27-Mar-2020 -->
<!-- Australian Health Service Alliance -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.ahsa.com.au/schema/medicalagreements" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" targetNamespace="http://www.ahsa.com.au/schema/medicalagreements" elementFormDefault="qualified" xpathDefaultNamespace="##defaultNamespace" vc:minVersion="1.1">
	<xs:element name="MedicalAgreement" type="MedicalAgreementType"/>
	<!-- Complex Types -->
	<xs:complexType name="AccountType">
		<xs:sequence>
			<xs:element name="Name" type="StringType150" minOccurs="1" maxOccurs="1"/>
			<xs:element name="BSB" type="BSBType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="AccountNumber" type="AccountNumberType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Reference" type="StringType18" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Bank" type="StringType150" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Branch" type="StringType50" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AddressType">
		<xs:sequence>
			<xs:element name="Address1" type="StringType50" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Address2" type="StringType50" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Place" type="StringType50" minOccurs="1" maxOccurs="1"/>
			<xs:element name="State" type="StateType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Postcode" type="PostcodeType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="DPID" type="DPIDType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AgreementCompanyType">
		<xs:sequence>
			<xs:element name="CompanyType" type="CompanyTypeType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="CompanyCode" type="CompanyCodeType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="CompanyName" type="StringType50" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AgreementProviderType">
		<xs:sequence>
			<xs:element name="AgreementNumber" type="AgreementNumberType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="AgreementVersion" type="IntegerTypeP" minOccurs="1" maxOccurs="1"/>
			<xs:element name="ScheduleCode" type="ScheduleCodeType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="StartDate" type="DateType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="ChangeDate" type="DateType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Termination" type="TerminationType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="DaysForPayment" type="IntegerTypeP" minOccurs="0" maxOccurs="1"/>
			<xs:element name="PublicListingFlag" type="ListingType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="GPListingFlag" type="ListingType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="MemberPhoneInquiryFlag" type="ListingType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AgreementScheduleType">
		<xs:sequence>
			<xs:element name="AgreementNumber" type="AgreementCodeType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="AgreementName" type="StringType50" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Company" type="AgreementCompanyType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="AgreementStartDate" type="DateType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Termination" type="TerminationType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="AgreementScheduleVersions" type="AgreementScheduleVersionsType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:attribute name="agreementType" type="AgreementTypeAttributeType" use="required"/>
		<xs:attribute name="state" type="StateType" use="optional"/>
		<xs:assert test="AgreementStartDate le //AgreementScheduleVersion/VersionStartDate"/>
		<xs:assert test="@agreementType = 'A' and AgreementScheduleVersions/AgreementScheduleVersion/EpisodeOutOfPocketAmount and AgreementScheduleVersions/AgreementScheduleVersion/ObstericsOutOfPocketAmount"/>
		<xs:assert test="@agreementType eq 'M' and AgreementScheduleVersions/AgreementScheduleVersion/EpisodeOutOfPocketAmount"/>
		<xs:assert test="@agreementType eq 'P' and AgreementScheduleVersions/AgreementScheduleVersion/EpisodeOutOfPocketAmount"/>
		<xs:assert test="@agreementType eq 'E' and not(AgreementScheduleVersions/AgreementScheduleVersion/EpisodeOutOfPocketAmount) and AgreementScheduleVersions/AgreementScheduleVersion/Schedules/Schedule/Items/Item/ItemOutOfPocketAmount"/>
	</xs:complexType>
	<xs:complexType name="AgreementScheduleVersionType">
		<xs:sequence>
			<xs:element name="AgreementVersion" type="IntegerTypeP" minOccurs="1" maxOccurs="1"/>
			<xs:element name="VersionStartDate" type="DateType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="DefaultDaysForPayment" type="IntegerTypeP" minOccurs="1" maxOccurs="1"/>
			<xs:element name="EpisodeOutOfPocketAmount" type="DecimalType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ObstetricsOutOfPocketAmount" type="DecimalType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Schedules" type="SchedulesType" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AgreementScheduleVersionsType">
		<xs:sequence>
			<xs:element name="AgreementScheduleVersion" type="AgreementScheduleVersionType" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="versionCount" type="IntegerTypeP" use="required"/>
		<xs:assert test="count(AgreementScheduleVersion) eq @versionCount"/>
	</xs:complexType>
	<xs:complexType name="AgreementsProviderType">
		<xs:sequence>
			<xs:element name="Agreement" type="AgreementProviderType" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="agreementCount" type="IntegerTypeP" use="required"/>
		<xs:assert test="count(Agreement) eq @agreementCount"/>
	</xs:complexType>
	<xs:complexType name="BillingType">
		<xs:sequence>
			<xs:element name="PaymentMethod" type="PaymentMethodType"/>
			<xs:element name="BankAccount" type="AccountType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="BillingName" type="StringType50" minOccurs="0" maxOccurs="1"/>
			<xs:element name="BillingAddress" type="AddressType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="BillingContact" type="ContactType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:assert test="(PaymentMethod eq 'EFT' and BankAccount) or (PaymentMethod eq 'Cheque' and not(BankAccount) and BillingAddress)"/>
	</xs:complexType>
	<xs:complexType name="ContactMethodType">
		<xs:sequence>
			<xs:element name="PhoneNumber" type="StringType15" minOccurs="0" maxOccurs="1"/>
			<xs:element name="FaxNumber" type="StringType15" minOccurs="0" maxOccurs="1"/>
			<xs:element name="EmailAddress" type="StringType128" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:assert test="PhoneNumber or FaxNumber or EmailAddress"/>
	</xs:complexType>
	<xs:complexType name="ContactType">
		<xs:sequence>
			<xs:element name="Salutation" type="SalutationType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="FirstName" type="StringType50" minOccurs="0" maxOccurs="1"/>
			<xs:element name="LastName" type="StringType50" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Title" type="StringType50" minOccurs="0" maxOccurs="1"/>
			<xs:element name="PhoneNumber" type="StringType15" minOccurs="0" maxOccurs="1"/>
			<xs:element name="FaxNumber" type="StringType15" minOccurs="0" maxOccurs="1"/>
			<xs:element name="EmailAddress" type="StringType128" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:assert test="(Salutation or FirstName or LastName or Title)"/>
	</xs:complexType>
	<xs:complexType name="ItemsType">
		<xs:sequence>
			<xs:element name="Item" type="ItemType" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="itemCount" type="IntegerTypeP" use="required"/>
		<xs:assert test="count(Item) eq @itemCount"/>
	</xs:complexType>
	<xs:complexType name="ItemType">
		<xs:sequence>
			<xs:element name="ItemCode" type="ItemCodeType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="ItemDescription" type="StringType50" minOccurs="0" maxOccurs="1"/>
			<xs:choice minOccurs="1" maxOccurs="1">
				<xs:element name="PercentageRate" type="PercentageRateType"/>
				<xs:element name="Amount" type="DecimalType"/>
			</xs:choice>
			<xs:element name="ItemOutOfPocketAmount" type="DecimalType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:attribute name="itemType" type="ItemTypeType" use="required"/>
		<xs:attribute name="feeType" type="FeeTypeType" use="optional"/>
	</xs:complexType>
	<xs:complexType name="MedicalAgreementType">
		<xs:sequence>
			<xs:choice minOccurs="1" maxOccurs="1">
				<xs:element name="AgreementSchedule" type="AgreementScheduleType" minOccurs="1" maxOccurs="1"/>
				<xs:element name="Providers" type="ProvidersType" minOccurs="1" maxOccurs="1"/>
			</xs:choice>
		</xs:sequence>
		<xs:attribute name="schemaVersion" type="DecimalType" use="required"/>
		<xs:attribute name="content" type="ContentType" use="required"/>
		<xs:attribute name="fromDate" type="DateType" use="optional"/>
		<xs:attribute name="toDate" type="DateType" use="optional"/>
		<xs:attribute name="creationDate" type="DateType" use="required"/>
		<xs:attribute name="fileType" type="FileType" use="required"/>
		<xs:attribute name="scope" type="AgreementCodeType" use="optional"/>
		<xs:assert test="(@fromDate and @toDate and @fromDate le @toDate) or (not(@fromDate) and not(@toDate))"/>
	</xs:complexType>
	<xs:complexType name="NameType">
		<xs:sequence>
			<xs:element name="Salutation" type="SalutationType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="FirstName" type="StringType50" minOccurs="1" maxOccurs="1"/>
			<xs:element name="MiddleNames" type="StringType50" minOccurs="0" maxOccurs="1"/>
			<xs:element name="LastName" type="StringType50" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Suffix" type="StringType20" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Title" type="StringType50" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ProvidersType">
		<xs:sequence>
			<xs:element name="Provider" type="ProviderType" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="providerCount" type="IntegerTypeP" use="required"/>
		<xs:assert test="count(Provider) eq @providerCount"/>
	</xs:complexType>
	<xs:complexType name="ProviderType">
		<xs:sequence>
			<xs:element name="ProviderName" type="NameType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="PracticeAddress" type="AddressType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="PracticeContactMethod" type="ContactMethodType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Agreements" type="AgreementsProviderType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Billing" type="BillingType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="PublicSalariedDoctor" type="BooleanType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:attribute name="providerNumber" type="MedicalProviderNumberType" use="required"/>
	</xs:complexType>
	<xs:complexType name="SchedulesType">
		<xs:sequence>
			<xs:element name="Schedule" type="ScheduleType" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="scheduleCount" type="IntegerTypeP" use="required"/>
		<xs:assert test="count(Schedule) eq @scheduleCount"/>
	</xs:complexType>
	<xs:complexType name="ScheduleType">
		<xs:sequence>
			<xs:element name="ScheduleCode" type="ScheduleCodeType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="ScheduleName" type="StringType50" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ScheduleActionFlag" type="ScheduleActionFlagType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Items" type="ItemsType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TerminationType">
		<xs:sequence>
			<xs:element name="TerminationReasonCode" type="TerminationReasonCodeType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="TerminationDate" type="DateType" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<!-- Simple Types -->
	<xs:simpleType name="AccountNumberType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="9"/>
			<xs:pattern value="[0-9]*"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AgreementCodeType">
		<xs:restriction base="xs:string">
			<xs:minLength value="6"/>
			<xs:maxLength value="8"/>
			<xs:pattern value="[AE][ADNQSTVW]-MAST-|[MP][ADNQSTVW][A-Z0-9]{4}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AgreementNumberType">
		<xs:restriction base="xs:string">
			<xs:length value="8"/>
			<xs:pattern value="[AEMP][ADNQSTVW][A-Z0-9]{6}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AgreementTypeAttributeType">
		<xs:restriction base="xs:string">
			<xs:length value="1"/>
			<xs:pattern value="[AEMP]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AgreementTypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="AGC"/>
			<xs:enumeration value="AGC2"/>
			<xs:enumeration value="HPPA/PA"/>
			<xs:enumeration value="MPPA"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="AgreementVersionType">
		<xs:restriction base="IntegerTypeP">
			<xs:totalDigits value="4"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BooleanType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Y"/>
			<xs:enumeration value="N"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BSBType">
		<xs:restriction base="xs:string">
			<xs:length value="7"/>
			<xs:pattern value="[0-9]{3}[-][0-9]{3}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CompanyCodeType">
		<xs:restriction base="xs:string">
			<xs:minLength value="6"/>
			<xs:maxLength value="8"/>
			<xs:pattern value="[C][0-9]{5}|[0-9]{7}[ABFHJKLTWXY]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CompanyTypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Hospital"/>
			<xs:enumeration value="Medical"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ContentType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Incremental"/>
			<xs:enumeration value="Snapshot"/>
			<xs:enumeration value="Full"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DateType">
		<xs:restriction base="xs:date">
			<xs:minInclusive value="1990-01-01"/>
			<xs:maxInclusive value="2100-12-31"/>
			<xs:pattern value="\d{4}-\d{2}-\d{2}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DecimalType">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0.0"/>
			<xs:fractionDigits value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DPIDType">
		<xs:restriction base="xs:string">
			<xs:length value="8"/>
			<xs:pattern value="[0-9]{8}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FeeTypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Derived"/>
			<xs:enumeration value="Normal"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FileType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Schedule"/>
			<xs:enumeration value="Provider"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="HospitalProviderNumberType">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:length value="8"/>
			<xs:pattern value="[0-9]{7}[ABFHJKLTWXY]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="IntegerTypeN">
		<xs:restriction base="xs:nonNegativeInteger"/>
	</xs:simpleType>
	<xs:simpleType name="IntegerTypeP">
		<xs:restriction base="xs:positiveInteger"/>
	</xs:simpleType>
	<xs:simpleType name="ItemCodeType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{5}|[A-Z]{3}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ItemTypeType">
		<xs:restriction base="xs:string">
			<xs:length value="1"/>
			<xs:pattern value="[CGO]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ListingType">
		<xs:restriction base="xs:string">
			<xs:length value="1"/>
			<xs:pattern value="[YNU]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="MedicalProviderNumberType">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="collapse"/>
			<xs:length value="8"/>
			<xs:pattern value="[0-9]{6}[0-9A-HJ-NP-RT-Y][ABFHJKLTWXY]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PaymentMethodType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Cheque"/>
			<xs:enumeration value="EFT"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PercentageRateType">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="0.0"/>
			<xs:fractionDigits value="1"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PostcodeType">
		<xs:restriction base="xs:string">
			<xs:length value="4"/>
			<xs:pattern value="[0-9]{4}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="SalutationType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="AProf"/>
			<xs:enumeration value="Capt"/>
			<xs:enumeration value="Dr"/>
			<xs:enumeration value="Miss"/>
			<xs:enumeration value="Mr"/>
			<xs:enumeration value="Mrs"/>
			<xs:enumeration value="Ms"/>
			<xs:enumeration value="Prof"/>
			<xs:enumeration value="Sir"/>
			<xs:enumeration value="Sr"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ScheduleActionFlagType">
		<xs:restriction base="xs:string">
			<xs:length value="1"/>
			<xs:pattern value="[DINU]"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ScheduleCodeType">
		<xs:restriction base="xs:string">
			<xs:minLength value="8"/>
			<xs:maxLength value="10"/>
			<xs:pattern value="[AE][ADNQSTVW]-MAST-[0-9]{2}|[MP][ADNQSTVW][A-Z0-9]{4}[0-9]{2}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StateType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACT"/>
			<xs:enumeration value="NSW"/>
			<xs:enumeration value="NT"/>
			<xs:enumeration value="QLD"/>
			<xs:enumeration value="SA"/>
			<xs:enumeration value="TAS"/>
			<xs:enumeration value="VIC"/>
			<xs:enumeration value="WA"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringType6">
		<xs:restriction base="xs:string">
			<xs:maxLength value="6"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringType15">
		<xs:restriction base="xs:string">
			<xs:maxLength value="15"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringType18">
		<xs:restriction base="xs:string">
			<xs:maxLength value="18"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringType20">
		<xs:restriction base="xs:string">
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringType50">
		<xs:restriction base="xs:string">
			<xs:maxLength value="50"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringType128">
		<xs:restriction base="xs:string">
			<xs:maxLength value="128"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringType150">
		<xs:restriction base="xs:string">
			<xs:maxLength value="150"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringType255">
		<xs:restriction base="xs:string">
			<xs:maxLength value="255"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="StringType1024">
		<xs:restriction base="xs:string">
			<xs:maxLength value="1024"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TerminationReasonCodeType">
		<xs:restriction base="xs:string">
			<xs:length value="5"/>
			<xs:pattern value="[T][0-9]{4}"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
