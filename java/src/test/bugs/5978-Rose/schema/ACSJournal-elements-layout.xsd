              </xsd:documentation>
      </xsd:annotation>
   </xsd:import>
   <xsd:import namespace="http://namespace.acs.org/2008/acs"/>
   <!--* Some imports may need to be added manually *-->
   <xsd:element name="abbrev-journal-title">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Abbreviated Journal Title</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType mixed="true">
         <xsd:sequence/>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="abstract">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Abstract</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:sequence>
            <xsd:element ref="title" minOccurs="0"/>
            <xsd:element ref="p" maxOccurs="unbounded"/>
         </xsd:sequence>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="abstract-graphic">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Abstract Graphic</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:group ref="graphic-model" minOccurs="0" maxOccurs="unbounded"/>
         <xsd:attribute name="applies-to-print" use="optional">
            <xsd:annotation/>
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="no"/>
                  <xsd:enumeration value="pdf-only"/>
                  <xsd:enumeration value="print-only"/>
                  <xsd:enumeration value="yes"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="applies-to-web" use="optional">
            <xsd:annotation/>
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="no"/>
                  <xsd:enumeration value="yes"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="checksum" use="optional" type="xsd:string"/>
         <xsd:attribute name="href" use="required" type="xsd:string"/>
         <xsd:attribute name="id" use="optional" type="xsd:ID">
            <xsd:annotation/>
         </xsd:attribute>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="abstract-group">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Abstract Group</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:sequence>
            <xsd:group ref="abstract-group-model"/>
         </xsd:sequence>
         <xsd:attribute name="use-first-para" use="optional" default="no">
            <xsd:annotation/>
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="no"/>
                  <xsd:enumeration value="yes"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="access-date">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Access Date For Cited Work</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType mixed="true">
         <xsd:sequence/>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="ack">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Acknowledgments</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:sequence>
            <xsd:sequence minOccurs="0">
               <xsd:group ref="label.class"/>
            </xsd:sequence>
            <xsd:element ref="title" minOccurs="0"/>
            <xsd:element ref="live-change" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element ref="p" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element ref="sec" minOccurs="0" maxOccurs="unbounded"/>
         </xsd:sequence>
         <xsd:attribute name="auto-number" use="optional">
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="no"/>
                  <xsd:enumeration value="yes"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="auto-numbering-enabled" use="optional">
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="off"/>
                  <xsd:enumeration value="on"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="id" use="optional" type="xsd:ID">
            <xsd:annotation/>
         </xsd:attribute>
         <xsd:attribute name="numbering-scale" use="optional" type="xsd:string"/>
         <xsd:attribute name="numbering-style" use="optional" type="xsd:string"/>
         <xsd:attribute name="sec-punctuation-style" use="optional">
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="brackets"/>
                  <xsd:enumeration value="colon"/>
                  <xsd:enumeration value="parens"/>
                  <xsd:enumeration value="period"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="acs-biochem">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Acs Biochemical Journal Citation</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:sequence>
            <xsd:sequence minOccurs="0">
               <xsd:group ref="label.class"/>
            </xsd:sequence>
            <xsd:element ref="note" minOccurs="0"/>
            <xsd:element ref="acs-cite-author" maxOccurs="unbounded"/>
            <xsd:element ref="etal" minOccurs="0"/>
            <xsd:element ref="year"/>
            <xsd:element ref="article-title" minOccurs="0"/>
            <xsd:element ref="source"/>
            <xsd:element ref="volume" minOccurs="0"/>
            <xsd:element ref="issue" minOccurs="0"/>
            <xsd:choice>
               <xsd:sequence>
                  <xsd:element ref="fpage"/>
                  <xsd:element ref="lpage" minOccurs="0"/>
               </xsd:sequence>
               <xsd:element ref="elocation-id"/>
            </xsd:choice>
            <xsd:element ref="uri" minOccurs="0"/>
            <xsd:element ref="note" minOccurs="0"/>
            <xsd:element ref="doi" minOccurs="0"/>
            <xsd:element ref="pub-id" minOccurs="0"/>
            <xsd:element ref="issn" minOccurs="0"/>
         </xsd:sequence>
         <xsd:attribute name="href" use="optional" type="xsd:string"/>
         <xsd:attribute name="id" use="optional" type="xsd:ID">
            <xsd:annotation/>
         </xsd:attribute>
         <xsd:attribute name="parent-citation" use="optional" type="xsd:IDREF"/>
         <xsd:attribute name="role" use="optional" type="xsd:string"/>
         <xsd:attribute name="show" use="optional">
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="embed"/>
                  <xsd:enumeration value="new"/>
                  <xsd:enumeration value="none"/>
                  <xsd:enumeration value="other"/>
                  <xsd:enumeration value="replace"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="title" use="optional" type="xsd:string"/>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="acs-cite-author">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Acs Citation Author</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:choice>
            <xsd:sequence>
               <xsd:element ref="surname"/>
               <xsd:element ref="initials" minOccurs="0"/>
               <xsd:element ref="suffix" minOccurs="0"/>
            </xsd:sequence>
            <xsd:element ref="collab"/>
         </xsd:choice>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="acs-no-titles">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Acs No-Titles Journal Citation</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:sequence>
            <xsd:sequence minOccurs="0">
               <xsd:group ref="label.class"/>
            </xsd:sequence>
            <xsd:element ref="note" minOccurs="0"/>
            <xsd:element ref="acs-cite-author" maxOccurs="unbounded"/>
            <xsd:element ref="etal" minOccurs="0"/>
            <xsd:element ref="source"/>
            <xsd:element ref="year"/>
            <xsd:element ref="volume" minOccurs="0"/>
            <xsd:element ref="issue" minOccurs="0"/>
            <xsd:choice>
               <xsd:sequence>
                  <xsd:element ref="fpage"/>
                  <xsd:element ref="lpage" minOccurs="0"/>
               </xsd:sequence>
               <xsd:element ref="elocation-id"/>
            </xsd:choice>
            <xsd:element ref="uri" minOccurs="0"/>
            <xsd:element ref="note" minOccurs="0"/>
            <xsd:element ref="doi" minOccurs="0"/>
            <xsd:element ref="pub-id" minOccurs="0"/>
            <xsd:element ref="issn" minOccurs="0"/>
         </xsd:sequence>
         <xsd:attribute name="href" use="optional" type="xsd:string"/>
         <xsd:attribute name="id" use="optional" type="xsd:ID">
            <xsd:annotation/>
         </xsd:attribute>
         <xsd:attribute name="parent-citation" use="optional" type="xsd:IDREF"/>
         <xsd:attribute name="role" use="optional" type="xsd:string"/>
         <xsd:attribute name="show" use="optional">
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="embed"/>
                  <xsd:enumeration value="new"/>
                  <xsd:enumeration value="none"/>
                  <xsd:enumeration value="other"/>
                  <xsd:enumeration value="replace"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="title" use="optional" type="xsd:string"/>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="acs-titles">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Acs Titles Journal Citation</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:sequence>
            <xsd:sequence minOccurs="0">
               <xsd:group ref="label.class"/>
            </xsd:sequence>
            <xsd:group ref="acs-titles-mix"/>
         </xsd:sequence>
         <xsd:attribute name="href" use="optional" type="xsd:string"/>
         <xsd:attribute name="id" use="optional" type="xsd:ID"/>
         <xsd:attribute name="parent-citation" use="optional" type="xsd:IDREF"/>
         <xsd:attribute name="role" use="optional" type="xsd:string"/>
         <xsd:attribute name="show" use="optional">
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="embed"/>
                  <xsd:enumeration value="new"/>
                  <xsd:enumeration value="none"/>
                  <xsd:enumeration value="other"/>
                  <xsd:enumeration value="replace"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="title" use="optional" type="xsd:string"/>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="add-correct">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Addition/Correction</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:sequence>
            <xsd:element ref="previous" maxOccurs="unbounded"/>
            <xsd:element ref="change-desc"/>
         </xsd:sequence>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="addr-line">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Address Line</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType mixed="true">
         <xsd:choice minOccurs="0" maxOccurs="unbounded">
            <xsd:group ref="simple-text"/>
         </xsd:choice>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="address">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Address/Contact Information</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:choice minOccurs="0" maxOccurs="unbounded">
            <xsd:group ref="address.class"/>
            <xsd:group ref="ext-link.class"/>
         </xsd:choice>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="aff">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Affiliation</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType mixed="true">
         <xsd:choice minOccurs="0" maxOccurs="unbounded">
            <xsd:group ref="label.class"/>
            <xsd:group ref="address.class"/>
            <xsd:group ref="break.class"/>
            <xsd:group ref="emphasis.class"/>
            <xsd:group ref="ext-link.class"/>
            <xsd:group ref="subsup.class"/>
            <xsd:group ref="dept-office.class"/>
            <xsd:group ref="external-identifier.class"/>
         </xsd:choice>
         <xsd:attribute name="id" use="optional" type="xsd:ID">
            <xsd:annotation/>
         </xsd:attribute>
         <xsd:attribute name="rid" use="optional" type="xsd:IDREFS">
            <xsd:annotation/>
         </xsd:attribute>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="alt-person-name">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Alternate Personal Names</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType mixed="true">
         <xsd:choice minOccurs="0" maxOccurs="unbounded">
            <xsd:group ref="person-name-basic.class"/>
            <xsd:group ref="subsup.class"/>
         </xsd:choice>
         <xsd:attribute name="alt-name-type" use="optional">
            <xsd:annotation/>
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="legal-name"/>
                  <xsd:enumeration value="native-lang"/>
                  <xsd:enumeration value="nickname"/>
                  <xsd:enumeration value="other"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="altimg" use="optional" type="xsd:string"/>
         <xsd:attribute name="font-name" use="optional" type="xsd:string"/>
         <xsd:attribute ref="xml:lang" use="optional" default="EN"/>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="anchor">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Anchor</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:attribute name="rid" use="optional" type="xsd:IDREFS">
            <xsd:annotation/>
         </xsd:attribute>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="app">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Appendix</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:sequence>
            <xsd:group ref="sec-opt-title-model"/>
            <xsd:choice minOccurs="0" maxOccurs="unbounded">
               <xsd:group ref="display-meta.class"/>
            </xsd:choice>
         </xsd:sequence>
         <xsd:attribute name="auto-number" use="optional">
            <xsd:annotation/>
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="no"/>
                  <xsd:enumeration value="yes"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="auto-numbering-enabled" use="optional">
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="off"/>
                  <xsd:enumeration value="on"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="id" use="required" type="xsd:ID">
            <xsd:annotation/>
         </xsd:attribute>
         <xsd:attribute name="numbering-scale" use="optional" type="xsd:string"/>
         <xsd:attribute name="numbering-style" use="optional" type="xsd:string"/>
         <xsd:attribute name="sec-punctuation-style" use="optional">
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="brackets"/>
                  <xsd:enumeration value="colon"/>
                  <xsd:enumeration value="parens"/>
                  <xsd:enumeration value="period"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="array">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Array (Pseudo-Table)</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:choice>
            <xsd:element ref="tbody"/>
         </xsd:choice>
         <xsd:attribute name="applies-to-print" use="optional">
            <xsd:annotation/>
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="no"/>
                  <xsd:enumeration value="pdf-only"/>
                  <xsd:enumeration value="print-only"/>
                  <xsd:enumeration value="yes"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="applies-to-web" use="optional">
            <xsd:annotation/>
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="no"/>
                  <xsd:enumeration value="yes"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="checksum" use="optional" type="xsd:string"/>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="article-title">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Article Title</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType mixed="true">
         <xsd:choice minOccurs="0" maxOccurs="unbounded">
            <xsd:group ref="title-elements"/>
         </xsd:choice>
         <xsd:attribute name="added-from" use="optional" type="xsd:string">
            <xsd:annotation/>
         </xsd:attribute>
         <xsd:attribute name="ref-style" use="optional">
            <xsd:annotation/>
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="base-text"/>
                  <xsd:enumeration value="superscript"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
         <xsd:attribute name="suppress-in-print" use="optional">
            <xsd:annotation/>
            <xsd:simpleType>
               <xsd:annotation>
                  <xsd:documentation/>
               </xsd:annotation>
               <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="no"/>
                  <xsd:enumeration value="yes"/>
               </xsd:restriction>
            </xsd:simpleType>
         </xsd:attribute>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="ascii-abstract">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Ascii Abstract</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType>
         <xsd:sequence>
            <xsd:element ref="title" minOccurs="0"/>
            <xsd:element ref="p" maxOccurs="unbounded"/>
         </xsd:sequence>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="ascii-synopsis">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Ascii Synopsis</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType mixed="true">
         <xsd:sequence/>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="ascii-title">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
               <h3>Ascii Title</h3>
            </div>
         </xsd:documentation>
      </xsd:annotation>
      <xsd:complexType mixed="true">
         <xsd:choice minOccurs="0" maxOccurs="unbounded">
            <xsd:group ref="just-rendition"/>
         </xsd:choice>
      </xsd:complexType>
   </xsd:element>
   <xsd:element name="author-notes">
      <xsd:annotation>
         <xsd:documentation>
            <div xmlns="http://www.w3.org/1999/xhtml">
