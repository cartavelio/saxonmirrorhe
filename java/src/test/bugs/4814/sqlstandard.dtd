<!-- extsymresult is used to capture the result of an invocable subclause    -->
<!--   in another part                                                       -->
<!ELEMENT extsymresult (#PCDATA | %inline.class;)*>
<!-- The "param" attribute identifies the target symparam by name            -->
<!ATTLIST extsymresult
