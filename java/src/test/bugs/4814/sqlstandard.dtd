<!-- A clause has a heading, a body, possibly subclauses (max 4 levels)      -->
<!--   A clause has 1 attribute: a symbol for referencing it                 -->
<!--   The clauseNumber attribute, used only in the TC, gives a specific #   -->
<!ELEMENT clause     ((%comments.class;)*, clauseNumber?,
                      (%comments.class;)*, clauseHeading,
                      (%comments.class;)*, bodyMatter?,
                      ((%comments.class;)*, subClause)*, (%comments.class;)*)>
