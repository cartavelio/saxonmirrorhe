<!ATTLIST item
	id ID #IMPLIED
>


<!-- A lbllist is a kind of list in which the document author specifies the  -->
<!--   character(s) to be used as the identifier for each list item, as      -->
<!--   opposed to the type of list determining that identifier. Because this -->
<!--   difference is so significant, we choose to use a new element for the  -->
<!--   list items; instead of "item", we use "lblitem" with a "label"        -->
<!--   attribute that specifies the character(s) to be used as the label.    -->
<!--   The optional lblwidth attribute overrides the default width of the    -->
<!--   label                                                                 -->
<!ELEMENT lbllist (lblitem | (%comments.class;)*)+>
<!ATTLIST lbllist 
  lblwidth CDATA #IMPLIED 
>


<!-- A lbllist lblitem is a lot like a list item, but with a label attribute -->
<!--   NOTE: The label should be rather short...1 or 2 characters, maybe 3   -->
<!--   unless a specific lblwidth attribute is specified on the given lbllist-->
<!ELEMENT lblitem (#PCDATA | %inline.class; | %blocks.class;)*>
<!ATTLIST lblitem
	id    ID #IMPLIED
  label CDATA #REQUIRED
>


<!-- None is a special element used in various Rules that says "None. " 
-->
<!ELEMENT None EMPTY>


<!-- NoAdditional is a special element that says "No additional * Rules. "
-->
<!ELEMENT NoAdditional EMPTY>


<!-- NoDefinition is a special element that says "No additional Definitions. "
-->
<!ELEMENT NoDefinition EMPTY>


<!-- A grammar is a BNF section. It has one or more BNFdef elements
-->
<!ELEMENT grammar (((%comments.class;)*, NoFormat) | (((%comments.class;)*, BNFdef, 
                  (%comments.class;)*, (%notes.class;)*)+, (%comments.class;)*) )>
<!ATTLIST grammar
  discussion ( yes | no ) #IMPLIED
>


<!-- NoFormat is a special element that says "No additional Format items. "
-->
<!ELEMENT NoFormat EMPTY>


<!-- A BNFdef has an attribute giving the name of the BNF nonterminal being
     defined, and contains exactly one rhs (right-hand side)
-->
<!ELEMENT BNFdef ((%comments.class;)*, (%newlines.class;)*, rhs)>
<!ATTLIST BNFdef
	name CDATA #REQUIRED
	predicative ( yes | no ) #IMPLIED 
>


<!-- The rhs of a BNFdef can have either two or more alt or minialtlist elements or can
     can have one set of right-hand side terms
-->
<!ELEMENT rhs ( ( (%comments.class;)*, (%newlines.class;)*, (%comments.class;)*, alt,
                  (%comments.class;)*, seeTheRules?, (%comments.class;)*
                )+
              | ( (%comments.class;)*, (%newlines.class; | minialtlist)*,
	                (%comments.class;)*, seeTheRules?, (%comments.class;)*
                )+
              | ( (%comments.class;)*, (%newlines.class; | minialt)*,
	                (%comments.class;)*, seeTheRules?, (%comments.class;)*
                )+
              | ( ( (%comments.class;)*
                  | (%newlines.class;)
                  | opt
                  | group
                  | terminalsymbol
                  | %inline.class;
                  )*,
                  (%comments.class;)*, seeTheRules?, (%comments.class;)*
                )+
              | ( (%comments.class;)*, seeTheRules )
              )*>


<!-- An alt of the rhs of a BNFdef can one set of right-hand side terms
-->
<!ELEMENT alt (#PCDATA | allAltsFrom | opt | group | terminalsymbol 
              | %inline.class; | %comments.class;)*>


<!-- A BNF element has a name attribute and optional part and standard attributes;
     It is otherwise empty 
-->
<!ELEMENT BNF EMPTY>
<!ATTLIST BNF
	name CDATA #REQUIRED
  part CDATA #IMPLIED
  standard CDATA #IMPLIED
>


<!-- An allAltsFrom element represents "!! All alternatives from standard-part
-->
<!ELEMENT allAltsFrom EMPTY>
<!ATTLIST allAltsFrom
  part CDATA #REQUIRED
  standard CDATA #IMPLIED
>


<!-- An opt element is one or more right-hand side elements surrounded by square brackets
-->
<!ELEMENT opt (#PCDATA | alt | opt | group | minialt | terminalsymbol | %inline.class; 
               | %comments.class;)*>


<!-- A group element is two or more right-hand side elements surrounded by curly braces
-->
<!ELEMENT group (#PCDATA | alt | opt | group | minialt | terminalsymbol | %inline.class; 
                 | %comments.class;)*>


<!-- An ellipsis is an empty element that is set as three dots...an ellipsis
-->
<!ELEMENT ellipsis EMPTY>


<!-- A minialtlist element is set of minialt elements which format onto one line
-->
<!ELEMENT minialtlist (#PCDATA | minialt | %inline.class; | terminalsymbol | %comments.class;)*>


<!-- A minialt element is an alt which does not force a line break
-->
<!ELEMENT minialt (#PCDATA | %inline.class; | terminalsymbol | opt | minialt)*>


<!-- A terminalsymbol element allows inclusion of literal characters in BNF
-->
<!ELEMENT terminalsymbol (#PCDATA | %inline.class;)*>


<!-- A kw element is just a keyword...text in all caps
-->
<!ELEMENT kw (#PCDATA)>


<!-- An sjkw element is a SQL/JSON keyword...text in monospaced font
-->
<!ELEMENT sjkw (#PCDATA)>


<!-- A seeTheRules element is an empty element that will be rendered by
     setting the sequence "!! See the Syntax Rules"
-->
<!ELEMENT seeTheRules EMPTY>


<!-- The code element is used for blocks of code examples 
     The indent attribute, if specified as "yes", makes the block indented
-->
<!ELEMENT code (#PCDATA | NoDefinition |
                %inline.class; | %comments.class;)*>
<!ATTLIST code
  indent ( yes | no ) #IMPLIED
>


<!-- The xmlcode element is used for blocks of XML-related code examples
     The indent attribute, if specified with "yes", makes the block indented
-->
<!ELEMENT xmlcode (#PCDATA | NoDefinition |
                   %inline.class; | %comments.class;)*>
<!ATTLIST xmlcode
  indent ( yes | no ) #IMPLIED
>


<!-- The schemacode element is used for table definitions, etc.
     The indent attribute, if specified with "yes", makes the block indented
-->
<!ELEMENT schemacode (#PCDATA | NoDefinition | %inline.class; | %comments.class;)*>
<!ATTLIST schemacode
  indent ( yes | no ) #IMPLIED
>


<!-- The hostcode element is used for blocks of programming language code
     The indent attribute, if specified with "yes", makes the block indented
-->
<!ELEMENT hostcode (#PCDATA | 
                    %inline.class; | %comments.class;)*>
<!ATTLIST hostcode
  indent ( yes | no ) #IMPLIED
>

<!ELEMENT adaPackageConditions EMPTY>


<!-- A note is the word NOTE, a sequential note number, a dash, and text     -->
<!-- The number attribute is used only in the TC and allows a specific       -->
<!--   note number to be given, such as "12.1"                               -->
<!ELEMENT note (#PCDATA | %comments.class; | %paratext.class;
             | %lists.class; | %codeblock.class; | %tables.class; 
             | %images.class; | %examples.class; | %inline.class;)*>
<!ATTLIST note
	id     ID #IMPLIED
  number CDATA #IMPLIED
>


<!-- A definition is used for terms formally defined in Definitions          -->
<!-- The term child element is required (naturally) and the domain child     -->
<!--   element is optional (naturally).  In addition, note that the defn     -->
<!--   element is also optional, because the definition element is used not  -->
<!--   only to define new terms in "this" part, but also to cite terms that  -->
<!--   are defined in other documents.                                       -->
<!ELEMENT definition (term+, (%comments.class;)*, 
                                  defnDomain?, (%comments.class;)*, 
                                  defn?, (%comments.class;)*, 
                                  defnExample*, (%comments.class;)*, 
                                  defnNote*, (%comments.class;)*, 
                                  defnSource?, (%comments.class;)*, 
                                  (%notes.class;)*)>
<!-- The start attribute forces the list to start with the given number      -->
<!-- For example, <definition start="5">, followed by two <definition>       -->
<!-- elements would result in definitions 3.1.6.5, 3.1.6.6 and 3.1.6.7       -->
<!-- (assuming that the they occur in Subclause 3.1.6).                      -->
<!-- The new attribute causes the list elements to append "." and a sort of  -->
<!--   "extended" number that follows the "." and then increments for        -->
<!--   subsequent definitions.                                               -->
<!-- For example, <definition start="5" new="1">, followed by one more       -->
<!-- <definition> element would result in definitions 3.1.6.5.1, 3.1.6.5.2   -->
<!ATTLIST definition
 id    ID #IMPLIED
 start CDATA #IMPLIED
 new   CDATA #IMPLIED
>


<!-- A term is part of a formal definition; it is the term being defined.    -->
<!ELEMENT term (#PCDATA | %inline.class;)*>
<!-- The type attribute defines the type of the term. 
     The ISO Directives Part 2 defines 3 alternatives:
        * preferred - the preferred term(s) which should be listed in preference order
        * admitted - other acceptable term(s) for the concept
        * deprecated -  terms which should no longer be used
-->
<!ATTLIST term
 type (preferred | admitted | deprecated) "preferred"
>


<!-- A defnDdomain is part of a formal definition; it expands the term being defined.
-->
<!ELEMENT defnDomain (#PCDATA | %inline.class;)*>


<!-- The defn is the actual definition in a formal definition                -->
<!ELEMENT defn (#PCDATA | %inline.class;)*>
<!-- If the id attribute is specified then a (set) of entities are generated for the
     <term>s defined in the <definition> which can be used with the document.
     The entity names are the term with preceeding and following underscores.
     Entities with botn lowercase and initial capitals are generated.
     If type is not specified then plural versions of the above are also generated.
     * a - the term is and adjective or adverb
     * npn - the term is a noun whose plural is identical to its singular form, e.g. data
     If qual is specified then, in the entities generated, the value of qual with 2 preceeding
     underscores is appended to the term in all the generated entities.
-->
<!ATTLIST defn
  id ID #IMPLIED
  type (a | npn) #IMPLIED
  qual (type | edge) #IMPLIED>


<!-- The defnNote is part of a formal definition; it is used for a normative note in a definition
-->
<!ELEMENT defnNote (#PCDATA | %inline.class;)*>


<!-- The defnExample is part of a formal definition; it allows to give an example of term usage -->
<!ELEMENT defnExample (#PCDATA | %inline.class;)*>


<!-- The defnSource is part of a formal definition; it describes the source of the term -->
<!ELEMENT defnSource (#PCDATA | %inline.class;)*>


<!-- An ednote has a prominent header, is boxed, and contains text
-->
<!ELEMENT ednote (#PCDATA | %paratext.class; | %lists.class; | %codeblock.class; 
                 | %inline.class; | %comments.class;)*>
<!ATTLIST ednote
	id ID #IMPLIED
>

<!-- Tables (table) are a bit complicated...
-->
<!ELEMENT table ((%comments.class;)*, (tableNumber?, tableTitle)?,
                 (%comments.class;)*, table-common,
                 (%comments.class;)*, table-body,
                 (%comments.class;)*)>
<!-- The class attribute is currently unused.  The keep attribute is intended
     to signify that the rendering engine do as much as possible to keep the
     table on a single page 
-->
<!ATTLIST table
	id ID #IMPLIED
  class CDATA #IMPLIED
  keep  CDATA #IMPLIED
>

<!ELEMENT table-common (
  (%comments.class;)*, table-setup,
  ((%comments.class;)*, table-notations)?,
  ((%comments.class;)*, table-heads)?,
  (%comments.class;)*)>

<!ELEMENT table-notations (
  ((%comments.class;)*, table-key)?,
  ((%comments.class;)*, table-note)*,
  (%comments.class;)*)>

<!ELEMENT table-body (
  ((%comments.class;)*, table-row)+,
  (%comments.class;)*)>


<!-- A tableNumber may be present for formal tables, but only in the TC      -->
<!ELEMENT tableNumber (#PCDATA)>


<!-- A tableTitle is present for formal tables, absent for informal tables   -->
<!ELEMENT tableTitle (#PCDATA | %inline.class;)*>


<!-- A table setup determines the number and width of columns                -->
<!ELEMENT table-setup ((%comments.class;)*, table-coldef)+>
<!ATTLIST table-setup
	numcols CDATA #REQUIRED
>


<!-- table-key is present to define a single key for notations in a table    -->
<!ELEMENT table-key (#PCDATA | %inline.class; | %blocks.class;)*>


<!-- table-note is present to define one or more footnotes in a table        -->
<!ELEMENT table-note (#PCDATA | %inline.class; | %blocks.class;)*>
<!ATTLIST table-note
   note-char CDATA #REQUIRED
>


<!-- A table column definition gives the number of each column and its width -->
<!ELEMENT table-coldef EMPTY>
<!ATTLIST table-coldef
	colnum   CDATA #REQUIRED
	colwidth CDATA #REQUIRED
>


<!-- The table heads have one or more table head elements or table head rows -->
<!ELEMENT table-heads ((%comments.class;)*, (table-head-row | table-head))+>


<!-- A table head row is a container for multi-row table heads               -->
<!ELEMENT table-head-row ((%comments.class;)*, table-head)+>


<!-- A table head is just inline material                                    -->
<!ELEMENT table-head (#PCDATA | %inline.class; )*>
<!-- The span attribute allows the editor to specify table headers that      -->
<!-- span more than one table column.                                        -->
<!-- The vspan attribute allows the editor to specify table headers that     -->
<!-- span more than one table row.                                           -->
<!-- The align attribute allows the editor to specify how the text of a      -->
<!-- table header is positioned (horizontally) within its space              -->
<!ATTLIST table-head
  span  CDATA #IMPLIED
  vspan CDATA #IMPLIED
  align ( left | center | right ) #IMPLIED
>


<!-- A table-noteref is the way to reference a table-note from a cell        -->
<!ELEMENT table-noteref EMPTY>
<!ATTLIST table-noteref
   note-char CDATA #REQUIRED
>


<!-- A table row is one or more table cells                                  -->
<!ELEMENT table-row ((%comments.class;)*, table-cell)+>


<!-- A table cell may contain inline material or block material              -->
<!ELEMENT table-cell (#PCDATA | table-row-number | %inline.class; |
                      %blocks.class;)*>
<!-- The span attribute allows the editor to specify table headers that      -->
<!-- span more than one table column.                                        -->
<!-- The vspan attribute allows the editor to specify table headers that     -->
<!-- span more than one table row.                                           -->
<!-- The align attribute allows the editor to specify how the text of a      -->
<!-- table cell is positioned (horizontally) within its space                -->
<!-- The valign attribute allows the editor to specify how the text of a     -->
<!-- table cell is positioned (vertically) within its space                  -->
<!ATTLIST table-cell
  span   CDATA #IMPLIED
  vspan  CDATA #IMPLIED
  align  ( left | center | right ) #IMPLIED
  valign ( top | middle | bottom ) #IMPLIED
>


<!-- A table-row-number is the number of the given row within its table      -->
<!ELEMENT table-row-number EMPTY>
<!ATTLIST table-row-number
	id     ID #IMPLIED
  number CDATA #IMPLIED
>


<!-- A figure element has a figureTitle, and has an ID and an image file     -->
<!ELEMENT figure ((%comments.class;)*, (figureNumber?, figureTitle)?)>
<!ATTLIST figure
	id    ID #REQUIRED
	file  CDATA #REQUIRED
	width CDATA #IMPLIED
>


<!-- A figureNumber may be present for figures, but only in the TC           -->
<!ELEMENT figureNumber (#PCDATA)>


<!-- A figureTitle is always present                                         -->
<!ELEMENT figureTitle (#PCDATA | %inline.class;)*>


<!-- An example element has an exampleTitle, and has an ID and <code> element -->
<!ELEMENT example ((%comments.class;)*, exampleNumber?, exampleTitle, (%codeblock.class;))>
<!ATTLIST example
	id    ID #REQUIRED
>


<!-- An exampleNumber may be present for examples, but only in the TC        -->
<!ELEMENT exampleNumber (#PCDATA)>


<!-- An exampleTitle is always present
-->
<!ELEMENT exampleTitle (#PCDATA | %inline.class;)*>


<!-- An equation element has an equationTitle and an ID and <mathML> element -->
<!ELEMENT equation ((%comments.class;)*, equationNumber?, equationTitle, mathML)>
<!ATTLIST equation
	id    ID #REQUIRED
>


<!-- An equationNumber may be present for equations, but only in the TC      -->
<!ELEMENT equationNumber (#PCDATA)>


<!-- An equationTitle is always present
-->
<!ELEMENT equationTitle (#PCDATA | %inline.class;)*>


<!-- A mathML element TEMPORARILY is allowed ONLY as a child of an equation
-->
<!ELEMENT mathML (m:math)>


<!-- Most standards contain specifications that raise conditions. 
     Each of those conditions (exception and completion) are recorded in a table in the part that
     specifies when they are raised.  
     In earlier versions of this DTD, that table was manually marked up to display the class codes
     of such conditions and, where applicable, the subclass codes for each of the class codes.
     The <raise> element marked up the specifications where those conditions are raised, and took a
     <class> and optionally a <subclass> child element, each of which contained the actual text that
     expressed the condition.
     In this version of the DTD, the <raise> element instead has two attributes, class and subclass, 
     that each take the "code" value of the class and optionally subclass of the condition being 
     raised.
     Furthermore, the table that consolidates all conditions in a given document is now generated 
     from an external .xml file instead of being manually marked.
     conditionsTable generates a table of the used conditions
-->
<!ELEMENT conditionsTable ( tableTitle, (conditionsFrom)* )>
<!ATTLIST conditionsTable
  id ID #REQUIRED
>

<!-- conditionsFrom defines the part whose defined conditions are not to be included but for which
     an "All alternatives from..." row is to be generated.
     The value of the @part attribute must be the value of the 2-digit part number of the part 
     whose definitions are not to be included. 
-->
<!ELEMENT conditionsFrom EMPTY>
<!ATTLIST conditionsFrom
  part CDATA #REQUIRED
>



<!-- A modifiesPart indicates what part, and what (sub)clause in that part,  -->
<!--   a (sub)clause in an incremental part modifies                         -->
<!ELEMENT modifiesPart EMPTY>
<!ATTLIST modifiesPart
  part ( 01 | 02 | 03 | 04 | 09 | 11 ) #REQUIRED
  ref  CDATA #REQUIRED
>


<!-- A modifiedByPart indicates what incremental part, and what (sub)clause  -->
<!--   in that incremental part, modifies "this" (sub)Clause in a modified   -->
<!--   part                                                                  -->
<!ELEMENT modifiedByPart EMPTY>
<!ATTLIST modifiedByPart
  part CDATA #REQUIRED
  ref  CDATA #REQUIRED
>


<!-- A functionSignature indicates the name, parameters, and parameter       -->
<!-- data types for a function in a function library                         -->
<!-- For example:
     normal_distribution (
       given_value REAL,
       mean REAL,
       standard_deviation REAL,
       cumulative_or_density STRING
     )
     returns (
       density_or_probability REAL
     )

     The markup for that signature might be:
     <functionSignature name="normal_distribution">
       <funcParam paramName="given_value" paramType="REAL"/>
       <funcParam paramName="mean" paramType="REAL"/>
       <funcParam paramName="standard_deviation" paramType="REAL"/>
       <funcParam paramName="cumulative_or_density" paramType="STRING"/>
       <funcReturn returnName="density_or_probability" returnType="REAL"/>
     </funcParam>
-->
<!ELEMENT functionSignature (funcParam*, funcReturn+)>
<!ATTLIST functionSignature
  name CDATA #REQUIRED
>

<!-- A funcParam indicates the name and data type of a parameter of a        -->
<!-- function in a function library, as well as whether the parameter is     -->
<!-- optional or not                                                         -->
<!ELEMENT funcParam EMPTY>
<!ATTLIST funcParam
  paramName CDATA #REQUIRED
  paramType CDATA #REQUIRED
  paramOptional CDATA #IMPLIED
>

<!-- A funcReturn indicates the name and data type of a return value of a    -->
<!-- function in a function library, as well as whether the return value is  -->
<!-- optional or not                                                         -->
<!ELEMENT funcReturn EMPTY>
<!ATTLIST funcReturn
  returnName CDATA #REQUIRED
  returnType CDATA #REQUIRED
  returnOptional CDATA #IMPLIED
>



