<!ATTLIST subClause3
	id ID   #REQUIRED
	newpage ( true | false ) #IMPLIED
>


<!-- A subClause4 has a heading and a body, but no subclauses                -->
<!--   A subClause4 has 1 attribute: a symbol for referencing it             -->
<!ELEMENT subClause4 ((%comments.class;)*, clauseNumber?,
