<!-- An slist is a simple list (no bullets, numbers, etc.)                   -->
<!ELEMENT slist (item | (%comments.class;)*)+>


<!-- A ulist is an unnumbered list (bullets or dashes)                       -->
<!ELEMENT ulist (item | (%comments.class;)*)+>


<!-- An olist is an ordered list (numbers, letters, roman numerals, etc.)    -->
<!ELEMENT olist (((%comments.class;)* | (%notes.class;)* | item)+
               | ((%comments.class;)*, None, (%comments.class;)*)
               | ((%comments.class;)*, NoAdditional, (%comments.class;)*))>
<!-- The start attribute forces the list to start with the given number      -->
<!-- For example, <olist start="5">, followed by three <item> elements       -->
<!--   would result in items 5, 6, 7                                         -->
<!-- The new attribute causes the list elements to append "." and a sort of  -->
<!--   "extended" number that follows the "." and then increments for        -->
<!--   subsequent list items.                                                -->
<!-- For example, <olist start="5" new="1">, followed by three <item>        -->
<!--   elements would result in items 5.1, 5.2, 5.3                          -->
<!ATTLIST olist
  start CDATA #IMPLIED
  new   CDATA #IMPLIED
>


<!-- An nlist is a simple numbered list                                      -->
<!ELEMENT nlist (item | (%comments.class;)*)+>
<!-- The start attribute forces the list to start with the given number      -->
