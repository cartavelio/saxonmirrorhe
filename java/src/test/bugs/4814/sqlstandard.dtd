>


<!-- A dlist is a simple dashed list
-->
<!ELEMENT dlist (item | (%comments.class;)*)+>


<!-- A blist is a simple bulleted list
-->
<!ELEMENT blist (item | (%comments.class;)*)+>


<!-- A list item can be the same things that bodyMatter can be, plus a bit
-->
