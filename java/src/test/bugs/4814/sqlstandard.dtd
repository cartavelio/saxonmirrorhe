>


<!-- symreturn is used in an invocable subclause to identify its return item 
-->
<!ELEMENT symreturn (#PCDATA | %inline.class;)*>
<!-- The "name" attribute = symbolic parameter name                          
-->
<!ATTLIST symreturn
  name CDATA #REQUIRED
>


<!-- tcSymparam is used in an invocable subclause to identify a parameter 
     in the TC where there is not a proper referent                          
-->
<!ELEMENT tcSymparam (#PCDATA | %inline.class;)*>
<!-- the "name" attribute = symbolic parameter name                          
-->
<!ATTLIST tcSymparam
  name CDATA #IMPLIED
>


<!-- applySC is used in the Rules of one Subclause to cause the Rules        -->
<!--   of some other, invocable Subclause to be applied                      -->
<!-- 2016-10-21 and 2017-02-25: allow 0, 1, or more symreturns               -->
<!ELEMENT applySC ((symarg)*, symresult*)>
<!-- The "ref" attribute identifies the Subclause whose Rules will be applied-->
<!-- The "rules" attribute specifies which set of Rule are to be applied     -->
<!ATTLIST applySC
  ref   IDREF #REQUIRED
  rules ( Syntax | Access | General ) #IMPLIED
>


<!-- symarg is used to define an argument passed to an invocable subclause   -->
<!ELEMENT symarg (#PCDATA | %inline.class;)*>
<!-- The "param" attribute identifies the target symparam by name            -->
<!ATTLIST symarg
  param CDATA #REQUIRED
>


<!-- symresult is used to capture the result of an invocable subclause       -->
<!ELEMENT symresult (#PCDATA | %inline.class;)*>
<!-- the "param" attribute identifies the target symparam by name            -->
<!ATTLIST symresult
  param CDATA #REQUIRED
>


<!-- tcSymarg is used to define an argument passed to an invocable subclause -->
<!-- in the TC where there is not a proper referent                          -->
<!ELEMENT tcSymarg (#PCDATA | %inline.class;)*>
<!-- The "ref" attribute identifies that other Subclause                     -->
<!-- the "param" attribute identifies the target symparam by name            -->
<!ATTLIST tcSymarg
  param CDATA #IMPLIED
  ref   IDREF #IMPLIED
>


<!-- *********************************************************************** -->
<!-- 2006-09-05 ** TEMPORARILY changed ref attribute to be CDATA **          -->
<!--    But eventually, must change it back to IDREF                         -->
<!-- *********************************************************************** -->
<!-- applyExtSC is used in the Rules of one Subclause to cause the           -->
<!--   Rules of some invocable Subclause in another Part to be applied       -->
<!-- 2016-10-21 and 2017-02-25: allow 0, 1, or more extsymresults            -->
<!ELEMENT applyExtSC ((extsymarg)*, extsymresult*)>
<!-- The "part" attribute identifies the part in which the symparam appears  -->
<!-- The "ref" attribute identifies the Subclause whose Rules will be applied-->
<!-- The "rules" attribute specifies which set of Rule are to be applied     -->
<!--    standard - the standard number of the part if this is different from
                   that of the referencing document 
-->
<!ATTLIST applyExtSC
  part  ( 01 | 02 | 03 | 04 | 09 | 10 | 11 | 13 | 14 | 15 | 16 | 17 | 18 | 19 | 20 ) #REQUIRED
  ref   CDATA #REQUIRED
  rules ( Syntax | Access | General ) #IMPLIED
  standard CDATA #IMPLIED
>


<!-- *********************************************************************** -->
<!-- 2005-05-25 ** TEMPORARILY changed ref attribute to be CDATA **          -->
<!--    But eventually, must change it back to IDREF                         -->
<!-- *********************************************************************** -->
