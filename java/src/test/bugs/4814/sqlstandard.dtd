<!--   "extended" number that follows the "." and then increments for        -->
<!--   subsequent list items.                                                -->
<!ATTLIST nlist
  start CDATA #IMPLIED
  new   CDATA #IMPLIED
>


<!-- An alist is a simple lower-case alphabetical list                       -->
<!ELEMENT alist (item | (%comments.class;)*)+>
<!-- The start attribute forces the list to start with the given number      -->
<!-- The new attribute causes the list elements to append "." and a sort of  -->
<!--   "extended" number that follows the "." and then increments for        -->
<!--   subsequent list items.                                                -->
<!ATTLIST alist
  start CDATA #IMPLIED
  new   CDATA #IMPLIED
>


<!-- An rlist is a simple lower-case roman-number list                       -->
<!ELEMENT rlist (item | (%comments.class;)*)+>
