                      (%comments.class;)*, bodyMatter?,
                      ((%comments.class;)*, subClause2)*, (%comments.class;)*)>
<!ATTLIST subClause
	id      ID #REQUIRED
	newpage ( true | false ) #IMPLIED
>


<!-- A subClause2 has a heading, body, possibly subclauses (max 2 levels)    -->
