<!-- SCsignature is used to specify the signature of subclauses that are
     invoked from rules in other subclauses 
     2016-10-21 and 2017-02-25: allow 0, 1, or more symreturns               
-->
<!ELEMENT SCsignature ((symparam)*, symreturn*)>
<!ATTLIST SCsignature
  rules ( Syntax|Access|General ) #IMPLIED
>


<!-- symparam is used in an invocable subclause to identify a parameter      
-->
<!ELEMENT symparam (#PCDATA | %inline.class;)*>
<!-- The "name" attribute = symbolic parameter name                         
 -->
<!ATTLIST symparam
