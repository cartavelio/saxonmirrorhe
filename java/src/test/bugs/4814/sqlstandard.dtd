  textOnly ( yes | no ) #IMPLIED
>


<!-- package is used to represent the packages of the SQL language           -->
<!ELEMENT package (#PCDATA | %inline.class;)*>
<!ATTLIST package
	code CDATA #REQUIRED
>


<!-- indexTerm is used to "wrap" and identify terms and phrases that are     -->
<!--   intended to be indexed.  This is normally applied through the use of  -->
<!--   a stylesheet applied to the original XML file, not manually applied.  -->
<!ELEMENT indexTerm (#PCDATA | %inline.class;)*>


<!-- unicode is represents Unicode values using "U+nnnn"
-->
<!ELEMENT unicode (#PCDATA | %inline.class;)*>


<!-- mono is set in Courier or other monospaced font
-->
<!ELEMENT mono (#PCDATA | %inline.class;)*>


<!-- hosttext is set in Courier or other monospaced font
-->
<!ELEMENT hosttext (#PCDATA | %inline.class;)*>


<!-- URI is set in Courier or other monospaced font
-->
<!ELEMENT URI (#PCDATA | %inline.class;)*>
<!ATTLIST URI
	active CDATA 'yes'
>


<!-- bool represents the 3 Boolean values, they are presented in italics and underlined
-->
<!ELEMENT bool (#PCDATA | %inline.class;)*>


<!-- raise identifies a condition that is to be raised
-->
<!ELEMENT raise EMPTY>
<!ATTLIST raise
    class    CDATA #REQUIRED
    subclass CDATA #IMPLIED
>

<!-- sub is a subscript
-->
<!ELEMENT sub (#PCDATA | %inline.class;)*>


<!-- super is a superscript
-->
<!ELEMENT super (#PCDATA | %inline.class;)*>


<!-- A phrase links to passages and defns explaining a term
-->
<!ELEMENT phrase (#PCDATA | %inline.class;)*>
<!ATTLIST phrase
	ref IDREF #REQUIRED
>


<!-- A repeatdefn repeats a previously defined defn in inline text
-->
<!ELEMENT repeatdefn EMPTY>
<!ATTLIST repeatdefn
	ref IDREF #REQUIRED
>


<!-- A repeatpassage repeats a previously defined passage in inline text
-->
<!ELEMENT repeatpassage EMPTY>
<!ATTLIST repeatpassage
	ref IDREF #REQUIRED
>


<!-- A specref is Clause/Subclause/Annex/etc., the number, and the title
-->
<!ELEMENT specref EMPTY>
<!ATTLIST specref
	ref IDREF #REQUIRED
>


<!-- An itemref is used to reference a list element
-->
<!ELEMENT itemref EMPTY>
<!-- ref - symbolic reference to frag id (#) within a document                 -->
<!-- type - the kind of list item (General Rule, step, etc.)                   -->
<!--   ENHANCEMENT? Should I add allowable values for type, e.g., "paragraph"? -->
<!ATTLIST itemref
	ref  IDREF #REQUIRED
	type CDATA #REQUIRED
>


<!-- An extref is used to reference something in another document.  
     Its attributes are: 
       part - a part number (e.g., "01", "14") as defined in SQLParts.xml
       ref - symbolic reference to frag id (#) within a document
       and optionally: 
       standard - the standard number of the part if this is different from that of the referencing 
                  document 
-->
<!ELEMENT extref EMPTY>
<!ATTLIST extref
  part ( 01 | 02 | 03 | 04 | 09 | 10 | 11 | 13 | 14 | 15 | 16 | 17 | 18 | 19 | 20 ) #REQUIRED
  ref  CDATA #REQUIRED
  standard CDATA #IMPLIED
>


<!-- An extitemref is used to reference a list element in another document   -->
<!ELEMENT extitemref EMPTY>
<!-- part - a part number (e.g., "01", "14") as defined in SQLParts.xml      -->
<!-- ref - symbolic reference to frag id (#) within a document               -->
<!-- type - the kind of list item (General Rule, step, etc.)                 -->
<!ATTLIST extitemref
  part ( 01 | 02 | 03 | 04 | 09 | 10 | 11 | 13 | 14 | 15 | 16 | 17 | 18 | 19 | 20 ) #REQUIRED
  ref  CDATA #REQUIRED
  type ( LE | SR | AR | GR | CR | Desc | para | table | figure | note ) #IMPLIED
>


<!-- A PPref is used to reference a PP or LO element in the editor's notes,  -->
<!--   but only in "this" document, not in another document.                 
-->
<!ELEMENT PPref EMPTY>
<!-- ref - symbolic reference to frag id (#) within a document               
-->
<!ATTLIST PPref
	ref IDREF #REQUIRED
>


<!-- A lblitemref is used to reference a lblitem in a lbllist, but only in   -->
<!-- "this" document, not in another document.                               
-->
<!ELEMENT lblitemref EMPTY>
<!-- ref - symbolic reference to id of a lblitem                             
-->
<!ATTLIST lblitemref
  ref IDREF #REQUIRED
>


<!-- A docref is used to reference a refdocument.class element in a normativeReferences or 
     bibliography, but only in "this" document, not in another, unless in the TC, in which case 
     the part attribute is required. 
-->
<!ELEMENT docref EMPTY>
<!-- The attribute of docref are:
      * ref which is the id attribute of the document being referenced
      * part is the part in which the refdoc.class element exists. This is only for use in the TC.
--> 
<!ATTLIST docref
  ref  CDATA #REQUIRED
  part CDATA #IMPLIED
>


<!-- A footnote creates an inline, superscript, number (monotonically        -->
<!-- increasing through the document, as well as a block of text that floats -->
<!-- near the bottom of the page, prefixed with the same superscript number  
-->
<!ELEMENT footnote (#PCDATA | %inline.class;)*>
<!-- No attributes                                                           
-->


<!-- A mergeInstr is used to capture merge instructions (used for Rules,       -->
<!--   paragraphs, Descriptions, etc.) in incremental parts.                   -->
<!ELEMENT mergeInstr EMPTY>
<!-- instr - The words indicating the type of merger (e.g., Insert this SR)    -->
<!-- part  - The part in which the merge is metaphorically performed           -->
<!-- type  - The kind of thing being merged (e.g., SR, Descr.)                 -->
<!-- ref   - The symbolic reference of the place in the target document        -->
<!--           where the merger is metaphorically to take place                -->
<!--   ENHANCEMENT? Should I add allowable values for type, e.g., "paragraph"? -->
<!ATTLIST mergeInstr
  instr CDATA #REQUIRED
  part  ( 01 | 02 | 03 | 04 | 09 | 10 | 11 | 13 | 14 | 15 | 16 | 17 | 18 | 19 | 20 ) #REQUIRED
  type ( LE | SR | AR | GR | CR | Desc | para | table | figure | note | spec ) #IMPLIED
  ref   CDATA #IMPLIED
>


<!-- A box element has a...wait for it...box drawn around its contents       
-->
<!ELEMENT box (#PCDATA | %inline.class;)*>


<!-- A linebreak element has nothing in it; it is used to get a linebreak    
-->
<!ELEMENT linebreak EMPTY>


<!-- A blankline element has nothing in it; it is used to get a blank line   
-->
<!ELEMENT blankline EMPTY>


<!-- A breakindent element has nothing in it; it is used to get a blank line 
-->
<!ELEMENT breakindent EMPTY>


<!-- A math expression using Greek Sigma                                     
-->
<!ELEMENT math-sum (lower, upper, expression)>
<!ATTLIST math-sum
	index CDATA #REQUIRED
  length CDATA '3em'
  upadding CDATA '-3em'
  lpadding CDATA '-1.8em'
>


<!-- A math expression using Greek Pi                                        
-->
<!ELEMENT math-prod (lower, upper, expression)>
<!ATTLIST math-prod
	index CDATA #REQUIRED
  length CDATA '3em'
  upadding CDATA '-3em'
  lpadding CDATA '-1.8em'
>


<!ELEMENT lower (#PCDATA | %inline.class;)*>


<!ELEMENT upper (#PCDATA | %inline.class;)*>


<!ELEMENT expression (#PCDATA | %inline.class;)*>


<!-- ======================================================================= -->
<!-- Following this comment are the Editor Notes elements (PPs, LOs)         -->
<!-- ======================================================================= -->

<!-- A PP takes four attributes: id, number, severity (major or minor),      -->
<!--   and realm (technical or editorial).                                   -->
<!--   Its children include: reference (symbolic ref to Subclause), noteAt   -->
<!--   (symbolic ref to rule), source (paper number), problem (paragraphs    -->
<!--   of text), and solution (paragraphs of text)                           -->
<!ELEMENT PP ( (comment)*, reference*,
               (comment)*, noteAt*, 
               (comment)*, source*, 
               (comment)*, problem, 
               (comment)*, solution*,
               (comment)* )>
<!ATTLIST PP
id       ID #REQUIRED
number   CDATA #REQUIRED
severity CDATA #REQUIRED
realm    CDATA #REQUIRED
>


<!-- An LO takes two attributes: id and number                               -->
<!-- An LO's children include: reference (symbolic ref to Subclause),        -->
<!--   source (paper number), problem (paragraphs of text), and solution     -->
<!--   (paragraphs of text)                                                  -->
<!ELEMENT LO ( (comment)*, reference*, 
               (comment)*, noteAt*, 
               (comment)*, source*, 
               (comment)*, problem, 
               (comment)*, solution*, 
               (comment)* )>
<!ATTLIST LO
id     ID #REQUIRED
number CDATA #REQUIRED
>


<!-- A reference is merely PCDATA text members of the inline.class or blocks.class.
     One of the "ref" members of the inline.class may frequently be used
-->
<!ELEMENT reference (#PCDATA | %inline.class; | %blocks.class;)*>


<!-- A noteAt is merely PCDATA text or members of the inline.class or blocks.class.
     One of the "ref" members of the inline.class may frequently be used
-->
<!ELEMENT noteAt (#PCDATA | %inline.class; | %blocks.class;)*>


<!-- source describes the source of the Possible Problem or Language Opportunity
      * PCDATA text
      * one or more members of the inline.class 
      * one or more members of the blocks.class
-->
<!ELEMENT source (#PCDATA | %inline.class; | %blocks.class;)*>


<!-- problem describes the Possible Problem or Language Opportunity
      * one or more members of the blocks.class
-->
<!ELEMENT problem  (%blocks.class;)+>


<!-- solution provides a suggested solution to the Possible Problem or Language Opportunity
      * one or more members of the blocks.class
-->
<!ELEMENT solution (%blocks.class;)*>
