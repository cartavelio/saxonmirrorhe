<!--   but it's not worth the trouble to restrict them from clauses          -->
<!-- JM/SJC added tc as a possible child of bodyMatter, 2004-02-20           -->
<!ELEMENT bodyMatter ( ( (%comments.class;)*, tc )* |
                       ( %partModifier.class; | %blocks.class; | %subSection.class; )* ) >


<!-- =======================================================================
     A tc is a sequence of elements in support of the Technical Corrigendum 
    ======================================================================= 
-->

<!-- A tc element contains a rationale, a source, an instruction, and a body
-->
<!ELEMENT tc (tcRationale, tcSource, tcInstruction, tcBody*)>


<!-- The rationale is merely a textual explanation of why the tc exists
-->
<!ELEMENT tcRationale (#PCDATA | %inline.class; | %comments.class; )*>


