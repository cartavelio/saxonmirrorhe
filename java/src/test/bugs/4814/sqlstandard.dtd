<!-- Specify the elements of the backMatter                                  -->
<!-- ======================================================================= -->

<!-- An annex can be nested (with subClause[n]); we allow 3 sublevels only   -->
<!--   The clauseNumber attribute, used only in the TC, gives a specific #   -->
<!ELEMENT annex ((%comments.class;)*, clauseNumber?,
                 (%comments.class;)*, clauseHeading,
                 (%comments.class;)*, bodyMatter?,
                 (%comments.class;)*, conformanceSummary?,
                 ((%comments.class;)*, subClause)*, (%comments.class;)*)>
<!ATTLIST annex
	normative ( informative | normative ) #REQUIRED
	id        ID #REQUIRED
>


<!-- A conformanceSummary generates (right...) a conformance rules summary   -->
<!--  It should be used only in "Annex A", but we'll have to trust authors.  -->
<!ELEMENT conformanceSummary EMPTY>


<!-- A bibliography has one or more elements in the refdocument class
-->
<!ELEMENT bibliography ( ( (%refdocument.class;) | (%notes.class;) | (%comments.class;) )+ )>
<!-- The attribute of bibliography is:
      * id is the unique identifier for the bibliography
-->
<!ATTLIST bibliography
    id ID #REQUIRED
>


<!-- A normativeReferences has one or more elements in the refdocument class 
-->
<!ELEMENT normativeReferences ( ( (%refdocument.class;) | (%notes.class;) | (%comments.class;) )+ )>


<!-- iso-iec-std defines a reference for an ISO or IEC document
-->
<!ELEMENT iso-iec-std ((%comments.class;)*, docIdentifier, (%notes.class;)*,
                       (%comments.class;)*, docDate?, (%notes.class;)*,
                       (%comments.class;)*, docTitle, (%notes.class;)*,
                       (%comments.class;)*, URI?, (%notes.class;)*,
                       (%comments.class;)*)>
<!-- The attribute of iso-iec-std is:
      * id is the unique identifier for the document
-->
<!ATTLIST iso-iec-std
    id ID #REQUIRED
>


<!-- docIdentifier defines the reference text for an ISO or IEC document
     This is the text that is displayed by a docref element
-->
<!ELEMENT docIdentifier (#PCDATA | %inline.class;)*>


<!-- docDate is the date of publication for an ISO or IEC document
     This is optional and is only required is the containing document
      makes reference to explicit clauses, paragraphs, etc. in the referenced document.
-->
<!ELEMENT docDate (#PCDATA | %inline.class;)*>


<!-- docTitle is the title of the document
-->
<!ELEMENT docTitle (#PCDATA | %inline.class;)*>
<!-- The attribute of docTitle is:
      * comma If the value is "no" then the comma before the docTitle is suppressed
        This is required in an electronic-doc when primary-responsibility is specified, 
        in order to avoid the occurrence of a ". ," sequence.
-->
<!ATTLIST docTitle
    comma (yes | no) "yes"
>


<!-- An electronic-doc defines a reference for to a non-ISO and non-IEC document.
     Its sequence of elements and attributes is as defined in ISO 690 
-->
<!ELEMENT electronic-doc ((%comments.class;)*, docIdentifier, (%notes.class;)*,
                          (%comments.class;)*, docTitle, (%notes.class;)*,
                          (%comments.class;)*, docNotes?, (%notes.class;)*,
                          (%comments.class;)*, URI?, (%notes.class;)*,
                          (%comments.class;)*)>
<!-- The attribute of docTitle is:
      * id is the unique identifier for the document
      * primary-responsibility for an electronic document is normally that of the person(s) 
        responsible for writing the document. 
        Corporate bodies may also be treated as having primary responsibility when the work 
        reflects the collective thought or activity of the body or when the work is primarily 
        administrative in nature.
        If there are more than three names, only the first name, or the first two or three names, 
        need be recorded. The others may be omitted. 
        If names are omitted, the abbreviation "et al." shall be added after the last name recorded.
      * type-of-medium is the type of electronic medium. This will normally be "online".
      * subordinate-responsibility is for persons or corporate bodies performing a subordinate 
        function (editors, translators, illustrators, recipients of electronic mail; sponsoring 
        bodies, etc.) normally excluded from the "Primary responsibility" element.
      * edition is for the number or other designation for the edition in the terms given in the 
        source. Because electronic documents are often updated or expanded, they often carry a 
        statement of edition. Such words as "edition", "version", "release", "level", or "update" 
        are used; more traditional words such as "revised edition", "third update", or "training 
        level" may also appear.
      * publication-place is the place in which the item was published shall be recorded in the 
        original language as given on the source. The name of the state, province, country, etc., 
        should be added usually in parentheses (in abbreviated form if applicable) where it is 
        necessary to differentiate the place from others of the same name or to identify a place 
        that is not widely known.
      * publisher is the person or organization responsible production and dissemination of a 
        document.
      * publication-date is the date of publication
      * revision-date is the date of the update or revision using the terms given in the 
        source (e.g. "updated January 1997" or "rev. 1 March 1997").
      * citation-date is the date on which the electronic document was actually seen.
      * series is, in the case that an electronic document carries the name of a larger entity 
       (e.g. a series) of which it is a unit, either numbered or unnumbered, the name of that 
       larger entity and any related numeration should be recorded as they appear on the document.
      * number is the number of a non-ISO and non-IEC document which is assigned a number by its 
        publisher, e.g. IEEE documents.
-->
<!ATTLIST electronic-doc
    id ID #REQUIRED
    primary-responsibility CDATA #IMPLIED
    type-of-medium CDATA #IMPLIED
    subordinate-responsibility CDATA #IMPLIED
    edition CDATA #IMPLIED
    publication-place CDATA #IMPLIED
    publisher CDATA #IMPLIED
    publication-date CDATA #IMPLIED
    revision-date CDATA #IMPLIED
    citation-date CDATA #IMPLIED
    series CDATA #IMPLIED
    number CDATA #IMPLIED
>


<!-- docNotes is for any other relevant information regarding the document
