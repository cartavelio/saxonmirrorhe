<!-- strikethrough is text with a line through it                            
-->
<!ELEMENT strikethrough (#PCDATA | %inline.class;)*>


<!-- mark-inserted is text set in red and boldface                           
-->
<!ELEMENT mark-inserted (#PCDATA | %inline.class;)*>


<!-- mark-deleted is text set in blue and strikethrough                      
