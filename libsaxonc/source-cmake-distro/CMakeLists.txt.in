cmake_minimum_required(VERSION 3.27)
project(SaxonC@EDITION@ VERSION @VERSION@)

set(SaxonC_EDITION "@edition@" CACHE STRING "Saxon edition")
set(SAXON_EDITION "@EDITION@")
set(SAXONC_SRC_DIR .)
set(SAXONC_VERSION_SRC_DIR lib)
set(SAXONC_EDITION_SRC_DIR .)
set(SAXONC_CORE_PACKAGE_DIR SaxonCCore@EDITION@)

include("cmake/libsaxonc.cmake")
